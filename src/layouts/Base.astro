---
// Layout base: sistema visual del sitio (derivado del prototipo aprobado).
// Roboto para títulos y datos, PT Serif para el cuerpo. Amarillo #eeff41 solo
// con significado. El pie declara la licencia del material (ver /licencia).

// Fuentes autoalojadas: sin petición a Google, sin salto tipográfico y sin
// enviar la IP de quien lee a un tercero. Solo el subconjunto latino y solo
// los pesos que el sistema usa de verdad (el sans nunca va en cursiva).
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-700.css';
import '@fontsource/roboto/latin-900.css';
import '@fontsource/pt-serif/latin-400.css';
import '@fontsource/pt-serif/latin-700.css';
import '@fontsource/pt-serif/latin-400-italic.css';

// Las dos que pintan el primer viewport: el cuerpo y el titular.
import ptSerifRegular from '@fontsource/pt-serif/files/pt-serif-latin-400-normal.woff2';
import robotoBlack from '@fontsource/roboto/files/roboto-latin-900-normal.woff2';

interface Props {
  titulo: string;
  descripcion?: string;
  volverHref?: string;
  volverTexto?: string;
  // Páginas de uso interno de una clase (formularios, tableros de proyección).
  // No son secretas —el sitio no tiene login— pero no son parte del material
  // publicado y no deben aparecer en buscadores ni en el sitemap.
  noindex?: boolean;
  // `lectura` es la columna de siempre (62rem). `amplio` abre la retícula de
  // 12 columnas hasta 1296px: el hub, el curso y la sesión, que son índices
  // además de lectura. Las páginas de actividad y /diseno-visual no lo usan.
  ancho?: 'lectura' | 'amplio';
}

const { titulo, descripcion, volverHref, volverTexto, noindex, ancho = 'lectura' } = Astro.props;

// Destinos fijos de la cabecera. El actual se marca por prefijo de ruta; una
// sesión o una página de actividad cuenta como «Cursos».
const ruta = Astro.url.pathname;
const destinos = [
  { href: '/', texto: 'Cursos', activo: ruta === '/' || ruta.startsWith('/pensamiento-sensorial') },
  { href: '/diseno-visual', texto: 'Diseño visual', activo: ruta.startsWith('/diseno-visual') },
  { href: '/narrativa-interactiva/', texto: 'Narrativa interactiva', activo: ruta.startsWith('/narrativa-interactiva') },
  { href: '/licencia', texto: 'Licencia', activo: ruta.startsWith('/licencia') },
];

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cátedra · William Montoya" />
    <meta property="og:title" content={titulo} />
    {descripcion && <meta property="og:description" content={descripcion} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cátedra — repositorio docente de William Montoya" />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="license" href="https://creativecommons.org/licenses/by-nc-nd/4.0/" />
    <meta name="copyright" content="William Montoya" />
    <link rel="preload" href={ptSerifRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={robotoBlack} as="font" type="font/woff2" crossorigin />
    <style is:global>
      :root {
        --tinta: #222222;
        --texto: #444444;
        /* #888888 daba 3.54:1 sobre papel y no pasaba AA. #6f6f6f da 5.02:1
           y sostiene el mismo lugar en la jerarquía. */
        --secundario: #6f6f6f;
        --papel: #ffffff;
        --regla: #e5e5e5;
        --amarillo: #eeff41;
        --sans: 'Roboto', Helvetica, Arial, sans-serif;
        --serif: 'PT Serif', Georgia, serif;
        /* aire lateral: nada se pega a los bordes del viewport */
        --margen: clamp(1.5rem, 6vw, 4rem);

        /* Escala de espaciado de 4px, la misma del portafolio. Lo nuevo se
           escribe con estos tokens; lo anterior se migra cuando se toque. */
        --space-1: 4px;   --space-2: 8px;   --space-3: 12px;  --space-4: 16px;
        --space-5: 20px;  --space-6: 24px;  --space-8: 32px;  --space-10: 40px;
        --space-11: 48px; --space-14: 64px; --space-16: 80px; --space-18: 96px;
        --space-19: 112px;
        /* alias de la retícula amplia: cambian en los quiebres de abajo */
        --margen-amplio: var(--space-16);
        --gutter: var(--space-6);
        --seccion: var(--space-19);
        /* el sitio es claro por decisión: que el navegador no pinte los
           controles en oscuro cuando el sistema lo está. */
        color-scheme: light;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      /* 112.5% = 18px con el ajuste por defecto, pero respeta a quien subió
         el tamaño base de fuente en su navegador. */
      html { font-size: 112.5%; }

      body {
        background: var(--papel);
        color: var(--texto);
        font-family: var(--serif);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        /* Último recurso: solo actúa cuando una palabra no cabe de ninguna
           forma. No cambia nada de lo que ya entra bien, y evita que un
           titular o una URL larga del cuerpo .mdx saquen scroll horizontal. */
        overflow-wrap: break-word;
      }

      a { color: inherit; }

      ::selection { background: var(--amarillo); color: var(--tinta); }

      /* retícula amplia: 12 columnas hasta 1296px */
      .contenedor.amplio {
        max-width: calc(1296px + 2 * var(--margen-amplio));
        padding-left: max(var(--margen-amplio), env(safe-area-inset-left));
        padding-right: max(var(--margen-amplio), env(safe-area-inset-right));
      }

      .ret {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--gutter);
      }

      /* ficha: pares rótulo / valor (curso, edición, sesión) */
      .ficha { display: grid; gap: var(--space-3); }
      .ficha > div { display: grid; align-content: start; }
      .ficha dt {
        font-family: var(--sans);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--secundario);
      }
      .ficha dd { font-family: var(--sans); font-size: 0.95rem; color: var(--tinta); }

      .contenedor {
        max-width: 62rem;
        margin: 0 auto;
        padding: 0 var(--margen) 5rem;
        /* En horizontal, el recorte de la pantalla es más ancho que el margen
           mínimo (1.5rem) y se comería el filo del texto. */
        padding-left: max(var(--margen), env(safe-area-inset-left));
        padding-right: max(var(--margen), env(safe-area-inset-right));
      }

      /* ── utilidades ───────────────────────────── */

      /* Solo para lectores de pantalla. El `margin: -1px` importa: sin él la
         caja de 1px alarga el scroll horizontal en pantallas estrechas. */
      .sr-solo {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        border: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      /* salto al contenido: aparece únicamente con teclado */
      .salto {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 20;
        font-family: var(--sans);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: var(--amarillo);
        color: var(--tinta);
        border: 1px solid var(--tinta);
        padding: 0.7rem 1.2rem;
        text-decoration: none;
      }

      .salto:focus { left: 0.5rem; top: 0.5rem; }

      /* ── utilidades de voz ────────────────────── */
      .mono {
        font-family: var(--sans);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      /* los rótulos de sección son encabezados reales; el navegador les
         impone tamaño y peso propios y hay que devolverlos a `.mono`. */
      h2.mono, h3.mono { font-size: 0.72rem; font-weight: 500; }

      /* resaltado tipo marcador */
      .hl {
        background: linear-gradient(to top, var(--amarillo) 38%, transparent 38%);
        color: var(--tinta);
        padding: 0 0.08em;
      }

      /* ── cabecera ─────────────────────────────── */
      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 1.75rem 0;
        border-bottom: 1px solid var(--tinta);
      }

      .marca {
        font-family: var(--sans);
        font-weight: 900;
        font-size: 1rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--tinta);
        text-decoration: none;
        /* La marca no se parte: si no cabe junto a la navegación, la
           navegación baja a la fila siguiente. */
        white-space: nowrap;
      }

      .marca span { color: var(--secundario); font-weight: 400; }

      .volver {
        font-family: var(--sans);
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        color: var(--secundario);
        text-decoration: none;
        white-space: nowrap;
        display: inline-flex;
        gap: 0.4rem;
        align-items: baseline;
      }

      .volver:hover { color: var(--tinta); }

      .topbar { flex-wrap: wrap; }

      .topbar .derecha {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: flex-end;
        gap: var(--space-2) var(--space-6);
      }

      .nav-sitio ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2) var(--space-6);
      }

      .nav-sitio a {
        font-family: var(--sans);
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--texto);
        text-decoration: none;
        padding-block: var(--space-1);
      }

      .nav-sitio a:hover { color: var(--tinta); }

      /* la sección actual: subrayado amarillo, y además en negrita de tinta
         para que no dependa solo del color */
      .nav-sitio a[aria-current='page'] {
        color: var(--tinta);
        box-shadow: inset 0 -3px 0 var(--amarillo);
      }
      .volver .flecha-izq { transition: transform 0.18s ease; }
      .volver:hover .flecha-izq { transform: translateX(-3px); }

      /* ── animaciones de entrada ───────────────── */
      @keyframes sube {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .sube { animation: sube 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
      .sube-1 { animation-delay: 0.05s; }
      .sube-2 { animation-delay: 0.15s; }
      .sube-3 { animation-delay: 0.25s; }
      .sube-4 { animation-delay: 0.35s; }

      /* ══════════ HUB ══════════ */
      .hero { padding: 4.5rem 0 3.5rem; }

      .hero .mono { color: var(--secundario); display: block; margin-bottom: 1.5rem; }

      .hero h1 {
        font-family: var(--sans);
        font-weight: 900;
        font-size: clamp(2.4rem, 6.5vw, 4.4rem);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--tinta);
        max-width: 15ch;
      }

      .hero .lede {
        font-style: italic;
        font-size: 1.2rem;
        color: var(--texto);
        margin-top: 1.75rem;
        max-width: 36ch;
        line-height: 1.55;
      }

      /* ── tarjeta-póster del curso ─────────────── */
      .seccion { padding: 2.5rem 0 3rem; }

      .seccion > .mono { color: var(--secundario); display: block; margin-bottom: 1.5rem; }

      /* bloques de contenido */
      .bloque { padding: 3rem 0; border-bottom: 1px solid var(--regla); }
      .bloque:last-of-type { border-bottom: none; }

      .bloque > .mono { color: var(--secundario); display: block; margin-bottom: 1.25rem; }

      .bloque p { max-width: 56ch; margin-bottom: 1rem; }

      .pill {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        font-family: var(--sans);
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--tinta);
        text-decoration: none;
        border: 1px solid var(--tinta);
        padding: 0.55rem 1rem;
        margin-top: 0.5rem;
        transition: background 0.15s ease;
      }

      .pill:hover { background: var(--amarillo); }
      .pill .nota { color: var(--secundario); text-transform: none; letter-spacing: 0; }

      /* un correo en mayúsculas no se lee ni se copia bien */
      .pill.tal-cual { text-transform: none; letter-spacing: 0.02em; }

      /* sticker rotado */
      .sticker {
        display: inline-block;
        font-family: var(--sans);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        background: var(--amarillo);
        color: var(--tinta);
        border: 1px solid var(--tinta);
        padding: 0.35rem 0.7rem;
        transform: rotate(-2deg);
        box-shadow: 2px 2px 0 var(--tinta);
        white-space: nowrap;
      }

      /* ══════════ LANDING DE SESIÓN ══════════ */
      .hero-clase { padding: 4rem 0 3rem; }

      .hero-clase > .mono { color: var(--secundario); display: block; margin-bottom: 1.25rem; }

      .hero-clase .numeral-hero {
        font-family: var(--sans);
        font-weight: 900;
        font-size: clamp(4.5rem, 12vw, 8rem);
        letter-spacing: -0.04em;
        line-height: 0.9;
        color: var(--amarillo);
        -webkit-text-stroke: 2px var(--tinta);
        display: block;
      }

      .hero-clase h1 {
        font-family: var(--sans);
        font-weight: 900;
        font-size: clamp(2rem, 5.5vw, 3.4rem);
        line-height: 1.05;
        letter-spacing: -0.025em;
        color: var(--tinta);
        margin-top: 1rem;
        max-width: 18ch;
      }

      .hero-clase .lede {
        font-style: italic;
        font-size: clamp(1.05rem, 2.2vw, 1.3rem);
        line-height: 1.55;
        margin-top: 1.75rem;
        max-width: 42ch;
      }

      /* la pregunta que abre la tensión de la sesión */
      .pregunta-tension {
        font-style: italic;
        color: var(--secundario);
        margin-top: 1rem;
        max-width: 46ch;
      }

      .boton {
        font-family: var(--sans);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        background: var(--tinta);
        color: var(--papel);
        border: 1px solid var(--tinta);
        padding: 0.8rem 1.5rem;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .boton:hover { background: var(--amarillo); color: var(--tinta); }

      /* momentos de la sesión */
      .momentos { display: grid; gap: 1.25rem; }

      .momento {
        border-left: 3px solid var(--amarillo);
        padding-left: 1.25rem;
      }

      .momento .mono { color: var(--tinta); display: block; margin-bottom: 0.4rem; }

      .momento p { max-width: 56ch; font-size: 1rem; margin-bottom: 0; }

      /* ── la memoria de la sesión ────────────────────────────────────
         Una memoria es una distancia, así que la pieza central es un par:
         lo que se esperaba y lo que pasó, uno al lado del otro. El plan
         lleva filete gris y lo ocurrido lo lleva amarillo —la misma regla
         que separa `.momento` del resto: el amarillo marca lo vivo.
         El único relleno amarillo de la página es la sorpresa. Es el campo
         que más cuesta escribir y el que más vale leer; si compitiera con
         otro bloque por la atención, dejaría de ser el remate. */
      .memoria-cabecera {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem 2rem;
        flex-wrap: wrap;
        margin-bottom: 1.75rem;
      }

      .memoria-cabecera > .mono { color: var(--secundario); }
      .memoria-cabecera .escrita-el { color: var(--secundario); }

      .memoria-par {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem 2.5rem;
        align-items: start;
      }

      .memoria-par .lado { padding-left: 1.25rem; }
      .memoria-par .esperaba { border-left: 3px solid var(--regla); }
      .memoria-par .paso { border-left: 3px solid var(--amarillo); }

      .memoria-par h3.mono { display: block; margin-bottom: 0.5rem; }
      .memoria-par .esperaba h3.mono { color: var(--secundario); }
      .memoria-par .paso h3.mono { color: var(--tinta); }

      /* En el par, la medida la fija la columna: 56ch dejaría la de la
         izquierda más angosta que la de la derecha por puro azar del texto. */
      .memoria-par p { max-width: none; font-size: 1rem; margin-bottom: 0; }

      .memoria-evidencia { margin-top: 2.5rem; }
      .memoria-evidencia h3.mono { color: var(--secundario); display: block; margin-bottom: 1rem; }

      .memoria-evidencia ul { list-style: none; max-width: 60ch; }

      .memoria-evidencia li {
        border-top: 1px solid var(--regla);
        padding: 0.85rem 0;
        font-size: 0.95rem;
        color: var(--texto);
      }

      .memoria-evidencia li:last-child { border-bottom: 1px solid var(--regla); }

      .memoria-sorpresa {
        margin-top: 2.5rem;
        max-width: 46rem;
        background: var(--amarillo);
        border: 2px solid var(--tinta);
        box-shadow: 4px 4px 0 var(--tinta);
        padding: 1.75rem 2rem;
      }

      .memoria-sorpresa h3.mono { color: var(--tinta); display: block; margin-bottom: 0.6rem; }

      /* Sin medida propia: la caja ya la fija. Con `max-width` en ch, el texto
         se detenía a dos tercios del amarillo y sobraba un vacío a la derecha
         que hacía ver la caja rota en vez de amplia. */
      .memoria-sorpresa p {
        color: var(--tinta);
        max-width: none;
        margin-bottom: 0;
      }

      /* El cambio es la consecuencia de la sorpresa, no un apéndice: va pegado
         a ella y cerrado por una regla gruesa, la única de la página, para que
         no se lea como texto que sobró después del bloque amarillo. */
      .memoria-cambio {
        margin-top: 2rem;
        border-top: 2px solid var(--tinta);
        padding-top: 1.25rem;
        max-width: 46rem;
      }

      .memoria-cambio h3.mono { color: var(--secundario); display: block; margin-bottom: 0.5rem; }
      .memoria-cambio p { max-width: 56ch; margin-bottom: 0; }

      /* materiales: enlaces */
      ul.materiales { list-style: none; }

      ul.materiales li { border-bottom: 1px solid var(--regla); }
      ul.materiales li:first-child { border-top: 1px solid var(--regla); }

      ul.materiales a {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0.25rem;
        text-decoration: none;
        transition: transform 0.18s ease;
      }

      ul.materiales a:hover { transform: translateX(0.35rem); }

      ul.materiales .mat-titulo { color: var(--tinta); }

      ul.materiales .mat-autor {
        font-family: var(--sans);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--secundario);
        white-space: nowrap;
      }

      /* cuerpo MDX de la sesión (notas, referentes) */
      .contenido-mdx p { max-width: 56ch; margin-bottom: 1rem; }

      /* Titular de sección dentro de una consigna. La misma voz sans del resto
         del sitio: sin esta regla, un h2 de consigna hereda la serif del cuerpo
         y el tamaño por defecto del navegador. Los rótulos `.mono` quedan fuera
         a propósito: son etiquetas, no titulares. */
      .bloque h2:not(.mono) {
        font-family: var(--sans);
        font-weight: 700;
        font-size: 1.4rem;
        line-height: 1.25;
        color: var(--tinta);
        margin-bottom: 0.9rem;
      }

      .contenido-mdx h2 {
        font-family: var(--sans);
        font-weight: 700;
        font-size: 1.4rem;
        color: var(--tinta);
        margin: 2.5rem 0 1rem;
      }

      .contenido-mdx ul {
        list-style: none;
      }

      .contenido-mdx li {
        padding: 0.6rem 0;
        font-size: 0.98rem;
        border-bottom: 1px solid var(--regla);
        max-width: 56ch;
      }

      .contenido-mdx li:last-child { border-bottom: none; }

      .contenido-mdx em { color: var(--tinta); }

      .contenido-mdx strong { color: var(--tinta); }

      /* `a { color: inherit }` es global: sin esta regla, un enlace escrito
         en el cuerpo de una sesión sería indistinguible del texto. */
      .contenido-mdx a {
        color: var(--tinta);
        text-decoration: underline;
        text-decoration-color: var(--regla);
        text-underline-offset: 0.15em;
      }

      .contenido-mdx a:hover { text-decoration-color: var(--tinta); }

      /* condiciones de la licencia: frases, no enlaces */
      ul.condiciones { list-style: none; }

      ul.condiciones li {
        border-bottom: 1px solid var(--regla);
        padding: 1rem 0.25rem;
        color: var(--tinta);
        max-width: 56ch;
      }

      ul.condiciones li:first-child { border-top: 1px solid var(--regla); }

      /* ── navegación entre sesiones ────────────── */
      /* El aire de abajo importa: sin él el botón se pega al filo del pie.
         3rem es el mismo respiro que usa `.bloque`. */
      .nav-sesiones {
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        border-top: 1px solid var(--tinta);
        padding: 1.5rem 0 3rem;
        margin-top: 1rem;
      }

      .salto-sesion {
        display: block;
        flex: 1 1 14rem;
        text-decoration: none;
        padding: 0.35rem 0;
        transition: transform 0.18s ease;
      }

      .salto-sesion.hacia-atras:hover, .salto-sesion.hacia-atras:focus-visible {
        transform: translateX(-0.35rem);
      }

      .salto-sesion.hacia-adelante {
        text-align: right;
      }

      .salto-sesion.hacia-adelante:hover, .salto-sesion.hacia-adelante:focus-visible {
        transform: translateX(0.35rem);
      }

      .salto-sesion .mono { color: var(--secundario); display: block; margin-bottom: 0.35rem; }
      .salto-sesion .que-sigue { font-family: var(--sans); font-weight: 700; color: var(--tinta); }
      .salto-sesion:hover .mono { color: var(--tinta); }

      .volver-curso {
        flex: 1 1 100%;
        text-align: center;
        margin-top: 1.25rem;
      }

      /* ── candado ──────────────────────────────── */
      .candado-fondo {
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, 0.94);
        display: none;
        align-items: center;
        /* En horizontal, o con el teclado del teléfono abierto, el diálogo es
           más alto que la ventana. `safe` evita que el centrado recorte la
           parte de arriba —justo donde está el botón de cerrar—; quien no lo
           entienda descarta la línea y conserva el `center` de arriba. */
        align-items: safe center;
        justify-content: center;
        overflow-y: auto;
        padding: 1.5rem;
        z-index: 10;
      }

      .candado-fondo.abierto { display: flex; }

      .candado {
        position: relative;
        background: var(--papel);
        border: 2px solid var(--tinta);
        box-shadow: 10px 10px 0 var(--amarillo), 10px 10px 0 2px var(--tinta);
        padding: 2.75rem;
        max-width: 26rem;
        width: 100%;
      }

      /* Sin este botón, la única salida sin teclado es tocar fuera del
         diálogo, y nada lo indica. Por eso mismo tiene que poder tocarse: 44px
         es el mínimo para acertarle con el pulgar. La caja crece, la × no. */
      .candado .cerrar {
        position: absolute;
        top: 0.25rem;
        right: 0.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 44px;
        font-family: var(--sans);
        font-size: 1.4rem;
        line-height: 1;
        background: none;
        border: 1px solid transparent;
        color: var(--secundario);
        padding: 0;
        cursor: pointer;
      }

      .candado .cerrar:hover { color: var(--tinta); }

      .candado .numeral-modal {
        font-family: var(--sans);
        font-weight: 900;
        font-size: 3.5rem;
        letter-spacing: -0.03em;
        line-height: 1;
        color: var(--amarillo);
        -webkit-text-stroke: 2px var(--tinta);
        display: block;
      }

      .candado h3 {
        font-family: var(--sans);
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--tinta);
        margin: 0.75rem 0 0.5rem;
      }

      .candado p { font-size: 0.95rem; margin-bottom: 1.5rem; }

      .candado form { display: flex; gap: 0.75rem; }

      .candado input {
        flex: 1;
        min-width: 0;
        font-family: var(--sans);
        font-size: 0.95rem;
        padding: 0.7rem 0.85rem;
        border: 1px solid var(--tinta);
        outline: none;
        background: var(--papel);
      }

      .candado input:focus { box-shadow: 3px 3px 0 var(--amarillo); }

      .candado button {
        font-family: var(--sans);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        background: var(--tinta);
        color: var(--papel);
        border: 1px solid var(--tinta);
        padding: 0.7rem 1.4rem;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .candado button:hover { background: var(--amarillo); color: var(--tinta); }

      .candado .error {
        font-family: var(--sans);
        font-size: 0.8rem;
        font-weight: 500;
        color: #b3261e;
        margin-top: 0.85rem;
        min-height: 1.2em;
      }

      /* ── pie: licencia ──────────────────────── */
      /* Es una frase con información legal, no una etiqueta: sans y legible,
         pero sin mayúsculas ni tracking de rótulo. */
      .pie {
        border-top: 1px solid var(--regla);
        padding: 1.5rem 0 0;
        color: var(--secundario);
        font-family: var(--sans);
        font-size: 0.8rem;
        line-height: 1.6;
      }

      .pie a { color: var(--texto); text-decoration-color: var(--regla); }
      .pie a:hover { color: var(--tinta); text-decoration-color: var(--tinta); }

      /* ── responsive ───────────────────────────── */
      @media (max-width: 1100px) {
        :root { --margen-amplio: var(--space-11); --seccion: var(--space-18); }
      }

      @media (max-width: 759px) {
        :root { --margen-amplio: var(--space-5); --gutter: var(--space-4); --seccion: var(--space-16); }
      }

      /* La cabecera con cuatro destinos más «volver» ya no cabe en una fila
         por debajo de esto: la marca arriba, la navegación debajo. */
      @media (max-width: 56rem) {
        .topbar { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
        .topbar .derecha { justify-content: flex-start; flex-direction: column-reverse; align-items: flex-start; }
        .nav-sitio ul { gap: var(--space-1) var(--space-5); }
      }

      @media (max-width: 40rem) {
        html { font-size: 100%; }

        /* La marca y el enlace de vuelta dejan de repartirse una sola fila.
           `.volver` no puede partirse en dos líneas, así que era la marca la
           que cedía: en una sesión ("← Pensamiento Sensorial 3.0") quedaba
           partida en tres. Apiladas, cada una entra completa. */
        .topbar {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
        }

        .hero { padding: 3.5rem 0 2.5rem; }

        /* El par de la memoria se apila. Sigue leyéndose como par porque el
           filete de color no cambia: gris el plan, amarillo lo que pasó. */
        .memoria-par { grid-template-columns: 1fr; gap: 1.75rem; }
        .memoria-sorpresa { padding: 1.5rem; box-shadow: 3px 3px 0 var(--tinta); }



        .candado { padding: 2rem 1.5rem; }
      }

      @media (max-width: 30rem) {
        .salto-sesion.hacia-adelante { text-align: left; }
        /* el autor de un material puede ser más ancho que la pantalla */
        ul.materiales a { flex-wrap: wrap; }
        ul.materiales .mat-autor { white-space: normal; }
      }

      /* ── movimiento reducido ──────────────────── */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-delay: 0ms !important;
          transition-duration: 0.01ms !important;
        }
        ul.materiales a:hover, .salto-sesion:hover { transform: none; }
      }

      /* foco de teclado visible */
      a:focus-visible, button:focus-visible, input:focus-visible {
        outline: 2px solid var(--tinta);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <div class:list={['contenedor', { amplio: ancho === 'amplio' }]}>
      <header class="topbar">
        <a class="marca" href="/">Cátedra <span>/ William Montoya</span></a>
        <div class="derecha">
          {volverHref && volverTexto && (
            <a class="volver" href={volverHref}><span class="flecha-izq" aria-hidden="true">←</span> {volverTexto}</a>
          )}
          <nav class="nav-sitio" aria-label="Sitio">
            <ul role="list">
              {destinos.map((d) => (
                <li><a href={d.href} aria-current={d.activo ? 'page' : undefined}>{d.texto}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      </header>
      <main id="contenido">
        <slot />
      </main>
      <footer class="pie">
        © 2026 William Montoya · Material docente bajo licencia
        {' '}<a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" rel="license">CC BY-NC-ND 4.0</a>
        {' '}· <a href="/licencia">Licencia y usos</a>
      </footer>
    </div>
  </body>
</html>
