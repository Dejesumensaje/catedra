---
// Consigna de la tarea de la sesión 3: construir la imagen del sistema.
// La actividad no alcanzó a ocurrir en clase y quedó como tarea: el prototipo
// se construye en casa y la prueba cruzada abre la próxima sesión. La primera
// fase es el simulador (/simulador). Esta es la única consigna; la antigua
// página de la tarea (/que-estamos-suponiendo) redirige acá.
import Base from '../../layouts/Base.astro';

// Las personas no son diagnósticos ni arquetipos de marketing: son modelos
// mentales que no coinciden con el del sistema. Esa distancia es el ejercicio.
// Son las mismas cinco personas del simulador —allí se vive su situación— y la
// asignación a los grupos se hizo por sorteo.
const personas = [
  {
    grupo: 'Grupo 1',
    nombre: 'Valentina, 22 · un plato con gluten la enferma de verdad',
    quiere: 'Almorzar sin exponerse al gluten.',
    espera: 'Poder confiar en que una opción es segura — no solo ver información sobre ella.',
    noQuiere: 'Adivinar si la etiqueta «sin gluten» es confiable, ni escribirle a cada restaurante a preguntar.',
    sePierde: 'Cuando tiene toda la información y aún así no puede confiar: informar no es lo mismo que responder por el plato.',
  },
  {
    grupo: 'Grupo 2',
    nombre: 'Sofía, 29 · pide para su mamá, enferma y en otra ciudad',
    quiere: 'Que su mamá, sola en Medellín, almuerce hoy. Ella está en Bogotá.',
    espera: 'Pedir para otra persona, a distancia, y saber qué le pasó después de la entrega.',
    noQuiere: 'Que el sistema la trate como quien recibe: notificaciones, timbre e instrucciones no son para ella.',
    sePierde: 'Cuando «pedido entregado ✓» no le dice lo único que necesita saber: si su mamá abrió y está comiendo.',
  },
  {
    grupo: 'Grupo 3',
    nombre: 'Camila, 27 · tiene 40 minutos para almorzar',
    quiere: 'Almorzar antes de la 1:00 p. m. A esa hora entra a una reunión que no puede moverse.',
    espera: 'Que el tiempo que la app promete sea algo en lo que se pueda confiar: que alguien responda por esa hora.',
    noQuiere: 'Estimados que se recalculan en silencio mientras su hora de almuerzo corre.',
    sePierde: 'Cuando ningún número de la pantalla le dice lo único que importa: si va a alcanzar o no.',
  },
  {
    grupo: 'Grupo 4',
    nombre: 'Andrés, 41 · coordina el almuerzo de las 8 personas de su equipo',
    quiere: 'Resolver el almuerzo de ocho personas como una sola situación, no como ocho pedidos.',
    espera: 'Reunir lo que quiere cada quien, repartir cada plato y cobrar a cada uno lo suyo.',
    noQuiere: 'Ocho procesos completos, ni perseguir a todos la semana siguiente para que le paguen.',
    sePierde: 'Cuando el sistema lo trata como un solo comensal: un comprador, un pedido, un pago — y él está coordinando a ocho.',
  },
  {
    grupo: 'Grupo 5',
    nombre: 'Ernesto, 68 · quiere el almuerzo de siempre',
    quiere: 'Pedir el almuerzo del domingo: el mismo de siempre, del restaurante del barrio.',
    espera: 'Repetir con confianza algo que ya conoce, sin explorar ni decidir todo de nuevo.',
    noQuiere: 'Los 438 restaurantes, ni rearmar el pedido plato por plato cada vez.',
    sePierde: 'Cuando cualquier cambio —un precio, un menú reordenado— lo devuelve a explorar, comparar y dudar.',
  },
];

// Ficha B, la misma para todos: capacidades del sistema, no pantallas.
// Si dijera cómo debe verse, la actividad dejaría de ser diseño.
const sistema = [
  'Explorar cientos de restaurantes con su menú, sus precios y sus tiempos estimados.',
  'Filtrar por tipo de comida, precio, tiempo de entrega y calificación.',
  'Comparar opciones antes de elegir.',
  'Elegir un plato y personalizarlo: cantidades, modificaciones, notas para la cocina.',
  'Confirmar el pedido: resumen, dirección de entrega, total.',
  'Pagar: tarjeta, billetera digital o efectivo.',
  'Seguir el pedido por sus estados: recibido, en preparación, en camino, entregado.',
];

const pasos = [
  {
    numero: '01',
    titulo: 'Construyan la imagen del sistema',
    cuerpo: 'Con lo que trajeron del simulador: la ficha A, lo que el sistema da por hecho y su replanteamiento. La fidelidad no importa; importa que puedan probar una hipótesis, no que se vea bonita.',
  },
  {
    numero: '02',
    titulo: 'Pónganla a prueba',
    cuerpo: 'Otro grupo la recorre con solo la ficha A en la mano.',
    enClase: true,
  },
  {
    numero: '03',
    titulo: 'Comparen',
    cuerpo: 'El modelo mental inicial con el que la persona armó al usar la propuesta. ¿Qué logró comunicar? ¿Dónde produjo una lectura inesperada?',
    enClase: true,
  },
  {
    numero: '04',
    titulo: 'Segunda vuelta',
    cuerpo: 'Mismo sistema, otra persona. ¿Qué tendría que cambiar en la imagen del sistema?',
    enClase: true,
  },
];

const requisitos = [
  {
    titulo: 'Móvil',
    cuerpo: 'El prototipo se diseña y se prueba en pantalla de celular.',
  },
  {
    titulo: 'Flujo completo',
    cuerpo: 'Desde que la persona abre la app hasta confirmar el pedido. Si en algún punto habría que «imaginar» el siguiente paso, el flujo no está completo.',
  },
  {
    titulo: 'Interactuable',
    cuerpo: 'Eso define el nivel de terminado: no que se vea bonito, sino que alguien lo pueda recorrer sin ayuda.',
  },
];

const herramientas = [
  {
    nombre: 'Papel',
    cuerpo: 'Paper prototyping, con una condición: pantallas claramente marcadas y las bifurcaciones explícitas. Qué pasa si toco acá, qué pasa si me equivoco, qué pasa si cancelo.',
  },
  {
    nombre: 'Canva, Figma o similar',
    cuerpo: 'Pantallas enlazadas que se puedan recorrer de principio a fin.',
  },
  {
    nombre: 'Inteligencia artificial',
    cuerpo: 'Claude, Kimi, Gemini o la que prefieran, con la miniguía de más abajo. Es una vía más, no un requisito.',
  },
];

const pasosIA = [
  {
    n: '01',
    titulo: 'Diseñen en papel primero',
    cuerpo: 'Antes de abrir cualquier herramienta, el grupo decide la interfaz: qué ve su persona primero, qué pantallas hay y en qué orden, qué dice cada una. Un boceto acordado por todo el grupo es suficiente. Ese boceto es su diseño, y es la referencia contra la que se evalúa todo lo demás.',
  },
  {
    n: '02',
    titulo: 'Pasen su diseño a la IA',
    cuerpo: 'Con el boceto decidido, descríbanselo a la herramienta —o tómenle una foto al papel— junto con la ficha A y la ficha B, y pídanle el prototipo en un solo archivo HTML: «Construye este prototipo navegable. Este es nuestro diseño: …».',
  },
  {
    n: '03',
    titulo: 'Iteren contra su diseño, y guarden el rastro',
    cuerpo: 'Lo que la IA entregue se compara con el boceto y con la ficha A. Si se inventó pantallas, cambió el orden o agregó cosas que su persona no quiere, se corrige. Vayan guardando los prompts, las versiones y las correcciones: ese rastro es parte de la entrega.',
  },
  {
    n: '04',
    titulo: 'Tráiganlo funcionando',
    cuerpo: 'Publíquenlo gratis en Netlify Drop —arrastran el archivo y obtienen un enlace, como ya lo hizo un grupo— o simplemente traigan el archivo HTML y ábranlo en el navegador.',
  },
];

const conceptos = [
  {
    n: '01',
    q: 'Affordances y signifiers',
    nota: '¿Cómo sabe la persona qué puede hacer, y dónde?',
  },
  {
    n: '02',
    q: 'Constraints',
    nota: '¿Qué le impide equivocarse?',
  },
  {
    n: '03',
    q: 'Mappings',
    nota: '¿Dónde está cada cosa, y qué relación tiene con lo que controla?',
  },
  {
    n: '04',
    q: 'Feedback',
    nota: '¿Qué le responde el sistema cuando actúa?',
  },
];

const listo = [
  'Una persona que nunca ha visto el prototipo puede completar un pedido sin ayuda, hasta el pedido confirmado y sin huecos.',
  'Ninguna pantalla contradice la ficha A de su persona.',
  'Al menos una capacidad de la ficha B quedó por fuera o transformada, y pueden decir por qué su persona no la necesita.',
  'Si la primera pantalla es un catálogo con filtros, pueden defender por qué su persona empieza ahí.',
  'En cada pantalla se puede decir cómo sabe la persona qué puede hacer, qué le impide equivocarse, dónde está cada cosa y qué le responde el sistema.',
  'Cada decisión del prototipo dice de dónde salió: ficha A, ficha B o uno de los cinco conceptos.',
];
---

<Base
  titulo="Construir la imagen del sistema · Tarea · Pensamiento Sensorial 3.0"
  descripcion="Tarea de la sesión 3: todos los grupos diseñan la misma app de domicilios, cada uno para una persona distinta. Prototipo móvil, flujo completo, interactuable — y que otro grupo lo use sin explicaciones."
  volverHref="/pensamiento-sensorial/s03"
  volverTexto="Sesión 3 · ¿Qué es esta cosa?"
>
  <section class="hero-clase">
    <span class="mono sube sube-1">Tarea · Sesión 3 · En grupos · Para la próxima clase</span>
    <h1 class="sube sube-2">Construir la imagen del sistema</h1>
    <p class="lede sube-3">El mismo sistema. Cinco personas distintas. Se construye en casa, se prueba en clase.</p>
  </section>

  <section class="bloque">
    <h2 class="mono">Primero · El simulador</h2>
    <div class="encargo">
      <p class="encargo-frase">
        Antes de diseñar nada: <strong>vivan el problema.</strong>
      </p>
      <p class="encargo-nota">
        Una persona. Un sistema. Un problema. El simulador los pone en la situación
        de su persona —la del sorteo, la misma de la ficha A de más abajo—: usan la
        app como la usaría ella, sienten dónde el sistema no la deja hacer lo que
        esperaba, y solo entonces se ponen a diseñar. El recorrido queda guardado y
        se exporta: <strong>ese recorrido es la primera parte de la entrega</strong>.
      </p>
      <p class="encargo-nota">
        Tómenlo con calma: equivocarse dentro del simulador es parte del ejercicio.
      </p>
      <p class="encargo-cta">
        <a class="boton" href="/pensamiento-sensorial/simulador">Abrir el simulador →</a>
      </p>
    </div>
  </section>

  <section class="bloque">
    <h2 class="mono">El encargo</h2>
    <div class="encargo">
      <p class="encargo-frase">
        En la próxima clase, otro grupo usa su prototipo con solo la ficha A en la
        mano. Ustedes observan y <strong>no dicen una palabra</strong>.
      </p>
      <p class="encargo-nota">
        Si hay que explicarlo, la imagen del sistema todavía no está haciendo su
        trabajo. Todos los grupos diseñan el mismo sistema —una app de domicilios—
        y cada uno recibe <strong>una persona distinta</strong>.
      </p>
      <p class="encargo-nota">
        La <strong>ficha A</strong> es el modelo mental: quién es su persona, qué
        quiere resolver, qué espera, qué no quiere hacer. La <strong>ficha B</strong>{' '}
        es el modelo conceptual: qué puede hacer el sistema. No dice cómo debe verse.
      </p>
      <p class="encargo-nota">
        La regla: los dos modelos <strong>no coinciden</strong>. El simulador los deja
        con los dos extremos escritos —lo que espera su persona y lo que el sistema da
        por hecho—. Lo que falta va en el medio, y es lo que ustedes construyen:
      </p>
      <p class="encargo-plantilla">
        modelo mental · <span class="vacio">la imagen del sistema</span> · modelo conceptual
      </p>
    </div>
  </section>

  <section class="bloque">
    <h2 class="mono">Ficha A · Su persona</h2>
    <p>
      Cada grupo trabaja con la suya —la misma que les tocó en el simulador—. Las
      otras cuatro quedan acá para que sepan qué van a enfrentar cuando les toque
      probar la propuesta de otro grupo.
    </p>
    <ul class="personas" role="list">
      {personas.map((p) => (
        <li class="persona">
          <span class="persona-grupo mono">{p.grupo}</span>
          <h3 class="persona-nombre">{p.nombre}</h3>
          <dl class="persona-ficha">
            <div><dt>Quiere resolver</dt><dd>{p.quiere}</dd></div>
            <div><dt>Espera</dt><dd>{p.espera}</dd></div>
            <div><dt>No quiere</dt><dd>{p.noQuiere}</dd></div>
            <div><dt>Se siente perdida</dt><dd>{p.sePierde}</dd></div>
          </dl>
        </li>
      ))}
    </ul>
  </section>

  <section class="bloque">
    <h2 class="mono">Ficha B · El sistema</h2>
    <p>
      Esta ficha es la misma para todos. Es el modelo conceptual: lo que el sistema
      puede hacer y la información que maneja. <strong>No es una lista de pantallas</strong>,
      ni un menú obligatorio: cómo se hace perceptible cada una de estas cosas —y
      cuáles ni siquiera aparecen— es exactamente lo que van a diseñar.
    </p>
    <ul class="sistema" role="list">
      {sistema.map((capacidad) => <li>{capacidad}</li>)}
    </ul>
    <p class="remate">
      Restar también es diseñar: al menos una de estas capacidades tiene que
      quedar <strong>por fuera o transformada</strong>, y tienen que poder decir por qué su
      persona no la necesita. Ernesto —que solo quiere repetir el almuerzo de
      siempre— debería terminar sin catálogo infinito, sin filtros y sin comparación.
    </p>
  </section>

  <section class="bloque">
    <h2 class="mono">El proceso · de acá en adelante</h2>
    <p>
      Las tres primeras preguntas —dónde le falla la app a su persona, qué quiere y
      dónde choca con el sistema— ya las respondieron dentro del simulador. Lo que
      queda es esto:
    </p>
    <ol class="pasos" role="list">
      {pasos.map((paso) => (
        <li class="paso">
          <span class="paso-num mono">{paso.numero}</span>
          <div>
            <h3 class="paso-titulo">
              {paso.titulo}{paso.enClase && <span class="paso-cuando mono">en clase</span>}
            </h3>
            <p class="paso-cuerpo">{paso.cuerpo}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="bloque">
    <h2 class="mono">Lo que construyen</h2>
    <p>
      La imagen del sistema de su app de domicilios, para la persona que les tocó.
      Tres requisitos no negociables:
    </p>
    <div class="ejemplos">
      {requisitos.map((r) => (
        <div class="ejemplo">
          <span class="ejemplo-tag mono">{r.titulo}</span>
          <p>{r.cuerpo}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bloque">
    <h2 class="mono">Cómo lo construyen · Decisión de ustedes</h2>
    <p>
      La herramienta no es el tema. La interacción sí. Vale cualquier forma de
      construir el prototipo:
    </p>
    <div class="ejemplos">
      {herramientas.map((h) => (
        <div class="ejemplo">
          <span class="ejemplo-tag mono">{h.nombre}</span>
          <p>{h.cuerpo}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bloque">
    <details class="miniguia">
    <summary>
      <span class="miniguia-signo" aria-hidden="true">+</span>
      <span class="mono">Miniguía · si lo construyen con IA</span>
      <span class="miniguia-nota">cuatro pasos · ábranla solo si esa es su herramienta</span>
    </summary>
    <ol class="pasos" role="list">
      {pasosIA.map((paso) => (
        <li class="paso">
          <span class="paso-num mono">{paso.n}</span>
          <div>
            <h3 class="paso-titulo">{paso.titulo}</h3>
            <p class="paso-cuerpo">{paso.cuerpo}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="nota-prueba">
      La regla dura: la IA es solo la forma de hacer el prototipo —el equivalente a
      que otro grupo use papel o Canva—. <strong>Quienes diseñan la interfaz son
      ustedes.</strong> Ojo con la trampa: la primera respuesta de cualquier IA es la
      app genérica —catálogo infinito, ocho filtros, carrusel de promociones—, es
      decir, el modelo mental de nadie. Si lo que entrega se parece a la app de
      domicilios que ya conocen, la señal no es que haya que pulirlo: es que el
      diseño todavía no está hecho.
    </p>
    </details>
  </section>

  <section class="bloque">
    <h2 class="mono">Lo que se evalúa</h2>
    <p>
      Esto es un curso de interfaz e interacción. Lo que se evalúa es cómo usan los
      cinco conceptos para permitir <strong>interacciones con sentido</strong>:
    </p>
    <ol class="preguntas" role="list">
      {conceptos.map((c) => (
        <li>
          <span class="pregunta-n mono" aria-hidden="true">·</span>
          <div>
            <h3 class="pregunta-q">{c.q}</h3>
            <p class="pregunta-nota">{c.nota}</p>
          </div>
        </li>
      ))}
    </ol>
    <p>
      Y se evalúa <strong>el proceso</strong>: las decisiones que tomaron y cómo
      guiaron la herramienta, no el acabado visual del prototipo. Un prototipo
      impecable sin proceso visible no sustenta. Un prototipo tosco con decisiones
      claras, sí.
    </p>
  </section>

  <section class="bloque">
    <h2 class="mono">Qué entregan</h2>
    <div class="entregable">
      <p class="entregable-titulo">Un solo documento, por Classroom, antes de la próxima clase. El enlace o el archivo del prototipo, aparte.</p>
      <ol class="entrega" role="list">
        <li>
          <span class="entrega-letra mono" aria-hidden="true">A</span>
          <span class="entrega-texto">
            <strong>El recorrido del simulador.</strong>{' '}
            <span class="entrega-detalle">Se copia o se descarga desde la pantalla final del simulador. Trae las decisiones, lo que el sistema da por hecho y el replanteamiento.</span>
          </span>
        </li>
        <li>
          <span class="entrega-letra mono" aria-hidden="true">B</span>
          <span class="entrega-texto">
            <strong>El prototipo.</strong>{' '}
            <span class="entrega-detalle">Funcionando, móvil, flujo completo, interactuable.</span>
          </span>
        </li>
        <li>
          <span class="entrega-letra mono" aria-hidden="true">C</span>
          <span class="entrega-texto">
            <strong>El boceto inicial.</strong>{' '}
            <span class="entrega-detalle">Foto de donde el grupo decidió la interfaz antes de construir.</span>
          </span>
        </li>
        <li>
          <span class="entrega-letra mono" aria-hidden="true">D</span>
          <span class="entrega-texto">
            <strong>El rastro de IA.</strong>{' '}
            <span class="entrega-detalle">Solo si la usaron: los prompts clave, qué entregó, qué corrigieron y por qué.</span>
          </span>
        </li>
      </ol>
    </div>

    <h3 class="listo-titulo mono">Está listo cuando…</h3>
    <ul class="listo" role="list">
      {listo.map((l) => <li>{l}</li>)}
    </ul>
  </section>

  <section class="bloque">
    <h2 class="mono">El cierre</h2>
    <div class="cierre">
      <p>
        Al final no preguntamos cuál propuesta quedó mejor. Preguntamos:
      </p>
      <p class="cierre-pregunta">
        ¿Qué tuvo que hacer la interfaz para que los dos modelos se encontraran?
      </p>
      <p>
        Los cinco grupos resolvieron el mismo sistema para cinco personas distintas.
        La comparación no es entre diseños: es entre cinco maneras de cerrar la misma brecha.
      </p>
    </div>
  </section>
</Base>

<style>
  /* ── el encargo ───────────────────────────────── */
  .encargo {
    border: 2px solid var(--tinta);
    padding: 1.75rem 2rem;
    max-width: 46rem;
  }

  .encargo-frase {
    font-family: var(--sans);
    font-weight: 900;
    font-size: clamp(1.25rem, 3.2vw, 1.6rem);
    line-height: 1.25;
    color: var(--tinta);
    max-width: none;
    margin-bottom: 1rem;
  }

  .encargo-frase strong { background: var(--amarillo); padding: 0 0.15em; }

  .encargo-nota {
    max-width: none;
    margin-bottom: 0.9rem;
    font-size: 0.98rem;
    color: var(--secundario);
  }

  .encargo-nota strong { color: var(--tinta); }

  .encargo-plantilla {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--tinta);
    max-width: none;
    margin: 0.5rem 0 0;
    padding: 1rem 1.25rem;
    background: var(--amarillo);
    line-height: 1.5;
  }

  /* el hueco: mismo punteado que el cierre del simulador */
  .encargo-plantilla .vacio {
    letter-spacing: 0.02em;
    border: 2px dashed var(--tinta);
    padding: 0.2rem 0.6rem;
    display: inline-block;
  }

  .encargo-cta { margin: 1.5rem 0 0; max-width: none; }
  .encargo-cta .boton { text-decoration: none; display: inline-block; }

  /* ── las cinco personas ───────────────────────── */
  .personas {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin: 1.5rem 0 0;
  }

  .persona { border-top: 3px solid var(--tinta); padding-top: 0.8rem; }

  .persona-grupo { display: block; color: var(--secundario); margin-bottom: 0.5rem; }

  .persona-nombre {
    font-family: var(--sans);
    font-weight: 900;
    font-size: 1.15rem;
    color: var(--tinta);
    line-height: 1.25;
    margin-bottom: 0.9rem;
  }

  .persona-ficha { margin: 0; }

  .persona-ficha div {
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--regla);
  }

  .persona-ficha div:last-child { border-bottom: none; }

  .persona-ficha dt {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--secundario);
    margin-bottom: 0.15rem;
  }

  .persona-ficha dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--texto);
    line-height: 1.5;
    max-width: none;
  }

  /* ── ficha B ──────────────────────────────────── */
  .sistema {
    list-style: none;
    max-width: 52rem;
    margin-top: 1.25rem;
  }

  .sistema li {
    position: relative;
    padding: 0.6rem 0 0.6rem 1.9rem;
    font-size: 1rem;
