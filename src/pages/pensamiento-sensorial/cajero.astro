---
// El cajero tal como funciona hoy: solo el flujo, paso a paso.
//
// Esto era el laboratorio 2 parte 1 —encontrar una fricción y quitarla en
// treinta minutos, en grupos—. En la sesión 2 el tiempo se fue en UNO y en
// User Inyerface y el taller no se hizo, así que la página se quedó con lo
// único que sigue haciendo falta: que se entienda la máquina antes de
// rediseñarla. La consigna de qué hay que hacer vive en la tarea.
//
// El flujo va escrito como user flow —qué hace la persona, qué responde la
// máquina— y no como lista de nombres de pantalla. Es la única forma de que se
// pueda analizar con el vocabulario de la clase.
// Los pasos `fijo` están condicionados por seguridad: son la frontera del
// ejercicio, no un obstáculo que haya que vencer.
// Ojo con los pasos 3 a 6: la respuesta de la máquina es literalmente la
// misma cuatro veces. La repetición está a propósito y no se comenta — que la
// encuentren ellos es media clase.
import Base from '../../layouts/Base.astro';

const flujo = [
  { n: '1', persona: 'Inserta la tarjeta y la suelta.', maquina: 'La traga, lee el chip y la retiene.', fijo: true },
  { n: '2', persona: 'Marca cuatro dígitos, tapando el teclado con la otra mano.', maquina: 'Muestra un asterisco por cada dígito.', fijo: true },
  { n: '3', persona: 'Busca «Retiro» entre las opciones de la pantalla.', maquina: 'Muestra la siguiente pantalla.', fijo: false },
  { n: '4', persona: 'Elige de qué cuenta sale la plata.', maquina: 'Muestra la siguiente pantalla.', fijo: false },
  { n: '5', persona: 'Escribe el monto en el teclado numérico.', maquina: 'Muestra la siguiente pantalla.', fijo: false },
  { n: '6', persona: 'Revisa lo que escribió y confirma.', maquina: 'Muestra la siguiente pantalla.', fijo: false },
  { n: '7', persona: 'Espera, sin saber cuánto.', maquina: 'Consulta al banco y autoriza.', fijo: true },
  { n: '8', persona: 'Toma los billetes y los cuenta.', maquina: 'Abre el dispensador y entrega.', fijo: false },
  { n: '9', persona: 'Saca la tarjeta.', maquina: 'La devuelve y pita hasta que la retiren.', fijo: false },
  { n: '10', persona: 'Decide si quiere recibo y lo recoge.', maquina: 'Lo imprime.', fijo: false },
];
---

<Base
  titulo="El cajero, paso a paso · Pensamiento Sensorial 3.0"
  descripcion="El flujo completo de un retiro de dinero, tal como funciona hoy: qué hace la persona y qué responde la máquina."
  volverHref="/pensamiento-sensorial/s02"
  volverTexto="Sesión 2 · El lenguaje secreto de las cosas"
>
  <section class="hero-clase">
    <span class="mono sube sube-1">Sesión 2 · La máquina de la que se parte</span>
    <h1 class="sube sube-2">El cajero, paso a paso</h1>
    <p class="lede sube-3">Cómo funciona hoy, antes de tocarlo.</p>
  </section>

  <section class="bloque">
    <p class="entrada">
      Así retira plata alguien hoy. Cada paso tiene dos partes: lo que hace la
      persona y lo que contesta el cajero. Léanlo entero antes de rediseñar
      nada — <a href="/pensamiento-sensorial/cajero-para-todos">la tarea</a> se
      compara contra este flujo.
    </p>

    <div class="uf-carriles" aria-hidden="true">
      <span class="mono">La persona</span>
      <span class="mono">El cajero</span>
    </div>

    <ol class="userflow" role="list">
      {flujo.map((paso) => (
        <li class:list={['uf-paso', { fijo: paso.fijo }]}>
          <div class="uf-persona">
            <span class="uf-n mono">{paso.n}</span>
            <span class="uf-rotulo mono">La persona</span>
            <p>{paso.persona}</p>
          </div>
          <div class="uf-flecha" aria-hidden="true">→</div>
          <div class="uf-maquina">
            <span class="uf-rotulo mono">El cajero</span>
            <p>{paso.maquina}</p>
          </div>
          {paso.fijo && (
            <span class="uf-marca mono">
              fijo<span class="sr-solo"> — condicionado por seguridad, no se puede cambiar</span>
            </span>
          )}
        </li>
      ))}
    </ol>

    <p class="flujo-leyenda">
      Los tres pasos marcados <strong>fijo</strong> están condicionados por la seguridad o por
      la validación del banco. Esos no se tocan. Todo lo demás está sobre la mesa.
    </p>

    <p class="flujo-leyenda">
      Los tres pasos marcados <strong>fijo</strong> están condicionados por la
      seguridad o por la validación del banco. Esos no se tocan, ni aquí ni en
      la tarea. Todo lo demás está sobre la mesa.
    </p>
  </section>
</Base>

<style>
  .entrada {
    max-width: 52ch;
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }

  .entrada a {
    color: var(--tinta);
    text-decoration: underline;
    text-decoration-color: var(--regla);
    text-underline-offset: 0.15em;
  }

  .entrada a:hover { text-decoration-color: var(--tinta); }

  /* ── el flujo, como user flow de dos carriles ─── */
  /* Cajas y flechas, como un user flow de UX, pero en HTML y no en imagen: el
     texto se puede leer, buscar y ampliar, y se apila solo en pantalla angosta. */
  .uf-carriles {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr) 3.4rem;
    gap: 0 0.75rem;
    max-width: 52rem;
    margin: 1.75rem 0 0.6rem;
    color: var(--secundario);
  }

  .uf-carriles span:last-child { grid-column: 3; }

  .userflow {
    list-style: none;
    max-width: 52rem;
    margin-bottom: 1.5rem;
  }

  .uf-paso {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr) 3.4rem;
    gap: 0 0.75rem;
    align-items: stretch;
    margin-bottom: 2.1rem;
  }

  /* El conector que baja al paso siguiente, con su punta. */
  .uf-paso:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 1.4rem;
    bottom: -2.1rem;
    width: 0;
    height: 2.1rem;
    border-left: 1px solid var(--tinta);
  }

  .uf-paso:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(1.4rem - 3px);
    bottom: calc(-2.1rem + 1px);
    border-left: 3.5px solid transparent;
    border-right: 3.5px solid transparent;
    border-top: 5px solid var(--tinta);
  }

  .uf-persona,
  .uf-maquina {
    border: 1px solid var(--regla);
    padding: 0.8rem 1rem;
  }

  .uf-persona {
    border-color: var(--tinta);
    padding-left: 2.6rem;
    position: relative;
  }

  .uf-persona p {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.98rem;
    line-height: 1.35;
    color: var(--tinta);
    margin-bottom: 0;
    max-width: none;
  }

  .uf-n {
    position: absolute;
    left: 0.9rem;
    top: 0.85rem;
    font-size: 0.8rem;
    color: var(--secundario);
  }

  .uf-maquina p {
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--texto);
    margin-bottom: 0;
    max-width: none;
  }

  .uf-flecha {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--sans);
    color: var(--tinta);
  }

  /* Los carriles se rotulan una vez arriba; dentro de cada caja el rótulo solo
     aparece cuando el paso se apila y la cabecera deja de servir. */
  .uf-rotulo { display: none; color: var(--secundario); }

  /* El paso fijo no se distingue solo por el filete: lleva su rótulo escrito. */
  .uf-paso.fijo .uf-persona { border-width: 2px; }

  .uf-marca {
    align-self: center;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--amarillo);
    color: var(--tinta);
    padding: 0.1rem 0.4rem;
    justify-self: start;
    white-space: nowrap;
  }

  .flujo-leyenda {
    font-size: 0.95rem;
    color: var(--secundario);
    max-width: 52ch;
  }

  .flujo-leyenda strong { color: var(--tinta); }

  .flujo-leyenda {
    font-size: 0.95rem;
    color: var(--secundario);
    max-width: 52ch;
  }

  .flujo-leyenda strong { color: var(--tinta); }
</style>
