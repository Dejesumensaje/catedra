---
// Primera vuelta de investigación. Cierra el arco de la sesión 4: inventamos una
// persona → descubrimos que era una hipótesis → la ponemos a prueba con alguien real.
//
// La sesión 4 no alcanzó a hacer esta actividad en clase: se anunció y pasó a ser
// tarea, recortada a sus tres primeros pasos —tipo de experiencia y público, cinco
// hipótesis, una sola entrevista—. El paso 4, la ficha de modelo mental, se construye
// en clase en la sesión 5 con las notas en la mano: es un formulario, y un formulario
// se llena mejor mirándolo y con alguien al lado que la primera vez que se ve.
// Por eso la ficha se muestra acá pero no se pide.
//
// La continuación de «dos o tres personas más» salió de esta semana: era una segunda
// ronda de algo que todavía no había tenido la primera. Vuelve cuando la haya tenido.
// La investigación queda abierta a propósito: es la materia prima de la sesión 5.
import Base from '../../layouts/Base.astro';

const sirven = [
  'No tiene que ser experta en nada, ni haber visto nunca una obra interactiva.',
  'No tiene que ser «el usuario perfecto». Basta con que se parezca a quien describieron.',
  'Puede ser alguien del salón que encaje con el perfil y no sea de su grupo.',
  'Puede ser una llamada de doce minutos a alguien que ya tienen en mente.',
];

const hipotesis = [
  'Creemos que se aburre si no entiende rápido qué puede hacer.',
  'Creemos que prefiere descubrir las cosas por su cuenta.',
  'Creemos que no vuelve si le da pena equivocarse en público.',
  'Creemos que le llaman más la atención las cosas que no entiende del todo.',
];

const prohibidas = [
  '¿Tú has ido a una instalación interactiva?',
  '¿Te gustaría una experiencia así?',
  '¿Usarías una interfaz de voz?',
  '¿Qué te gustaría que tuviera?',
];

const sirvenPreguntas = [
  '¿Qué es lo último que viste, jugaste o visitaste que se te quedó pegado?',
  '¿Por qué ese y no otro?',
  '¿Qué tipo de cosas te gustan? ¿Qué tienen en común?',
  'Contame algo que empezaste y dejaste a la mitad. ¿Qué pasó?',
  '¿Qué fue lo último que te sorprendió?',
];

const niveles = [
  {
    nivel: 'Lo dijo',
    que: 'Sus palabras, entre comillas. No un resumen de lo que quiso decir.',
    ejemplo: '«Me quedé porque no entendía nada y quería entender.»',
    dequien: 'De ella',
  },
  {
    nivel: 'Lo notamos',
    que: 'Lo que pasó mientras hablaba: dónde se emocionó, dónde se quedó corta, qué evitó.',
    ejemplo: 'Se emocionó contando eso y habló cinco minutos seguidos.',
    dequien: 'De ella',
  },
  {
    nivel: 'Lo inferimos',
    que: 'Nuestra lectura de las dos anteriores. Es útil, y no es un hecho.',
    ejemplo: 'No le molesta no entender: le molesta que se lo expliquen.',
    dequien: 'Nuestra',
  },
];

const ficha = [
  { campo: 'Sabemos que…', cuantas: '3', nota: 'Cada una respaldada directamente por algo que dijo o que hizo. Si no pueden señalar la frase que la sostiene, no va acá.' },
  { campo: 'Parece que…', cuantas: '2', nota: 'Interpretaciones razonables a partir de esa evidencia. Son de ustedes, no de ella.' },
  { campo: 'Todavía no sabemos…', cuantas: '2', nota: 'Preguntas que siguen abiertas. Salir con preguntas nuevas es un buen resultado, no un fracaso.' },
  { campo: 'Habíamos supuesto que…', cuantas: '2', nota: 'Dos de las cinco del paso 2, y qué le pasó a cada una: se confirmó, cambió, o resultó falsa.' },
  { campo: 'Para esta persona, interactuar parece significar…', cuantas: '1 frase', nota: 'Una sola. Y sigue siendo una hipótesis: va a cambiar con las próximas entrevistas.' },
];

// Media hora de trabajo, no una semana. Está acá para que nadie lo aplace por
// creerlo más grande de lo que es.
const tiempos = [
  { min: '5 min', que: 'Decidir el tipo de experiencia y el público', quien: 'paso 1 · el grupo' },
  { min: '10 min', que: 'Escribir las cinco hipótesis', quien: 'paso 2 · el grupo' },
  { min: '12 min', que: 'La entrevista', quien: 'paso 3 · dos del grupo' },
  { min: '10 min', que: 'Pasar en limpio las notas', quien: 'después, el mismo día' },
];

const entrega = [
  {
    letra: 'A',
    titulo: 'El tipo de experiencia y el público',
    detalle: 'Tres o cuatro líneas. A quién le están hablando, no qué van a hacer.',
  },
  {
    letra: 'B',
    titulo: 'Las cinco hipótesis, tal como las escribieron antes de la entrevista',
    detalle: 'Sin corregirlas después. Si una resultó falsa, eso es el hallazgo — no un error que haya que tapar.',
  },
  {
    letra: 'C',
    titulo: 'Las notas de la entrevista',
    detalle: 'Con las tres columnas separadas: lo que dijo, lo que notaron, lo que infirieron. Las comillas de ella son parte de la entrega.',
  },
  {
    letra: 'D',
    titulo: 'Una línea sobre quién es esa persona',
    detalle: 'Por qué encaja con el público que describieron, y si pueden volver a hablar con ella. No manden su nombre completo ni sus datos de contacto: eso es de ella, no del trabajo.',
  },
];

const noSePide = [
  'Wireframes, mockups o pantallas.',
  'Una solución, un concepto o una propuesta.',
  'Identidad gráfica, nombre o lenguaje visual.',
  'Conclusiones cerradas sobre «el usuario».',
];

const listo = [
  'Hablaron con una persona que existe, que pueden volver a contactar, y que se parece al público que describieron en el paso 1.',
  'Las cinco hipótesis quedaron escritas antes de la entrevista, no después.',
  'En las notas se distingue lo que dijo de lo que ustedes interpretaron.',
  'Hay al menos una frase textual de ella que les sorprendió.',
  'Pueden decir qué le pasó a cada una de las cinco hipótesis: se confirmó, cambió, o resultó falsa. Si las cinco siguen intactas, vale la pena revisar si preguntaron por la categoría en vez de por ella.',
];
---

<Base
  titulo="¿Qué sabemos de verdad? · Tarea · Pensamiento Sensorial 3.0"
  descripcion="Tarea de la sesión 4: pasar de un público imaginado a una primera evidencia. Cinco hipótesis escritas antes, y una entrevista de doce minutos con alguien que existe."
  volverHref="/pensamiento-sensorial/s04"
  volverTexto="Sesión 4 · Preguntar y percibir"
>
  <section class="hero-clase">
    <span class="mono sube sube-1">Tarea · Sesión 4 · En grupos · Para la sesión 5</span>
    <h1 class="sube sube-2">¿Qué sabemos de verdad?</h1>
    <p class="lede sube-3">Diseñamos para una persona que inventamos. Ahora hablamos con una que existe.</p>
  </section>

  <section class="bloque">
    <h2 class="mono">El encargo</h2>
    <div class="encargo">
      <p class="encargo-frase">
        Imaginen para quién quieren hacer algo, escriban qué creen de esa persona, y
        después <strong>búsquenla y pregúntenle</strong>.
      </p>
      <p class="encargo-nota">
        El orden importa. Primero se decide el tipo de experiencia y el tipo de público;
        después se escribe lo que suponemos de él; y solo entonces se habla con alguien
        real. Si lo que creemos se escribe <strong>después</strong> de la entrevista, ya
        no hay manera de saber qué sabíamos y qué aprendimos.
      </p>
      <p class="encargo-nota">
        Al final no van a tener «la verdad sobre el usuario». Van a tener algo mejor:
        unas cuantas suposiciones reemplazadas por evidencia, y unas preguntas nuevas
        que antes no existían.
      </p>
      <p class="encargo-nota">
        <strong>Es una primera vuelta, no la investigación completa.</strong> Tres pasos y
        una sola entrevista: media hora de trabajo bien hecha vale más que tres
        conversaciones apuradas. La ficha de modelo mental —el paso 4— la armamos en
        clase, en la sesión 5, con sus notas en la mano.
      </p>
    </div>
  </section>

  <section class="bloque">
    <h2 class="mono">Paso 1 · Para qué y para quién</h2>
    <ol class="pasos" role="list">
      <li class="paso">
        <span class="paso-num mono">01</span>
        <div>
          <h3 class="paso-titulo">¿Qué tipo de experiencia quieren hacer?</h3>
          <p class="paso-cuerpo">Un sitio, un videojuego, una instalación. <strong>El tipo, no la idea</strong>: todavía no hace falta tener nada decidido, y de hecho es mejor que no lo tengan.</p>
        </div>
      </li>
      <li class="paso">
        <span class="paso-num mono">02</span>
        <div>
          <h3 class="paso-titulo">¿A quién le quieren proponer esa interacción?</h3>
          <p class="paso-cuerpo">Descríbanlo en tres o cuatro líneas: qué hace esa persona, qué consume, dónde se la encuentra uno. No es una ficha todavía — es a quién le están hablando.</p>
        </div>
      </li>
    </ol>
    <p class="remate">
      Eso que acaban de describir <strong>no existe</strong>. Es un público imaginado, y
      es exactamente lo que vamos a poner a prueba.
    </p>
  </section>

  <section class="bloque">
    <h2 class="mono">Paso 2 · Lo que suponemos</h2>
    <p>
      Cinco afirmaciones sobre ese público. Ni una más. Todas empiezan igual:
      <strong>«Creemos que…»</strong>, porque escribirlo así deja claro de qué se trata.
    </p>
    <ul class="hipotesis" role="list">
      {hipotesis.map((h) => (
        <li><span class="hipotesis-tag mono">Hipótesis</span>{h}</li>
      ))}
    </ul>
    <p class="remate">
      Esto no es conocimiento sobre nadie. Es <strong>lo que estábamos fingiendo saber</strong>.
      Guárdenlo: al final lo van a volver a mirar, una por una.
    </p>
  </section>

  <section class="bloque">
    <h2 class="mono">Paso 3 · Buscar a alguien de ese público</h2>
    <p>
      Una persona real que <strong>pueda ser ese público</strong>. Nada más:
    </p>
    <ul class="listo" role="list">
      {sirven.map((s) => <li>{s}</li>)}
    </ul>
    <div class="condicion">
      <p class="condicion-frase">La única condición: que exista y puedan hablar con ella.</p>
      <p>
        <strong>Lo que no vale es inventar otra persona.</strong> Eso ya lo hicimos la
        semana pasada, y de ahí venimos.
      </p>
    </div>
  </section>

  <section class="bloque">
    <h2 class="mono">Cómo preguntar</h2>
    <p>
      La trampa está acá: <strong>no le pregunten por lo que ustedes quieren hacer.</strong>
      Si van a hacer una instalación y arrancan con «¿tú has ido a una instalación
      interactiva?», la respuesta va a ser que no y ahí se acabó la conversación — y si
      dice que sí, va a hablar de la instalación, no de ella.
    </p>
    <p>
      Lo que nos interesa es cómo esa persona se relaciona con las cosas, y eso no aparece
      preguntando por la categoría. Aparece preguntando por <strong>lo que la marcó, y por
      qué</strong>.
    </p>
    <div class="dos-columnas">
      <div class="col col--mal">
        <span class="col-tag mono">No sirven</span>
        <ul role="list">{prohibidas.map((p) => <li>{p}</li>)}</ul>
        <p class="col-nota">Preguntan por la categoría que nosotros queremos, y le dicen a la persona qué respuesta esperamos.</p>
      </div>
      <div class="col col--bien">
        <span class="col-tag mono">Sirven</span>
        <ul role="list">{sirvenPreguntas.map((p) => <li>{p}</li>)}</ul>
        <p class="col-nota">Piden algo que le pasó y el porqué. La segunda es <strong>la pregunta</strong>: las demás existen para poder hacerla.</p>
      </div>
    </div>
  </section>

  <section class="bloque">
    <h2 class="mono">Y mientras hablan</h2>
    <ol class="pasos" role="list">
      <li class="paso">
        <span class="paso-num mono">01</span>
        <div>
          <h3 class="paso-titulo">Uno pregunta, otro escribe</h3>
          <p class="paso-cuerpo">Y quien escribe anota <strong>las palabras de ella</strong>, no un resumen de lo que quiso decir. Las comillas son parte del trabajo.</p>
        </div>
      </li>
      <li class="paso">
        <span class="paso-num mono">02</span>
        <div>
          <h3 class="paso-titulo">No vendan la idea</h3>
          <p class="paso-cuerpo">No cuenten todavía qué quieren diseñar. En el momento en que lo cuenten, la persona empieza a responder para ayudarles, y deja de contar lo que le pasó.</p>
        </div>
      </li>
      <li class="paso">
        <span class="paso-num mono">03</span>
        <div>
          <h3 class="paso-titulo">No llenen el silencio</h3>
          <p class="paso-cuerpo">Cuando responda algo corto, esperen. Los tres segundos incómodos después de una respuesta son donde suele aparecer lo que de verdad importa.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="bloque">
    <h2 class="mono">Al anotar · tres cosas que no valen lo mismo</h2>
    <table class="niveles">
      <thead>
        <tr><th scope="col">Nivel</th><th scope="col">Qué es</th><th scope="col">Un ejemplo</th><th scope="col">¿De quién es?</th></tr>
      </thead>
      <tbody>
        {niveles.map((n) => (
          <tr class={n.nivel === 'Lo inferimos' ? 'nivel-nuestro' : undefined}>
            <th scope="row">{n.nivel}</th>
            <td>{n.que}</td>
            <td class="niveles-ej">{n.ejemplo}</td>
            <td class="niveles-quien">{n.dequien}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="remate">
      Las tres sirven. Solo las dos primeras son evidencia — son lo explícito y lo
      observable de los que hablamos en clase. <strong>La tercera es nuestra, y puede
      estar mal.</strong> Escribirla como si fuera un hecho es la manera más rápida de
      volver a diseñar para nosotros mismos.
    </p>
  </section>

  <section class="bloque">
    <h2 class="mono">Paso 4 · La ficha — esa la armamos en clase</h2>
    <div class="condicion">
      <p class="condicion-frase">No la hagan en casa.</p>
      <p>
        Lleguen a la sesión 5 con <strong>las notas</strong>, y la construimos ahí. Es un
        formulario, y la primera vez que se llena uno conviene tener a alguien al lado.
        Va acá para que sepan hacia dónde apuntan las notas — no para entregarla.
      </p>
    </div>
    <p>
      Sin foto, sin edad, sin hobbies, sin frase simpática. No es una ficha de personaje:
      es lo que entendieron de <strong>cómo esa persona se relaciona con las cosas</strong>.
    </p>
    <table class="ficha">
      <tbody>
        {ficha.map((f) => (
          <tr class={f.cuantas === '1 frase' ? 'ficha-cierre' : undefined}>
            <th scope="row">{f.campo}<span class="ficha-cuantas mono">{f.cuantas}</span></th>
            <td>{f.nota}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="bloque">
    <h2 class="mono">Los tiempos</h2>
    <p>
      Media hora larga, no una semana. Está acá para que nadie lo aplace creyéndolo más
      grande de lo que es.
    </p>
    <table class="tiempos">
      <tbody>
        {tiempos.map((t) => (
          <tr>
            <th scope="row" class="mono">{t.min}</th>
            <td><strong>{t.que}</strong><span class="tiempos-quien">{t.quien}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="bloque">
    <h2 class="mono">Qué entregan</h2>
    <div class="encargo">
      <p class="encargo-frase">Un solo documento, por Classroom, antes de la sesión 5.</p>
      <p class="encargo-nota">
        No tiene que estar bonito. Tiene que estar <strong>fechado y separado</strong>: se
        distingue lo que escribieron antes de hablar con ella de lo que escribieron
        después.
      </p>
    </div>
    <ol class="pasos" role="list">
      {entrega.map((e) => (
        <li class="paso">
          <span class="paso-num mono">{e.letra}</span>
          <div>
            <h3 class="paso-titulo">{e.titulo}</h3>
            <p class="paso-cuerpo">{e.detalle}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="remate">
      Y una advertencia sobre la segunda ronda: <strong>todavía no va</strong>. Hablar con
      dos o tres personas más era la continuación de esto, y esto apenas empieza. Se
      retoma cuando la primera vuelta esté hecha.
    </p>
    <div class="nopide">
      <p class="nopide-frase">Todavía no se pide nada de esto</p>
      <ul role="list">{noSePide.map((n) => <li>{n}</li>)}</ul>
      <p class="nopide-cola">
        La investigación se queda abierta a propósito. Diseñar viene después, y viene
        mejor si esto está bien hecho.
      </p>
    </div>

    <h3 class="listo-titulo mono">Está listo cuando…</h3>
    <ul class="listo" role="list">
      {listo.map((l) => <li>{l}</li>)}
    </ul>
  </section>

  <section class="bloque">
    <h2 class="mono">El cierre</h2>
    <div class="cierre">
      <p>Al terminar no van a tener una respuesta. Van a tener esto:</p>
      <p class="cierre-pregunta">
        Ahora sabemos más. Y sabemos mejor qué todavía no sabemos.
      </p>
      <p>
        Investigar no elimina la incertidumbre: la hace visible. Y con una incertidumbre
        visible ya se puede trabajar — que es exactamente lo que vamos a hacer en la
        sesión 5, empezando por convertir esas notas en una ficha.
      </p>
    </div>
  </section>
</Base>

<style>
  .encargo { border: 2px solid var(--tinta); padding: 1.75rem 2rem; max-width: 46rem; }

  .encargo-frase {
    font-family: var(--sans); font-weight: 900;
    font-size: clamp(1.25rem, 3.2vw, 1.6rem); line-height: 1.25;
    color: var(--tinta); max-width: none; margin-bottom: 1rem;
  }

  .encargo-frase strong { background: var(--amarillo); padding: 0 0.15em; }

  .encargo-nota {
    max-width: none; margin-bottom: 0.9rem;
    font-size: 0.98rem; color: var(--secundario);
  }

  .encargo-nota:last-child { margin-bottom: 0; }
  .encargo-nota strong { color: var(--tinta); }

  .remate {
    border-left: 3px solid var(--amarillo); padding-left: 1rem;
    font-size: 1.05rem; color: var(--tinta); max-width: 52rem;
  }

  /* ── la condición ─────────────────────────────── */
  .condicion {
    border: 2px solid var(--tinta); border-left-width: 10px;
    border-left-color: var(--amarillo);
    padding: 1.4rem 1.6rem; max-width: 46rem; margin-top: 1.5rem;
  }

  .condicion-frase {
    font-family: var(--sans); font-weight: 900; font-size: 1.2rem;
    color: var(--tinta); max-width: none; margin-bottom: 0.7rem;
  }

  .condicion p:last-child { max-width: none; margin-bottom: 0; font-size: 0.98rem; }

  /* ── las hipótesis ────────────────────────────── */
  .hipotesis { list-style: none; max-width: 52rem; margin: 1.25rem 0 1.5rem; }

  .hipotesis li {
    padding: 0.7rem 0; border-bottom: 1px solid var(--regla);
    font-size: 1.02rem; color: var(--tinta);
  }

  .hipotesis li:last-child { border-bottom: none; }

  .hipotesis-tag {
    display: inline-block; margin-right: 0.8rem;
    background: var(--amarillo); color: var(--tinta);
    padding: 0.1rem 0.45rem;
  }

  /* ── preguntas en dos columnas ────────────────── */
  .dos-columnas {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
    max-width: 56rem; margin: 1.5rem 0 0;
  }

  .col { padding-top: 0.8rem; }
  .col--mal { border-top: 3px solid var(--regla); }
  .col--bien { border-top: 3px solid var(--amarillo); }
  .col-tag { display: block; color: var(--secundario); margin-bottom: 0.7rem; }

  .col ul { list-style: none; }

  .col li {
    padding: 0.5rem 0; border-bottom: 1px solid var(--regla);
    font-size: 0.97rem; line-height: 1.45;
  }

  .col--mal li { color: var(--secundario); }
  .col--bien li { color: var(--tinta); }
  .col li:last-child { border-bottom: none; }

  .col-nota { font-size: 0.9rem; color: var(--secundario); margin-top: 0.8rem; max-width: none; }

  /* ── pasos ────────────────────────────────────── */
  .pasos { list-style: none; max-width: 52rem; margin-top: 1.25rem; }

  .paso {
    display: flex; gap: 1.4rem; align-items: baseline;
    padding: 1rem 0; border-bottom: 1px solid var(--regla);
  }

  .paso:last-child { border-bottom: none; }
  .paso-num { flex: 0 0 1.8rem; font-weight: 700; color: var(--secundario); }
  .paso .paso-titulo { font-size: 1.05rem; margin: 0 0 0.25rem; }
  .paso-cuerpo { font-size: 0.98rem; color: var(--texto); max-width: none; margin-bottom: 0; }

  /* ── tablas ───────────────────────────────────── */
  .niveles, .ficha, .tiempos {
    width: 100%; max-width: 54rem; border-collapse: collapse;
    margin: 1.25rem 0 1rem; font-size: 0.96rem;
  }

  .niveles th, .niveles td, .ficha th, .ficha td, .tiempos th, .tiempos td {
    border: 1px solid var(--regla); padding: 0.75rem 0.9rem;
    text-align: left; vertical-align: top;
  }

  .niveles thead th {
    font-family: var(--sans); font-weight: 700; font-size: 0.72rem;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--secundario); background: var(--amarillo);
  }

  .niveles th[scope='row'], .ficha th[scope='row'], .tiempos th[scope='row'] {
    font-family: var(--sans); font-weight: 900; color: var(--tinta); width: 11rem;
  }

  .niveles-ej { font-style: italic; color: var(--texto); }
  .niveles-quien { font-family: var(--sans); font-weight: 700; white-space: nowrap; }
  .nivel-nuestro { background: rgba(238, 255, 65, 0.35); }
  .nivel-nuestro .niveles-quien { color: var(--tinta); }

  .ficha th[scope='row'] { width: 17rem; }

  .ficha-cuantas {
    display: block; color: var(--secundario); font-weight: 400; margin-top: 0.2rem;
