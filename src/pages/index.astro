---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const cursos = (await getCollection('cursos')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<Base
  titulo="Cátedra · William Montoya"
  descripcion="Repositorio docente: el programa de cada curso y la memoria de lo que ocurrió de verdad."
>
  <section class="hero hero-indice">
    <h1 class="sube sube-1">Soy William Montoya, periodista, diseñador UX y docente de transformación digital, cultura y diseño.</h1>
    <p class="intro sube sube-2">En cada edición de mis cursos, una sesión se publica dos veces: el programa antes de clase y el registro de lo que pasó después.</p>
  </section>

  <section class="seccion" id="cursos">
    <span class="mono">Los cursos</span>

    {cursos.map((curso) => (
      <a class="poster" href={`/${curso.data.ruta}`}>
        {curso.data.version && (
          <span class="numero-gigante" aria-hidden="true">{curso.data.version}</span>
        )}
        <span class="mono">{curso.data.institucion} · {curso.data.periodo.etiqueta}</span>
        {/* La versión se ve una sola vez: como el número grande de la tarjeta.
            Ese número es decorativo para asistencia técnica (`aria-hidden`), así
            que la edición se queda en el encabezado sin verse. Sin esto, dos
            ediciones del mismo curso suenan idénticas en un lector de pantalla
            y el enlace no dice a cuál de las dos entra. */}
        <h2>{curso.data.titulo}{curso.data.version && <span class="sr-solo"> {curso.data.version}</span>}</h2>
        <p class="desc">{curso.data.descripcion}</p>
        <ul class="tags" role="list">
          <li>{curso.data.intensidad.sesiones} sesiones</li>
          <li>{curso.data.intensidad.modalidad}</li>
          <li>{curso.data.programa}</li>
        </ul>
        <span class="cta">Entrar al curso <span class="flecha" aria-hidden="true">→</span></span>
      </a>
    ))}
  </section>

  <section class="seccion" aria-labelledby="fuera-de-curso">
    <h2 class="mono" id="fuera-de-curso">Fuera de los cursos</h2>
    <p class="publicacion">
      <a href="/diseno-visual"><strong>Anatomía del diseño visual</strong></a>.
      Por qué un color parece otro según el fondo, o en qué momento la distancia vuelve grupo lo que estaba suelto. 37 conceptos de diseño visual con instrumentos para comprobar cada efecto en vivo y ejercicios para entrenar el ojo.
    </p>
    <p class="publicacion">
      <a href="/narrativa-interactiva/"><strong>Laboratorio de Narrativa Interactiva</strong></a>.
      Qué ocurre cuando seis proyectos interactivos dejan de explicar sus historias y buscan el gesto mínimo que las hace sentir. Un mapa de cuatro sesiones de asesoría con los giros y prototipos que destrabaron cada uno.
    </p>
  </section>
</Base>

<style>
  .publicacion { max-width: 46ch; }
  .publicacion + .publicacion { margin-top: 1.25em; }
  .publicacion a { color: var(--tinta); text-decoration-thickness: 2px; text-underline-offset: 0.2em; font-family: var(--sans); }
  .publicacion a:hover { background: var(--amarillo); }
</style>
