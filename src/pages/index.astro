---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const cursos = (await getCollection('cursos')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
---

<Base
  titulo="Cátedra · William Montoya"
  descripcion="Repositorio docente: el programa de cada curso y la memoria de lo que ocurrió de verdad."
>
  <section class="hero hero-indice">
    <span class="mono sube sube-1">Hola, bienvenidos a mi repositorio</span>
    <h1 class="sube sube-2">Soy William Montoya, periodista, diseñador UX y docente en temas de transformación digital, cultura y diseño.</h1>
    <p class="intro sube sube-3">Aquí está cada edición de los cursos que he dictado, con el programa y el registro de lo que ocurrió. Cada sesión se publica dos veces: el programa antes de la clase y, después, lo que realmente pasó.</p>
  </section>

  <section class="seccion" id="cursos">
    <span class="mono">Los cursos</span>

    {cursos.map((curso) => (
      <a class="poster" href={`/${curso.data.ruta}`}>
        {curso.data.version && (
          <span class="numero-gigante" aria-hidden="true">{curso.data.version}</span>
        )}
        <span class="mono">{curso.data.institucion} · {curso.data.periodo.etiqueta}</span>
        {/* La versión se ve una sola vez: como el número grande de la tarjeta.
            Ese número es decorativo para asistencia técnica (`aria-hidden`), así
            que la edición se queda en el encabezado sin verse. Sin esto, dos
            ediciones del mismo curso suenan idénticas en un lector de pantalla
            y el enlace no dice a cuál de las dos entra. */}
        <h2>{curso.data.titulo}{curso.data.version && <span class="sr-solo"> {curso.data.version}</span>}</h2>
        <p class="desc">{curso.data.descripcion}</p>
        <ul class="tags" role="list">
          <li>{curso.data.intensidad.sesiones} sesiones</li>
          <li>{curso.data.intensidad.modalidad}</li>
          <li>{curso.data.programa}</li>
        </ul>
        <span class="cta">Entrar al curso <span class="flecha" aria-hidden="true">→</span></span>
      </a>
    ))}
  </section>
</Base>
