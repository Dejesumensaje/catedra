---
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Página no encontrada · Cátedra"
  descripcion="Esta página no existe."
>
  <section class="hero">
    <span class="mono sube sube-1">Error 404</span>
    <h1 class="sube sube-2">Esta clase no existe <span class="hl">(todavía)</span>.</h1>
    <p class="lede sube sube-3">Puede que la sesión no se haya publicado o que la dirección esté mal escrita.</p>
  </section>

  <section class="seccion sube sube-4">
    <a class="pill" href="/">Volver a Cátedra →</a>
  </section>
</Base>
