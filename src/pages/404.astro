---
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Página no encontrada · Cátedra"
  descripcion="Esta página no existe."
>
  <section class="hero">
    <span class="mono sube sube-1">Error 404</span>
    <h1 class="sube sube-2">Esperabas algo que no está <span class="hl">aquí</span>.</h1>
    <p class="lede sube sube-3">Puede que la página no se haya publicado todavía o que la dirección esté mal escrita.</p>
  </section>

  <section class="seccion">
    <a class="pill" href="/">Volver a Cátedra →</a>
  </section>
</Base>
