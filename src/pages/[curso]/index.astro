---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { numeroSesion } from '../../lib/contenido';

export async function getStaticPaths() {
  const cursos = await getCollection('cursos');
  return cursos.map((curso) => ({
    params: { curso: curso.data.ruta },
    props: { curso },
  }));
}

const { curso } = Astro.props;

const sesiones = (
  await getCollection('sesiones', (s) => s.data.curso.id === curso.id)
).sort((a, b) => a.data.numero - b.data.numero);

const tensiones = await getCollection('tensiones');
const tensionPorId = new Map(tensiones.map((t) => [t.id, t]));

// Una sesión está disponible cuando tiene presentación publicada.
const disponibles = sesiones.filter((s) => s.data.presentacion);
const total = curso.data.intensidad.sesiones;
const ultima = disponibles.at(-1);
const progreso = Math.min(100, (disponibles.length / total) * 100);

function fechaCorta(fecha: Date): string {
  return fecha
    .toLocaleDateString('es-CO', { day: 'numeric', month: 'short', timeZone: 'UTC' })
    .replace('.', '');
}

const parrafosIntro = (curso.data.introduccion ?? curso.data.descripcion)
  .split(/\n\n+/)
  .map((p) => p.trim());
---

<Base
  titulo={`${[curso.data.titulo, curso.data.version].filter(Boolean).join(' ')} · Cátedra`}
  descripcion={curso.data.descripcion}
  volverHref="/"
  volverTexto="Todos los cursos"
>
  <section class="hero-curso">
    <span class="mono sube sube-1">{curso.data.institucion} · {curso.data.programa} · {curso.data.periodo.etiqueta}</span>
    <h1 class="sube sube-2">
      {curso.data.titulo}{curso.data.version && <> <span class="tres">{curso.data.version}</span></>}
    </h1>
    {curso.data.preguntaCentral && (
      <p class="lede sube sube-3">{curso.data.preguntaCentral}</p>
    )}
  </section>

  <div class="semestre sube sube-3">
    <span class="mono">Sesión {ultima ? numeroSesion(ultima.data.numero).toUpperCase() : 'S00'} / {total}</span>
    <div
      class="pista"
      role="progressbar"
      aria-label="Sesiones publicadas"
      aria-valuemin="0"
      aria-valuemax={total}
      aria-valuenow={disponibles.length}
    ><div class="relleno" style={`width: ${progreso}%;`}></div></div>
    <span class="mono">{curso.data.periodo.etiqueta}</span>
  </div>

  <section class="bloque">
    <h2 class="mono">El curso</h2>
    {parrafosIntro.map((parrafo) => <p>{parrafo}</p>)}
  </section>

  <div class="separador" aria-hidden="true">↔</div>

  <section class="bloque">
    <h2 class="mono">Sesiones — {total}, una por semana</h2>

    <ol class="clases" role="list">
      {sesiones.map((sesion) => {
        const tension = sesion.data.tension
          ? tensionPorId.get(sesion.data.tension.id)
          : undefined;
        const disponible = Boolean(sesion.data.presentacion);
        // Una sesión con memoria tiene todo lo que tiene una dictada, y además
        // el registro de en qué se desvió. La etiqueta lo dice: si las dos
        // dijeran «con presentación», el estado más completo del curso sería
        // el único que no se ve desde aquí.
        const conMemoria = sesion.data.estado === 'con-memoria';
        const numero = numeroSesion(sesion.data.numero).slice(1);

        return (
          <li class="clase-fila">
            <a class={disponible ? 'clase' : 'clase programada'} href={`/${curso.data.ruta}/s${numero}`}>
              <span class="numeral">{numero}</span>
              <span class="cuerpo">
                <span class="titulo-clase">{sesion.data.titulo}</span>
                {tension && (
                  <span class="tension">{tension.data.poloA} ↔ {tension.data.poloB}</span>
                )}
              </span>
              <span class="lado">
                {disponible ? (
                  <span class="sticker">{conMemoria ? 'Con memoria' : 'Con presentación'}</span>
                ) : (
                  <span class="estado-gris">Programada · {fechaCorta(sesion.data.fecha)}</span>
                )}
                <span class="flecha" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>

    <p class="nota-curso">El programa de las 16 sesiones está publicado desde el primer día. La presentación de cada una se abre el día de la clase. Los títulos y fechas pueden moverse: esto es un programa en construcción, no una promesa.</p>
  </section>
</Base>
