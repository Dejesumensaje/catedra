---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  numeroSesion,
  evaluacionDeSesion,
  faseDeSesion,
  rangoFase,
} from '../../lib/contenido';

export async function getStaticPaths() {
  const cursos = await getCollection('cursos');
  const sesiones = await getCollection('sesiones');

  return sesiones.map((sesion) => {
    const curso = cursos.find((c) => c.id === sesion.data.curso.id);
    if (!curso) {
      throw new Error(
        `La sesión "${sesion.id}" referencia el curso "${sesion.data.curso.id}", que no existe.`,
      );
    }

    const delCurso = sesiones
      .filter((s) => s.data.curso.id === curso.id)
      .sort((a, b) => a.data.numero - b.data.numero);

    const vecina = (offset: number) =>
      delCurso.find((s) => s.data.numero === sesion.data.numero + offset);

    return {
      params: { curso: curso.data.ruta, numero: numeroSesion(sesion.data.numero).slice(1) },
      props: { sesion, curso, delCurso, anterior: vecina(-1), siguiente: vecina(1) },
    };
  });
}

const { sesion, curso, delCurso, anterior, siguiente } = Astro.props;
const { Content } = await render(sesion);

const tension = sesion.data.tension ? await getEntry(sesion.data.tension) : undefined;
const evaluacion = await evaluacionDeSesion(curso.id, sesion.data.numero);
const fase = faseDeSesion(curso, sesion.data.numero);
const enFase = fase
  ? delCurso.filter((s) => s.data.numero >= fase.desde && s.data.numero <= fase.hasta)
  : [];

const numero = numeroSesion(sesion.data.numero).slice(1);
const nombreCurso = [curso.data.titulo, curso.data.version].filter(Boolean).join(' ');

const fecha = sesion.data.fecha.toLocaleDateString('es-CO', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const fechaCorta = (f: Date) =>
  f.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', timeZone: 'UTC' });

const rutaSesion = (s: typeof sesion) =>
  `/${curso.data.ruta}/s${numeroSesion(s.data.numero).slice(1)}`;

// Los materiales se escriben "Título — Autor"; se separan para mostrarlos en dos niveles.
function partirMaterial(titulo: string): [string, string | undefined] {
  const partes = titulo.split(' — ');
  return partes.length > 1
    ? [partes.slice(0, -1).join(' — '), partes.at(-1)]
    : [titulo, undefined];
}

const tieneCuerpo = (sesion.body ?? '').trim().length > 0;

const memoria = sesion.data.memoria;

// Con año, a diferencia del resto de fechas de la página: la memoria se queda
// publicada y su distancia con el día de la clase es parte de lo que dice.
const escritaEl = memoria?.escritaEl.toLocaleDateString('es-CO', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---

<Base
  titulo={`S${numero} · ${sesion.data.titulo} · ${curso.data.titulo}`}
  descripcion={sesion.data.preguntaCentral}
  ancho="amplio"
>
  <section class="hero-sesion ret">
    <p class="migas sube sube-1">
      <a href={`/${curso.data.ruta}`}>{nombreCurso}</a>{fase && <> · {fase.nombre}</>}
    </p>
    <span class="numeral-hero sube sube-1" aria-hidden="true">{numero}</span>
    <h1 class="sube sube-2"><span class="sr-solo">Sesión {numero}: </span>{sesion.data.titulo}</h1>
    <p class="lede sube sube-3">{sesion.data.preguntaCentral}</p>
  </section>

  <div class="cuerpo-sesion ret">
    <aside class="riel" aria-label="Datos de la sesión">
      <dl class="ficha">
        <div><dt>Fecha</dt><dd>{fecha}</dd></div>
        {tension && (
          <div>
            <dt>Tensión</dt>
            <dd><span class="sticker">{tension.data.poloA} ↔ {tension.data.poloB}</span></dd>
          </div>
        )}
        {evaluacion && (
          <div><dt>Cuenta para</dt><dd>{evaluacion.data.titulo} · {evaluacion.data.porcentaje}%</dd></div>
        )}
      </dl>

      {tension && <p class="pregunta-tension">{tension.data.pregunta}</p>}

      {sesion.data.conceptos.length > 0 && (
        <div class="conceptos">
          <h2 class="mono">Conceptos</h2>
          <ul class="etiquetas" role="list">
            {sesion.data.conceptos.map((concepto) => <li>{concepto}</li>)}
          </ul>
        </div>
      )}

      {sesion.data.presentacion && (
        <div class="deck">
          <button class="boton" id="abrir-deck" type="button">
            Abrir la presentación <span aria-hidden="true">→</span>
          </button>
          <p class="nota">Se abre en una ventana nueva, lista para proyectar. La contraseña se dice en clase.</p>
        </div>
      )}

      {fase && enFase.length > 1 && (
        <nav class="en-fase" aria-label="Sesiones de esta fase">
          <h2 class="mono">En esta fase · {fase.nombre} · {rangoFase(fase)}</h2>
          <ol role="list">
            {enFase.map((s) => {
              const n = numeroSesion(s.data.numero).slice(1);
              const actual = s.id === sesion.id;
              return (
                <li>
                  <a href={rutaSesion(s)} aria-current={actual ? 'page' : undefined}>
                    <span class="n">{n}</span>{s.data.titulo}
                  </a>
                </li>
              );
            })}
          </ol>
        </nav>
      )}
    </aside>

    <div class="lectura">
      {sesion.data.proposito && (
        <section aria-labelledby="t-proposito">
          <h2 class="mono" id="t-proposito">Propósito</h2>
          <p class="proposito">{sesion.data.proposito}</p>
        </section>
      )}

      {sesion.data.momentos.length > 0 && (
        <section aria-labelledby="t-momentos">
          <h2 class="mono" id="t-momentos">En esta sesión</h2>
          <div class="momentos">
            {sesion.data.momentos.map((momento) => (
              <div class="momento">
                <h3 class="mono">{momento.titulo}</h3>
                <p>{momento.cuerpo}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {sesion.data.materiales.length > 0 && (
        <section aria-labelledby="t-materiales">
          <h2 class="mono" id="t-materiales">Material de la semana</h2>
          <ul class="materiales" role="list">
            {sesion.data.materiales.map((material) => {
              const [titulo, autor] = partirMaterial(material.titulo);
              const externo = !material.url.startsWith('/');
              return (
                <li>
                  <a href={material.url} {...(externo ? { target: '_blank', rel: 'noopener' } : {})}>
                    <span class="mat-titulo">{titulo}</span>
                    {(autor || externo) && (
                      <span class="mat-autor">
                        {autor}{autor && externo && ' '}
                        {externo && (
                          <>
                            <span aria-hidden="true">↗</span>
                            <span class="sr-solo"> (abre en otra pestaña)</span>
                          </>
                        )}
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {tieneCuerpo && (
        <section class="contenido-mdx">
          <Content />
        </section>
      )}

      {memoria && (
        <section aria-labelledby="t-memoria">
          <div class="memoria-cabecera">
            <h2 class="mono" id="t-memoria">La memoria</h2>
            <span class="mono escrita-el">Escrita el {escritaEl}</span>
          </div>

          <div class="memoria-par">
            <div class="lado esperaba">
              <h3 class="mono">Lo que esperaba</h3>
              <p>{memoria.esperado}</p>
            </div>
            <div class="lado paso">
              <h3 class="mono">Lo que pasó</h3>
              <p>{memoria.observado}</p>
            </div>
          </div>

          {memoria.evidencia.length > 0 && (
            <div class="memoria-evidencia">
              <h3 class="mono">Evidencia</h3>
              <ul role="list">
                {memoria.evidencia.map((hecho) => <li>{hecho}</li>)}
              </ul>
            </div>
          )}

          {memoria.sorpresa && (
            <div class="memoria-sorpresa">
              <h3 class="mono">La sorpresa</h3>
              <p>{memoria.sorpresa}</p>
            </div>
          )}

          {memoria.cambio && (
            <div class="memoria-cambio">
              <h3 class="mono">La próxima vez</h3>
              <p>{memoria.cambio}</p>
            </div>
          )}
        </section>
      )}

      <nav class="nav-sesiones" aria-label="Sesiones vecinas">
        {anterior && (
          <a class="salto-sesion hacia-atras" href={rutaSesion(anterior)}>
            <span class="mono">← Anterior — {fechaCorta(anterior.data.fecha)}</span>
            <span class="que-sigue">S{numeroSesion(anterior.data.numero).slice(1)} · {anterior.data.titulo}</span>
          </a>
        )}
        {siguiente && (
          <a class="salto-sesion hacia-adelante" href={rutaSesion(siguiente)}>
            <span class="mono">Siguiente — {fechaCorta(siguiente.data.fecha)} →</span>
            <span class="que-sigue">S{numeroSesion(siguiente.data.numero).slice(1)} · {siguiente.data.titulo}</span>
          </a>
        )}
        <div class="volver-curso">
          <a class="pill" href={`/${curso.data.ruta}#sesiones`}>Todas las sesiones</a>
        </div>
      </nav>
    </div>
  </div>

  {sesion.data.presentacion && (
    <>
      <div class="candado-fondo" id="candado-fondo">
        <div class="candado" role="dialog" aria-modal="true" aria-labelledby="candado-titulo">
          <button class="cerrar" id="candado-cerrar" type="button" aria-label="Cerrar">×</button>
          <span class="numeral-modal" aria-hidden="true">{numero}</span>
          <h3 id="candado-titulo">{sesion.data.titulo}</h3>
          <p>Es para quienes están en el curso. La contraseña se dice en clase.</p>
          <form id="candado-form">
            <label class="sr-solo" for="candado-input">Contraseña</label>
            <input
              type="password"
              id="candado-input"
              placeholder="Contraseña"
              autocomplete="off"
              aria-describedby="candado-error"
            />
            <button type="submit">Abrir</button>
          </form>
          <p class="error" id="candado-error" role="status" aria-live="polite"></p>
        </div>
      </div>

      <!-- ancla oculta: abre el deck en ventana nueva (más confiable que window.open) -->
      <a id="deck-abridor" href={sesion.data.presentacion} target="_blank" rel="noopener" hidden></a>

      <script is:inline>
        (function () {
          var CLAVE = 'udea2026';
          var MARCA = 'catedra-clave-ok';
          var fondo = document.getElementById('candado-fondo');
          var dialogo = fondo.querySelector('.candado');
          var input = document.getElementById('candado-input');
          var error = document.getElementById('candado-error');
          var abridor = document.getElementById('deck-abridor');
          var boton = document.getElementById('abrir-deck');
          var cerrar = document.getElementById('candado-cerrar');
          var focoPrevio = null;

          function claveRecordada() {
            try { return sessionStorage.getItem(MARCA) === '1'; } catch (e) { return false; }
          }

          function recordarClave() {
            try { sessionStorage.setItem(MARCA, '1'); } catch (e) {}
          }

          function enfocables() {
            return dialogo.querySelectorAll('button, input');
          }

          function abrirCandado() {
            // Si ya la escribió bien en esta visita, no se la pedimos otra vez.
            if (claveRecordada()) { abridor.click(); return; }
            focoPrevio = document.activeElement;
            input.value = '';
            input.removeAttribute('aria-invalid');
            error.textContent = '';
            fondo.classList.add('abierto');
            input.focus();
          }

          function cerrarCandado() {
            if (!fondo.classList.contains('abierto')) return;
            fondo.classList.remove('abierto');
            // El foco vuelve al botón que abrió el diálogo, no al principio.
            if (focoPrevio && focoPrevio.focus) focoPrevio.focus();
            focoPrevio = null;
          }

          boton.addEventListener('click', abrirCandado);
          cerrar.addEventListener('click', cerrarCandado);
          fondo.addEventListener('click', function (e) {
            if (e.target === fondo) cerrarCandado();
          });

          document.addEventListener('keydown', function (e) {
            if (!fondo.classList.contains('abierto')) return;
            if (e.key === 'Escape') { cerrarCandado(); return; }
            if (e.key !== 'Tab') return;
            // El foco no se sale del diálogo mientras está abierto.
            var items = enfocables();
            var primero = items[0];
            var ultimo = items[items.length - 1];
            if (e.shiftKey && document.activeElement === primero) {
              e.preventDefault();
              ultimo.focus();
            } else if (!e.shiftKey && document.activeElement === ultimo) {
              e.preventDefault();
              primero.focus();
            }
          });

          document.getElementById('candado-form').addEventListener('submit', function (e) {
            e.preventDefault();
            if (input.value.trim().toLowerCase() === CLAVE) {
              recordarClave();
              abridor.click();
              cerrarCandado();
            } else {
              input.setAttribute('aria-invalid', 'true');
              error.textContent = 'Esa no es. Pregunta en clase.';
              input.focus();
            }
          });
        })();
      </script>
    </>
  )}
</Base>

<style>
  /* ── hero ── */
  .hero-sesion { padding-block: var(--space-14) var(--space-11); row-gap: var(--space-4); }
  .hero-sesion > * { grid-column: 1 / span 9; }
  .migas { font-family: var(--sans); font-size: 0.85rem; color: var(--secundario); }
  .migas a { color: var(--texto); text-underline-offset: 0.15em; }
  .migas a:hover { color: var(--tinta); }
  .numeral-hero {
    font-family: var(--sans);
    font-weight: 900;
    font-size: clamp(4.5rem, 12vw, 7rem);
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--amarillo);
    -webkit-text-stroke: 2px var(--tinta);
  }
  .hero-sesion h1 {
    font-family: var(--sans);
    font-weight: 900;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--tinta);
    text-wrap: balance;
  }
  .hero-sesion .lede { font-style: italic; font-size: clamp(1.05rem, 2.2vw, 1.25rem); line-height: 1.5; max-width: 42ch; }

  /* ── riel + lectura ── */
  .cuerpo-sesion { padding-bottom: var(--space-11); row-gap: var(--space-11); }
  .riel {
    grid-column: 1 / span 4;
    align-self: start;
    position: sticky;
    top: var(--space-6);
    border: 2px solid var(--tinta);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }
  .riel .pregunta-tension { font-size: 0.92rem; font-style: italic; color: var(--secundario); margin-top: calc(var(--space-2) * -1); }
  .riel h2.mono { color: var(--secundario); display: block; margin-bottom: var(--space-2); }
  .etiquetas { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .etiquetas li {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto);
    border: 1px solid var(--regla);
    padding: 2px var(--space-2);
  }
  .deck { display: grid; gap: var(--space-2); }
  .deck .boton { width: 100%; }
  .deck .nota { font-size: 0.82rem; color: var(--secundario); }

  .en-fase { border-top: 1px solid var(--tinta); padding-top: var(--space-4); }
  .en-fase ol { list-style: none; display: grid; }
  .en-fase a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-1);
    font-family: var(--sans);
    font-size: 0.88rem;
    line-height: 1.3;
    color: var(--texto);
    text-decoration: none;
    border-bottom: 1px solid var(--regla);
  }
  .en-fase .n { font-weight: 700; color: var(--secundario); font-variant-numeric: tabular-nums; }
  .en-fase a:hover { color: var(--tinta); background: linear-gradient(to right, var(--amarillo) 3px, transparent 3px); }
  .en-fase a[aria-current='page'] { color: var(--tinta); font-weight: 700; background: linear-gradient(to right, var(--amarillo) 3px, transparent 3px); }
  .en-fase a[aria-current='page'] .n { color: var(--tinta); }

  .lectura { grid-column: 6 / -1; display: grid; gap: var(--space-16); align-content: start; min-width: 0; }
  .lectura > section > h2.mono { color: var(--secundario); display: block; margin-bottom: var(--space-5); }
  .lectura p { max-width: 60ch; }
  .proposito { font-size: 1.15rem; line-height: 1.55; color: var(--tinta); }
  .lectura .momento p { max-width: 60ch; }
  .lectura .nav-sesiones { margin-top: 0; padding-bottom: 0; }

  @media (max-width: 899px) {
    .riel { grid-column: 1 / -1; position: static; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); align-items: start; }
    .riel .en-fase, .riel .deck, .riel .pregunta-tension { grid-column: 1 / -1; }
    .lectura { grid-column: 1 / -1; gap: var(--space-14); }
  }

  @media (max-width: 759px) {
    .hero-sesion > * { grid-column: 1 / -1; }
    .hero-sesion { padding-block: var(--space-10) var(--space-8); }
    .riel { padding: var(--space-5); }
  }
</style>
