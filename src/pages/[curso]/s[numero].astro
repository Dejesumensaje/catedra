---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { numeroSesion } from '../../lib/contenido';

export async function getStaticPaths() {
  const cursos = await getCollection('cursos');
  const sesiones = await getCollection('sesiones');

  return sesiones.map((sesion) => {
    const curso = cursos.find((c) => c.id === sesion.data.curso.id);
    if (!curso) {
      throw new Error(
        `La sesión "${sesion.id}" referencia el curso "${sesion.data.curso.id}", que no existe.`,
      );
    }

    const vecina = (offset: number) => sesiones.find(
      (s) => s.data.curso.id === curso.id && s.data.numero === sesion.data.numero + offset,
    );

    return {
      params: { curso: curso.data.ruta, numero: numeroSesion(sesion.data.numero).slice(1) },
      props: { sesion, curso, anterior: vecina(-1), siguiente: vecina(1) },
    };
  });
}

const { sesion, curso, anterior, siguiente } = Astro.props;
const { Content } = await render(sesion);

const tension = sesion.data.tension ? await getEntry(sesion.data.tension) : undefined;

const numero = numeroSesion(sesion.data.numero).slice(1);

const fecha = sesion.data.fecha.toLocaleDateString('es-CO', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const fechaCorta = (f: Date) =>
  f.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', timeZone: 'UTC' });

const rutaSesion = (s: typeof sesion) =>
  `/${curso.data.ruta}/s${numeroSesion(s.data.numero).slice(1)}`;

// Los materiales se escriben "Título — Autor"; se separan para mostrarlos en dos niveles.
function partirMaterial(titulo: string): [string, string | undefined] {
  const partes = titulo.split(' — ');
  return partes.length > 1
    ? [partes.slice(0, -1).join(' — '), partes.at(-1)]
    : [titulo, undefined];
}

const tieneCuerpo = (sesion.body ?? '').trim().length > 0;

const memoria = sesion.data.memoria;

// Con año, a diferencia del resto de fechas de la página: la memoria se queda
// publicada y su distancia con el día de la clase es parte de lo que dice.
const escritaEl = memoria?.escritaEl.toLocaleDateString('es-CO', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---

<Base
  titulo={`S${numero} · ${sesion.data.titulo} · ${curso.data.titulo}`}
  descripcion={sesion.data.preguntaCentral}
  volverHref={`/${curso.data.ruta}`}
  volverTexto={[curso.data.titulo, curso.data.version].filter(Boolean).join(' ')}
>
  <section class="hero-clase">
    <span class="mono sube sube-1">Sesión {numero} · {fecha}</span>
    <span class="numeral-hero sube sube-1" aria-hidden="true">{numero}</span>
    <h1 class="sube sube-2">{sesion.data.titulo}</h1>
    <p class="lede sube sube-3">{sesion.data.preguntaCentral}</p>
    <div class="meta-fila sube sube-3">
      {tension && (
        <span class="sticker">{tension.data.poloA} ↔ {tension.data.poloB}</span>
      )}
      {sesion.data.conceptos.map((concepto) => (
        <span class="tag-tinta">{concepto}</span>
      ))}
    </div>
    {tension && <p class="pregunta-tension sube sube-3">{tension.data.pregunta}</p>}
  </section>

  {sesion.data.presentacion && (
    <section class="bloque">
      <h2 class="mono">La presentación</h2>
      <div class="tarjeta-deck">
        <p class="detalle">
          Se abre en una ventana nueva, lista para proyectar.
          Pide la contraseña en clase.
        </p>
        <button class="boton" id="abrir-deck" type="button">
          Abrir<span class="sr-solo"> la presentación</span> <span aria-hidden="true">→</span>
        </button>
      </div>
    </section>
  )}

  {memoria && (
    <section class="bloque">
      <div class="memoria-cabecera">
        <h2 class="mono">La memoria</h2>
        <span class="mono escrita-el">Escrita el {escritaEl}</span>
      </div>

      <div class="memoria-par">
        <div class="lado esperaba">
          <h3 class="mono">Lo que esperaba</h3>
          <p>{memoria.esperado}</p>
        </div>
        <div class="lado paso">
          <h3 class="mono">Lo que pasó</h3>
          <p>{memoria.observado}</p>
        </div>
      </div>

      {memoria.evidencia.length > 0 && (
        <div class="memoria-evidencia">
          <h3 class="mono">Evidencia</h3>
          <ul role="list">
            {memoria.evidencia.map((hecho) => <li>{hecho}</li>)}
          </ul>
        </div>
      )}

      {memoria.sorpresa && (
        <div class="memoria-sorpresa">
          <h3 class="mono">La sorpresa</h3>
          <p>{memoria.sorpresa}</p>
        </div>
      )}

      {memoria.cambio && (
        <div class="memoria-cambio">
          <h3 class="mono">La próxima vez</h3>
          <p>{memoria.cambio}</p>
        </div>
      )}
    </section>
  )}

  {sesion.data.momentos.length > 0 && (
    <section class="bloque">
      <h2 class="mono">En esta sesión</h2>
      <div class="momentos">
        {sesion.data.momentos.map((momento) => (
          <div class="momento">
            <h3 class="mono">{momento.titulo}</h3>
            <p>{momento.cuerpo}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {sesion.data.materiales.length > 0 && (
    <section class="bloque">
      <h2 class="mono">Material de la semana</h2>
      <ul class="materiales" role="list">
        {sesion.data.materiales.map((material) => {
          const [titulo, autor] = partirMaterial(material.titulo);
          const externo = !material.url.startsWith('/');
          return (
            <li>
              <a href={material.url} {...(externo ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="mat-titulo">{titulo}</span>
                {(autor || externo) && (
                  <span class="mat-autor">
                    {autor}{autor && externo && ' '}
                    {externo && (
                      <>
                        <span aria-hidden="true">↗</span>
                        <span class="sr-solo"> (abre en otra pestaña)</span>
                      </>
                    )}
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {tieneCuerpo && (
    <section class="bloque contenido-mdx">
      <Content />
    </section>
  )}

  <nav class="nav-sesiones" aria-label="Sesiones">
    {anterior && (
      <a class="salto-sesion hacia-atras" href={rutaSesion(anterior)}>
        <span class="mono">← Anterior — {fechaCorta(anterior.data.fecha)}</span>
        <span class="que-sigue">S{numeroSesion(anterior.data.numero).slice(1)} · {anterior.data.titulo}</span>
      </a>
    )}
    {siguiente && (
      <a class="salto-sesion hacia-adelante" href={rutaSesion(siguiente)}>
        <span class="mono">Siguiente — {fechaCorta(siguiente.data.fecha)} →</span>
        <span class="que-sigue">S{numeroSesion(siguiente.data.numero).slice(1)} · {siguiente.data.titulo}</span>
      </a>
    )}
    <div class="volver-curso">
      <a class="pill" href={`/${curso.data.ruta}`}>Todas las sesiones</a>
    </div>
  </nav>

  {sesion.data.presentacion && (
    <>
      <div class="candado-fondo" id="candado-fondo">
        <div class="candado" role="dialog" aria-modal="true" aria-labelledby="candado-titulo">
          <button class="cerrar" id="candado-cerrar" type="button" aria-label="Cerrar">×</button>
          <span class="numeral-modal" aria-hidden="true">{numero}</span>
          <h3 id="candado-titulo">{sesion.data.titulo}</h3>
          <p>Es para quienes están en el curso. La contraseña se dice en clase.</p>
          <form id="candado-form">
            <label class="sr-solo" for="candado-input">Contraseña</label>
            <input
              type="password"
              id="candado-input"
              placeholder="Contraseña"
              autocomplete="off"
              aria-describedby="candado-error"
            />
            <button type="submit">Abrir</button>
          </form>
          <p class="error" id="candado-error" role="status" aria-live="polite"></p>
        </div>
      </div>

      <!-- ancla oculta: abre el deck en ventana nueva (más confiable que window.open) -->
      <a id="deck-abridor" href={sesion.data.presentacion} target="_blank" rel="noopener" hidden></a>

      <script is:inline>
        (function () {
          var CLAVE = 'udea2026';
          var MARCA = 'catedra-clave-ok';
          var fondo = document.getElementById('candado-fondo');
          var dialogo = fondo.querySelector('.candado');
          var input = document.getElementById('candado-input');
          var error = document.getElementById('candado-error');
          var abridor = document.getElementById('deck-abridor');
          var boton = document.getElementById('abrir-deck');
          var cerrar = document.getElementById('candado-cerrar');
          var focoPrevio = null;

          function claveRecordada() {
            try { return sessionStorage.getItem(MARCA) === '1'; } catch (e) { return false; }
          }

          function recordarClave() {
            try { sessionStorage.setItem(MARCA, '1'); } catch (e) {}
          }

          function enfocables() {
            return dialogo.querySelectorAll('button, input');
          }

          function abrirCandado() {
            // Si ya la escribió bien en esta visita, no se la pedimos otra vez.
            if (claveRecordada()) { abridor.click(); return; }
            focoPrevio = document.activeElement;
            input.value = '';
            input.removeAttribute('aria-invalid');
            error.textContent = '';
            fondo.classList.add('abierto');
            input.focus();
          }

          function cerrarCandado() {
            if (!fondo.classList.contains('abierto')) return;
            fondo.classList.remove('abierto');
            // El foco vuelve al botón que abrió el diálogo, no al principio.
            if (focoPrevio && focoPrevio.focus) focoPrevio.focus();
            focoPrevio = null;
          }

          boton.addEventListener('click', abrirCandado);
          cerrar.addEventListener('click', cerrarCandado);
          fondo.addEventListener('click', function (e) {
            if (e.target === fondo) cerrarCandado();
          });

          document.addEventListener('keydown', function (e) {
            if (!fondo.classList.contains('abierto')) return;
            if (e.key === 'Escape') { cerrarCandado(); return; }
            if (e.key !== 'Tab') return;
            // El foco no se sale del diálogo mientras está abierto.
            var items = enfocables();
            var primero = items[0];
            var ultimo = items[items.length - 1];
            if (e.shiftKey && document.activeElement === primero) {
              e.preventDefault();
              ultimo.focus();
            } else if (!e.shiftKey && document.activeElement === ultimo) {
              e.preventDefault();
              primero.focus();
            }
          });

          document.getElementById('candado-form').addEventListener('submit', function (e) {
            e.preventDefault();
            if (input.value.trim().toLowerCase() === CLAVE) {
              recordarClave();
              abridor.click();
              cerrarCandado();
            } else {
              input.setAttribute('aria-invalid', 'true');
              error.textContent = 'Esa no es. Pregunta en clase.';
              input.focus();
            }
          });
        })();
      </script>
    </>
  )}
</Base>
