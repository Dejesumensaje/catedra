---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { numeroSesion } from '../../lib/contenido';

export async function getStaticPaths() {
  const cursos = await getCollection('cursos');
  const sesiones = await getCollection('sesiones');

  return sesiones.map((sesion) => {
    const curso = cursos.find((c) => c.id === sesion.data.curso.id);
    if (!curso) {
      throw new Error(
        `La sesión "${sesion.id}" referencia el curso "${sesion.data.curso.id}", que no existe.`,
      );
    }

    const siguiente = sesiones.find(
      (s) => s.data.curso.id === curso.id && s.data.numero === sesion.data.numero + 1,
    );

    return {
      params: { curso: curso.data.ruta, numero: numeroSesion(sesion.data.numero).slice(1) },
      props: { sesion, curso, siguiente },
    };
  });
}

const { sesion, curso, siguiente } = Astro.props;
const { Content } = await render(sesion);

const tension = sesion.data.tension ? await getEntry(sesion.data.tension) : undefined;

const numero = numeroSesion(sesion.data.numero).slice(1);

const fecha = sesion.data.fecha.toLocaleDateString('es-CO', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const fechaSiguiente = siguiente?.data.fecha.toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});

// Los materiales se escriben "Título — Autor"; se separan para mostrarlos en dos niveles.
function partirMaterial(titulo: string): [string, string | undefined] {
  const partes = titulo.split(' — ');
  return partes.length > 1
    ? [partes.slice(0, -1).join(' — '), partes.at(-1)]
    : [titulo, undefined];
}

const tieneCuerpo = (sesion.body ?? '').trim().length > 0;
---

<Base
  titulo={`S${numero} · ${sesion.data.titulo} · ${curso.data.titulo}`}
  descripcion={sesion.data.preguntaCentral}
  volverHref={`/${curso.data.ruta}`}
  volverTexto={`${curso.data.titulo} ${curso.data.version ?? ''}`}
>
  <section class="hero-clase">
    <span class="mono sube sube-1">Sesión {numero} · {fecha}</span>
    <span class="numeral-hero sube sube-1" aria-hidden="true">{numero}</span>
    <h1 class="sube sube-2">{sesion.data.titulo}</h1>
    <p class="lede sube sube-3">{sesion.data.preguntaCentral}</p>
    <div class="meta-fila sube sube-3">
      {tension && (
        <span class="sticker">{tension.data.poloA} ↔ {tension.data.poloB}</span>
      )}
      {sesion.data.conceptos.map((concepto) => (
        <span class="tag-tinta">{concepto}</span>
      ))}
    </div>
  </section>

  {sesion.data.presentacion && (
    <section class="bloque sube sube-4">
      <span class="mono">La presentación</span>
      <div class="tarjeta-deck">
        <div>
          <p class="que">El deck de la sesión</p>
          <p class="detalle">Se abre en una ventana nueva, listo para proyectar. Pide la contraseña en clase.</p>
        </div>
        <button class="boton" id="abrir-deck" type="button">Abrir presentación →</button>
      </div>
    </section>
  )}

  {sesion.data.momentos.length > 0 && (
    <section class="bloque">
      <span class="mono">En esta sesión</span>
      <div class="momentos">
        {sesion.data.momentos.map((momento) => (
          <div class="momento">
            <span class="mono">{momento.titulo}</span>
            <p>{momento.cuerpo}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {sesion.data.materiales.length > 0 && (
    <section class="bloque">
      <span class="mono">Material</span>
      <ul class="materiales">
        {sesion.data.materiales.map((material) => {
          const [titulo, autor] = partirMaterial(material.titulo);
          return (
            <li>
              <a href={material.url} target="_blank" rel="noopener">
                <span class="mat-titulo">{titulo}</span>
                <span class="mat-autor">{autor ? `${autor} ↗` : '↗'}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {tieneCuerpo && (
    <section class="bloque contenido-mdx">
      <Content />
    </section>
  )}

  {siguiente && (
    <div class="siguiente">
      <span class="mono">Siguiente — {fechaSiguiente}</span>
      <span class="que-sigue">S{numeroSesion(siguiente.data.numero).slice(1)} · {siguiente.data.titulo}</span>
    </div>
  )}

  {sesion.data.presentacion && (
    <>
      <div class="candado-fondo" id="candado-fondo">
        <div class="candado" role="dialog" aria-modal="true" aria-labelledby="candado-titulo">
          <span class="numeral-modal">{numero}</span>
          <h3 id="candado-titulo">{sesion.data.titulo}</h3>
          <p>Esta presentación es para quienes están en el curso. Escribe la contraseña y se abre en una ventana nueva.</p>
          <form id="candado-form">
            <input type="password" id="candado-input" placeholder="Contraseña" autocomplete="off" aria-label="Contraseña" />
            <button type="submit">Abrir</button>
          </form>
          <p class="error" id="candado-error"></p>
        </div>
      </div>

      <!-- ancla oculta: abre el deck en ventana nueva (más confiable que window.open) -->
      <a id="deck-abridor" href={sesion.data.presentacion} target="_blank" rel="noopener" hidden></a>

      <script is:inline>
        (function () {
          var CLAVE = 'udea2026';
          var MARCA = 'catedra-clave-ok';
          var fondo = document.getElementById('candado-fondo');
          var input = document.getElementById('candado-input');
          var error = document.getElementById('candado-error');
          var abridor = document.getElementById('deck-abridor');
          var boton = document.getElementById('abrir-deck');

          function claveRecordada() {
            try { return sessionStorage.getItem(MARCA) === '1'; } catch (e) { return false; }
          }

          function recordarClave() {
            try { sessionStorage.setItem(MARCA, '1'); } catch (e) {}
          }

          function abrirCandado() {
            // Si ya la escribió bien en esta visita, no se la pedimos otra vez.
            if (claveRecordada()) { abridor.click(); return; }
            input.value = '';
            error.textContent = '';
            fondo.classList.add('abierto');
            input.focus();
          }

          function cerrarCandado() {
            fondo.classList.remove('abierto');
          }

          boton.addEventListener('click', abrirCandado);
          fondo.addEventListener('click', function (e) {
            if (e.target === fondo) cerrarCandado();
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') cerrarCandado();
          });

          document.getElementById('candado-form').addEventListener('submit', function (e) {
            e.preventDefault();
            if (input.value.trim().toLowerCase() === CLAVE) {
              recordarClave();
              abridor.click();
              cerrarCandado();
            } else {
              error.textContent = 'Esa no es. Pregunta en clase.';
            }
          });
        })();
      </script>
    </>
  )}
</Base>
