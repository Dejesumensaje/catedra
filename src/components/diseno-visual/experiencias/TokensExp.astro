<script>
  import { conectar, svg, n } from '../../../lib/diseno-visual/estado';
  import { guiar } from '../../../lib/diseno-visual/guia';
  import { jugar, barajar, type Ronda } from '../../../lib/diseno-visual/juego';

  const SANS = 'Roboto, Helvetica, Arial, sans-serif';
  const SERIF = "'PT Serif', Georgia, serif";

  type E = {
    tema: string;
    acento: string;
    espacio: number;
    radio: number;
    infiltrado: boolean;
    rayosx: boolean;
  };

  const TEMAS: Record<string, { nombre: string; papel: string; fondo: string; tinta: string; texto: string; sec: string; regla: string }> = {
    claro: {
      nombre: 'Claro',
      papel: '#ffffff',
      fondo: '#fbfbf9',
      tinta: '#222222',
      texto: '#444444',
      sec: '#6f6f6f',
      regla: '#e5e5e5',
    },
    contraste: {
      nombre: 'Alto contraste',
      papel: '#161616',
      fondo: '#0d0d0d',
      tinta: '#f5f5f0',
      texto: '#deded8',
      sec: '#b8b8b0',
      regla: '#3d3d3d',
    },
    editorial: {
      nombre: 'Editorial',
      papel: '#f7f3e8',
      fondo: '#efe9d8',
      tinta: '#2b2118',
      texto: '#4a3b2c',
      sec: '#6e5d4f',
      regla: '#d8cebe',
    },
  };

  const ACENTOS: Record<string, { hex: string; tintaSobreAcento: string; nombre: string }> = {
    amarillo: { hex: '#eeff41', tintaSobreAcento: '#222222', nombre: '#eeff41' },
    terracota: { hex: '#b3261e', tintaSobreAcento: '#ffffff', nombre: '#b3261e' },
    salvia: { hex: '#2e6f40', tintaSobreAcento: '#ffffff', nombre: '#2e6f40' },
  };

  function pintar(destino: HTMLElement, e: E) {
    const W = Math.max(destino.clientWidth, 280);
    const estrecho = W < 520;
    const H = estrecho ? 460 : 330;
    const t = TEMAS[e.tema] ?? TEMAS.claro;
    const ac = ACENTOS[e.acento] ?? ACENTOS.amarillo;
    const pad = e.espacio;
    const r = e.radio;

    const raiz = svg('svg', { viewBox: `0 0 ${W} ${H}`, width: W, height: H, role: 'img' });
    raiz.setAttribute(
      'aria-label',
      `Consola de tokens en tema ${t.nombre} con espacio interior de ${pad} px y acento ${ac.nombre}.`,
    );
    raiz.append(svg('rect', { width: W, height: H, fill: '#fbfbf9' }));

    const colIzqW = estrecho ? W - 28 : Math.round(W * 0.38);
    const colDerX = estrecho ? 14 : colIzqW + 26;
    const colDerW = estrecho ? W - 28 : W - colDerX - 14;
    const colDerY = estrecho ? 168 : 14;
    const colDerH = estrecho ? H - 182 : H - 28;

    // Panel izquierdo: Árbol de tokens
    const panelTokens = svg('g');
    panelTokens.append(
      svg('rect', {
        x: 14,
        y: 14,
        width: colIzqW,
        height: estrecho ? 142 : H - 28,
        rx: 0,
        fill: '#ffffff',
        stroke: '#222222',
        'stroke-width': 1.5,
      }),
    );

    const titIzq = svg('text', {
      x: 26,
      y: 34,
      'font-family': SANS,
      'font-size': 10,
      'font-weight': 900,
      'letter-spacing': 0.8,
      fill: '#222222',
    });
    titIzq.textContent = `TABLA DE TOKENS · TEMA ${t.nombre.toUpperCase()}`;
    panelTokens.append(titIzq);

    const filas = [
      { tok: '--superficie-papel', val: t.papel, muestra: t.papel },
      { tok: '--tinta-principal', val: t.tinta, muestra: t.tinta },
      { tok: '--texto-secundario', val: t.sec, muestra: t.sec },
      { tok: '--acento-estado', val: ac.nombre, muestra: ac.hex },
      { tok: '--espacio-interior', val: `${pad} px`, muestra: null },
      { tok: '--radio-borde', val: `${r} px`, muestra: null },
    ];

    const filasVisibles = estrecho ? filas.slice(0, 4) : filas;
    filasVisibles.forEach((f, idx) => {
      const fy = 52 + idx * (estrecho ? 22 : 38);
      if (!estrecho) {
        panelTokens.append(
          svg('rect', {
            x: 24,
            y: fy - 12,
            width: colIzqW - 20,
            height: 30,
            fill: '#fbfbf9',
            stroke: '#e5e5e5',
            'stroke-width': 1,
          }),
        );
      }
      const txtTok = svg('text', {
        x: 30,
        y: fy + 6,
        'font-family': SANS,
        'font-size': 10,
        'font-weight': 700,
        fill: '#222222',
      });
      txtTok.textContent = f.tok;
      panelTokens.append(txtTok);

      if (f.muestra) {
        panelTokens.append(
          svg('rect', {
            x: 14 + colIzqW - 78,
            y: fy - 6,
            width: 14,
            height: 14,
            fill: f.muestra,
            stroke: '#222222',
            'stroke-width': 1,
          }),
        );
      }
      const txtVal = svg('text', {
        x: 14 + colIzqW - 18,
        y: fy + 6,
        'text-anchor': 'end',
        'font-family': SANS,
        'font-size': 9.5,
        'font-weight': 700,
        fill: '#6f6f6f',
      });
      txtVal.textContent = f.val;
      panelTokens.append(txtVal);
    });

    raiz.append(panelTokens);

    // Panel derecho: Interfaz que consume los tokens
    const ui = svg('g');
    ui.append(
      svg('rect', {
        x: colDerX,
        y: colDerY,
        width: colDerW,
        height: colDerH,
        rx: r,
        fill: t.fondo,
        stroke: t.tinta,
        'stroke-width': 1.5,
      }),
    );

    // 1. Cabecera
    const cabY = colDerY + 12;
    const cabX = colDerX + 14;
    const cabW = colDerW - 28;
    const txtMarca = svg('text', {
      x: cabX,
      y: cabY + 14,
      'font-family': SANS,
      'font-size': 11,
      'font-weight': 900,
      'letter-spacing': 0.8,
      fill: t.tinta,
    });
    txtMarca.textContent = 'ARCHIVO SONORO';
    ui.append(txtMarca);

    // Insignia de estado (consume --acento-estado y --radio-borde)
    const badgeW = 86;
    ui.append(
      svg('rect', {
        x: cabX + cabW - badgeW,
        y: cabY,
        width: badgeW,
        height: 20,
        rx: r,
        fill: ac.hex,
        stroke: t.tinta,
        'stroke-width': 1.2,
      }),
    );
    const txtBadge = svg('text', {
      x: cabX + cabW - badgeW / 2,
      y: cabY + 14,
      'text-anchor': 'middle',
      'font-family': SANS,
      'font-size': 9,
      'font-weight': 900,
      fill: ac.tintaSobreAcento,
    });
    txtBadge.textContent = 'EN VIVO · 24 H';
    ui.append(txtBadge);

    // 2. Tarjeta principal (consume --superficie-papel, --espacio-interior, --radio-borde)
    const cardY = cabY + 30;
    const cardH = Math.min(116, 72 + pad * 1.8);
    ui.append(
      svg('rect', {
        x: cabX,
        y: cardY,
        width: cabW,
        height: cardH,
        rx: r,
        fill: t.papel,
        stroke: t.tinta,
        'stroke-width': 1.5,
      }),
    );

    const kText = svg('text', {
      x: cabX + pad,
      y: cardY + pad + 8,
      'font-family': SANS,
      'font-size': 9,
      'font-weight': 700,
      'letter-spacing': 0.6,
      fill: t.sec,
    });
    kText.textContent = 'SESIÓN 04 · FONOTECA';
    ui.append(kText);

    const hText = svg('text', {
      x: cabX + pad,
      y: cardY + pad + 26,
      'font-family': SERIF,
      'font-size': 15,
      'font-weight': 700,
      fill: t.tinta,
    });
    hText.textContent = 'Paisajes de cinta magnética';
    ui.append(hText);

    // Botón primario dentro de la tarjeta
    const btnW = 108;
    const btnH = 24;
    const btnY = cardY + cardH - pad - btnH + 4;
    ui.append(
      svg('rect', {
        x: cabX + pad,
        y: btnY,
        width: btnW,
        height: btnH,
        rx: r,
        fill: ac.hex,
        stroke: t.tinta,
        'stroke-width': 1.4,
      }),
    );
    const txtBtn = svg('text', {
      x: cabX + pad + btnW / 2,
      y: btnY + 16,
      'text-anchor': 'middle',
      'font-family': SANS,
      'font-size': 10,
      'font-weight': 900,
      fill: ac.tintaSobreAcento,
    });
    txtBtn.textContent = 'Reservar cupo';
    ui.append(txtBtn);

    // 3. Bloque inferior: formulario y alerta
    const formY = cardY + cardH + 12;
    const formH = Math.max(66, colDerY + colDerH - formY - 12);
    ui.append(
      svg('rect', {
        x: cabX,
        y: formY,
        width: cabW,
        height: formH,
        rx: r,
        fill: t.papel,
        stroke: e.infiltrado ? '#b3261e' : t.regla,
        'stroke-width': e.infiltrado ? 2 : 1.2,
      }),
    );

    // Si infiltrado está activo, el texto usa #222222 fijo en lugar del token --tinta-principal
    const colorTextoInfiltrado = e.infiltrado ? '#222222' : t.tinta;
    const lblForm = svg('text', {
      x: cabX + pad,
      y: formY + Math.min(pad, 18) + 8,
      'font-family': SANS,
      'font-size': 10.5,
      'font-weight': 700,
      fill: colorTextoInfiltrado,
    });
    lblForm.textContent = e.infiltrado
      ? 'Aviso con #222222 fijo (¡sin token!)'
      : 'Suscripción al boletín mensual';
    ui.append(lblForm);

    const subForm = svg('text', {
      x: cabX + pad,
      y: formY + Math.min(pad, 18) + 26,
      'font-family': SERIF,
      'font-size': 11,
      fill: e.infiltrado ? '#222222' : t.texto,
    });
    subForm.textContent = e.infiltrado
      ? 'En modo alto contraste este texto queda negro sobre negro.'
      : 'Recibe la programación con 48 horas de antelación.';
    ui.append(subForm);

    // Etiquetas de rayos X
    if (e.rayosx) {
      const pins = [
        { x: cabX + cabW - badgeW - 6, y: cabY + 10, txt: '--acento-estado' },
        { x: cabX + cabW - 8, y: cardY + 18, txt: '--superficie-papel' },
        { x: cabX + cabW - 8, y: cardY + cardH - 12, txt: `--espacio-interior (${pad} px)` },
      ];
      for (const p of pins) {
        const wPin = p.txt.length * 5.6 + 10;
        const px = p.x - wPin;
        ui.append(
          svg('rect', {
            x: px,
            y: p.y - 10,
            width: wPin,
            height: 15,
            fill: '#222222',
          }),
        );
        const tPin = svg('text', {
          x: px + 5,
          y: p.y + 1,
          'font-family': SANS,
          'font-size': 8.5,
          'font-weight': 700,
          fill: '#eeff41',
        });
        tPin.textContent = p.txt;
        ui.append(tPin);
      }
    }

    raiz.append(ui);
    destino.replaceChildren(raiz);
  }

  function describir(e: E): string {
    const t = TEMAS[e.tema] ?? TEMAS.claro;
    const ac = ACENTOS[e.acento] ?? ACENTOS.amarillo;
    if (e.infiltrado && e.tema === 'contraste') {
      return `¡Fuga detectada! Mientras los componentes conectados a tokens se adaptaron al tema <b class="dv-cifra">${t.nombre}</b>, el bloque inferior con <code>#222222</code> fijo quedó negro sobre fondo <code>${t.papel}</code> y perdió toda su legibilidad.`;
    }
    if (e.infiltrado) {
      return `Hay un valor bruto (<code>#222222</code>) infiltrado en el bloque inferior. En el tema <b class="dv-cifra">${t.nombre}</b> pasa inadvertido porque coincide con la tinta, pero fallará en cuanto cambies a Alto contraste.`;
    }
    return `Tema <b class="dv-cifra">${t.nombre}</b> activo: 6 tokens semánticos gobiernan 4 bloques a la vez (acento <code>${ac.nombre}</code>, espacio interior de <b class="dv-cifra">${n(e.espacio, 0)} px</b> y radio de <b class="dv-cifra">${n(e.radio, 0)} px</b>).`;
  }

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-lab="tokens"]')) {
    guiar<E>(raiz, [
      (e) => e.tema === 'contraste',
      (e) => e.tema === 'editorial',
      (e) => e.espacio >= 20,
      (e) => e.acento === 'terracota',
      (e) => e.infiltrado && e.tema === 'contraste',
    ]);
    conectar<E>({ raiz, pintar, describir });
  }

  // ── Especímenes de error ─────────────────────────────────────────
  type E1 = { nombre: string };
  function pintarE1(d: HTMLElement, e: E1) {
    const mapa: Record<string, { decl: string; estado: string; ok: boolean }> = {
      apariencia: {
        decl: '--azul-oscuro: #b3261e;',
        estado: 'Nombre roto: al cambiar la marca a terracota, el token llamado «azul» guarda un rojo.',
        ok: false,
      },
      posicion: {
        decl: '--color-abajo-derecha: #b3261e;',
        estado: 'Nombre frágil: si en móvil el botón pasa arriba, el nombre deja de tener sentido.',
        ok: false,
      },
      funcion: {
        decl: '--color-accion-primaria: #b3261e;',
        estado: 'Nombre semántico: describe qué papel cumple la pieza, sin importar qué color tenga hoy.',
        ok: true,
      },
    };
    const m = mapa[e.nombre] ?? mapa.apariencia;
    d.innerHTML = `
      <div style="padding:14px 16px;font-family:${SANS};color:#222222;background:#ffffff;border:1.5px solid #222222;">
        <div style="padding:8px 10px;background:${m.ok ? '#fbfbf9' : '#fbe9e7'};border:1px solid ${m.ok ? '#222222' : '#b3261e'};font-weight:700;font-size:12px;margin-bottom:10px;">
          <code>${m.decl}</code>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
          <span style="font-family:${SERIF};font-size:12.5px;color:#444444;">${m.estado}</span>
          <span style="padding:6px 12px;background:#b3261e;color:#ffffff;font-size:11px;font-weight:700;white-space:nowrap;">Confirmar envío</span>
        </div>
      </div>`;
  }
  function describirE1(e: E1) {
    if (e.nombre === 'apariencia') return 'Llamar a un token <b class="dv-cifra">--azul-oscuro</b> ata el nombre al valor cromático y caduca con el primer rediseño.';
    if (e.nombre === 'posicion') return 'Nombrar por ubicación (<b class="dv-cifra">--color-abajo-derecha</b>) impide reutilizar el token en otros componentes.';
    return '<b class="dv-cifra">Nombre por función</b>: <code>--color-accion-primaria</code> sobrevive a cambios de marca, de tema y de disposición.';
  }

  type E2 = { consolidacion: number };
  function pintarE2(d: HTMLElement, e: E2) {
    const k = e.consolidacion / 100;
    const p1 = Math.round(11 + k * (16 - 11));
    const p2 = Math.round(15 + k * (16 - 15));
    const p3 = Math.round(21 + k * (16 - 21));
    const etq1 = k === 1 ? 'var(--espacio-m) · 16 px' : `${p1} px (a ojo)`;
    const etq2 = k === 1 ? 'var(--espacio-m) · 16 px' : `${p2} px (a ojo)`;
    const etq3 = k === 1 ? 'var(--espacio-m) · 16 px' : `${p3} px (a ojo)`;
    d.innerHTML = `
      <div style="padding:14px 16px;font-family:${SANS};color:#222222;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
        <div style="padding:${p1}px;border:1.5px solid #222222;background:#ffffff;">
          <p style="margin:0;font-size:9.5px;font-weight:700;color:#6f6f6f;">${etq1}</p>
          <p style="margin:4px 0 0;font-size:12px;font-weight:700;">Módulo A</p>
        </div>
        <div style="padding:${p2}px;border:1.5px solid #222222;background:#ffffff;">
          <p style="margin:0;font-size:9.5px;font-weight:700;color:#6f6f6f;">${etq2}</p>
          <p style="margin:4px 0 0;font-size:12px;font-weight:700;">Módulo B</p>
        </div>
        <div style="padding:${p3}px;border:1.5px solid #222222;background:#ffffff;">
          <p style="margin:0;font-size:9.5px;font-weight:700;color:#6f6f6f;">${etq3}</p>
          <p style="margin:4px 0 0;font-size:12px;font-weight:700;">Módulo C</p>
        </div>
      </div>`;
  }
  function describirE2(e: E2) {
    if (e.consolidacion < 100) return `Aún conviven medidas arbitrarias (${Math.round(11 + (e.consolidacion / 100) * 5)} px y ${Math.round(21 - (e.consolidacion / 100) * 5)} px) que producen desalineaciones sutiles.`;
    return '<b class="dv-cifra">Un solo token (16 px)</b>: los tres módulos comparten exactamente el mismo respiro interior.';
  }

  type E3 = { regla: string };
  function pintarE3(d: HTMLElement, e: E3) {
    const usaToken = e.regla === 'token';
    d.innerHTML = `
      <div style="padding:14px 16px;font-family:${SANS};background:#161616;color:#f5f5f0;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
        <div style="padding:10px;border:1px solid #3d3d3d;background:#222222;">
          <p style="margin:0;font-size:9.5px;color:#eeff41;font-weight:700;">var(--tinta)</p>
          <p style="margin:4px 0 0;font-size:12px;font-weight:700;color:#f5f5f0;">Lectura clara</p>
        </div>
        <div style="padding:10px;border:1px solid #3d3d3d;background:#222222;">
          <p style="margin:0;font-size:9.5px;color:#eeff41;font-weight:700;">var(--tinta)</p>
          <p style="margin:4px 0 0;font-size:12px;font-weight:700;color:#f5f5f0;">Lectura clara</p>
        </div>
        <div style="padding:10px;border:1.5px solid ${usaToken ? '#eeff41' : '#b3261e'};background:#222222;">
          <p style="margin:0;font-size:9.5px;color:${usaToken ? '#eeff41' : '#f5f5f0'};font-weight:700;">${usaToken ? 'var(--tinta)' : '#222222 fijo'}</p>
          <p style="margin:4px 0 0;font-size:12px;font-weight:700;color:${usaToken ? '#f5f5f0' : '#2a2a2a'};">Tercer dato</p>
        </div>
      </div>`;
  }
  function describirE3(e: E3) {
    if (e.regla === 'bruto') return 'El valor suelto <code>#222222</code> ignora el cambio de tema y deja el texto <b class="dv-cifra">oscuro sobre oscuro</b>.';
    return '<b class="dv-cifra">Propagación restaurada</b>: al conectar la tarjeta a <code>var(--tinta-principal)</code>, responde al modo oscuro igual que sus vecinas.';
  }

  const especimenes: [string, (d: HTMLElement, e: never) => void, (e: never) => string][] = [
    ['tokens-e1', pintarE1 as never, describirE1 as never],
    ['tokens-e2', pintarE2 as never, describirE2 as never],
    ['tokens-e3', pintarE3 as never, describirE3 as never],
  ];
  for (const [id, p, desc] of especimenes) {
    for (const r of document.querySelectorAll<HTMLElement>(`[data-lab="${id}"]`)) {
      conectar({ raiz: r, pintar: p, describir: desc });
    }
  }

  // ── Juego de 5 rondas ────────────────────────────────────────────
  function r1NombreSemantico(): Ronda {
    const ops = barajar([
      {
        texto: '--color-superficie-alerta: describe para qué sirve la decisión sin atarla al matiz actual',
        es: true,
      },
      {
        texto: '--amarillo-chillón-eeff41: repite el valor hexadecimal dentro del nombre',
        es: false,
      },
      {
        texto: '--caja-arriba-izquierda: nombra la coordenada donde aparece hoy en una pantalla',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Quieres guardar en un token el color de fondo de los avisos importantes. ¿Cuál de estos nombres es un buen token semántico?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Un token semántico nombra la función o el rol dentro del sistema («superficie de alerta»), no su apariencia física ni su coordenada en una pantalla concreta.',
      repaso: 'Nomenclatura semántica',
    };
  }

  function r2CapasTokens(): Ronda {
    const ops = barajar([
      {
        texto: 'Reasignar a qué tokens primitivos apuntan los tokens semánticos en el nuevo tema',
        es: true,
      },
      {
        texto: 'Duplicar todos los componentes y cambiar los valores hexadecimales línea por línea',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Tu sistema tiene una capa de tokens primitivos (la paleta base) y una capa de tokens semánticos (--superficie-papel, --tinta-principal). ¿Cómo se añade un modo nocturno limpio?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'La arquitectura en dos capas permite que los componentes lean siempre el mismo token semántico mientras cada tema cambia únicamente a qué primitivo apunta ese token.',
      repaso: 'Primitivos frente a semánticos',
    };
  }

  function r3ValorInfiltrado(): Ronda {
    const ops = barajar([
      {
        texto: 'Alguien escribió un valor bruto (#222222) en lugar de usar el token semántico de texto',
        es: true,
      },
      {
        texto: 'El navegador no admite más de tres variables CSS en la misma página',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Al activar el tema oscuro de una aplicación, 49 etiquetas pasan a blanco pero una sola se queda negra sobre fondo negro. ¿Cuál es la causa habitual?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Cuando un valor bruto («hardcoded») se infiltra directamente en el estilo de un elemento, queda desconectado del árbol de tokens y no se entera cuando cambia el tema.',
      repaso: 'Valores sueltos infiltrados',
    };
  }

  function r4Proliferacion(): Ronda {
    const ops = barajar([
      {
        texto: 'Una escala acotada de 5 tokens de espacio (4, 8, 16, 24 y 40 px) con función clara',
        es: true,
      },
      {
        texto: '40 tokens numerados de 1 px en 1 px (--espacio-13, --espacio-14, --espacio-15…)',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: '¿Qué conjunto de tokens de espaciado ayuda mejor a que un equipo mantenga consistencia entre pantallas?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Si existen 40 tokens separados por 1 px, elegir entre --espacio-15 y --espacio-16 vuelve a ser arbitrario. Una escala corta con saltos francos elimina la duda.',
      repaso: 'Escala acotada de tokens',
    };
  }

  function r5AjusteEspacio(): Ronda {
    return {
      tipo: 'ajuste',
      pregunta: 'La tarjeta destacada tiene un valor suelto de 6 px de relleno interior que asfixia el texto frente al resto del sistema (que usa --espacio-m = 16 px). Lleva el token de espacio al valor del sistema (entre 16 y 20 px).',
      control: {
        etiqueta: 'Valor del token --espacio-interior',
        min: 4,
        max: 28,
        paso: 2,
        valor: 6,
        unidad: 'px',
      },
      pintar: (c, v) => {
        c.innerHTML = `
          <div style="padding:12px;font-family:${SANS};background:#fbfbf9;border:1px solid #e5e5e5;display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            <div style="padding:16px;background:#ffffff;border:1.5px solid #222222;">
              <span style="font-size:10px;font-weight:700;color:#6f6f6f;">SISTEMA (16 px)</span>
              <p style="margin:4px 0 0;font-size:13px;font-weight:700;color:#222222;">Ficha estándar</p>
            </div>
            <div style="padding:${v}px;background:#eeff41;border:1.5px solid #222222;">
              <span style="font-size:10px;font-weight:700;color:#222222;">ACTUAL (${v} px)</span>
              <p style="margin:4px 0 0;font-size:13px;font-weight:700;color:#222222;">Ficha conectada</p>
            </div>
          </div>`;
      },
      cumple: (v) => v >= 16 && v <= 20,
      falta: (v) => v < 16 ? `Con ${v} px el interior sigue comprimido frente al estándar de 16 px.` : `Con ${v} px te pasaste al peldaño siguiente de la escala.`,
      porque: 'Conectar ambas tarjetas al mismo peldaño de la escala (--espacio-m: 16 px) alinea sus cabeceras y estabiliza el ritmo interno.',
      repaso: 'Alineación mediante tokens de espacio',
    };
  }

  const rootJuego = document.querySelector<HTMLElement>('[data-juego="tokens"]');
  if (rootJuego) {
    jugar(rootJuego, () =>
      barajar([
        r1NombreSemantico(),
        r2CapasTokens(),
        r3ValorInfiltrado(),
        r4Proliferacion(),
        r5AjusteEspacio(),
      ]),
    );
  }
</script>
