---
import Anotada from '../Anotada.astro';
import Instrumento from '../controles/Instrumento.astro';
import Deslizador from '../controles/Deslizador.astro';
import Opciones from '../controles/Opciones.astro';
import Interruptor from '../controles/Interruptor.astro';
import Guia, { type PasoGuia } from '../controles/Guia.astro';
import Juego from '../Juego.astro';

interface Props {
  paso: 'idea' | 'miralo' | 'pruebalo' | 'errores' | 'ejemplos' | 'juego';
}

const { paso } = Astro.props;
const lab = 'tokens';

const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const SERIF = "'PT Serif', Georgia, serif";
const T = '#222222';
const TXT = '#444444';
const G = '#6f6f6f';
const PAPEL = '#ffffff';
const FONDO = '#fbfbf9';
const REGLA = '#e5e5e5';
const AMARILLO = '#eeff41';
const ROJO = '#b3261e';

const W = 360;
const H = 280;
const pct = (x: number, y: number) => ({ x: Math.round((x / W) * 100), y: Math.round((y / H) * 100) });
const zona = (x: number, y: number, w: number, h: number) => ({
  x: Math.round((x / W) * 100),
  y: Math.round((y / H) * 100),
  w: Math.round((w / W) * 100),
  h: Math.round((h / H) * 100),
});

const pasos: PasoGuia[] = [
  {
    titulo: 'Cambia de tema sin tocar los componentes.',
    hacer: 'En «Tema activo (reasignación semántica)», selecciona «Alto contraste».',
    pista: 'Elige la segunda opción del primer control.',
    logro: 'La cabecera, la tarjeta, el formulario y la alerta cambiaron al unísono porque no tenían colores fijos: cada pieza lee tokens semánticos como «--superficie-papel» y «--tinta-principal».',
  },
  {
    titulo: 'Prueba un registro editorial cálido.',
    hacer: 'En «Tema activo (reasignación semántica)», selecciona «Editorial».',
    pista: 'Elige la tercera opción del primer control.',
    logro: 'El mismo código de interfaz adopta una paleta de papel crema y acento terracota. El token separa qué función cumple cada elemento de qué valor concreto tiene hoy.',
  },
  {
    titulo: 'Propaga el espacio interior desde un único punto.',
    hacer: 'Sube «Token --espacio-interior» a 20 px o más.',
    pista: 'Arrastra el deslizador de espacio interior hacia la derecha.',
    preparar: { tema: 'claro' },
    logro: 'El margen interno de la tarjeta, del bloque de formulario y del aviso crece de manera coordinada. Nadie tuvo que editar tres hojas de estilo por separado.',
  },
  {
    titulo: 'Reasigna el token de acento semántico.',
    hacer: 'En «Token --acento-estado apunta a», selecciona «Terracota (#b3261e)».',
    pista: 'Elige la segunda opción del selector de acento.',
    logro: 'Cambiar a qué primitivo apunta el token semántico transforma al instante la etiqueta de estado y el indicador activo sin alterar textos ni bordes.',
  },
  {
    titulo: 'Detecta un valor suelto («hardcoded») infiltrado.',
    hacer: 'Abre «Más controles», activa «Infiltrar un valor bruto (#222222) sin token» y cambia «Tema activo (reasignación semántica)» a «Alto contraste».',
    pista: 'Despliega «Más controles», marca la casilla y elige el tema «Alto contraste».',
    preparar: { tema: 'claro', infiltrado: false },
    abrir: true,
    logro: 'Mientras toda la interfaz invierte sus colores con limpieza, el bloque que tenía «#222222» escrito a fuego queda negro sobre negro y se vuelve ilegible. Un solo valor sin token rompe la propagación del sistema.',
  },
];
---

{paso === 'idea' && (
  <div class="dv-pregunta-visual">
    <svg viewBox="0 0 600 180" role="img" aria-label="Dos diagramas comparados: a la izquierda, cambiar el valor bruto #222222 rompe a la vez el texto, el borde y el botón; a la derecha, tres tokens con nombre permiten cambiar solo el botón.">
      <rect width="600" height="180" fill={FONDO} />
      {/* Izquierda: valor bruto */}
      <g transform="translate(18, 16)">
        <rect width="268" height="148" fill={PAPEL} stroke={REGLA} stroke-width="1.5" />
        <text x="14" y="22" font-family={SANS} font-size="10" font-weight="700" letter-spacing="0.06em" fill={ROJO}>SIN TOKENS · VALOR BRUTO #222222</text>
        <rect x="14" y="34" width="92" height="24" fill={T} />
        <text x="60" y="50" text-anchor="middle" font-family={SANS} font-size="11" font-weight="700" fill={AMARILLO}>#222222 → #b3261e</text>
        <path d="M 106 46 L 138 36 M 106 46 L 138 74 M 106 46 L 138 112" stroke={ROJO} stroke-width="1.5" stroke-dasharray="3 2" />
        <rect x="140" y="24" width="114" height="110" fill={PAPEL} stroke={ROJO} stroke-width="2.5" />
        <text x="150" y="46" font-family={SANS} font-size="12" font-weight="700" fill={ROJO}>Título en rojo</text>
        <text x="150" y="64" font-family={SERIF} font-size="10.5" fill={ROJO}>Párrafo también</text>
        <text x="150" y="78" font-family={SERIF} font-size="10.5" fill={ROJO}>teñido por error.</text>
        <rect x="150" y="94" width="94" height="26" fill={ROJO} />
        <text x="197" y="111" text-anchor="middle" font-family={SANS} font-size="10.5" font-weight="700" fill={PAPEL}>Botón acción</text>
      </g>

      {/* Derecha: con tokens semánticos */}
      <g transform="translate(314, 16)">
        <rect width="268" height="148" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="14" y="22" font-family={SANS} font-size="10" font-weight="700" letter-spacing="0.06em" fill={T}>CON TOKENS · ROL SEMÁNTICO</text>
        <rect x="14" y="34" width="104" height="22" fill={FONDO} stroke={T} stroke-width="1" />
        <text x="20" y="49" font-family={SANS} font-size="9.5" font-weight="700" fill={T}>--color-texto</text>
        <rect x="14" y="64" width="104" height="22" fill={FONDO} stroke={T} stroke-width="1" />
        <text x="20" y="79" font-family={SANS} font-size="9.5" font-weight="700" fill={T}>--color-borde</text>
        <rect x="14" y="94" width="104" height="24" fill={AMARILLO} stroke={T} stroke-width="1.5" />
        <text x="20" y="110" font-family={SANS} font-size="9.5" font-weight="900" fill={T}>--color-accion</text>

        <path d="M 118 45 L 142 44 M 118 75 L 142 75 M 118 106 L 142 107" stroke={T} stroke-width="1.4" />
        <rect x="144" y="24" width="110" height="110" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="154" y="46" font-family={SANS} font-size="12" font-weight="700" fill={T}>Título intacto</text>
        <text x="154" y="64" font-family={SERIF} font-size="10.5" fill={TXT}>El cuerpo y el borde</text>
        <text x="154" y="78" font-family={SERIF} font-size="10.5" fill={TXT}>conservan su rol.</text>
        <rect x="154" y="94" width="90" height="26" fill={AMARILLO} stroke={T} stroke-width="1.5" />
        <text x="199" y="111" text-anchor="middle" font-family={SANS} font-size="10.5" font-weight="900" fill={T}>Botón acción</text>
      </g>
    </svg>
    <p>En una tarjeta el texto, el borde y el botón usan hoy el mismo color <code>#222222</code>. ¿Qué pasa mañana cuando quieres que solo los botones cambien de color?</p>
    <details>
      <summary>Ver la respuesta</summary>
      <div class="dv-texto">
        <p>Si las tres piezas apuntan directamente al valor bruto <code>#222222</code>, un «buscar y reemplazar» teñirá por accidente los párrafos y los bordes, o te obligará a revisar archivo por archivo para decidir cuál <code>#222222</code> era botón y cuál era texto. Cuando cada pieza apunta a un token con nombre de función (<code>--color-texto</code>, <code>--color-borde</code>, <code>--color-accion</code>), aunque hoy valgan lo mismo, mañana puedes cambiar solo <code>--color-accion</code> con precisión quirúrgica.</p>
      </div>
    </details>
  </div>
)}

{paso === 'miralo' && (
  <div class="dv-anotadas">
    <Anotada
      veredicto="mal"
      rotulo="19 grises al azar y 14 medidas sueltas"
      notas={[
        {
          ...pct(330, 56),
          titulo: 'Proliferación de grises casi idénticos',
          texto: 'Conviven #666666, #6b6b6b, #707070 y #737373. Nadie sabe cuál es el oficial ni cuál cumple el contraste mínimo.',
          zona: zona(16, 18, 328, 76),
        },
        {
          ...pct(330, 148),
          titulo: 'Márgenes nacidos a ojo',
          texto: 'Cada tarjeta usa 13 px, 15 px, 17 px o 21 px de espacio interior según quién la escribió ese día.',
          zona: zona(16, 104, 328, 82),
        },
        {
          ...pct(330, 232),
          titulo: 'Imposible cambiar de tema',
          texto: 'Al intentar crear un modo de alto contraste, hay que auditar cientos de líneas con números mágicos sin contexto.',
          zona: zona(16, 194, 328, 70),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Hoja de estilos caótica con diecinueve valores hexadecimales parecidos y márgenes irregulares de 13, 15, 17 y 21 píxeles.">
        <rect width={W} height={H} fill={PAPEL} />
        <rect x="18" y="18" width="324" height="74" fill="#f7f7f5" stroke="#d4d4d4" stroke-width="1.5" />
        <text x="28" y="36" font-family={SANS} font-size="10" font-weight="700" fill={ROJO}>VALORES SUELTOS EN EL CÓDIGO (19 GRISES)</text>
        <text x="28" y="54" font-family={SANS} font-size="10.5" fill={T}>color: #666; · color: #6b6b6b; · border: #707070;</text>
        <text x="28" y="72" font-family={SANS} font-size="10.5" fill={T}>color: #737373; · background: #fafafa; · #f4f4f4;</text>

        <rect x="18" y="106" width="154" height="78" fill={PAPEL} stroke="#666666" stroke-width="1.5" />
        <text x="31" y="127" font-family={SANS} font-size="11" font-weight="700" fill={T}>Tarjeta A (pad: 13 px)</text>
        <text x="31" y="145" font-family={SERIF} font-size="11" fill="#6b6b6b">Subtítulo en #6b6b6b</text>
        <rect x="31" y="154" width="84" height="20" fill="#292929" />
        <text x="73" y="168" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={PAPEL}>Botón #292929</text>

        <rect x="188" y="106" width="154" height="78" fill="#fcfcfc" stroke="#707070" stroke-width="2" />
        <text x="209" y="131" font-family={SANS} font-size="11.5" font-weight="700" fill="#1e1e1e">Tarjeta B (pad: 21 px)</text>
        <text x="209" y="149" font-family={SERIF} font-size="11" fill="#737373">Subtítulo en #737373</text>
        <rect x="209" y="156" width="84" height="20" fill="#111111" />
        <text x="251" y="170" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={PAPEL}>Botón #111111</text>

        <rect x="18" y="198" width="324" height="64" fill="#fbe9e7" stroke={ROJO} stroke-width="1.5" />
        <text x="30" y="220" font-family={SANS} font-size="11" font-weight="700" fill={ROJO}>14 medidas de margen sin relación: 7, 11, 13, 15, 19, 21 px…</text>
        <text x="30" y="240" font-family={SERIF} font-size="11.5" fill={T}>Cada pantalla parece diseñada por un equipo distinto.</text>
      </svg>
    </Anotada>

    <Anotada
      veredicto="bien"
      rotulo="4 tokens de color y una escala de 5 espacios"
      notas={[
        {
          ...pct(330, 52),
          titulo: 'Vocabulario semántico acotado',
          texto: 'Cuatro tokens de color (--tinta, --texto, --secundario, --amarillo) cubren todas las jerarquías con contraste verificado.',
          zona: zona(16, 18, 328, 76),
        },
        {
          ...pct(330, 146),
          titulo: 'Consistencia entre piezas',
          texto: 'Ambas tarjetas leen --espacio-m (16 px) y --tinta (#222222). Si cambia el token, las dos se ajustan a la vez.',
          zona: zona(16, 104, 328, 82),
        },
        {
          ...pct(330, 232),
          titulo: 'Escala de espaciado predecible',
          texto: 'Cinco peldaños con nombre (4, 8, 16, 24 y 40 px) eliminan las dudas al maquetar cualquier bloque nuevo.',
          zona: zona(16, 194, 328, 70),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Sistema gobernado por cuatro tokens semánticos de color y cinco tokens de espacio interior perfectamente alineados.">
        <rect width={W} height={H} fill={PAPEL} />
        <rect x="18" y="18" width="324" height="74" fill={FONDO} stroke={T} stroke-width="1.5" />
        <text x="28" y="36" font-family={SANS} font-size="10" font-weight="700" fill={T}>TOKENS DEL SISTEMA (4 COLORES · 5 ESPACIOS)</text>
        <text x="28" y="54" font-family={SANS} font-size="10.5" fill={T}>--tinta: #222222 · --texto: #444444 · --secundario: #6f6f6f</text>
        <text x="28" y="72" font-family={SANS} font-size="10.5" fill={T}>--espacio-xs: 4 px · -s: 8 px · -m: 16 px · -l: 24 px · -xl: 40 px</text>

        <rect x="18" y="106" width="154" height="78" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="34" y="128" font-family={SANS} font-size="11" font-weight="700" fill={T}>Tarjeta A (--espacio-m)</text>
        <text x="34" y="146" font-family={SERIF} font-size="11" fill={G}>Usa --secundario</text>
        <rect x="34" y="154" width="90" height="20" fill={T} />
        <text x="79" y="168" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={AMARILLO}>Usa --tinta</text>

        <rect x="188" y="106" width="154" height="78" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="204" y="128" font-family={SANS} font-size="11" font-weight="700" fill={T}>Tarjeta B (--espacio-m)</text>
        <text x="204" y="146" font-family={SERIF} font-size="11" fill={G}>Usa --secundario</text>
        <rect x="204" y="154" width="90" height="20" fill={T} />
        <text x="249" y="168" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={AMARILLO}>Usa --tinta</text>

        <rect x="18" y="198" width="324" height="64" fill={AMARILLO} stroke={T} stroke-width="1.5" />
        <text x="30" y="220" font-family={SANS} font-size="9.8" font-weight="900" fill={T}>1 cambio en :root actualiza 100 pantallas sin buscar ni reemplazar</text>
        <text x="30" y="240" font-family={SERIF} font-size="11.5" fill={T}>La decisión se toma una vez y se propaga con nombre propio.</text>
      </svg>
    </Anotada>
  </div>
)}

{paso === 'pruebalo' && (
  <Instrumento
    id={lab}
    titulo="Consola de dos capas · tokens primitivos y tokens semánticos"
    consigna="A la izquierda ves el árbol de tokens (primitivos y semánticos); a la derecha, una mini interfaz con cabecera, tarjeta, campo de formulario y alerta que los consume en vivo. Reasigna el tema o cambia un token para ver cómo se propaga."
    nota="Fija el tema claro como A y cámbialo a Alto contraste o Editorial en B: verás que los cuatro componentes no cambian su estructura, solo el valor al que apuntan sus tokens semánticos."
  >
    <svg slot="escenario" viewBox="0 0 640 320" role="img" aria-label="Consola de tokens conectada a una interfaz compuesta por cabecera, tarjeta de evento, formulario y alerta de estado.">
      <rect width="640" height="320" fill={FONDO} />
      <rect x="20" y="20" width="230" height="280" fill={PAPEL} stroke={T} stroke-width="1.5" />
      <text x="34" y="44" font-family={SANS} font-size="11" font-weight="700" fill={T}>CAPA SEMÁNTICA (:root)</text>
      <text x="34" y="70" font-family={SANS} font-size="10.5" fill={TXT}>--superficie-papel → #ffffff</text>
      <text x="34" y="92" font-family={SANS} font-size="10.5" fill={TXT}>--tinta-principal → #222222</text>
      <text x="34" y="114" font-family={SANS} font-size="10.5" fill={TXT}>--acento-estado → #eeff41</text>
      <text x="34" y="136" font-family={SANS} font-size="10.5" fill={TXT}>--espacio-interior → 16 px</text>
      <rect x="270" y="20" width="350" height="280" fill={PAPEL} stroke={T} stroke-width="1.5" />
      <text x="290" y="50" font-family={SANS} font-size="14" font-weight="900" fill={T}>Vista previa de los 4 bloques</text>
      <rect x="290" y="68" width="310" height="72" fill={AMARILLO} stroke={T} stroke-width="1.5" />
      <text x="306" y="96" font-family={SANS} font-size="12" font-weight="700" fill={T}>Alerta gobernada por --acento-estado</text>
    </svg>

    <Guia slot="guia" pasos={pasos} final="Guía completada. Combina temas, cambia el radio de borde o activa las etiquetas de tokens en «Más controles» para inspeccionar qué variable gobierna cada pieza." />

    <Opciones
      lab={lab}
      variable="tema"
      etiqueta="Tema activo (reasignación semántica)"
      valor="claro"
      opciones={[
        { valor: 'claro', texto: 'Claro' },
        { valor: 'contraste', texto: 'Alto contraste' },
        { valor: 'editorial', texto: 'Editorial' },
      ]}
      ayuda="Cambia a qué valores primitivos apuntan --superficie-papel y --tinta-principal sin tocar los componentes."
    />

    <Opciones
      lab={lab}
      variable="acento"
      etiqueta="Token --acento-estado apunta a"
      valor="amarillo"
      opciones={[
        { valor: 'amarillo', texto: 'Amarillo (#eeff41)' },
        { valor: 'terracota', texto: 'Terracota (#b3261e)' },
        { valor: 'salvia', texto: 'Verde salvia (#2e6f40)' },
      ]}
      ayuda="Observa cómo cambian a la vez la insignia de estado, el foco del campo y el borde de la alerta."
    />

    <Deslizador
      lab={lab}
      variable="espacio"
      etiqueta="Token --espacio-interior"
      min={8}
      max={24}
      paso={4}
      valor={16}
      unidad="px"
      ayuda="Gobierna el margen interno de la tarjeta, del formulario y de la alerta desde un solo lugar."
    />

    <Fragment slot="avanzados">
      <Deslizador
        lab={lab}
        variable="radio"
        etiqueta="Token --radio-borde"
        min={0}
        max={12}
        paso={2}
        valor={0}
        unidad="px"
        ayuda="Propaga el redondeo a tarjetas, botones, entradas de texto e insignias."
      />
      <Interruptor
        lab={lab}
        variable="infiltrado"
        etiqueta="Infiltrar un valor bruto (#222222) sin token"
        ayuda="Fija a fuego #222222 en el subtítulo del formulario para ver cómo falla al cambiar al tema de alto contraste."
      />
      <Interruptor
        lab={lab}
        variable="rayosx"
        etiqueta="Mostrar qué token lee cada pieza"
        activo={true}
        ayuda="Superpone las etiquetas de los tokens semánticos sobre la interfaz."
      />
    </Fragment>

    <Fragment slot="pruebas">
      <button type="button" class="dv-boton" data-preset='{"tema":"claro","acento":"amarillo","espacio":16,"radio":0,"infiltrado":false}'>Sistema canónico (claro)</button>
      <button type="button" class="dv-boton" data-preset='{"tema":"contraste","acento":"amarillo","espacio":16,"radio":0,"infiltrado":false}'>Modo alto contraste limpio</button>
      <button type="button" class="dv-boton" data-preset='{"tema":"contraste","acento":"amarillo","espacio":16,"radio":0,"infiltrado":true}'>Fuga de valor bruto en modo oscuro</button>
      <button type="button" class="dv-boton" data-preset='{"tema":"editorial","acento":"terracota","espacio":20,"radio":4,"infiltrado":false}'>Edición revista cálida</button>
    </Fragment>
  </Instrumento>
)}

{paso === 'errores' && (
  <div class="dv-especimenes">
    <Instrumento
      id={`${lab}-e1`}
      titulo="Nombra el token por su función, no por su apariencia"
      comparar={false}
      consigna="El botón principal usa un token llamado «--azul-oscuro». Cuando la revista cambia su identidad a terracota o entra en modo oscuro, el nombre miente o obliga a buscarlo en todos los archivos. Cámbialo a un nombre semántico."
    >
      <div slot="escenario" style={`padding:14px 16px;font-family:${SANS};color:${T};`}>
        <p style="margin:0;font-weight:700;">--azul-oscuro: #b3261e (contradicción semántica)</p>
      </div>
      <Opciones
        lab={`${lab}-e1`}
        variable="nombre"
        etiqueta="Cómo nombras el token del botón principal"
        valor="apariencia"
        opciones={[
          { valor: 'apariencia', texto: '--azul-oscuro (apariencia)' },
          { valor: 'posicion', texto: '--color-abajo-derecha (posición)' },
          { valor: 'funcion', texto: '--color-accion-primaria (función)' },
        ]}
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e2`}
      titulo="Consolida 12 medidas casi iguales en una escala de 5 tokens"
      comparar={false}
      consigna="Tres tarjetas contiguas tienen márgenes de 11 px, 15 px y 19 px nacidos al azar. Reduce la proliferación conectándolas a una escala de 5 tokens de espaciado."
    >
      <div slot="escenario" style={`padding:14px 16px;font-family:${SANS};color:${T};`}>
        <p style="margin:0;">12 medidas sueltas (7, 9, 11, 13, 15, 17, 19, 21 px…)</p>
      </div>
      <Deslizador
        lab={`${lab}-e2`}
        variable="consolidacion"
        etiqueta="Nivel de consolidación en tokens de espacio"
        min={0}
        max={100}
        paso={25}
        valor={0}
        unidad="%"
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e3`}
      titulo="Caza el valor bruto infiltrado que rompe el cambio de tema"
      comparar={false}
      consigna="En modo de alto contraste, dos tarjetas se leen bien pero la tercera desaparece porque alguien escribió color: #222222 en vez de usar var(--tinta-principal). Sustituye el valor infiltrado por el token."
    >
      <div slot="escenario" style={`padding:14px 16px;font-family:${SANS};color:${T};`}>
