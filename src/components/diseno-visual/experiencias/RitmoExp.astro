    descripcion="Cinco rondas sobre pulso vertical, sangría frente a espacio entre párrafos, pausas de articulación y sincronía de líneas de base."
  />
)}

<script>
  import { conectar, svg } from '../../../lib/diseno-visual/estado';
  import { guiar } from '../../../lib/diseno-visual/guia';
  import { jugar, barajar, type Ronda } from '../../../lib/diseno-visual/juego';

  const lab = 'ritmo-tipografico';

  const SANS = 'Roboto, Helvetica, Arial, sans-serif';
  const SERIF = "'PT Serif', Georgia, serif";
  const TINTA = '#222222';
  const SEC = '#6f6f6f';
  const COTA = '#b3261e';
  const AMARILLO = '#eeff41';

  // ── 1. Instrumento principal: ritmo-tipografico ─────────────────
  type E = {
    unidad: number;
    separacion: string;
    frecuencia: string;
    rejilla: boolean;
    mancha: boolean;
  };

  function pintar(destino: HTMLElement, e: E) {
    const W = Math.max(destino.clientWidth, 300);
    const u = e.unidad;
    const top = 46;
    const totalLineas = 12;
    const H = top + totalLineas * u + 26;

    const raiz = svg('svg', { viewBox: `0 0 ${W} ${H}`, width: W, height: H, role: 'img' });
    raiz.setAttribute(
      'aria-label',
      `Doble columna con unidad base de ${u} píxeles, separación ${e.separacion}, frecuencia ${e.frecuencia} y rejilla ${e.rejilla ? 'activa' : 'inactiva'}.`,
    );
    raiz.append(svg('rect', { width: W, height: H, fill: '#fbfbf9' }));

    const padX = W < 500 ? 16 : 28;
    const gap = W < 500 ? 16 : 28;
    const colW = (W - padX * 2 - gap) / 2;
    const x1 = padX;
    const x2 = padX + colW + gap;

    const okRitmo = e.separacion !== 'ambas' && e.frecuencia !== 'muro' && e.rejilla;
    const etq = svg('text', {
      x: padX,
      y: 24,
      'font-family': SANS,
      'font-size': 11,
      'font-weight': 700,
      fill: okRitmo ? TINTA : COTA,
    });
    etq.textContent = `PULSO BASE: ${u} PX · ${
      e.rejilla ? 'ALINEADO A REJILLA' : 'FUERA DE REJILLA (DESFASE ENTRE COLUMNAS)'
    }`;
    raiz.append(etq);

    // Marco y líneas de la rejilla base
    raiz.append(
      svg('rect', {
        x: padX - 8,
        y: top - 10,
        width: W - (padX - 8) * 2,
        height: totalLineas * u + 20,
        fill: '#ffffff',
        stroke: okRitmo ? TINTA : '#d4d4ce',
        'stroke-width': 1.4,
      }),
    );

    for (let i = 0; i <= totalLineas; i++) {
      const y = top + i * u;
      raiz.append(
        svg('line', {
          x1: padX - 6,
          y1: y,
          x2: W - padX + 6,
          y2: y,
          stroke: e.rejilla ? '#e6e6de' : '#f1f1ec',
          'stroke-width': 1,
        }),
      );
    }

    const fs = Math.max(9.5, Math.min(12.5, u * 0.56));
    const usaSangria = e.separacion === 'sangria' || e.separacion === 'ambas';
    const usaHueco = e.separacion === 'espacio' || e.separacion === 'ambas';

    function dibujarLinea(x: number, y: number, texto: string, opts?: { sangria?: boolean; titulo?: boolean; cita?: boolean; desfase?: boolean }) {
      const dx = opts?.sangria ? 18 : opts?.cita ? 12 : 0;
      const wMax = colW - dx - 6;
      if (opts?.cita) {
        raiz.append(svg('line', { x1: x + 2, y1: y - fs, x2: x + 2, y2: y + 3, stroke: TINTA, 'stroke-width': 2.2 }));
      }
      if (e.mancha) {
        const frac = opts?.titulo ? 0.62 : Math.min(0.96, texto.length / 36);
        raiz.append(
          svg('rect', {
            x: x + dx,
            y: y - fs * 0.78,
            width: Math.max(36, wMax * frac),
            height: opts?.titulo ? fs * 0.95 : fs * 0.62,
            fill: opts?.titulo ? TINTA : opts?.cita ? '#555555' : '#3a3a3a',
            opacity: opts?.cita ? 0.75 : 0.9,
          }),
        );
      } else {
        const t = svg('text', {
          x: x + dx,
          y,
          'font-family': opts?.titulo ? SANS : SERIF,
          'font-size': opts?.titulo ? fs * 1.06 : fs,
          'font-weight': opts?.titulo ? 900 : 400,
          'font-style': opts?.cita ? 'italic' : 'normal',
          fill: opts?.desfase ? COTA : TINTA,
        });
        t.textContent = texto;
        raiz.append(t);
      }
    }

    // Construir renglones de la columna 1
    if (e.frecuencia === 'muro') {
      const frases = [
        'Cuando todos los renglones se suceden',
        'sin pausas ni cambios de jerarquía,',
        'la columna se convierte en un muro',
        'compacto donde cuesta orientarse.',
        'La vista recorre línea tras línea',
        'sin encontrar un solo punto de apoyo',
        'para descansar o retomar la lectura',
        'si alguien interrumpe un momento.',
        'Aunque la línea base sea regular,',
        'la repetición sin variaciones termina',
        'adormeciendo la atención del lector.',
      ];
      frases.forEach((f, i) => {
        const y = top + (i + 1) * u;
        dibujarLinea(x1, y, f, { sangria: usaSangria && (i === 4 || i === 8) });
      });
    } else if (e.frecuencia === 'pausado') {
      const p1 = ['El pulso regular de la línea base', 'sostiene el recorrido horizontal', 'de cada párrafo con estabilidad.'];
      const p2 = ['Al cambiar de idea, una pausa', 'clara —sangría o un renglón libre—', 'marca el inicio del bloque nuevo.'];
      const p3 = ['Sin embargo, en textos extensos', 'hace falta además algún acento', 'que articule las secciones.'];
      let cursor = top + u;
      p1.forEach((f) => {
        dibujarLinea(x1, cursor, f);
        cursor += u;
      });
      if (usaHueco) cursor += e.rejilla ? u : u * 0.65;
      if (e.separacion === 'ambas') {
        raiz.append(svg('rect', { x: x1, y: cursor - u + 3, width: colW, height: u - 4, fill: COTA, opacity: 0.14 }));
      }
      p2.forEach((f, idx) => {
        dibujarLinea(x1, cursor, f, { sangria: usaSangria && idx === 0, desfase: !e.rejilla });
        cursor += u;
      });
      if (usaHueco) cursor += e.rejilla ? u : u * 0.65;
      p3.forEach((f, idx) => {
        if (cursor <= top + totalLineas * u) {
          dibujarLinea(x1, cursor, f, { sangria: usaSangria && idx === 0, desfase: !e.rejilla });
          cursor += u;
        }
      });
    } else {
      // articulado
      const p1 = ['El pulso regular del renglón base', 'sostiene la lectura línea a línea', 'como el compás en una partitura.'];
      let cursor = top + u;
      p1.forEach((f) => {
        dibujarLinea(x1, cursor, f);
        cursor += u;
      });
      if (usaHueco) cursor += e.rejilla ? u : u * 0.6;
      const p2 = ['Cada párrafo añade una respiración', 'medida sin romper la columna.'];
      p2.forEach((f, idx) => {
        dibujarLinea(x1, cursor, f, { sangria: usaSangria && idx === 0, desfase: !e.rejilla });
        cursor += u;
      });
      // Intertítulo: en rejilla ocupa exactamente 2u (1u de espacio arriba + 1u de línea)
      cursor += e.rejilla ? u : u * 0.45;
      raiz.append(
        svg('rect', {
          x: x1,
          y: cursor - fs * 0.85,
          width: Math.min(colW, 180),
          height: fs * 1.15,
          fill: AMARILLO,
          opacity: 0.55,
        }),
      );
      dibujarLinea(x1, cursor, '1. Variación dentro del orden', { titulo: true, desfase: !e.rejilla });
      cursor += e.rejilla ? u : u * 0.75;
      const p3 = ['Después del subtítulo, el cuerpo', 'vuelve a pisar la línea de base', 'en sincronía con la otra columna.'];
      p3.forEach((f, idx) => {
        if (cursor <= top + totalLineas * u) {
          dibujarLinea(x1, cursor, f, { sangria: usaSangria && idx === 0, desfase: !e.rejilla });
          cursor += u;
        }
      });
    }

    // Columna 2 (para comprobar sincronía horizontal con la columna 1)
    let c2 = top + u;
    const der1 = ['En la segunda columna los renglones', 'comparten el mismo pulso vertical', 'para evitar escalones en el centro.'];
    der1.forEach((f) => {
      dibujarLinea(x2, c2, f);
      c2 += u;
    });

    if (e.frecuencia === 'articulado') {
      c2 += e.rejilla ? u : u * 0.55;
      const cita = ['«La regularidad sostiene la vista;', 'la variación despierta el interés.»'];
      cita.forEach((f) => {
        dibujarLinea(x2, c2, f, { cita: true, desfase: !e.rejilla });
        c2 += u;
      });
      c2 += e.rejilla ? u : u * 0.65;
    } else if (usaHueco && e.frecuencia !== 'muro') {
      c2 += e.rejilla ? u : u * 0.65;
    }

    const der2 = [
      'Al retomar el texto normal, las',
      'líneas de base de ambas columnas',
      'coinciden de lado a lado cuando',
      'los blancos usan múltiplos exactos',
      'de la unidad base del documento.',
    ];
    der2.forEach((f, idx) => {
      if (c2 <= top + totalLineas * u) {
        dibujarLinea(x2, c2, f, { sangria: usaSangria && idx === 0 && e.frecuencia !== 'muro', desfase: !e.rejilla });
        c2 += u;
      }
    });

    destino.replaceChildren(raiz);
  }

  function describir(e: E): string {
    if (e.separacion === 'ambas') {
      return `Estás aplicando <b class="dv-cifra">sangría y espacio vertical a la vez</b>. Ambas señales dicen «nuevo párrafo»: usarlas juntas muerde la esquina del bloque y entorpece el ritmo.`;
    }
    if (!e.rejilla) {
      return `Con la rejilla desactivada, los espacios de títulos y citas usan fracciones sueltas en vez de múltiplos de <b class="dv-cifra">${e.unidad} px</b>: las dos columnas pierden la alineación horizontal.`;
    }
    if (e.frecuencia === 'muro') {
      return `Pulso constante de <b class="dv-cifra">${e.unidad} px</b>, pero en <b class="dv-cifra">muro continuo</b>: hay repetición mecánica sin pausas ni jerarquía que articulen la página.`;
    }
    if (e.frecuencia === 'pausado') {
      const modoSep = e.separacion === 'sangria' ? 'sangría de primera línea' : `un renglón completo (${e.unidad} px)`;
      return `Párrafos separados mediante <b class="dv-cifra">${modoSep}</b> sobre una rejilla de ${e.unidad} px. Añade «Compás articulado» para ver cómo entran en juego los intertítulos y las citas.`;
    }
    return `Ritmo vivo y sincronizado: todos los bloques, intertítulos y citas suman múltiplos exactos de <b class="dv-cifra">${e.unidad} px</b> y las dos columnas encajan en la misma línea de base.`;
  }

  for (const raiz of document.querySelectorAll<HTMLElement>(`[data-lab="${lab}"]`)) {
    guiar<E>(raiz, [
      (e) => e.frecuencia === 'muro' && e.separacion === 'sangria',
      (e) => e.separacion === 'ambas',
      (e) => e.separacion === 'espacio' && e.frecuencia === 'articulado',
      (e) => !e.rejilla,
    ]);
    conectar<E>({ raiz, pintar, describir });
  }

  // ── 2. Especímenes de error ────────────────────────────────────
  type E1 = { metodo: string };
  function pintarE1(d: HTMLElement, e: E1) {
    const indent = e.metodo === 'ambos' || e.metodo === 'sangria' ? '2em' : '0';
    const mb = e.metodo === 'ambos' ? '18px' : e.metodo === 'espacio' ? '12px' : '0';
    const borde = e.metodo === 'ambos' ? COTA : '#222';
    d.innerHTML = `
      <div style="padding:16px 18px;font-family:${SERIF};font-size:13px;line-height:1.5;color:#222;border-left:3px solid ${borde};">
        <p style="margin:0 0 ${mb};">El primer párrafo introduce la tesis general sin sangría porque abre la sección y su punto de partida ya está claro.</p>
        <p style="margin:0 0 ${mb};text-indent:${indent};">El segundo párrafo desarrolla el argumento. Solo necesita una señal —o sangría o espacio vertical— para distinguirse del anterior.</p>
        <p style="margin:0;text-indent:${indent};">El tercer párrafo cierra la demostración manteniendo el mismo pulso que eligió el diseñador.</p>
      </div>`;
  }
  function describirE1(e: E1) {
    if (e.metodo === 'ambos') {
      return '<b class="dv-cifra">Señal duplicada</b>: sumar sangría de 2 em y además 18 px de hueco vertical abre escalones vacíos en cada párrafo.';
    }
    if (e.metodo === 'sangria') {
      return '<b class="dv-cifra">Tradición editorial impresa</b>: la sangría sola mantiene la mancha compacta y continua sin perder la división de párrafos.';
    }
    return '<b class="dv-cifra">Convención de pantalla</b>: un espacio vertical medido separa los bloques manteniendo limpio el eje izquierdo.';
  }

  type E2 = { nivel: string };
  function pintarE2(d: HTMLElement, e: E2) {
    if (e.nivel === 'muro') {
      d.innerHTML = `
        <div style="padding:16px 18px;font-family:${SERIF};font-size:12.5px;line-height:1.48;color:#222;">
          <p style="margin:0;">Las cubiertas vegetales retienen hasta el sesenta por ciento del agua de lluvia y amortiguan el calor urbano durante el verano. Para instalarlas sobre una losa existente conviene verificar primero la carga estructural disponible, colocar una membrana impermeable continua con raíces bloqueadas, extender una capa drenante liviana de arcilla expandida y elegir especies crasas de bajo riego que resistan tanto la insolación directa como las semanas secas sin mantenimiento mecánico.</p>
        </div>`;
      return;
    }
    if (e.nivel === 'parrafos') {
      d.innerHTML = `
        <div style="padding:16px 18px;font-family:${SERIF};font-size:12.5px;line-height:1.48;color:#222;">
          <p style="margin:0 0 10px;">Las cubiertas vegetales retienen hasta el sesenta por ciento del agua de lluvia y amortiguan el calor urbano durante el verano.</p>
          <p style="margin:0;">Para instalarlas sobre una losa existente conviene verificar primero la carga estructural disponible, colocar una membrana impermeable continua, extender una capa drenante liviana y elegir especies de bajo riego.</p>
        </div>`;
      return;
    }
    d.innerHTML = `
      <div style="padding:16px 18px;font-family:${SERIF};font-size:12.5px;line-height:1.48;color:#222;">
        <p style="margin:0 0 10px;">Las cubiertas vegetales retienen hasta el 60 % del agua de lluvia y amortiguan el calor urbano durante el verano.</p>
        <p style="margin:0 0 6px;font-family:${SANS};font-size:11px;font-weight:900;letter-spacing:0.04em;color:#222;">REQUISITOS DE INSTALACIÓN</p>
        <ul style="margin:0;padding-left:18px;">
          <li>Verificar la carga estructural de la losa.</li>
          <li>Colocar membrana impermeable y capa drenante liviana.</li>
          <li>Sembrar especies crasas resistentes a la sequía.</li>
        </ul>
      </div>`;
  }
  function describirE2(e: E2) {
    if (e.nivel === 'muro') return 'El texto entero se funde en <b class="dv-cifra">un único bloque denso</b> que oculta la enumeración técnica.';
    if (e.nivel === 'parrafos') return 'Separar los dos párrafos da una primera pausa, aunque los tres pasos técnicos siguen escondidos dentro de una oración larga.';
    return '<b class="dv-cifra">Ritmo articulado</b>: el párrafo presenta la idea, el intertítulo anuncia el cambio y la lista ordena los tres requisitos.';
  }

  type E3 = { altoSub: number };
  function pintarE3(d: HTMLElement, e: E3) {
    const casado = e.altoSub === 40;
    const desfase = e.altoSub - 40;
    d.innerHTML = `
      <div style="padding:16px 18px;font-family:${SERIF};font-size:12.5px;color:#222;background:repeating-linear-gradient(to bottom, #ffffff 0, #ffffff 19px, #ecece4 19px, #ecece4 20px);">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div>
            <div style="height:20px;line-height:20px;">Primera línea sobre la rejilla de 20 px.</div>
            <div style="height:${e.altoSub}px;display:flex;align-items:flex-end;font-family:${SANS};font-size:11px;font-weight:900;color:${casado ? '#222' : COTA};">
              Subtítulo (${e.altoSub} px totales)
            </div>
            <div style="height:20px;line-height:20px;color:${casado ? '#222' : COTA};">Renglón posterior al subtítulo.</div>
            <div style="height:20px;line-height:20px;color:${casado ? '#222' : COTA};">Cierre de la primera columna.</div>
          </div>
          <div>
            <div style="height:20px;line-height:20px;">Primera línea de la columna vecina.</div>
            <div style="height:20px;line-height:20px;">Segunda línea continua en 20 px.</div>
            <div style="height:20px;line-height:20px;">Tercera línea continua en 20 px.</div>
            <div style="height:20px;line-height:20px;font-weight:${casado ? '700' : '400'};">Renglón que debe empatar →</div>
            <div style="height:20px;line-height:20px;">Cierre de la segunda columna.</div>
          </div>
        </div>
      </div>`;
    void desfase;
  }
  function describirE3(e: E3) {
    const diff = e.altoSub - 40;
    if (diff === 0) {
      return '<b class="dv-cifra">40 px (2 × 20 px)</b>: el subtítulo ocupa exactamente dos renglones base y las dos columnas vuelven a pisar la misma línea.';
    }
    return `Con <b class="dv-cifra">${e.altoSub} px</b> hay un desfase de ${Math.abs(diff)} px respecto al múltiplo de 40 px: los renglones de la izquierda quedan desnivelados frente a la derecha.`;
  }

  const especimenes: [string, (d: HTMLElement, e: never) => void, (e: never) => string][] = [
    [`${lab}-e1`, pintarE1 as never, describirE1 as never],
    [`${lab}-e2`, pintarE2 as never, describirE2 as never],
    [`${lab}-e3`, pintarE3 as never, describirE3 as never],
  ];
  for (const [id, p, desc] of especimenes) {
    for (const raiz of document.querySelectorAll<HTMLElement>(`[data-lab="${id}"]`)) {
      conectar({ raiz, pintar: p, describir: desc });
    }
  }

  // ── 3. Juego de 5 rondas ───────────────────────────────────────
  function rondaSenalParrafo(): Ronda {
    const ops = barajar([
      {
        texto: 'Párrafos separados por 1 renglón de espacio vertical, sin sangría',
        describir: 'Tres párrafos alineados al margen izquierdo con un espacio vertical limpio entre ellos.',
        es: true,
        html: `<div style="padding:10px 12px;background:#fff;border:1.5px solid #222;text-align:left;font-family:${SERIF};font-size:11.5px;line-height:1.45;color:#222;">
          <p style="margin:0 0 10px;">El primer párrafo establece el pulso de lectura sobre el eje izquierdo.</p>
          <p style="margin:0;">El segundo párrafo se separa con un salto vertical medido, sin añadir sangría redundante.</p>
        </div>`,
      },
      {
        texto: 'Párrafos con sangría profunda de 3 em y además un hueco grande entre bloques',
        describir: 'Párrafos que combinan sangría exagerada y salto en blanco al mismo tiempo.',
        es: false,
        html: `<div style="padding:10px 12px;background:#fff;border:1px solid #ccc;text-align:left;font-family:${SERIF};font-size:11.5px;line-height:1.45;color:#222;">
          <p style="margin:0 0 18px;text-indent:2.6em;">El primer párrafo sangra su inicio y deja además un hueco enorme debajo.</p>
          <p style="margin:0;text-indent:2.6em;">El segundo vuelve a sangrar después del hueco, duplicando la misma señal.</p>
        </div>`,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: '¿Cuál de los dos bloques marca el cambio de párrafo con limpieza y sin redundancia?',
      opciones: ops.map((o) => ({
        texto: o.texto,
        describir: o.describir,
        pintar: (d) => {
          d.innerHTML = o.html;
        },
      })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'La sangría de primera línea y el espacio vertical entre párrafos cumplen exactamente la misma función. Elegir una sola mantiene limpio el ritmo vertical.',
      repaso: 'Sangría frente a espacio vertical',
    };
  }

  function rondaMuroVsCompas(): Ronda {
    const ops = barajar([
      {
        texto: 'Texto articulado con párrafo introductorio, intertítulo y cita en bloque',
        describir: 'Columna donde alternan un párrafo, un intertítulo en negrita y una cita con filete lateral.',
        es: true,
        html: `<div style="padding:10px 12px;background:#fff;border:1.5px solid #222;text-align:left;font-family:${SERIF};font-size:11px;line-height:1.4;color:#222;">
          <p style="margin:0 0 8px;">La alternancia de bloques permite anticipar la estructura del texto antes de leer cada frase.</p>
          <strong style="display:block;font-family:${SANS};font-size:10px;margin-bottom:4px;">1. PAUSA Y VARIACIÓN</strong>
          <blockquote style="margin:0;padding-left:8px;border-left:2px solid #222;font-style:italic;color:#444;">«El ritmo nace de combinar orden y contraste.»</blockquote>
        </div>`,
      },
      {
        texto: 'Veinte renglones corridos del mismo estilo sin un solo punto y aparte ni subtítulo',
        describir: 'Bloque macizo de texto continuo sin divisiones visibles.',
        es: false,
        html: `<div style="padding:10px 12px;background:#fff;border:1px solid #ccc;text-align:left;font-family:${SERIF};font-size:10.5px;line-height:1.35;color:#222;">
          Cuando una página entera carece de puntos y aparte, de intertítulos o de listas, toda la superficie tiene la misma densidad gris. Quien intenta consultar un dato no encuentra puertas de entrada ni lugares donde descansar la vista al cambiar de idea.
        </div>`,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Según Emil Ruder, ¿cuál de las dos composiciones transforma la repetición uniforme en un ritmo vivo?',
      opciones: ops.map((o) => ({
        texto: o.texto,
        describir: o.describir,
        pintar: (d) => {
          d.innerHTML = o.html;
        },
      })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'La simple repetición de líneas iguales produce monotonía; el ritmo aparece cuando ese pulso base se articula con pausas, intertítulos y cambios controlados de densidad.',
      repaso: 'Repetición frente a ritmo articulado',
    };
  }

  function rondaRejillaBase(): Ronda {
    const ops = barajar([
      {
        texto: 'El subtítulo más sus márgenes suma 48 px (exactamente 2 renglones de 24 px)',
        describir: 'Dos columnas cuyos renglones vuelven a coincidir después de un subtítulo de 48 px.',
        es: true,
        html: `<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:10px 12px;background:repeating-linear-gradient(to bottom,#fff 0,#fff 19px,#eaeae2 19px,#eaeae2 20px);border:1.5px solid #222;text-align:left;font-family:${SERIF};font-size:11px;line-height:20px;color:#222;">
          <div>
            <div>Renglón base 1</div>
            <div style="height:40px;display:flex;align-items:flex-end;font-family:${SANS};font-weight:900;font-size:10.5px;">SUBTÍTULO (2 × 20 PX)</div>
            <div>Empata con la derecha →</div>
          </div>
          <div>
            <div>Renglón base 1</div>
            <div>Renglón base 2</div>
            <div>Renglón base 3</div>
            <div>← Misma línea de base</div>
          </div>
        </div>`,
      },
      {
        texto: 'El subtítulo más sus márgenes suma 31 px sobre un renglón base de 24 px',
        describir: 'Dos columnas donde el subtítulo deja desnivelados todos los renglones siguientes.',
        es: false,
        html: `<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:10px 12px;background:repeating-linear-gradient(to bottom,#fff 0,#fff 19px,#eaeae2 19px,#eaeae2 20px);border:1px solid #ccc;text-align:left;font-family:${SERIF};font-size:11px;line-height:20px;color:#222;">
          <div>
            <div>Renglón base 1</div>
            <div style="height:29px;display:flex;align-items:flex-end;font-family:${SANS};font-weight:900;font-size:10.5px;color:${COTA};">SUBTÍTULO (29 PX)</div>
            <div style="color:${COTA};">Queda desfasado 9 px →</div>
          </div>
          <div>
            <div>Renglón base 1</div>
            <div>Renglón base 2</div>
            <div>Renglón base 3</div>
            <div>← No coincide</div>
          </div>
        </div>`,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Tu cuerpo de texto tiene un interlineado base de 24 px. ¿Qué medida para el bloque del intertítulo mantiene casadas dos columnas paralelas?',
      opciones: ops.map((o) => ({
        texto: o.texto,
        describir: o.describir,
        pintar: (d) => {
          d.innerHTML = o.html;
        },
      })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Como explica Bringhurst, cuando el alto del intertítulo sumado a sus espacios superior e inferior equivale a un múltiplo entero del renglón base (2 × 24 = 48 px), el texto posterior retoma la rejilla sin desfase.',
      repaso: 'Múltiplos enteros del renglón base',
    };
  }

  function rondaAsimetriaSubtitulo(): Ronda {
    const ops = barajar([
      {
        texto: '24 px arriba del intertítulo y 8 px debajo (más cerca del párrafo que encabeza)',
        describir: 'Intertítulo separado del bloque anterior y próximo al párrafo que introduce.',
        es: true,
        html: `<div style="padding:10px 12px;background:#fff;border:1.5px solid #222;text-align:left;font-family:${SERIF};font-size:11px;line-height:1.4;color:#222;">
          <p style="margin:0 0 18px;">Aquí termina la sección anterior.</p>
          <strong style="display:block;font-family:${SANS};font-size:10.5px;margin:0 0 4px;">2. NUEVA SECCIÓN (24 PX ARRIBA / 8 PX ABAJO)</strong>
          <p style="margin:0;">El subtítulo abraza a su propio párrafo y sigue sumando 32 px en total.</p>
        </div>`,
      },
      {
        texto: '8 px arriba del intertítulo y 24 px debajo (pegado al párrafo que ya terminó)',
        describir: 'Intertítulo pegado al párrafo anterior y separado del suyo.',
        es: false,
        html: `<div style="padding:10px 12px;background:#fff;border:1px solid #ccc;text-align:left;font-family:${SERIF};font-size:11px;line-height:1.4;color:#222;">
          <p style="margin:0 0 4px;">Aquí termina la sección anterior.</p>
          <strong style="display:block;font-family:${SANS};font-size:10.5px;margin:0 0 18px;color:${COTA};">2. NUEVA SECCIÓN (PEGADA ARRIBA)</strong>
          <p style="margin:0;">El subtítulo queda huérfano y lejos del texto que debía presentar.</p>
        </div>`,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Para mantener un múltiplo total de 32 px alrededor de un intertítulo y respetar a la vez la ley de proximidad, ¿cómo repartes el espacio antes y después?',
      opciones: ops.map((o) => ({
        texto: o.texto,
        describir: o.describir,
        pintar: (d) => {
          d.innerHTML = o.html;
        },
      })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Un intertítulo pertenece a la sección que abre: debe llevar más espacio arriba (pausa respecto al bloque anterior) que abajo (unión con su propio párrafo), mientras la suma de ambos conserva el múltiplo de la rejilla.',
      repaso: 'Compás asimétrico en intertítulos',
    };
  }

  function rondaAjusteRejilla(): Ronda {
    return {
      tipo: 'ajuste',
      pregunta: 'El renglón base de esta página mide 20 px. Ajusta el espacio total que ocupa la cita destacada hasta que sea un múltiplo exacto (60 px = 3 renglones) y las dos columnas queden alineadas abajo.',
      control: {
        etiqueta: 'Altura total del bloque de la cita',
        min: 44,
        max: 72,
        paso: 2,
        valor: 48,
        unidad: 'px',
      },
      pintar: (c, v) => {
        const ok = v === 60;
        c.innerHTML = `
          <div style="padding:14px;background:repeating-linear-gradient(to bottom,#ffffff 0,#ffffff 19px,#eaeae2 19px,#eaeae2 20px);border:1.5px solid ${ok ? TINTA : COTA};text-align:left;font-family:${SERIF};font-size:12px;color:#222;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
              <div>
                <div style="height:20px;line-height:20px;">Línea 1 (izquierda)</div>
                <div style="height:${v}px;box-sizing:border-box;border-left:3px solid ${ok ? TINTA : COTA};padding-left:8px;display:flex;align-items:center;background:rgba(238,255,65,0.28);font-style:italic;">
                  «Cita destacada: ${v} px totales»
                </div>
                <div style="height:20px;line-height:20px;font-weight:700;color:${ok ? TINTA : COTA};">Línea posterior a la cita →</div>
              </div>
              <div>
                <div style="height:20px;line-height:20px;">Línea 1 (derecha)</div>
                <div style="height:20px;line-height:20px;">Línea 2 continua</div>
                <div style="height:20px;line-height:20px;">Línea 3 continua</div>
                <div style="height:20px;line-height:20px;">Línea 4 continua</div>
                <div style="height:20px;line-height:20px;font-weight:700;">← Línea 5 (meta: 60 px)</div>
              </div>
            </div>
          </div>`;
      },
      cumple: (v) => v === 60,
      falta: (v) => `Con ${v} px la línea inferior queda desfasada ${Math.abs(60 - v)} px respecto a la rejilla de 20 px. Lleva el bloque a 60 px.`,
      porque: 'Con 60 px (exactamente 3 renglones de 20 px), la cita introduce una variación clara sin sacar de compás los párrafos que siguen debajo.',
      repaso: 'Sincronización a la rejilla de líneas de base',
    };
  }

  const root = document.querySelector<HTMLElement>(`[data-juego="${lab}"]`);
  if (root) {
    jugar(root, () =>
      barajar([
        rondaSenalParrafo(),
        rondaMuroVsCompas(),
        rondaRejillaBase(),
        rondaAsimetriaSubtitulo(),
        rondaAjusteRejilla(),
      ]),
    );
  }
</script>
