---
// Paso 2 de interacción del color: el mismo formulario de pago dos veces.
// Mismos colores de marca; cambia lo que tiene al lado cada color y si el
// error se dice solo con color.
import Anotada from '../Anotada.astro';

const W = 320;
const H = 280;
const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const T = '#222222';
const ROJO = '#c62828';
const AMARILLO = '#f5c542';
const pct = (y: number) => (y / H) * 100;
const zona = (y: number, h: number) => ({ x: 5, y: pct(y), w: 90, h: pct(h) });
---

<div class="dv-anotadas">
  <Anotada
    veredicto="mal"
    rotulo="Cuando el color tiene que hacerlo todo"
    notas={[
      { x: 100, y: pct(76), titulo: 'El aviso de error', texto: 'El único indicador es un borde rojo. Si alguien no distingue ese color o no percibe bien el contraste de la pantalla, puede pasar por alto el error.', zona: zona(44, 60) },
      { x: 100, y: pct(214), titulo: 'El botón de pago', texto: 'El texto blanco está sobre un fondo amarillo. Ambos colores tienen una luminancia relativamente alta y la diferencia entre ellos es pequeña. La razón de contraste es de 1,6:1, insuficiente para texto normal.', zona: zona(186, 56) },
    ]}
  >
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Formulario de pago: un campo con borde rojo y un botón amarillo con texto blanco.">
      <rect width={W} height={H} fill="#fff" />
      <text x="24" y="40" font-family={SANS} font-weight="500" font-size="13" fill={T}>Número de tarjeta</text>
      <rect x="24" y="52" width="272" height="44" fill="#fff" stroke={ROJO} stroke-width="2" />
      <text x="38" y="80" font-family={SANS} font-size="15" fill={T}>4152 3100 8720</text>
      <rect x="24" y="190" width="272" height="48" fill={AMARILLO} />
      <text x="160" y="220" text-anchor="middle" font-family={SANS} font-weight="700" font-size="16" fill="#ffffff">Pagar $48.000</text>
    </svg>
  </Anotada>

  <Anotada
    veredicto="bien"
    rotulo="Cuando cada color tiene una función clara"
    notas={[
      { x: 100, y: pct(76), titulo: 'El aviso de error', texto: 'El borde rojo se acompaña de un símbolo y una frase que explica qué falta. Aunque el color no se perciba, quedan otras señales.', zona: zona(44, 82) },
      { x: 100, y: pct(214), titulo: 'El botón de pago', texto: 'El amarillo conserva su lugar en la identidad visual, pero ahora lleva texto oscuro. La razón de contraste es de 9,8:1, una diferencia mucho mayor que facilita la lectura.', zona: zona(186, 56) },
    ]}
  >
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="El mismo formulario: el campo con borde rojo, un símbolo y el texto «Faltan 4 dígitos», y el botón amarillo con texto oscuro.">
      <rect width={W} height={H} fill="#fff" />
      <text x="24" y="40" font-family={SANS} font-weight="500" font-size="13" fill={T}>Número de tarjeta</text>
      <rect x="24" y="52" width="272" height="44" fill="#fff" stroke={ROJO} stroke-width="3" />
      <text x="38" y="80" font-family={SANS} font-size="15" fill={T}>4152 3100 8720</text>
      <rect x="24" y="106" width="14" height="14" fill="none" stroke={ROJO} stroke-width="2" />
      <path d="M27.5 109.5l7 7M34.5 109.5l-7 7" stroke={ROJO} stroke-width="2" />
      <text x="46" y="118" font-family={SANS} font-weight="500" font-size="13" fill={ROJO}>Faltan 4 dígitos.</text>
      <rect x="24" y="190" width="272" height="48" fill={AMARILLO} />
      <text x="160" y="220" text-anchor="middle" font-family={SANS} font-weight="700" font-size="16" fill={T}>Pagar $48.000</text>
    </svg>
  </Anotada>
</div>
