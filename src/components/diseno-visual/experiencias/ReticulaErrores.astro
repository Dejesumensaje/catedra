---
// Paso 4 de retículas: tres errores que se repiten, cada uno con su arreglo
// escrito en la nota.
import Anotada from '../Anotada.astro';

const W = 300;
const H = 200;
const T = '#222222';
const G = '#9a9a9a';
const pc = (x: number, y: number) => ({ x: (x / W) * 100, y: (y / H) * 100 });
const zn = (x: number, y: number, w: number, h: number) => ({ x: (x / W) * 100, y: (y / H) * 100, w: (w / W) * 100, h: (h / H) * 100 });
const barras = (x: number, y: number, w: number, n: number) =>
  Array.from({ length: n }, (_, i) => ({ x, y: y + i * 11, w: i === n - 1 ? w * 0.6 : w }));
---

<div class="dv-anotadas">
  <Anotada
    veredicto="mal"
    rotulo="Casi alineado"
    notas={[
      { ...pc(W, 70), texto: 'La imagen empieza cuatro píxeles a la derecha del título y del texto. La diferencia es mínima, pero precisamente por eso puede parecer un descuido: los elementos parecen querer compartir una línea sin llegar a hacerlo.', zona: zn(20, 22, 40, 160) },
      { ...pc(W, 150), titulo: 'Cómo corregirlo', texto: 'Alinea exactamente la imagen con los otros bloques. Si necesitas que destaque por su posición, muévela lo suficiente para que la ruptura se perciba como intencional.' },
    ]}
  >
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Un texto y una imagen cuyos bordes izquierdos casi coinciden, con cuatro píxeles de diferencia.">
      <rect width={W} height={H} fill="#fff" />
      <rect x="30" y="24" width="200" height="16" fill={T} />
      <rect x="34" y="54" width="180" height="80" fill="#4a4a4a" />
      {barras(30, 148, 220, 3).map((b) => <rect x={b.x} y={b.y} width={b.w} height="4" fill={G} />)}
    </svg>
  </Anotada>

  <Anotada
    veredicto="mal"
    rotulo="Una alineación distinta en cada bloque"
    notas={[
      { ...pc(W, 40), texto: 'El título está centrado, el texto se alinea a la izquierda y el dato aparece a la derecha. Los elementos no comparten una dirección visual clara.', zona: zn(14, 16, 272, 170) },
      { ...pc(W, 150), titulo: 'Cómo corregirlo', texto: 'Elige una alineación coherente para los elementos que forman parte de un mismo conjunto. No significa que toda la página deba usar siempre la misma alineación, sino que las diferencias deben responder a una función reconocible.' },
    ]}
  >
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Un título centrado, un párrafo alineado a la izquierda y un dato alineado a la derecha.">
      <rect width={W} height={H} fill="#fff" />
      <rect x="70" y="24" width="160" height="16" fill={T} />
      {barras(24, 62, 170, 5).map((b) => <rect x={b.x} y={b.y} width={b.w} height="4" fill={G} />)}
      <text x="276" y="160" text-anchor="end" font-family="Roboto, Helvetica, Arial, sans-serif" font-weight="900" font-size="30" fill={T}>48</text>
    </svg>
  </Anotada>

  <Anotada
    veredicto="mal"
    rotulo="Todo alineado, nada importante"
    notas={[
      { ...pc(W, 40), texto: 'Los seis bloques están perfectamente alineados y tienen el mismo protagonismo. La composición se ve ordenada, pero cuesta reconocer dónde empezar.', zona: zn(16, 16, 268, 168) },
      { ...pc(W, 150), titulo: 'Cómo corregirlo', texto: 'La retícula ya organiza las posiciones. Ahora introduce jerarquía: dale a un bloque más espacio, mayor tamaño o más contraste. La estructura y el protagonismo cumplen funciones distintas.' },
    ]}
  >
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Seis rectángulos grises iguales en dos filas de tres, perfectamente alineados.">
      <rect width={W} height={H} fill="#fff" />
      {[0, 1].map((f) => [0, 1, 2].map((c) => (
        <g>
          <rect x={24 + c * 88} y={24 + f * 82} width="76" height="40" fill="#bdbdbd" />
          {barras(24 + c * 88, 70 + f * 82, 76, 2).map((b) => <rect x={b.x} y={b.y} width={b.w} height="3" fill={G} />)}
        </g>
      )))}
    </svg>
  </Anotada>
</div>
