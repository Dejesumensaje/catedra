---
// Ancho de línea (medida): todos los pasos en un componente multi-modo.
import Anotada from '../Anotada.astro';
import Instrumento from '../controles/Instrumento.astro';
import Deslizador from '../controles/Deslizador.astro';
import Opciones from '../controles/Opciones.astro';
import Interruptor from '../controles/Interruptor.astro';
import Guia, { type PasoGuia } from '../controles/Guia.astro';
import Juego from '../Juego.astro';

interface Props {
  paso: 'idea' | 'miralo' | 'pruebalo' | 'errores' | 'ejemplos' | 'juego';
}

const { paso } = Astro.props;
const lab = 'ancho-de-linea';

const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const SERIF = "'PT Serif', Georgia, serif";
const T = '#222222';
const G = '#6f6f6f';
const ROJO = '#b3261e';
const AMARILLO = '#eeff41';

const W = 360;
const H = 280;
const pct = (x: number, y: number) => ({ x: (x / W) * 100, y: (y / H) * 100 });
const zona = (x: number, y: number, w: number, h: number) => ({
  x: (x / W) * 100,
  y: (y / H) * 100,
  w: (w / W) * 100,
  h: (h / H) * 100,
});

const pasos: PasoGuia[] = [
  {
    titulo: 'Lleva la columna a un pasillo estrecho.',
    hacer: 'Mueve «Ancho del contenedor» por debajo de 240 px.',
    pista: 'Arrastra el primer deslizador hacia la izquierda.',
    preparar: { tamano: 16, alineacion: 'izquierda' },
    logro: 'Con unos 22 a 26 caracteres por línea, cada frase se rompe en tres o cuatro renglones cortos. El ojo salta de línea casi en cada palabra y pierde el ritmo de lectura.',
  },
  {
    titulo: 'Justifica esa columna estrecha.',
    hacer: 'En «Alineación del párrafo», selecciona «Justificada».',
    pista: 'Elige la segunda opción de alineación manteniendo la columna angosta.',
    logro: 'Como caben muy pocas palabras por renglón, el navegador estira los huecos entre ellas para tocar ambos márgenes y abre grietas verticales («ríos de blanco») que fracturan el bloque.',
  },
  {
    titulo: 'Estira el renglón de lado a lado.',
    hacer: 'Vuelve a «Izquierda» y lleva «Ancho del contenedor» por encima de 860 px.',
    pista: 'Arrastra «Ancho del contenedor» hasta el extremo derecho.',
    preparar: { tamano: 15, alineacion: 'izquierda' },
    logro: 'El párrafo supera los 110 caracteres por línea. Cuando terminas un renglón a la derecha, el viaje de retorno hacia el inicio de la línea siguiente es tan largo que cuesta acertar en el renglón correcto.',
  },
  {
    titulo: 'Entra en la zona de 45 a 75 caracteres.',
    hacer: 'Ajusta «Ancho del contenedor» entre 460 px y 580 px con «Tamaño de la letra» en 16 px.',
    pista: 'Activa la franja guía si quieres ver la zona óptima marcada sobre el texto.',
    preparar: { zona: true },
    logro: 'Alrededor de los 60 a 68 caracteres por renglón, la vista realiza entre siete y diez fijaciones cómodas por línea y regresa al margen izquierdo sin dudar.',
  },
  {
    titulo: 'Cambia los caracteres sin tocar los píxeles de la caja.',
    hacer: 'Sin mover el ancho del contenedor, sube «Tamaño de la letra» a 22 px o más.',
    pista: 'Mueve el segundo deslizador hacia la derecha.',
    logro: 'La caja sigue midiendo los mismos píxeles de ancho, pero la medida bajó de ~65 a ~45 caracteres por renglón. El ancho tipográfico depende siempre de la relación entre el ancho de la columna y el cuerpo de la letra.',
  },
];
---

{paso === 'idea' && (
  <div class="dv-pregunta-visual">
    <svg viewBox="0 0 600 180" role="img" aria-label="Tres bloques con el mismo párrafo: uno muy estrecho de 22 caracteres con saltos constantes, uno equilibrado de 62 caracteres y uno interminable de 135 caracteres donde el viaje de retorno del ojo se desvía.">
      <rect width="600" height="180" fill="#fbfbf9" />

      {/* 1. 22 caracteres */}
      <g transform="translate(18, 16)">
        <text x="0" y="12" font-family={SANS} font-size="9" font-weight="700" fill={ROJO}>22 CH · PASILLO</text>
        <rect x="0" y="20" width="92" height="128" fill="#ffffff" stroke="#d8d8d4" />
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => {
          const w = [68, 52, 74, 44, 64, 58, 70, 38][i];
          return (
            <g>
              <rect x="10" y={30 + i * 13} width={w} height="4.5" fill={T} />
              {i < 7 && (
                <path d={`M ${10 + w} ${33 + i * 13} L 10 ${41 + i * 13}`} stroke={ROJO} stroke-width="0.9" stroke-dasharray="2 2" fill="none" />
              )}
            </g>
          );
        })}
        <text x="0" y="160" font-family={SANS} font-size="9.5" fill={G}>Salto cada 3 palabras</text>
      </g>

      {/* 2. 62 caracteres */}
      <g transform="translate(132, 16)">
        <text x="0" y="12" font-family={SANS} font-size="10" font-weight="700" fill={T}>62 CARACTERES · FLUJO CÓMODO</text>
        <rect x="0" y="20" width="184" height="128" fill="#ffffff" stroke={T} stroke-width="1.6" />
        <rect x="126" y="20" width="48" height="128" fill={AMARILLO} opacity="0.45" />
        {[0, 1, 2, 3, 4].map((i) => {
          const w = [156, 162, 148, 158, 112][i];
          return (
            <g>
              <rect x="12" y={34 + i * 18} width={w} height="5" fill={T} />
              {i === 0 && (
                <path d={`M ${12 + w} 39 Q 90 46 12 50`} stroke={T} stroke-width="1.2" fill="none" />
              )}
            </g>
          );
        })}
        <text x="12" y="138" font-family={SANS} font-size="9.5" font-weight="700" fill={T}>Franja óptima: 45–75 ch</text>
        <text x="0" y="160" font-family={SANS} font-size="9.5" fill={G}>Retorno ocular limpio y estable</text>
      </g>

      {/* 3. 135 caracteres */}
      <g transform="translate(338, 16)">
        <text x="0" y="12" font-family={SANS} font-size="10" font-weight="700" fill={ROJO}>135 CARACTERES · RENGLÓN INTERMINABLE</text>
        <rect x="0" y="20" width="244" height="128" fill="#ffffff" stroke="#d8d8d4" />
        {[0, 1, 2].map((i) => {
          const w = [224, 220, 168][i];
          return <rect x="10" y={36 + i * 22} width={w} height="4.5" fill={T} />;
        })}
        <path d="M 234 40 C 160 66, 80 42, 14 58" stroke={ROJO} stroke-width="1.4" stroke-dasharray="3 2" fill="none" />
        <circle cx="14" cy="58" r="3" fill={ROJO} />
        <text x="12" y="118" font-family={SANS} font-size="9.5" font-weight="700" fill={ROJO}>¿Qué línea seguía?</text>
        <text x="12" y="133" font-family={SANS} font-size="9" fill={G}>El ojo se pierde al volver a la izquierda</text>
        <text x="0" y="160" font-family={SANS} font-size="9.5" fill={G}>Viaje de vuelta demasiado largo</text>
      </g>
    </svg>
    <p>Los tres bloques contienen exactamente las mismas palabras. ¿Por qué solo el del centro se lee de corrido sin fatigar la vista?</p>
    <details>
      <summary>Ver la respuesta</summary>
      <div class="dv-texto">
        <p>En la columna de 22 caracteres el renglón se acaba antes de completar una idea y la mirada salta en escalera sin descanso. En la de 135 caracteres ocurre lo opuesto: al terminar una línea tan larga, el ángulo de regreso hacia el margen izquierdo es tan tendido que el ojo suele repetir el mismo renglón o saltarse el siguiente. Entre 45 y 75 caracteres (con 60–66 como centro cómodo), el barrido horizontal y el salto de línea entran en equilibrio.</p>
      </div>
    </details>
  </div>
)}

{paso === 'miralo' && (
  <div class="dv-anotadas">
    <Anotada
      veredicto="mal"
      rotulo="Texto de lado a lado en pantalla ancha (~140 caracteres)"
      notas={[
        {
          ...pct(310, 48),
          titulo: '100 % del monitor (1280 px)',
          texto: 'El párrafo hereda todo el ancho de la ventana sin límite. A 16 px caben cerca de 140 caracteres en cada renglón.',
          zona: zona(16, 28, 328, 34),
        },
        {
          ...pct(180, 128),
          titulo: 'Retorno ocular impreciso',
          texto: 'Recorrer más de veinte centímetros de pantalla para volver al inicio del renglón siguiente obliga a buscar con el dedo o el cursor por dónde iba la lectura.',
          zona: zona(16, 70, 328, 92),
        },
        {
          ...pct(286, 224),
          titulo: 'Espacio lateral desaprovechado',
          texto: 'En vez de reservar margen para un índice o notas de apoyo, toda la superficie se llena con un muro de renglones larguísimos.',
          zona: zona(16, 174, 328, 86),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Página de documentación donde los párrafos ocupan todo el ancho de 1280 píxeles de lado a lado.">
        <rect width={W} height={H} fill="#ffffff" />
        <rect x="14" y="14" width="332" height="252" fill="#fbfbf9" stroke="#d6d6d2" />
        <text x="24" y="32" font-family={SANS} font-size="8.5" font-weight="700" fill={ROJO}>CONTENEDOR 1280 PX · TEXTO AL 100 % (~140 CARACTERES POR LÍNEA)</text>
        <text x="24" y="54" font-family={SANS} font-size="14" font-weight="900" fill={T}>Guía de migración del motor de búsqueda</text>

        {[0, 1, 2, 3, 4].map((i) => (
          <text x="24" y={78 + i * 13} font-family={SERIF} font-size="5.3" fill={T}>
            {[
              'Cuando un documento técnico se extiende de borde a borde en un monitor de escritorio, cada renglón acumula más de veinte palabras',
              'seguidas y obliga al lector a girar el cuello de izquierda a derecha. Al terminar la línea en el extremo derecho, el ojo tiene',
              'que cruzar toda la pantalla para encontrar el comienzo del renglón siguiente; como las líneas son largas y parecen idénticas,',
              'es habitual volver a leer por error la misma línea o saltarse una entera sin notarlo hasta mitad de frase.',
              'El problema no es el ancho de la pantalla, sino confundir el ancho del contenedor general con el ancho de la columna de lectura.',
            ][i]}
          </text>
        ))}

        <path d="M 332 92 C 230 116, 110 92, 24 104" stroke={ROJO} stroke-width="1.4" stroke-dasharray="3 2" fill="none" />
        <circle cx="24" cy="104" r="2.8" fill={ROJO} />

        <rect x="24" y="156" width="312" height="36" fill="#f0f0ec" stroke="#d4d4d0" />
        <text x="32" y="177" font-family={SANS} font-size="8.5" fill={G}>bloque de código o tabla estirada al mismo ancho que la prosa</text>

        {[0, 1, 2].map((i) => (
          <text x="24" y={212 + i * 13} font-family={SERIF} font-size="5.3" fill={T}>
            {[
              'Incluso un texto breve de tres o cuatro oraciones parece pesado y burocrático cuando se despliega en renglones interminables',
              'que no ofrecen puntos de apoyo visual ni pausas claras a lo largo del recorrido horizontal.',
              'Quien consulta la documentación termina escaneando palabras sueltas en lugar de comprender el procedimiento.',
            ][i]}
          </text>
        ))}
      </svg>
    </Anotada>

    <Anotada
      veredicto="bien"
      rotulo="Contenedor amplio + columna de texto acotada a 65ch"
      notas={[
        {
          ...pct(140, 96),
          titulo: 'Columna acotada a 65ch',
          texto: 'El texto corrido se limita a unos 65 caracteres por línea. Cada renglón se abarca en pocas fijaciones y el salto al siguiente es inmediato.',
          zona: zona(22, 62, 214, 100),
        },
        {
          ...pct(302, 96),
          titulo: 'Margen activo para consulta',
          texto: 'El espacio que libera el párrafo en pantallas anchas aloja el índice de la página o notas al margen sin competir con la lectura.',
          zona: zona(248, 56, 92, 110),
        },
        {
          ...pct(180, 206),
          titulo: 'Las tablas sí pueden abrirse más',
          texto: 'Acotar el párrafo a 65ch no encierra toda la página: una tabla comparativa o un diagrama puede ocupar un ancho mayor cuando lo necesita.',
          zona: zona(22, 172, 314, 78),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="La misma página de documentación con la columna de lectura limitada a 65 caracteres, un índice lateral a la derecha y una tabla ancha debajo.">
        <rect width={W} height={H} fill="#ffffff" />
        <rect x="14" y="14" width="332" height="252" fill="#fbfbf9" stroke={T} stroke-width="1.4" />
        <text x="24" y="32" font-family={SANS} font-size="8.5" font-weight="700" fill={T}>CONTENEDOR 1280 PX · COLUMNA DE LECTURA: MAX-WIDTH 65CH</text>
        <text x="24" y="54" font-family={SANS} font-size="14" font-weight="900" fill={T}>Guía de migración del motor</text>

        <rect x="24" y="64" width="210" height="92" fill={AMARILLO} opacity="0.22" />
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <text x="24" y={76 + i * 13} font-family={SERIF} font-size="9" fill={T}>
            {[
              'Limitar el párrafo a unos 65 caracteres',
              'permite mantener un ritmo constante de',
              'lectura sin perder el inicio del renglón',
              'siguiente. El contenedor general sigue',
              'siendo amplio, pero cada pieza usa el',
              'ancho que conviene a su función.',
            ][i]}
          </text>
        ))}

        {/* Columna lateral de índice */}
        <line x1="248" y1="62" x2="248" y2="156" stroke="#dcdcd6" />
        <text x="258" y="74" font-family={SANS} font-size="7.5" font-weight="700" letter-spacing="0.08em" fill={G}>EN ESTA PÁGINA</text>
        <text x="258" y="90" font-family={SANS} font-size="8.5" font-weight="700" fill={T}>1. Requisitos</text>
        <text x="258" y="105" font-family={SANS} font-size="8.5" fill={G}>2. Índices nuevos</text>
        <text x="258" y="120" font-family={SANS} font-size="8.5" fill={G}>3. Pruebas de carga</text>
        <text x="258" y="135" font-family={SANS} font-size="8.5" fill={G}>4. Reversión</text>

        {/* Tabla que sí aprovecha el ancho */}
        <rect x="24" y="174" width="312" height="72" fill="#ffffff" stroke={T} stroke-width="1.2" />
        <rect x="24" y="174" width="312" height="20" fill="#222222" />
        <text x="32" y="187" font-family={SANS} font-size="8" font-weight="700" fill={AMARILLO}>PARÁMETRO</text>
        <text x="134" y="187" font-family={SANS} font-size="8" font-weight="700" fill="#ffffff">VERSIÓN 2</text>
        <text x="234" y="187" font-family={SANS} font-size="8" font-weight="700" fill="#ffffff">VERSIÓN 3</text>
        <text x="32" y="210" font-family={SANS} font-size="8.5" fill={T}>Límite por lote</text>
        <text x="134" y="210" font-family={SANS} font-size="8.5" fill={G}>500 docs</text>
        <text x="234" y="210" font-family={SANS} font-size="8.5" font-weight="700" fill={T}>2.000 docs</text>
        <line x1="24" y1="218" x2="336" y2="218" stroke="#e5e5e5" />
        <text x="32" y="234" font-family={SANS} font-size="8.5" fill={T}>Tiempo de espera</text>
        <text x="134" y="234" font-family={SANS} font-size="8.5" fill={G}>30 s</text>
        <text x="234" y="234" font-family={SANS} font-size="8.5" font-weight="700" fill={T}>10 s (configurable)</text>
      </svg>
    </Anotada>
  </div>
)}

{paso === 'pruebalo' && (
  <Instrumento
    id={lab}
    titulo="Instrumento · medida en caracteres frente a ancho en píxeles"
    consigna="Ajusta el ancho del contenedor y el tamaño de la letra sobre el mismo párrafo. Observa cómo varía el número real de caracteres por renglón y qué ocurre con los espacios entre palabras al justificar una columna estrecha."
    nota="Fija una medida de ~65 caracteres en A (por ejemplo, 520 px a 16 px) y en B consigue esos mismos ~65 caracteres con una letra de 21 px ensanchando el contenedor."
  >
    <svg slot="escenario" viewBox="0 0 640 300" role="img" aria-label="Párrafo de ensayo con regla superior en caracteres y franja óptima entre 45 y 75 caracteres.">
      <rect width="640" height="300" fill="#fbfbf9" />
      <rect x="36" y="24" width="440" height="248" fill="#ffffff" stroke="#222222" stroke-width="1.5" />
      <rect x="280" y="24" width="165" height="248" fill="#eeff41" opacity="0.28" />
      <text x="52" y="52" font-family={SANS} font-size="11" font-weight="700" fill="#222222">MEDIDA PROMEDIO: 64 CARACTERES POR LÍNEA (ÓPTIMA: 45–75)</text>
      <text x="52" y="84" font-family={SERIF} font-size="15" fill="#222222">
        <tspan x="52" dy="0">La medida de una columna no se define por los centímetros</tspan>
        <tspan x="52" dy="24">que mide en el papel ni por los píxeles que ocupa en el</tspan>
        <tspan x="52" dy="24">monitor, sino por cuántas letras y espacios caben en cada</tspan>
        <tspan x="52" dy="24">renglón antes de que la vista deba regresar al margen.</tspan>
      </text>
    </svg>

    <Guia
      slot="guia"
      pasos={pasos}
      final="Guía completada. Prueba ahora cómo una misma caja de 500 px puede ser ancha para una letra de 13 px y estrecha para una de 24 px."
    />

    <Deslizador
      lab={lab}
      variable="ancho"
      etiqueta="Ancho del contenedor"
      min={180}
      max={920}
      paso={10}
      valor={520}
      unidad="px"
      ayuda="Ancho físico de la columna en píxeles."
    />
    <Deslizador
      lab={lab}
      variable="tamano"
      etiqueta="Tamaño de la letra"
      min={13}
      max={24}
      paso={1}
      valor={16}
      unidad="px"
      ayuda="Cambiar el cuerpo altera cuántos caracteres caben en el mismo contenedor."
    />
    <Opciones
      lab={lab}
      variable="alineacion"
      etiqueta="Alineación del párrafo"
      valor="izquierda"
      opciones={[
        { valor: 'izquierda', texto: 'Izquierda' },
        { valor: 'justificada', texto: 'Justificada' },
      ]}
      ayuda="Prueba qué pasa con los espacios entre palabras al justificar una columna de menos de 40 caracteres."
    />

    <Fragment slot="avanzados">
      <Interruptor
        lab={lab}
        variable="zona"
        etiqueta="Marcar la zona de 45 a 75 caracteres"
        valor={true}
        ayuda="Resalta la franja donde una columna de lectura continua resulta más cómoda."
      />
    </Fragment>

    <Fragment slot="pruebas">
      <button type="button" class="dv-boton" data-preset='{"ancho":520,"tamano":16,"alineacion":"izquierda","zona":true}'>Columna óptima (~65 ch)</button>
      <button type="button" class="dv-boton" data-preset='{"ancho":210,"tamano":16,"alineacion":"justificada","zona":true}'>Pasillo estrecho justificado (ríos)</button>
      <button type="button" class="dv-boton" data-preset='{"ancho":900,"tamano":14,"alineacion":"izquierda","zona":true}'>Monitor de lado a lado (~125 ch)</button>
      <button type="button" class="dv-boton" data-preset='{"ancho":700,"tamano":22,"alineacion":"izquierda","zona":true}'>Cuerpo grande en caja ancha (~63 ch)</button>
    </Fragment>
  </Instrumento>
)}

{paso === 'errores' && (
  <div class="dv-especimenes">
    <Instrumento
      id={`${lab}-e1`}
      titulo="Acota el párrafo en pantallas grandes sin desperdiciar la retícula"
      comparar={false}
      consigna="En este artículo el texto ocupa el 100 % del contenedor y supera los 120 caracteres por renglón. Reduce el ancho máximo de la columna de texto y aprovecha el espacio lateral para la ficha de resumen."
    >
      <div slot="escenario" style={`padding:16px 18px;font-family:${SERIF};font-size:13px;color:#222;`}>
        <p style="margin:0;">Cuando la columna de texto se estira al ancho total de la pantalla, los renglones superan los cien caracteres y dificultan el regreso del ojo.</p>
      </div>
      <Deslizador
        lab={`${lab}-e1`}
        variable="medida"
        etiqueta="Ancho máximo del párrafo"
        min={55}
        max={125}
        paso={5}
        valor={120}
        unidad="ch"
        ayuda="Lleva la columna al rango de 60–70 ch para liberar el margen lateral."
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e2`}
      titulo="Elimina los «ríos de blanco» en una columna estrecha"
      comparar={false}
      consigna="Esta nota lateral mide apenas 28 caracteres por línea y está justificada a ambos lados, lo que abre huecos enormes entre palabras. Cambia la alineación o ensancha la medida para recuperar un espaciado uniforme."
    >
      <div slot="escenario" style={`padding:16px 18px;font-family:${SERIF};font-size:13px;color:#222;`}>
        <p style="margin:0;">Justificar una columna estrecha abre huecos irregulares entre palabras.</p>
      </div>
      <Opciones
        lab={`${lab}-e2`}
        variable="modo"
        etiqueta="Cómo resolver la columna estrecha"
        valor="justificado-estrecho"
        opciones={[
          { valor: 'justificado-estrecho', texto: 'Justificada en 28 ch (con ríos)' },
          { valor: 'izquierda-estrecho', texto: 'Alineada a la izquierda en 28 ch' },
          { valor: 'justificado-ancho', texto: 'Justificada en 60 ch' },
        ]}
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e3`}
      titulo="Divide un formato apaisado en dos columnas cómodas"
      comparar={false}
      consigna="En un folleto horizontal, una sola columna produce renglones de 115 caracteres; cuatro columnas producen pasillos de 24 caracteres. Elige la división que deje cada columna en una medida legible."
    >
      <div slot="escenario" style={`padding:16px 18px;font-family:${SANS};font-size:13px;color:#222;`}>
        <p style="margin:0;">El número de columnas de una retícula depende de cuántos caracteres caben en cada una.</p>
      </div>
      <Opciones
        lab={`${lab}-e3`}
        variable="columnas"
        etiqueta="División del formato apaisado"
