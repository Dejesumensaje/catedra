{paso === 'juego' && (
  <Juego
    slug={lab}
    rondas={5}
    descripcion="Cinco rondas breves sobre medida en caracteres, barrido de retorno, ríos de blanco y relación entre cuerpo y ancho de columna."
  />
)}

<script>
  import { conectar, svg, n } from '../../../lib/diseno-visual/estado';
  import { guiar } from '../../../lib/diseno-visual/guia';
  import { jugar, barajar, type Ronda } from '../../../lib/diseno-visual/juego';

  const lab = 'ancho-de-linea';

  const SANS = 'Roboto, Helvetica, Arial, sans-serif';
  const SERIF = "'PT Serif', Georgia, serif";
  const TINTA = '#222222';
  const SEC = '#6f6f6f';
  const COTA = '#b3261e';
  const AMARILLO = '#eeff41';

  // ── 1. Instrumento principal: ancho-de-linea ────────────────────
  type E = {
    ancho: number;
    tamano: number;
    alineacion: string;
    zona: boolean;
  };

  const TEXTO_LAB =
    'El ancho de una columna de lectura no se mide en centímetros ni en píxeles fijos, sino en cuántas letras y espacios entran en cada renglón. Cuando la línea reúne entre cuarenta y cinco y setenta y cinco caracteres, el ojo avanza con fijaciones regulares y regresa al margen izquierdo sin perder el hilo ni saltar de renglón.';

  function partirEnLineas(texto: string, maxChars: number): string[] {
    const palabras = texto.split(' ');
    const lineas: string[] = [];
    let actual = '';
    for (const p of palabras) {
      if (!actual) {
        actual = p;
      } else if (actual.length + 1 + p.length <= maxChars) {
        actual += ' ' + p;
      } else {
        lineas.push(actual);
        actual = p;
      }
    }
    if (actual) lineas.push(actual);
    return lineas;
  }

  function calcularMedida(e: E) {
    const anchoChar = e.tamano * 0.49;
    const padInterno = 28;
    const util = Math.max(80, e.ancho - padInterno * 2);
    const charsMax = Math.max(14, Math.round(util / anchoChar));
    const lineas = partirEnLineas(TEXTO_LAB, charsMax);
    const promedio = Math.round(
      lineas.slice(0, Math.max(1, lineas.length - 1)).reduce((acc, l) => acc + l.length, 0) /
        Math.max(1, lineas.length - 1),
    );
    return { charsMax, promedio, lineas, anchoChar, padInterno };
  }

  function pintar(destino: HTMLElement, e: E) {
    const W = Math.max(destino.clientWidth, 300);
    const escala = Math.min(1, (W - 24) / 920);
    const { charsMax, promedio, lineas, anchoChar, padInterno } = calcularMedida(e);

    const fs = Math.max(10.5, e.tamano * (W < 540 ? 0.78 : 0.88));
    const lh = Math.round(fs * 1.48);
    const cajaW = Math.min(W - 24, Math.max(140, Math.round(e.ancho * (W < 640 ? Math.min(0.88, escala + 0.18) : 0.66))));
    const topCaja = 44;
    const altoTexto = lineas.length * lh + 32;
    const H = Math.max(250, topCaja + altoTexto + 34);

    const raiz = svg('svg', { viewBox: `0 0 ${W} ${H}`, width: W, height: H, role: 'img' });
    raiz.setAttribute(
      'aria-label',
      `Columna de ${e.ancho} píxeles con letra de ${e.tamano} píxeles: promedio de ${promedio} caracteres por línea.`,
    );
    raiz.append(svg('rect', { width: W, height: H, fill: '#fbfbf9' }));

    const xCaja = 16;
    const optimo = promedio >= 45 && promedio <= 75;
    const hayRios = e.alineacion === 'justificada' && promedio < 38;

    // Etiqueta superior de estado
    const estadoTxt = optimo
      ? `MEDIDA CÓMODA · ~${promedio} CARACTERES POR LÍNEA`
      : promedio < 45
        ? `COLUMNA ESTRECHA · ~${promedio} CARACTERES POR LÍNEA`
        : `RENGLÓN EXCESIVO · ~${promedio} CARACTERES POR LÍNEA`;

    const etq = svg('text', {
      x: xCaja,
      y: 24,
      'font-family': SANS,
      'font-size': 11,
      'font-weight': 700,
      fill: optimo ? TINTA : COTA,
    });
    etq.textContent = `${estadoTxt}  (${e.ancho} px · cuerpo ${e.tamano} px)`;
    raiz.append(etq);

    // Caja contenedora
    raiz.append(
      svg('rect', {
        x: xCaja,
        y: topCaja,
        width: cajaW,
        height: altoTexto,
        fill: '#ffffff',
        stroke: optimo ? TINTA : COTA,
        'stroke-width': optimo ? 1.6 : 1.8,
      }),
    );

    const xTexto = xCaja + 16;
    const anchoTextoMax = cajaW - 32;
    const pxPorChar = anchoTextoMax / Math.max(14, charsMax);

    // Franja de 45 a 75 caracteres
    if (e.zona) {
      const x45 = xTexto + 45 * pxPorChar;
      const x75 = xTexto + 75 * pxPorChar;
      const xIni = Math.min(xCaja + cajaW - 2, Math.max(xTexto, x45));
      const xFin = Math.min(xCaja + cajaW - 2, Math.max(xIni, x75));
      if (xFin > xIni + 4) {
        raiz.append(
          svg('rect', {
            x: xIni,
            y: topCaja + 1,
            width: xFin - xIni,
            height: altoTexto - 2,
            fill: AMARILLO,
            opacity: 0.32,
          }),
        );
      }
      if (x45 <= xCaja + cajaW + 40) {
        const l45 = Math.min(W - 8, x45);
        raiz.append(
          svg('line', {
            x1: l45,
            y1: topCaja - 6,
            x2: l45,
            y2: topCaja + altoTexto + 6,
            stroke: TINTA,
            'stroke-width': 1,
            'stroke-dasharray': '3 3',
          }),
        );
        const t45 = svg('text', {
          x: l45 + 3,
          y: topCaja + altoTexto + 16,
          'font-family': SANS,
          'font-size': 9.5,
          'font-weight': 700,
          fill: TINTA,
        });
        t45.textContent = '45 ch';
        raiz.append(t45);
      }
      if (x75 <= W - 12) {
        raiz.append(
          svg('line', {
            x1: x75,
            y1: topCaja - 6,
            x2: x75,
            y2: topCaja + altoTexto + 6,
            stroke: TINTA,
            'stroke-width': 1,
            'stroke-dasharray': '3 3',
          }),
        );
        const t75 = svg('text', {
          x: x75 + 3,
          y: topCaja + altoTexto + 16,
          'font-family': SANS,
          'font-size': 9.5,
          'font-weight': 700,
          fill: TINTA,
        });
        t75.textContent = '75 ch';
        raiz.append(t75);
      }
    }

    // Dibujar renglones y ríos si aplica
    lineas.forEach((linea, idx) => {
      const y = topCaja + 24 + idx * lh;
      const esUltima = idx === lineas.length - 1;
      const t = svg('text', {
        x: xTexto,
        y,
        'font-family': SERIF,
        'font-size': fs,
        fill: TINTA,
      });
      if (e.alineacion === 'justificada' && !esUltima && linea.includes(' ')) {
        t.setAttribute('textLength', String(Math.round(anchoTextoMax)));
        t.setAttribute('lengthAdjust', 'spacing');
      }
      t.textContent = linea;
      raiz.append(t);

      // Marcar huecos/ríos cuando se justifica en estrecho
      if (hayRios && !esUltima) {
        const palabras = linea.split(' ');
        if (palabras.length > 1 && palabras.length <= 5) {
          let acum = 0;
          for (let p = 0; p < palabras.length - 1; p++) {
            acum += palabras[p].length;
            const frac = (acum + p * 1.4) / Math.max(1, linea.length);
            const rx = xTexto + frac * anchoTextoMax;
            raiz.append(
              svg('rect', {
                x: rx - 3,
                y: y - fs * 0.78,
                width: 8,
                height: fs * 0.92,
                fill: COTA,
                opacity: 0.22,
              }),
            );
          }
        }
      }
    });

    // Si es excesivamente largo, dibujar la curva de retorno que se pierde
    if (promedio > 82 && lineas.length >= 2) {
      const y1 = topCaja + 24;
      const y2 = topCaja + 24 + lh;
      const xFin = xTexto + Math.min(anchoTextoMax, lineas[0].length * pxPorChar);
      raiz.append(
        svg('path', {
          d: `M ${xFin} ${y1 - 3} C ${xTexto + anchoTextoMax * 0.6} ${y2 + 8}, ${xTexto + anchoTextoMax * 0.25} ${y1 - 6}, ${xTexto} ${y2 - 3}`,
          fill: 'none',
          stroke: COTA,
          'stroke-width': 1.4,
          'stroke-dasharray': '4 3',
        }),
      );
    }

    void anchoChar;
    void padInterno;
    destino.replaceChildren(raiz);
  }

  function describir(e: E): string {
    const { promedio, lineas } = calcularMedida(e);
    const cifra = `<b class="dv-cifra">~${n(promedio, 0)} caracteres por línea</b>`;
    const rios =
      e.alineacion === 'justificada' && promedio < 38
        ? ' Además, al justificar una línea tan corta se abren <b class="dv-cifra">ríos de blanco</b> entre las palabras.'
        : '';

    if (promedio < 38) {
      return `Con ${e.ancho} px de ancho y letra de ${e.tamano} px caben ${cifra} (${lineas.length} renglones). La columna es demasiado estrecha: el ojo salta de línea a cada instante.${rios}`;
    }
    if (promedio < 45) {
      return `Medida de ${cifra}: funciona bien en composiciones de varias columnas o notas breves, aunque resulta algo corta para una columna única de lectura larga.${rios}`;
    }
    if (promedio <= 75) {
      return `Medida equilibrada de ${cifra} (${lineas.length} renglones). Está dentro de la franja recomendada de <b class="dv-cifra">45 a 75 caracteres</b> para lectura continua en una sola columna.`;
    }
    if (promedio <= 90) {
      return `Medida de ${cifra}: empieza a superar el límite cómodo de 75 caracteres. Si mantienes este ancho, conviene aumentar el interlineado para no perder el renglón al volver.`;
    }
    return `Medida excesiva de ${cifra}: el renglón es tan largo que el barrido de retorno hacia el margen izquierdo pierde precisión y cansa la vista.`;
  }

  for (const raiz of document.querySelectorAll<HTMLElement>(`[data-lab="${lab}"]`)) {
    guiar<E>(raiz, [
      (e) => e.ancho <= 240,
      (e) => e.ancho <= 260 && e.alineacion === 'justificada',
      (e) => e.alineacion === 'izquierda' && e.ancho >= 860,
      (e) => {
        const { promedio } = calcularMedida(e);
        return promedio >= 55 && promedio <= 72 && e.tamano === 16;
      },
      (e) => e.tamano >= 22,
    ]);
    conectar<E>({ raiz, pintar, describir });
  }

  // ── 2. Especímenes de error ────────────────────────────────────
  type E1 = { medida: number };
  function pintarE1(d: HTMLElement, e: E1) {
    const acotado = e.medida <= 75;
    const anchoPct = Math.min(100, Math.round((e.medida / 125) * 100));
    d.innerHTML = `
      <div style="padding:16px 18px;font-family:${SANS};color:#222;">
        <div style="display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;">
          <div style="flex:1 1 ${anchoPct}%;max-width:${anchoPct}%;font-family:${SERIF};font-size:13px;line-height:1.5;color:#222;">
            <p style="margin:0 0 6px;font-family:${SANS};font-size:10px;font-weight:700;letter-spacing:0.08em;color:${acotado ? '#222' : COTA};">COLUMNA PRINCIPAL · MAX-WIDTH: ${e.medida}CH</p>
            <p style="margin:0;">Cuando limitas el ancho máximo del párrafo a unos 65 caracteres, el texto deja de estirarse sin control en monitores grandes y el margen derecho queda disponible para información de apoyo.</p>
          </div>
          ${
            acotado
              ? `<aside style="flex:0 0 140px;padding:8px 10px;background:#fbfbf9;border:1px solid #222;font-size:11px;line-height:1.35;">
                  <strong style="display:block;font-size:10px;letter-spacing:0.06em;color:#6f6f6f;margin-bottom:4px;">FICHA LATERAL</strong>
                  <span style="color:#222;">Tiempo de lectura: 4 min · Nivel intermedio</span>
                </aside>`
              : ''
          }
        </div>
      </div>`;
  }
  function describirE1(e: E1) {
    if (e.medida > 90) return `A <b class="dv-cifra">${e.medida} ch</b> el renglón cruza todo el contenedor y fatiga la lectura.`;
    if (e.medida > 75) return `A <b class="dv-cifra">${e.medida} ch</b> la línea ya se acorta, pero todavía supera el umbral cómodo de 75 caracteres.`;
    return `<b class="dv-cifra">${e.medida} ch</b>: la columna entra en la franja óptima y libera espacio limpio para la ficha lateral.`;
  }

  type E2 = { modo: string };
  function pintarE2(d: HTMLElement, e: E2) {
    const esJustEstrecho = e.modo === 'justificado-estrecho';
    const esIzqEstrecho = e.modo === 'izquierda-estrecho';
    const maxW = e.modo === 'justificado-ancho' ? '360px' : '165px';
    const align = esIzqEstrecho ? 'left' : 'justify';
    d.innerHTML = `
      <div style="padding:16px 18px;font-family:${SERIF};color:#222;">
        <div style="max-width:${maxW};padding:10px 12px;border:1.5px solid ${esJustEstrecho ? COTA : '#222'};background:#fff;text-align:${align};font-size:13px;line-height:1.48;">
          ${
            esJustEstrecho
              ? 'La&nbsp;&nbsp;&nbsp;&nbsp;observación&nbsp;&nbsp;&nbsp;de&nbsp;&nbsp;&nbsp;las<br/>estrellas&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;variables&nbsp;&nbsp;&nbsp;&nbsp;exige<br/>comparar&nbsp;&nbsp;&nbsp;&nbsp;su&nbsp;&nbsp;&nbsp;&nbsp;brillo&nbsp;&nbsp;&nbsp;con<br/>tres&nbsp;&nbsp;&nbsp;referencias&nbsp;&nbsp;&nbsp;vecinas.'
              : 'La observación de las estrellas variables exige comparar su brillo aparente con tres referencias vecinas del mismo campo.'
          }
        </div>
      </div>`;
  }
  function describirE2(e: E2) {
    if (e.modo === 'justificado-estrecho') {
      return 'En 28 caracteres con justificación forzada aparecen <b class="dv-cifra">ríos de blanco</b> que parten el párrafo en vertical.';
    }
    if (e.modo === 'izquierda-estrecho') {
      return '<b class="dv-cifra">Espaciado uniforme</b>: si la columna debe ser estrecha, alinear a la izquierda conserva constante el espacio entre palabras.';
    }
    return '<b class="dv-cifra">Medida suficiente (60 ch)</b>: cuando caben diez o doce palabras por línea, el justificado reparte el blanco sin abrir grietas.';
  }

  type E3 = { columnas: string };
  function pintarE3(d: HTMLElement, e: E3) {
    const cols = Number(e.columnas);
    const bien = cols === 2;
    const chAprox = cols === 1 ? 115 : cols === 2 ? 54 : 24;
    d.innerHTML = `
      <div style="padding:16px 18px;font-family:${SERIF};color:#222;">
        <p style="margin:0 0 8px;font-family:${SANS};font-size:10px;font-weight:700;letter-spacing:0.08em;color:${bien ? '#222' : COTA};">FORMATO APAISADO · ${cols} ${cols === 1 ? 'COLUMNA' : 'COLUMNAS'} (~${chAprox} CH POR LÍNEA)</p>
        <div style="column-count:${cols};column-gap:16px;font-size:12px;line-height:1.45;border:1.5px solid ${bien ? '#222' : '#d4d4d0'};padding:10px 12px;background:#fff;">
          El catálogo del jardín botánico organiza las especies según el estrato de bosque que habitan. Cada ficha indica la temporada de floración, el tipo de suelo y las aves que participan en la dispersión de sus semillas a lo largo de la cordillera.
        </div>
      </div>`;
  }
  function describirE3(e: E3) {
    if (e.columnas === '1') return 'Una sola columna de <b class="dv-cifra">~115 caracteres</b> obliga a recorrer todo el pliego horizontal en cada renglón.';
    if (e.columnas === '4') return 'Cuatro columnas de <b class="dv-cifra">~24 caracteres</b> fragmentan las frases en pasillos demasiado angostos.';
    return '<b class="dv-cifra">Dos columnas de ~54 caracteres</b>: cada bloque queda dentro de la medida cómoda sin desaprovechar el formato horizontal.';
  }

  const especimenes: [string, (d: HTMLElement, e: never) => void, (e: never) => string][] = [
    [`${lab}-e1`, pintarE1 as never, describirE1 as never],
    [`${lab}-e2`, pintarE2 as never, describirE2 as never],
    [`${lab}-e3`, pintarE3 as never, describirE3 as never],
  ];
  for (const [id, p, desc] of especimenes) {
    for (const raiz of document.querySelectorAll<HTMLElement>(`[data-lab="${id}"]`)) {
      conectar({ raiz, pintar: p, describir: desc });
    }
  }

  // ── 3. Juego de 5 rondas ───────────────────────────────────────
  function rondaUnidadMedida(): Ronda {
    const ops = barajar([
      {
        texto: 'Columna limitada a 65ch (unos 62–66 caracteres por línea)',
        describir: 'Párrafo acotado en caracteres que conserva su proporción al cambiar el cuerpo.',
        es: true,
        html: `<div style="padding:10px 12px;background:#fff;border:1.5px solid #222;text-align:left;font-family:${SERIF};font-size:12.5px;line-height:1.45;color:#222;max-width:250px;margin:0 auto;">
          <span style="display:block;font-family:${SANS};font-size:9.5px;font-weight:700;color:#222;margin-bottom:4px;">MAX-WIDTH: 65CH · ~64 CARACTERES</span>
          La medida se adapta al tamaño de la letra y mantiene entre nueve y once palabras por renglón.
        </div>`,
      },
      {
        texto: 'Columna al 100 % del monitor (más de 135 caracteres por línea)',
        describir: 'Párrafo estirado de borde a borde con renglones larguísimos.',
        es: false,
        html: `<div style="padding:10px 12px;background:#fff;border:1px solid #ccc;text-align:left;font-family:${SERIF};font-size:9px;line-height:1.35;color:#222;">
          <span style="display:block;font-family:${SANS};font-size:9.5px;font-weight:700;color:${COTA};margin-bottom:4px;">WIDTH: 100% · ~138 CARACTERES</span>
          Cuando el párrafo ocupa todo el ancho de la ventana sin límite en caracteres, cada línea acumula más de veinte palabras y el ojo pierde la referencia al regresar al margen izquierdo.
        </div>`,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: '¿Cuál de las dos columnas aplica la regla clásica de Robert Bringhurst (45 a 75 caracteres) para lectura continua en una columna?',
      opciones: ops.map((o) => ({
        texto: o.texto,
        describir: o.describir,
        pintar: (d) => {
          d.innerHTML = o.html;
        },
      })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'La medida de lectura continua en una columna se sitúa entre 45 y 75 caracteres (con 60–66 como referencia ideal). Expresarla en unidades ch mantiene esa proporción aunque cambie la pantalla.',
      repaso: 'Rango de 45 a 75 caracteres',
    };
  }

  function rondaRiosJustificado(): Ronda {
    const ops = barajar([
      {
        texto: 'Columna estrecha alineada a la izquierda (en bandera)',
        describir: 'Nota lateral de 28 caracteres alineada a la izquierda con espacios regulares entre palabras.',
        es: true,
        html: `<div style="padding:10px 12px;background:#fff;border:1.5px solid #222;text-align:left;font-family:${SERIF};font-size:12px;line-height:1.45;color:#222;width:148px;margin:0 auto;">
          Las muestras de arcilla se secan a la sombra durante cuarenta y ocho horas antes del horneado.
        </div>`,
      },
      {
        texto: 'Columna estrecha justificada a ambos lados',
        describir: 'Nota lateral de 28 caracteres justificada con grandes huecos blancos entre palabras.',
        es: false,
        html: `<div style="padding:10px 12px;background:#fff;border:1px solid #ccc;text-align:justify;font-family:${SERIF};font-size:12px;line-height:1.45;color:#222;width:148px;margin:0 auto;">
          Las&nbsp;&nbsp;&nbsp;&nbsp;muestras&nbsp;&nbsp;&nbsp;&nbsp;de<br/>arcilla&nbsp;&nbsp;&nbsp;&nbsp;se&nbsp;&nbsp;&nbsp;&nbsp;secan<br/>durante&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;cuarenta<br/>y&nbsp;&nbsp;&nbsp;&nbsp;ocho&nbsp;&nbsp;&nbsp;&nbsp;horas.
        </div>`,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Tienes una columna lateral donde solo caben 28 caracteres por línea. ¿Qué alineación evita los «ríos de blanco»?',
      opciones: ops.map((o) => ({
        texto: o.texto,
        describir: o.describir,
        pintar: (d) => {
          d.innerHTML = o.html;
        },
      })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Cuando caben tres o cuatro palabras por línea, forzar la justificación reparte todo el espacio sobrante en dos o tres huecos enormes. Alinear a la izquierda preserva el ritmo entre palabras.',
      repaso: 'Ríos de blanco en columnas estrechas',
    };
  }

  function rondaCuerpoYMedida(): Ronda {
    const ops = barajar([
      {
        texto: 'Con letra de 16 px (~64 caracteres por renglón)',
        describir: 'Caja de 500 px con cuerpo de 16 px y medida cómoda de 64 caracteres.',
        es: true,
        html: `<div style="padding:10px 12px;background:#fff;border:1.5px solid #222;text-align:left;font-family:${SERIF};font-size:13px;line-height:1.45;color:#222;">
          <span style="display:block;font-family:${SANS};font-size:9.5px;font-weight:700;color:#222;margin-bottom:4px;">CAJA DE 500 PX · LETRA DE 16 PX (~64 CH)</span>
          En la misma caja de 500 px, un cuerpo de 16 px produce unos 64 caracteres por línea y se lee con fluidez.
        </div>`,
      },
      {
        texto: 'Con letra de 28 px (~34 caracteres por renglón)',
        describir: 'La misma caja de 500 px con cuerpo de 28 px donde caben pocas letras por renglón.',
        es: false,
        html: `<div style="padding:10px 12px;background:#fff;border:1px solid #ccc;text-align:left;font-family:${SERIF};font-size:18px;line-height:1.25;color:#222;">
          <span style="display:block;font-family:${SANS};font-size:9.5px;font-weight:700;color:${COTA};margin-bottom:4px;">CAJA DE 500 PX · LETRA DE 28 PX (~34 CH)</span>
          El cuerpo grande reduce la medida a pocas palabras por renglón.
        </div>`,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Ambas cajas miden exactamente 500 píxeles de ancho. ¿Cuál conserva una medida adecuada para leer varios párrafos seguidos?',
      opciones: ops.map((o) => ({
        texto: o.texto,
        describir: o.describir,
        pintar: (d) => {
          d.innerHTML = o.html;
        },
      })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'La misma caja en píxeles cambia de medida al modificar el tamaño de la fuente: a mayor cuerpo de letra, menos caracteres entran en cada renglón.',
      repaso: 'Relación entre cuerpo y ancho de caja',
    };
  }

  function rondaMulticolumna(): Ronda {
    const ops = barajar([
      {
        texto: 'Dos columnas de ~48 caracteres separadas por una calle clara',
        describir: 'Página apaisada dividida en dos columnas cómodas de 48 caracteres.',
        es: true,
        html: `<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:10px 12px;background:#fff;border:1.5px solid #222;text-align:left;font-family:${SERIF};font-size:11px;line-height:1.4;color:#222;">
          <div>En formatos anchos, dividir el texto en dos columnas acerca la medida al rango de 40 a 50 caracteres.</div>
          <div>Cada columna se recorre con pocas fijaciones y el salto al renglón siguiente resulta seguro.</div>
        </div>`,
      },
      {
        texto: 'Una sola columna de ~115 caracteres que cruza todo el pliego',
        describir: 'Página apaisada con una única línea larguísima de lado a lado.',
        es: false,
        html: `<div style="padding:10px 12px;background:#fff;border:1px solid #ccc;text-align:left;font-family:${SERIF};font-size:9.5px;line-height:1.4;color:#222;">
          En formatos anchos, dejar una sola columna de más de cien caracteres obliga a recorrer toda la lámina horizontal en cada línea y multiplica los tropiezos al regresar al margen izquierdo.
        </div>`,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Diseñas un catálogo impreso en formato horizontal. ¿Qué disposición mantiene una medida descansada para el lector?',
      opciones: ops.map((o) => ({
        texto: o.texto,
        describir: o.describir,
        pintar: (d) => {
          d.innerHTML = o.html;
        },
      })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Para páginas de varias columnas, Bringhurst recomienda entre 40 y 50 caracteres por línea: así se aprovecha el formato apaisado sin estirar los renglones.',
      repaso: 'Medida en retículas multicolumna',
    };
  }

  function rondaAjusteMedida(): Ronda {
    return {
      tipo: 'ajuste',
      pregunta: 'Este artículo en pantalla ancha tiene unos 120 caracteres por línea. Ajusta el ancho de la columna hasta dejar la medida dentro del rango cómodo de 55 a 70 caracteres.',
      control: {
        etiqueta: 'Medida de la columna de lectura',
        min: 30,
        max: 120,
        paso: 5,
        valor: 120,
        unidad: 'ch',
      },
      pintar: (c, v) => {
        const ok = v >= 55 && v <= 70;
        const pctW = Math.max(32, Math.min(100, Math.round((v / 120) * 100)));
        c.innerHTML = `
          <div style="padding:14px;background:#fbfbf9;border:1px solid #dcdcd6;text-align:left;">
            <p style="margin:0 0 6px;font-family:${SANS};font-size:10.5px;font-weight:700;color:${ok ? TINTA : COTA};">
              MEDIDA ACTUAL: ${v} CARACTERES POR LÍNEA ${ok ? '· RANGO ÓPTIMO (55–70 CH)' : ''}
            </p>
            <div style="width:${pctW}%;padding:10px 12px;background:#ffffff;border:1.5px solid ${ok ? TINTA : COTA};font-family:${SERIF};font-size:12.5px;line-height:1.48;color:#222;">
              La lectura fluida ocurre cuando la vista abarca el renglón en unas pocas fijaciones y vuelve al comienzo de la línea siguiente sin dudar.
            </div>
          </div>`;
      },
      cumple: (v) => v >= 55 && v <= 70,
      falta: (v) =>
        v > 70
          ? `Con ${v} ch la línea sigue siendo demasiado larga. Acota más la columna.`
          : `Con ${v} ch la columna quedó demasiado estrecha. Ábrela hasta al menos 55 ch.`,
      porque: 'Entre 55 y 70 caracteres por línea, el párrafo combina buen ritmo horizontal con un barrido de retorno corto y seguro.',
      repaso: 'Ajuste de la medida óptima',
    };
  }

  const root = document.querySelector<HTMLElement>(`[data-juego="${lab}"]`);
  if (root) {
    jugar(root, () =>
      barajar([
        rondaUnidadMedida(),
        rondaRiosJustificado(),
        rondaCuerpoYMedida(),
        rondaMulticolumna(),
        rondaAjusteMedida(),
      ]),
    );
  }
</script>
