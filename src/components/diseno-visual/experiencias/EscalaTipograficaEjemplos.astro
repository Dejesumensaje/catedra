---
// Paso 4 de escalas: tres piezas reales. En las tres, el tamaño dice qué
// importa, y no siempre coincide con lo que va primero.
import Anotada from '../Anotada.astro';

const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const SERIF = "'PT Serif', Georgia, serif";
const T = '#222222';
const G = '#5f5f5f';

const CW = 300; const CH = 420;
const cp = (x: number, y: number) => ({ x: (x / CW) * 100, y: (y / CH) * 100 });
const cz = (x: number, y: number, w: number, h: number) => ({ x: (x / CW) * 100, y: (y / CH) * 100, w: (w / CW) * 100, h: (h / CH) * 100 });
const dias = [['Mañana', '26° / 16°'], ['Jueves', '25° / 17°'], ['Viernes', '23° / 16°'], ['Sábado', '27° / 18°']];

const MW = 340; const MH = 250;
const mp = (x: number, y: number) => ({ x: (x / MW) * 100, y: (y / MH) * 100 });
const mz = (x: number, y: number, w: number, h: number) => ({ x: (x / MW) * 100, y: (y / MH) * 100, w: (w / MW) * 100, h: (h / MH) * 100 });

const PW = 300; const PH = 380;
const pp = (x: number, y: number) => ({ x: (x / PW) * 100, y: (y / PH) * 100 });
const pz = (x: number, y: number, w: number, h: number) => ({ x: (x / PW) * 100, y: (y / PH) * 100, w: (w / PW) * 100, h: (h / PH) * 100 });
---

<div class="dv-anotadas">
  <Anotada
    rotulo="Una aplicación del clima"
    notas={[
      { ...cp(300, 120), texto: 'La temperatura es el dato que se viene a buscar. Por eso es, por mucho, el nivel más grande.', zona: cz(18, 62, 200, 100) },
      { ...cp(300, 40), texto: 'La ciudad va arriba, pero en tamaño pequeño, porque ya sabes dónde estás. Estar arriba y ser lo más grande son dos decisiones distintas.', zona: cz(18, 22, 200, 30) },
      { ...cp(300, 320), texto: 'El pronóstico de la semana usa el tamaño más pequeño. Está disponible para quien lo busque.', zona: cz(18, 250, 264, 150) },
    ]}
  >
    <svg viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label="Pantalla de una aplicación del clima con la temperatura en grande.">
      <text x="24" y="44" font-family={SANS} font-weight="500" font-size="15" fill={T}>Medellín</text>
      <text x="20" y="150" font-family={SANS} font-weight="400" font-size="96" letter-spacing="-4" fill={T}>24°</text>
      <text x="24" y="190" font-family={SANS} font-size="18" fill={T}>Parcialmente nublado</text>
      <text x="24" y="214" font-family={SANS} font-size="13" fill={G}>Máxima 27° · Mínima 17°</text>
      <line x1="24" y1="244" x2="276" y2="244" stroke="#e5e5e5" />
      {dias.map(([d, t], i) => (
        <g>
          <text x="24" y={274 + i * 34} font-family={SANS} font-size="12" fill={T}>{d}</text>
          <text x="276" y={274 + i * 34} text-anchor="end" font-family={SANS} font-size="12" fill={T}>{t}</text>
        </g>
      ))}
    </svg>
  </Anotada>

  <Anotada
    rotulo="La ficha junto a un cuadro (artista y obra inventadas)"
    notas={[
      { ...mp(340, 66), texto: 'El título de la obra es el nivel mayor: es lo que la gente va a buscar o a recordar.', zona: mz(16, 42, 300, 34) },
      { ...mp(340, 30), texto: 'El nombre de la artista, un nivel por debajo y en negrita. Se encuentra rápido sin quitarle el lugar a la obra.', zona: mz(16, 14, 300, 26) },
      { ...mp(340, 98), texto: 'Año y técnica en el nivel más pequeño: datos para consultar, no para leer de lejos.', zona: mz(16, 84, 300, 22) },
      { ...mp(340, 170), texto: 'El texto que explica la obra usa un tamaño cómodo para leer de pie, a un metro de distancia.', zona: mz(16, 118, 300, 112) },
    ]}
  >
    <svg viewBox={`0 0 ${MW} ${MH}`} role="img" aria-label="Ficha de museo con nombre de la artista, título de la obra, datos y un párrafo.">
      <text x="22" y="34" font-family={SANS} font-weight="700" font-size="15" fill={T}>Inés Duque</text>
      <text x="22" y="68" font-family={SERIF} font-style="italic" font-weight="700" font-size="25" fill={T}>Mercado de domingo</text>
      <text x="22" y="98" font-family={SANS} font-size="11" fill={G}>1958 · Óleo sobre tela · 90 × 120 cm</text>
      <text font-family={SERIF} font-size="13" fill={T}>
        <tspan x="22" y="136">Pintó el mercado desde una ventana durante</tspan>
        <tspan x="22" y="156">tres domingos seguidos. Cada visita añadió</tspan>
        <tspan x="22" y="176">gente al cuadro, pero ninguna cara: solo</tspan>
        <tspan x="22" y="196">sombreros, canastos y el color de las frutas.</tspan>
      </text>
    </svg>
  </Anotada>

  <Anotada
    rotulo="Un producto en una tienda en línea"
    notas={[
      { ...pp(300, 230), texto: 'El precio es lo más grande de la ficha porque es lo que decide la compra.', zona: pz(18, 206, 160, 36) },
      { ...pp(300, 186), texto: 'El nombre, un nivel por debajo: dice qué es sin competir con el precio.', zona: pz(18, 168, 264, 28) },
      { ...pp(300, 300), texto: 'La descripción y el envío van en tamaño de lectura o menor. Responden dudas sin llamar la atención.', zona: pz(18, 256, 264, 100) },
    ]}
  >
    <svg viewBox={`0 0 ${PW} ${PH}`} role="img" aria-label="Ficha de producto con imagen, nombre, precio grande y descripción.">
      <rect x="24" y="20" width="252" height="130" fill="#d9d9d3" />
      <circle cx="150" cy="85" r="40" fill="none" stroke={T} stroke-width="3" />
      <text x="24" y="188" font-family={SANS} font-weight="500" font-size="17" fill={T}>Taza de barro, 350 ml</text>
      <text x="24" y="234" font-family={SANS} font-weight="900" font-size="32" fill={T}>$38.000</text>
      <text font-family={SERIF} font-size="13" fill={T}>
        <tspan x="24" y="276">Hecha a mano en El Carmen de Viboral.</tspan>
        <tspan x="24" y="296">Cada pieza es un poco distinta.</tspan>
      </text>
      <text x="24" y="336" font-family={SANS} font-size="11" fill={G}>Envío en 3 a 5 días hábiles</text>
    </svg>
  </Anotada>
</div>
