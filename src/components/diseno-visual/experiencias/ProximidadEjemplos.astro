---
// Paso 4 de proximidad: tres piezas reales con marcas. Las tres usan el
// mismo recurso con materiales distintos: un menú, una pantalla y un cartel.
import Anotada from '../Anotada.astro';

const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const SERIF = "'PT Serif', Georgia, serif";
const T = '#222222';
const G = '#6f6f6f';

// ── menú ────────────────────────────────────────
const MW = 320; const MH = 380;
const entradas = [
  ['Empanadas de pipián', 'Tres unidades, ají de maní', '$14.000'],
  ['Sopa de tortilla', 'Aguacate y queso fresco', '$18.000'],
  ['Patacón con hogao', 'Plátano verde, tomate, cebolla', '$16.000'],
];
const fuertes = [
  ['Bandeja de la casa', 'Fríjoles, arroz, chicharrón', '$38.000'],
  ['Trucha al ajillo', 'Papa criolla y ensalada', '$42.000'],
];
const mp = (x: number, y: number) => ({ x: (x / MW) * 100, y: (y / MH) * 100 });

// ── ajustes ─────────────────────────────────────
const AW = 320; const AH = 420;
const ap = (x: number, y: number) => ({ x: (x / AW) * 100, y: (y / AH) * 100 });

// ── cartel ──────────────────────────────────────
const CW = 320; const CH = 440;
const cp = (x: number, y: number) => ({ x: (x / CW) * 100, y: (y / CH) * 100 });
---

<div class="dv-anotadas">
  <Anotada
    rotulo="Un menú"
    notas={[
      { ...mp(320, 66), texto: 'El nombre y la descripción de un plato están juntos porque hablan de lo mismo.', zona: { x: 5, y: (54 / MH) * 100, w: 90, h: (30 / MH) * 100 } },
      { ...mp(320, 100), texto: 'Una separación mayor entre platos permite distinguir cada opción sin convertir cada renglón en una pieza independiente.', zona: { x: 5, y: (92 / MH) * 100, w: 90, h: (14 / MH) * 100 } },
      { ...mp(320, 222), texto: 'El título de una sección está más cerca de los platos que presenta que de los anteriores.', zona: { x: 5, y: (196 / MH) * 100, w: 90, h: (60 / MH) * 100 } },
      { ...mp(320, 280), texto: 'El precio puede estar lejos del nombre y seguir relacionado con él gracias a la alineación. El espacio no es la única señal que organiza la lectura.', zona: { x: 66, y: (264 / MH) * 100, w: 30, h: (22 / MH) * 100 } },
    ]}
  >
    <svg viewBox={`0 0 ${MW} ${MH}`} role="img" aria-label="Menú de restaurante con dos secciones, Entradas y Platos fuertes.">
      <text x="24" y="40" font-family={SANS} font-weight="700" font-size="11" letter-spacing="2" fill={T}>ENTRADAS</text>
      {entradas.map(([nom, desc, precio], i) => (
        <g>
          <text x="24" y={72 + i * 50} font-family={SERIF} font-weight="700" font-size="15" fill={T}>{nom}</text>
          <text x="296" y={72 + i * 50} text-anchor="end" font-family={SANS} font-size="13" fill={T}>{precio}</text>
          <text x="24" y={89 + i * 50} font-family={SERIF} font-size="12" fill={G}>{desc}</text>
        </g>
      ))}
      <text x="24" y="250" font-family={SANS} font-weight="700" font-size="11" letter-spacing="2" fill={T}>PLATOS FUERTES</text>
      {fuertes.map(([nom, desc, precio], i) => (
        <g>
          <text x="24" y={282 + i * 50} font-family={SERIF} font-weight="700" font-size="15" fill={T}>{nom}</text>
          <text x="296" y={282 + i * 50} text-anchor="end" font-family={SANS} font-size="13" fill={T}>{precio}</text>
          <text x="24" y={299 + i * 50} font-family={SERIF} font-size="12" fill={G}>{desc}</text>
        </g>
      ))}
    </svg>
  </Anotada>

  <Anotada
    rotulo="Una pantalla de ajustes"
    notas={[
      { ...ap(320, 92), texto: 'Cada título de sección tiene más espacio encima que debajo. Así queda visualmente asociado con las opciones que introduce.', zona: { x: 5, y: (72 / AH) * 100, w: 90, h: (106 / AH) * 100 } },
      { ...ap(320, 196), texto: 'La separación mayor aparece entre secciones, porque cada una trata un tema distinto.', zona: { x: 5, y: (180 / AH) * 100, w: 90, h: (26 / AH) * 100 } },
      { ...ap(160, 248), texto: 'La etiqueta y el interruptor pueden estar en extremos opuestos de una fila. La alineación y las líneas divisorias ayudan a mantener su relación.', zona: { x: 5, y: (228 / AH) * 100, w: 90, h: (30 / AH) * 100 } },
    ]}
  >
    <svg viewBox={`0 0 ${AW} ${AH}`} role="img" aria-label="Pantalla de ajustes con tres secciones: Cuenta, Notificaciones y Privacidad.">
      <text x="24" y="46" font-family={SANS} font-weight="900" font-size="24" fill={T}>Ajustes</text>

      <text x="24" y="96" font-family={SANS} font-weight="700" font-size="11" letter-spacing="1.5" fill={G}>CUENTA</text>
      <text x="24" y="124" font-family={SANS} font-size="15" fill={T}>Perfil</text>
      <text x="292" y="124" text-anchor="end" font-family={SANS} font-size="15" fill={G}>›</text>
      <line x1="24" y1="140" x2="296" y2="140" stroke="#e5e5e5" />
      <text x="24" y="164" font-family={SANS} font-size="15" fill={T}>Contraseña</text>
      <text x="292" y="164" text-anchor="end" font-family={SANS} font-size="15" fill={G}>›</text>

      <text x="24" y="222" font-family={SANS} font-weight="700" font-size="11" letter-spacing="1.5" fill={G}>NOTIFICACIONES</text>
      <text x="24" y="250" font-family={SANS} font-size="15" fill={T}>Por correo</text>
      <rect x="258" y="237" width="38" height="18" fill={T} />
      <rect x="279" y="240" width="14" height="12" fill="#fff" />
      <line x1="24" y1="266" x2="296" y2="266" stroke="#e5e5e5" />
      <text x="24" y="290" font-family={SANS} font-size="15" fill={T}>Mensajes</text>
      <rect x="258" y="277" width="38" height="18" fill="#fff" stroke={T} stroke-width="1.5" />
      <rect x="261" y="280" width="14" height="12" fill={T} />

      <text x="24" y="348" font-family={SANS} font-weight="700" font-size="11" letter-spacing="1.5" fill={G}>PRIVACIDAD</text>
      <text x="24" y="376" font-family={SANS} font-size="15" fill={T}>Ubicación</text>
      <text x="292" y="376" text-anchor="end" font-family={SANS} font-size="15" fill={G}>Nunca ›</text>
    </svg>
  </Anotada>

  <Anotada
    rotulo="Un cartel"
    notas={[
      { ...cp(320, 40), texto: 'Las líneas del título están muy juntas y se perciben como una sola unidad.', zona: { x: 5, y: (20 / CH) * 100, w: 90, h: (104 / CH) * 100 } },
      { ...cp(320, 348), texto: 'La fecha, el lugar y el precio aparecen agrupados para que la información práctica se encuentre de un vistazo.', zona: { x: 5, y: (330 / CH) * 100, w: 64, h: (56 / CH) * 100 } },
      { ...cp(320, 418), texto: 'El nombre de quien organiza queda separado y tiene menos protagonismo. Así no compite con los datos necesarios para asistir.', zona: { x: 5, y: (402 / CH) * 100, w: 90, h: (28 / CH) * 100 } },
    ]}
  >
    <svg viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label="Cartel de un festival de cine de barrio, con título, una figura geométrica y los datos prácticos agrupados abajo.">
      <text font-family={SANS} font-weight="900" font-size="34" letter-spacing="-1" fill={T}>
        <tspan x="22" y="58">FESTIVAL</tspan>
        <tspan x="22" y="90">DE CINE</tspan>
        <tspan x="22" y="122">DE BARRIO</tspan>
      </text>
      <rect x="22" y="160" width="276" height="140" fill="#e4572e" stroke={T} stroke-width="2" />
      <circle cx="120" cy="230" r="46" fill={T} />
      <rect x="180" y="190" width="80" height="80" fill="none" stroke={T} stroke-width="8" />
      <text x="22" y="348" font-family={SANS} font-weight="900" font-size="18" fill={T}>12 — 15 de noviembre</text>
      <text x="22" y="366" font-family={SANS} font-size="13" fill={T}>Teatro del barrio, 7:00 p. m.</text>
      <text x="22" y="382" font-family={SANS} font-size="13" fill={T}>Entrada libre</text>
      <text x="22" y="420" font-family={SANS} font-size="10" fill={G}>Organiza el colectivo de cine del barrio</text>
    </svg>
  </Anotada>
</div>
