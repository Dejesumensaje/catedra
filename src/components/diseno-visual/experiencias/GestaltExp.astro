    <Anotada
      rotulo="Portada de álbum: una figura emergente construida solo con barras sueltas"
      notas={[
        {
          ...pct(330, 56),
          titulo: 'Prägnanz en el centro geométrico',
          texto: 'Dieciséis trazos verticales de distinta altura hacen emerger un círculo central aunque ninguna línea curva esté dibujada.',
          zona: zona(90, 34, 180, 156),
        },
        {
          ...pct(330, 148),
          titulo: 'Repetición rítmica de las partes',
          texto: 'La separación constante entre barras permite que el ojo compare sus extremos como un contorno continuo.',
          zona: zona(98, 52, 164, 120),
        },
        {
          ...pct(330, 232),
          titulo: 'Créditos agrupados como bloque único',
          texto: 'Autor y título se sitúan al pie con el mismo ancho que la figura superior, cerrando un rectángulo general estable.',
          zona: zona(70, 206, 220, 48),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Portada minimalista donde dieciséis barras verticales de distinta longitud hacen emerger la silueta de una esfera en el centro.">
        <rect width={W} height={H} fill="#1b1b1b" />
        <rect x="64" y="16" width="232" height="248" fill="#fbfbf9" stroke={T} stroke-width="1.5" />
        {Array.from({ length: 15 }, (_, i) => {
          const dx = (i - 7) / 7;
          const hSemi = Math.sqrt(Math.max(0, 1 - dx * dx)) * 58;
          const x = 103 + i * 11;
          return (
            <g>
              <line x1={x} y1={110 - hSemi} x2={x} y2={110 + hSemi} stroke={T} stroke-width="5" />
            </g>
          );
        })}
        <text x="180" y="218" text-anchor="middle" font-family={SANS} font-size="11" font-weight="900" letter-spacing="2" fill={T}>ENSAMBLE NORTE</text>
        <text x="180" y="236" text-anchor="middle" font-family={SERIF} font-size="12" font-style="italic" fill={TXT}>Variaciones sobre cámara acústica</text>
      </svg>
    </Anotada>
  </div>
)}

{paso === 'juego' && (
  <Juego
    slug={lab}
    rondas={5}
    descripcion="Cinco rondas sobre emergencia, buena forma (Prägnanz) y competencia entre señales perceptivas."
  />
)}

<script>
  import { conectar, svg } from '../../../lib/diseno-visual/estado';
  import { guiar } from '../../../lib/diseno-visual/guia';
  import { jugar, barajar, type Ronda } from '../../../lib/diseno-visual/juego';

  const TINTA = '#222222';
  const TXT = '#444444';
  const SEC = '#6f6f6f';
  const AMARILLO = '#eeff41';
  const COTA = '#b3261e';
  const SANS = 'Roboto, Helvetica, Arial, sans-serif';

  type E = {
    distancia: number;
    color: string;
    cajas: string;
    conexion: boolean;
    lectura: boolean;
  };

  function diagnosticar(e: E) {
    const dirs: { ley: string; dir: string; peso: number }[] = [];
    if (e.distancia >= 12) dirs.push({ ley: 'proximidad', dir: 'cuadrantes', peso: Math.round((e.distancia / 48) * 55) });
    if (e.color !== 'ninguno') dirs.push({ ley: 'semejanza cromática', dir: e.color, peso: 42 });
    if (e.cajas !== 'ninguna') dirs.push({ ley: 'región común', dir: e.cajas, peso: 78 });
    if (e.conexion) dirs.push({ ley: 'conexión uniforme', dir: 'filas', peso: 86 });

    if (dirs.length === 0) {
      return { estado: 'neutro', dominante: 'ninguna', dirGanadora: 'bloque único', conflicto: false, dirs };
    }
    const porDir = new Map<string, number>();
    for (const d of dirs) porDir.set(d.dir, (porDir.get(d.dir) ?? 0) + d.peso);
    const ordenadas = [... dirs].sort((a, b) => b.peso - a.peso);
    const unicas = new Set(dirs.map((d) => d.dir));
    return {
      estado: unicas.size === 1 ? 'cooperan' : 'compiten',
      dominante: ordenadas[0].ley,
      dirGanadora: ordenadas[0].dir,
      conflicto: unicas.size > 1,
      dirs,
    };
  }

  function pintar(destino: HTMLElement, e: E) {
    const W = Math.max(destino.clientWidth, 280);
    const H = 330;
    const raiz = svg('svg', { viewBox: `0 0 ${W} ${H}`, width: W, height: H, role: 'img' });
    const diag = diagnosticar(e);
    raiz.setAttribute(
      'aria-label',
      `Tablero de 16 piezas. Estado: ${diag.estado}; dirección dominante: ${diag.dirGanadora} por ${diag.dominante}.`,
    );
    raiz.append(svg('rect', { width: W, height: H, fill: '#fbfbf9' }));

    const cw = W < 460 ? 52 : 66;
    const ch = 40;
    const baseGap = 12;
    const extra = e.distancia;
    const totalW = cw * 4 + baseGap * 3 + extra;
    const totalH = ch * 4 + baseGap * 3 + extra * 0.75;
    const startX = (W - totalW) / 2;
    const startY = (H - (e.lectura ? 34 : 10) - totalH) / 2;

    const posX = (c: number) => startX + c * (cw + baseGap) + (c >= 2 ? extra : 0);
    const posY = (f: number) => startY + f * (ch + baseGap) + (f >= 2 ? extra * 0.75 : 0);

    // 1. Cajas de región común
    if (e.cajas === 'filas') {
      for (let f = 0; f < 4; f++) {
        raiz.append(
          svg('rect', {
            x: posX(0) - 7,
            y: posY(f) - 5,
            width: posX(3) + cw - posX(0) + 14,
            height: ch + 10,
            fill: '#f1f1ec',
            stroke: TINTA,
            'stroke-width': 1.8,
          }),
        );
      }
    } else if (e.cajas === 'columnas') {
      for (let c = 0; c < 4; c++) {
        raiz.append(
          svg('rect', {
            x: posX(c) - 6,
            y: posY(0) - 6,
            width: cw + 12,
            height: posY(3) + ch - posY(0) + 12,
            fill: '#f1f1ec',
            stroke: TINTA,
            'stroke-width': 1.8,
          }),
        );
      }
    } else if (e.cajas === 'cuadrantes') {
      for (const [f0, c0] of [[0, 0], [0, 2], [2, 0], [2, 2]]) {
        raiz.append(
          svg('rect', {
            x: posX(c0) - 7,
            y: posY(f0) - 6,
            width: posX(c0 + 1) + cw - posX(c0) + 14,
            height: posY(f0 + 1) + ch - posY(f0) + 12,
            fill: '#f1f1ec',
            stroke: TINTA,
            'stroke-width': 1.8,
          }),
        );
      }
    }

    // 2. Líneas de conexión uniforme
    if (e.conexion) {
      for (let f = 0; f < 4; f++) {
        const yMid = posY(f) + ch / 2;
        raiz.append(
          svg('line', {
            x1: posX(0) + cw / 2,
            y1: yMid,
            x2: posX(3) + cw / 2,
            y2: yMid,
            stroke: TINTA,
            'stroke-width': 5,
          }),
        );
      }
    }

    // 3. Los 16 elementos
    for (let f = 0; f < 4; f++) {
      for (let c = 0; c < 4; c++) {
        const x = posX(c);
        const y = posY(f);
        const cuad = (f >= 2 ? 2 : 0) + (c >= 2 ? 1 : 0);
        let indiceColor = -1;
        if (e.color === 'filas') indiceColor = f % 2;
        else if (e.color === 'columnas') indiceColor = c % 2;
        else if (e.color === 'cuadrantes') indiceColor = cuad % 2;

        const relleno = indiceColor === -1 ? '#ffffff' : indiceColor === 0 ? AMARILLO : TINTA;
        const colorTxt = relleno === TINTA ? '#ffffff' : TINTA;

        raiz.append(
          svg('rect', {
            x,
            y,
            width: cw,
            height: ch,
            fill: relleno,
            stroke: TINTA,
            'stroke-width': 1.6,
          }),
        );

        const t = svg('text', {
          x: x + cw / 2,
          y: y + ch / 2 + 4,
          'text-anchor': 'middle',
          'font-family': SANS,
          'font-size': 12,
          'font-weight': 700,
          fill: colorTxt,
        });
        t.textContent = String(f * 4 + c + 1).padStart(2, '0');
        raiz.append(t);
      }
    }

    // 4. Diagnóstico en vivo
    if (e.lectura) {
      const etq = diag.estado === 'neutro'
        ? 'SIN SEÑALES DIFERENCIALES · 1 BLOQUE DE 16'
        : diag.conflicto
          ? `CONFLICTO DE SEÑALES · SE IMPONE ${diag.dominante.toUpperCase()} (${diag.dirGanadora.toUpperCase()})`
          : `SEÑALES ALINEADAS · AGRUPACIÓN POR ${diag.dirGanadora.toUpperCase()}`;
      const pie = svg('text', {
        x: W / 2,
        y: H - 12,
        'text-anchor': 'middle',
        'font-family': SANS,
        'font-size': 11,
        'font-weight': 700,
        fill: diag.conflicto ? COTA : TINTA,
      });
      pie.textContent = etq;
      raiz.append(pie);
    }

    destino.replaceChildren(raiz);
  }

  function describir(e: E): string {
    const diag = diagnosticar(e);
    if (diag.estado === 'neutro') {
      return 'Sin señales diferenciales: las dieciséis fichas están a igual distancia y comparten el mismo aspecto. El ojo percibe <b class="dv-cifra">un único bloque de 16 piezas</b>.';
    }
    if (!diag.conflicto) {
      const lista = diag.dirs.map((d) => d.ley).join(' + ');
      return `Cooperación perceptual (${lista}): todas las señales activas agrupan <b class="dv-cifra">por ${diag.dirGanadora}</b>. La estructura se reconoce al instante sin esfuerzo.`;
    }
    const perdedoras = diag.dirs.slice(1).map((d) => `${d.ley} (${d.dir})`).join(' y ');
    return `Competencia perceptual: la <b class="dv-cifra">${diag.dominante}</b> agrupa por <b class="dv-cifra">${diag.dirGanadora}</b> y se impone sobre ${perdedoras}, pero el conflicto ralentiza la lectura.`;
  }

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-lab="gestalt"]')) {
    guiar<E>(raiz, [
      (e) => e.distancia === 0 && e.color === 'ninguno' && e.cajas === 'ninguna' && !e.conexion,
      (e) => e.distancia >= 28 && e.color === 'ninguno' && e.cajas === 'ninguna',
      (e) => e.distancia >= 24 && e.color === 'filas' && e.cajas === 'ninguna',
      (e) => e.cajas === 'columnas' && e.color === 'filas',
      (e) => e.distancia >= 24 && e.color === 'cuadrantes' && e.cajas === 'cuadrantes' && e.lectura,
    ]);
    conectar<E>({ raiz, pintar, describir });
  }

  // ── Especímenes de error ──────────────────────────────
  type E1 = { modo: string };
  function pintarE1(d: HTMLElement, e: E1) {
    const bgA = e.modo === 'conflicto' ? AMARILLO : e.modo === 'coopera' ? AMARILLO : '#ffffff';
    const bgB = e.modo === 'conflicto' ? '#ffffff' : e.modo === 'coopera' ? AMARILLO : '#ffffff';
    const bgC = e.modo === 'conflicto' ? AMARILLO : e.modo === 'coopera' ? '#222222' : '#ffffff';
    const bgD = e.modo === 'conflicto' ? '#ffffff' : e.modo === 'coopera' ? '#222222' : '#ffffff';
    const fgCD = e.modo === 'coopera' ? '#ffffff' : '#222222';
    d.innerHTML = `
      <div style="padding:16px 18px;font-family:${SANS};color:#222;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:24px;">
          <div style="display:flex;gap:6px;">
            <span style="padding:7px 11px;border:1.8px solid #222;background:${bgA};font-size:12px;font-weight:700;">Negrita</span>
            <span style="padding:7px 11px;border:1.8px solid #222;background:${bgB};font-size:12px;font-weight:700;">Cursiva</span>
          </div>
          <div style="display:flex;gap:6px;">
            <span style="padding:7px 11px;border:1.8px solid #222;background:${bgC};color:${fgCD};font-size:12px;font-weight:700;">Exportar</span>
            <span style="padding:7px 11px;border:1.8px solid #222;background:${bgD};color:${fgCD};font-size:12px;font-weight:700;">Imprimir</span>
          </div>
        </div>
      </div>`;
  }
  function describirE1(e: E1) {
    if (e.modo === 'conflicto') return 'El espacio separa «Formato» y «Salida», pero el color amarillo salta de un grupo a otro y <b class="dv-cifra">contradice la distancia</b>.';
    if (e.modo === 'neutro') return 'Al unificar el color, desaparece el conflicto y <b class="dv-cifra">la proximidad organiza sola</b> los dos pares.';
    return '<b class="dv-cifra">Proximidad y semejanza cooperan</b>: espacio y color separan sin duda las acciones de texto de las de archivo.';
  }

  type E2 = { limpieza: number };
  function pintarE2(d: HTMLElement, e: E2) {
    const k = e.limpieza / 100;
    const bw = Math.max(0, 2.5 - k * 2.5);
    const shadow = k < 0.4 ? '4px 4px 0 #222' : 'none';
    const items = [
      ['09:00', 'Laboratorio perceptual'],
      ['11:00', 'Revisión de retículas'],
      ['14:00', 'Seminario de lectura'],
    ];
    d.innerHTML = `
      <div style="padding:16px 18px;font-family:${SANS};color:#222;">
        <div style="display:grid;gap:${k > 0.6 ? '8px' : '10px'};">
          ${items.map(([h, t]) => `
            <div style="display:flex;justify-content:space-between;padding:8px 10px;background:#fff;border:${bw > 0.3 ? `${bw.toFixed(1)}px solid #222` : 'none'};border-bottom:1px solid #e5e5e5;box-shadow:${shadow};">
              <strong style="font-size:12px;">${h}</strong>
              <span style="font-size:12.5px;color:#444;">${t}</span>
            </div>
          `).join('')}
        </div>
      </div>`;
  }
  function describirE2(e: E2) {
    if (e.limpieza < 40) return 'Tres cajas pesadas con sombra dura: cada fila se cierra sobre sí misma y <b class="dv-cifra">rompe la unidad de la tabla</b>.';
    if (e.limpieza < 80) return 'Sin sombras dobles, la columna de horas y la de temas empiezan a leerse como un conjunto.';
    return '<b class="dv-cifra">Máxima pregnancia</b>: la alineación y una sutil línea divisoria bastan para organizar el horario con la mitad de tinta.';
  }

  type E3 = { senales: number };
  function pintarE3(d: HTMLElement, e: E3) {
    const gap = e.senales >= 1 ? 18 : 4;
    const caja = e.senales >= 2 ? 'padding:8px 10px;border:1.8px solid #222;background:#fbfbf9;' : 'padding:4px 0;';
    const alerta = e.senales >= 3 ? 'background:#eeff41;border:2px solid #222;padding:8px 10px;' : caja;
    d.innerHTML = `
      <div style="padding:16px 18px;font-family:${SANS};color:#222;font-size:12.5px;">
        <div style="padding:5px 0;border-bottom:1px solid #e5e5e5;">Idioma de la interfaz · Español</div>
        <div style="padding:5px 0;border-bottom:1px solid #e5e5e5;">Resumen semanal por correo · Activo</div>
        <div style="margin-top:${gap}px;${alerta}font-weight:${e.senales >= 2 ? 700 : 400};">
          ${e.senales >= 3 ? 'ZONA CRÍTICA · ' : ''}Eliminar cuenta y borrar archivos
        </div>
      </div>`;
  }
  function describirE3(e: E3) {
    if (e.senales === 0) return '<b class="dv-cifra">0 señales</b>: la acción destructiva parece una preferencia más de la lista.';
    if (e.senales === 1) return '<b class="dv-cifra">1 señal (proximidad)</b>: el espacio separa la opción, aunque mantiene el mismo aspecto.';
    if (e.senales === 2) return '<b class="dv-cifra">2 señales (espacio + región)</b>: el marco cerrado ya advierte que pertenece a otra categoría.';
    return '<b class="dv-cifra">3 señales sumadas</b>: distancia, región común y contraste cooperan para evitar un clic accidental.';
  }

  for (const [id, p, desc] of [
    ['gestalt-e1', pintarE1, describirE1],
    ['gestalt-e2', pintarE2, describirE2],
    ['gestalt-e3', pintarE3, describirE3],
  ] as const) {
    for (const r of document.querySelectorAll<HTMLElement>(`[data-lab="${id}"]`)) {
      conectar({ raiz: r, pintar: p as never, describir: desc as never });
    }
  }

  // ── Juego de 5 rondas ─────────────────────────────────
  function rEmergencia(): Ronda {
    const ops = barajar([
      {
        texto: 'Emergencia: percibimos la configuración global antes que las piezas individuales',
        es: true,
      },
      {
        texto: 'Suma lineal: primero contamos cada punto y después calculamos la figura',
        es: false,
      },
      {
        texto: 'Fatiga retiniana: los puntos se funden porque el ojo pierde nitidez',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Cuando doce puntos dispuestos en anillo se ven de inmediato como «un círculo» antes de contar los puntos, ¿qué fenómeno ocurre?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'La emergencia perceptual hace que las relaciones espaciales entre las partes generen una forma global que se percibe antes que los elementos aislados.',
      repaso: 'Emergencia perceptual',
    };
  }

  function rPragnanz(): Ronda {
    const ops = barajar([
      {
        texto: 'Un cuadrado y un círculo superpuestos (dos figuras simples y simétricas)',
        es: true,
      },
      {
        texto: 'Tres polígonos irregulares con muescas que casualmente se tocan por los bordes',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Según el principio de Prägnanz (buena forma), ¿cómo tiende a organizar el sistema visual dos contornos que se cruzan?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'La ley de la buena forma establece que el sistema visual prefiere la interpretación más regular, simétrica y estable posible antes que fragmentar la escena en piezas arbitrarias.',
      repaso: 'Principio de Prägnanz',
    };
  }

  function rCompetencia(): Ronda {
    const ops = barajar([
      {
        texto: 'La región común (el marco cerrado) suele imponerse sobre el parecido de color',
        es: true,
      },
      {
        texto: 'Ambas señales se anulan por completo y dejan de verse los elementos',
        es: false,
      },
      {
        texto: 'El color siempre vence a cualquier línea o marco contenedor',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Dos fichas de distinto color están encerradas dentro de una misma caja con borde, mientras otra ficha del mismo color queda fuera. ¿Qué señal suele ganar?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Los experimentos de Stephen Palmer (1992) demostraron que el cerramiento explícito de una región común o una línea conectora suele dominar sobre la proximidad y la semejanza.',
      repaso: 'Competencia entre leyes',
    };
  }

  function rKoffka(): Ronda {
    const ops = barajar([
      {
        texto: '«El todo es algo distinto de la suma de sus partes»',
        es: true,
      },
      {
        texto: '«Cuantos más elementos tenga una página, mayor será su impacto»',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Kurt Koffka corrigió la traducción popular de la Gestalt. ¿Cuál es su formulación exacta?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Koffka (1935) aclaró que no se trata de que el todo sea «más» que la suma, sino de que el conjunto posee propiedades estructurales propias que no existen en las partes sueltas.',
      repaso: 'Tesis de Koffka',
    };
  }

  function rAjusteCooperacion(): Ronda {
    return {
      tipo: 'ajuste',
      pregunta: 'Los colores agrupan estos seis botones en dos pares, pero todos están a la misma distancia. Abre el espacio entre los dos grupos para que la proximidad coopere con el color.',
      control: {
        etiqueta: 'Espacio entre el grupo A y el grupo B',
        min: 4,
        max: 48,
        paso: 4,
        valor: 4,
        unidad: 'px',
      },
      pintar: (esc, v) => {
        esc.innerHTML = `
          <div style="display:flex;justify-content:center;align-items:center;padding:18px;font-family:${SANS};">
            <div style="display:flex;gap:6px;">
              <span style="padding:7px 11px;border:1.8px solid #222;background:${AMARILLO};font-size:12px;font-weight:700;color:#222;">Cortar</span>
              <span style="padding:7px 11px;border:1.8px solid #222;background:${AMARILLO};font-size:12px;font-weight:700;color:#222;">Copiar</span>
              <span style="padding:7px 11px;border:1.8px solid #222;background:${AMARILLO};font-size:12px;font-weight:700;color:#222;">Pegar</span>
            </div>
            <div style="width:${v}px;"></div>
            <div style="display:flex;gap:6px;">
              <span style="padding:7px 11px;border:1.8px solid #222;background:#fff;font-size:12px;font-weight:700;color:#222;">Compartir</span>
              <span style="padding:7px 11px;border:1.8px solid #222;background:#fff;font-size:12px;font-weight:700;color:#222;">Exportar</span>
              <span style="padding:7px 11px;border:1.8px solid #222;background:#fff;font-size:12px;font-weight:700;color:#222;">Archivar</span>
            </div>
          </div>`;
      },
      cumple: (v) => v >= 24,
      falta: (v) => `Con ${v} px la brecha entre grupos aún se parece demasiado al espacio interno (6 px). Ábrela al menos a 24 px.`,
      porque: 'Cuando la distancia entre grupos al menos triplica el espacio interno y además coincide con el cambio de color, proximidad y semejanza se refuerzan mutuamente.',
      repaso: 'Cooperación entre proximidad y semejanza',
    };
  }

  const juegoEl = document.querySelector<HTMLElement>('[data-juego="gestalt"]');
  if (juegoEl) {
    jugar(juegoEl, () =>
      barajar([rEmergencia(), rPragnanz(), rCompetencia(), rKoffka(), rAjusteCooperacion()]),
    );
  }
</script>
