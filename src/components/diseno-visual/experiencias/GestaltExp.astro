---
import Anotada from '../Anotada.astro';
import Instrumento from '../controles/Instrumento.astro';
import Deslizador from '../controles/Deslizador.astro';
import Opciones from '../controles/Opciones.astro';
import Interruptor from '../controles/Interruptor.astro';
import Guia, { type PasoGuia } from '../controles/Guia.astro';
import Juego from '../Juego.astro';

interface Props {
  paso: 'idea' | 'miralo' | 'pruebalo' | 'errores' | 'ejemplos' | 'juego';
}

const { paso } = Astro.props;
const lab = 'gestalt';

const T = '#222222';
const TXT = '#444444';
const G = '#6f6f6f';
const REGLA = '#e5e5e5';
const AMARILLO = '#eeff41';
const ROJO = '#b3261e';
const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const SERIF = "'PT Serif', Georgia, serif";

const W = 360;
const H = 280;
const pct = (x: number, y: number) => ({ x: Math.round((x / W) * 100), y: Math.round((y / H) * 100) });
const zona = (x: number, y: number, w: number, h: number) => ({
  x: Math.round((x / W) * 100),
  y: Math.round((y / H) * 100),
  w: Math.round((w / W) * 100),
  h: Math.round((h / H) * 100),
});

const anillo = Array.from({ length: 12 }, (_, i) => {
  const ang = (i / 12) * Math.PI * 2 - Math.PI / 2;
  return { x: Math.round(155 + Math.cos(ang) * 54), y: Math.round(92 + Math.sin(ang) * 54) };
});

const azarosos = [
  { x: 365, y: 42 }, { x: 418, y: 68 }, { x: 472, y: 38 }, { x: 536, y: 58 },
  { x: 382, y: 106 }, { x: 446, y: 96 }, { x: 502, y: 114 }, { x: 554, y: 102 },
  { x: 356, y: 146 }, { x: 412, y: 152 }, { x: 484, y: 148 }, { x: 540, y: 144 },
];

const pasos: PasoGuia[] = [
  {
    titulo: 'Parte de un campo sin estructura.',
    hacer: 'Lleva «Distancia entre grupos» a 0 px y desactiva las demás señales.',
    pista: 'Pon el deslizador al mínimo, «Parecido por color» en «Ninguno», «Cajas contenedoras» en «Ninguna» y apaga «Línea conectora».',
    preparar: { distancia: 0, color: 'ninguno', cajas: 'ninguna', conexion: false },
    logro: 'Los dieciséis elementos forman una retícula uniforme de 4 × 4. Sin diferencias de espacio, color ni contorno, el sistema visual percibe un único bloque indiviso.',
  },
  {
    titulo: 'Agrupa mediante el espacio.',
    hacer: 'Sube «Distancia entre grupos» a 28 px o más.',
    pista: 'Arrastra el primer deslizador hacia la derecha.',
    logro: 'Con solo abrir un corredor central horizontal y vertical, el bloque único se divide en cuatro cuadrantes de cuatro piezas. La proximidad organiza antes de añadir una sola línea.',
  },
  {
    titulo: 'Pon dos señales a competir.',
    hacer: 'En «Parecido por color», elige «Por filas».',
    pista: 'Selecciona la segunda opción de «Parecido por color» manteniendo la distancia alta.',
    preparar: { distancia: 32, cajas: 'ninguna', conexion: false },
    logro: 'Ahora el espacio pide leer cuatro cuadrantes, mientras el color pide leer filas horizontales. La mirada duda porque dos principios de organización apuntan en direcciones opuestas.',
  },
  {
    titulo: 'Desempata con una región común.',
    hacer: 'En «Cajas contenedoras», selecciona «Por columnas».',
    pista: 'Activa el contorno por columnas verticales.',
    logro: 'El marco cerrado alrededor de cada columna impone una frontera explícita que supera al parecido cromático. Las señales de cerramiento y conexión suelen pesar más que la distancia o el color.',
  },
  {
    titulo: 'Haz que todas las señales cooperen.',
    hacer: 'Abre «Más controles», activa «Mostrar qué ley domina» y alinea color y cajas «Por cuadrantes».',
    pista: 'Elige «Por cuadrantes» tanto en «Parecido por color» como en «Cajas contenedoras».',
    preparar: { distancia: 32, color: 'cuadrantes', cajas: 'cuadrantes', conexion: false, lectura: true },
    abrir: true,
    logro: 'Cuando proximidad, semejanza y región común apuntan al mismo agrupamiento, la estructura global alcanza su máxima pregnancia: se entiende en una fracción de segundo y sin ambigüedad.',
  },
];
---

{paso === 'idea' && (
  <div class="dv-pregunta-visual">
    <div class="dv-pv-lienzo">
      <svg viewBox="0 0 600 180" role="img" aria-label="A la izquierda, doce puntos negros dispuestos en anillo forman un círculo claro; a la derecha, los mismos doce puntos dispersos al azar.">
        <rect width="600" height="180" fill="#fbfbf9" />
        <text x="155" y="24" text-anchor="middle" font-family={SANS} font-size="10" font-weight="700" letter-spacing="1.2" fill={G}>A · 12 PUNTOS EN ANILLO</text>
        <text x="455" y="24" text-anchor="middle" font-family={SANS} font-size="10" font-weight="700" letter-spacing="1.2" fill={G}>B · LOS MISMOS 12 PUNTOS AL AZAR</text>
        <line x1="300" y1="20" x2="300" y2="162" stroke={REGLA} stroke-width="1.5" stroke-dasharray="4 4" />
        <circle cx="155" cy="92" r="54" fill="none" stroke={AMARILLO} stroke-width="10" />
        {anillo.map((p) => (
          <circle cx={p.x} cy={p.y} r="6.5" fill={T} />
        ))}
        {azarosos.map((p) => (
          <circle cx={p.x} cy={p.y} r="6.5" fill={T} />
        ))}
      </svg>
    </div>
    <p>En ambos lados hay exactamente doce círculos negros idénticos. ¿Qué viste a la izquierda antes de poder contarlos?</p>
    <details>
      <summary>Ver la respuesta</summary>
      <div class="dv-texto">
        <p>Viste «un círculo grande» o una rueda, no doce puntos sueltos. Esa forma circular no está dibujada en ningún punto individual: emerge de la relación espacial entre todos ellos. A la derecha, con la misma cantidad de tinta, no emerge ninguna figura global y el ojo tiene que saltar de punto en punto.</p>
      </div>
    </details>
  </div>
)}

{paso === 'miralo' && (
  <div class="dv-anotadas">
    <Anotada
      veredicto="mal"
      rotulo="Cuando las señales perceptivas se contradicen"
      notas={[
        {
          ...pct(330, 58),
          titulo: 'Colores que cruzan funciones',
          texto: 'El botón de borrar pista comparte el acento amarillo con el de reproducir, mientras el avance rápido tiene el mismo gris que el ajuste de audio.',
          zona: zona(18, 36, 324, 62),
        },
        {
          ...pct(330, 146),
          titulo: 'Distancias iguales para todo',
          texto: 'Los controles de transporte, el volumen y las acciones de archivo están separados por la misma brecha. El espacio no informa qué va con qué.',
          zona: zona(18, 108, 324, 68),
        },
        {
          ...pct(330, 224),
          titulo: 'Cajas que agrupan extraños',
          texto: 'Un marco encierra «Siguiente pista» junto con «Silenciar» y «Guardar lista», forzando un grupo que contradice la tarea real.',
          zona: zona(18, 186, 324, 72),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Panel de audio desorganizado donde colores, espacios y marcos agrupan controles sin relación funcional.">
        <rect width={W} height={H} fill="#ffffff" />
        <text x="20" y="24" font-family={SANS} font-size="10" font-weight="700" letter-spacing="1" fill={G}>REPRODUCTOR · SEÑALES EN CONFLICTO</text>
        <rect x="20" y="40" width="98" height="48" fill={AMARILLO} stroke={T} stroke-width="2" />
        <text x="69" y="68" text-anchor="middle" font-family={SANS} font-size="12" font-weight="900" fill={T}>▶ PLAY</text>
        <rect x="131" y="40" width="98" height="48" fill="#f4f4f2" stroke={T} stroke-width="1.5" />
        <text x="180" y="68" text-anchor="middle" font-family={SANS} font-size="11" font-weight="700" fill={T}>VOLUMEN 70 %</text>
        <rect x="242" y="40" width="98" height="48" fill={AMARILLO} stroke={T} stroke-width="2" />
        <text x="291" y="68" text-anchor="middle" font-family={SANS} font-size="11" font-weight="900" fill={T}>BORRAR</text>

        <rect x="20" y="112" width="98" height="48" fill="#f4f4f2" stroke={T} stroke-width="1.5" />
        <text x="69" y="140" text-anchor="middle" font-family={SANS} font-size="11" font-weight="700" fill={T}>⏮ ANTERIOR</text>
        <rect x="131" y="112" width="98" height="48" fill={T} />
        <text x="180" y="140" text-anchor="middle" font-family={SANS} font-size="11" font-weight="700" fill="#ffffff">LISTA (14)</text>
        <rect x="242" y="112" width="98" height="48" fill="#f4f4f2" stroke={T} stroke-width="1.5" />
        <text x="291" y="140" text-anchor="middle" font-family={SANS} font-size="11" font-weight="700" fill={T}>ECUALIZADOR</text>

        <rect x="20" y="188" width="320" height="68" fill="#fbfbf9" stroke={ROJO} stroke-width="2" stroke-dasharray="5 3" />
        <rect x="32" y="202" width="88" height="40" fill="#ffffff" stroke={T} stroke-width="1.5" />
        <text x="76" y="226" text-anchor="middle" font-family={SANS} font-size="10.5" font-weight="700" fill={T}>⏭ SIGUIENTE</text>
        <rect x="136" y="202" width="88" height="40" fill={T} />
        <text x="180" y="226" text-anchor="middle" font-family={SANS} font-size="10.5" font-weight="700" fill="#ffffff">SILENCIAR</text>
        <rect x="240" y="202" width="88" height="40" fill="#ffffff" stroke={T} stroke-width="1.5" />
        <text x="284" y="226" text-anchor="middle" font-family={SANS} font-size="10.5" font-weight="700" fill={T}>GUARDAR</text>
      </svg>
    </Anotada>

    <Anotada
      veredicto="bien"
      rotulo="Cuando proximidad, semejanza y región cooperan"
      notas={[
        {
          ...pct(332, 68),
          titulo: 'Transporte unido por forma y cercanía',
          texto: 'Anterior, Reproducir y Siguiente están juntos en una sola franja superior y comparten el estilo de botón primario.',
          zona: zona(20, 38, 320, 66),
        },
        {
          ...pct(332, 148),
          titulo: 'Sonido en su propia región',
          texto: 'Volumen, Silenciar y Ecualizador comparten un contenedor suave que los agrupa como controles de salida de audio.',
          zona: zona(20, 118, 320, 64),
        },
        {
          ...pct(332, 228),
          titulo: 'Gestión de lista separada y discreta',
          texto: 'Las acciones sobre la lista van abajo, con tratamiento neutro y separadas del resto por espacio limpio.',
          zona: zona(20, 198, 320, 60),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Panel de audio organizado en tres bloques claros: transporte arriba, ajustes de sonido en una caja central y acciones de lista abajo.">
        <rect width={W} height={H} fill="#ffffff" />
        <text x="20" y="24" font-family={SANS} font-size="10" font-weight="700" letter-spacing="1" fill={G}>REPRODUCTOR · TRES GRUPOS COOPERATIVOS</text>

        <rect x="20" y="42" width="92" height="52" fill="#ffffff" stroke={T} stroke-width="1.8" />
        <text x="66" y="72" text-anchor="middle" font-family={SANS} font-size="11" font-weight="700" fill={T}>⏮ ANTERIOR</text>
        <rect x="120" y="42" width="120" height="52" fill={AMARILLO} stroke={T} stroke-width="2.2" />
        <text x="180" y="72" text-anchor="middle" font-family={SANS} font-size="13" font-weight="900" fill={T}>▶ PLAY</text>
        <rect x="248" y="42" width="92" height="52" fill="#ffffff" stroke={T} stroke-width="1.8" />
        <text x="294" y="72" text-anchor="middle" font-family={SANS} font-size="11" font-weight="700" fill={T}>⏭ SIGUIENTE</text>

        <rect x="20" y="120" width="320" height="58" fill="#f5f5f2" stroke="#d4d4d0" stroke-width="1.2" />
        <text x="34" y="142" font-family={SANS} font-size="9.5" font-weight="700" letter-spacing="0.8" fill={G}>SALIDA DE AUDIO</text>
        <rect x="34" y="150" width="118" height="16" fill="#ffffff" stroke={T} stroke-width="1.2" />
        <rect x="34" y="150" width="82" height="16" fill={T} />
        <text x="164" y="162" font-family={SANS} font-size="11" font-weight="700" fill={T}>70 %</text>
        <text x="218" y="162" font-family={SANS} font-size="10.5" font-weight="700" fill={TXT}>Silenciar</text>
        <text x="278" y="162" font-family={SANS} font-size="10.5" font-weight="700" fill={TXT}>Ecualizar</text>

        <line x1="20" y1="198" x2="340" y2="198" stroke={REGLA} stroke-width="1" />
        <text x="20" y="232" font-family={SANS} font-size="11" font-weight="700" fill={T}>Lista actual (14 pistas)</text>
        <text x="222" y="232" font-family={SANS} font-size="11" fill={G}>Guardar</text>
        <text x="288" y="232" font-family={SANS} font-size="11" fill={ROJO}>Vaciar</text>
      </svg>
    </Anotada>
  </div>
)}

{paso === 'pruebalo' && (
  <Instrumento
    id={lab}
    titulo="Instrumento · cuatro señales sobre dieciséis piezas"
    consigna="Dieciséis fichas forman un tablero de 4 × 4. Combina espacio, color, cajas contenedoras y líneas de conexión para comprobar cuándo cooperan en una misma estructura y qué señal se impone cuando dos principios se contradicen."
    nota="Fija como A un agrupamiento por cuadrantes y compáralo con B oponiendo filas de color contra columnas encerradas en cajas."
  >
    <svg slot="escenario" viewBox="0 0 640 320" role="img" aria-label="Tablero de dieciséis elementos agrupados en cuatro cuadrantes.">
      <rect width="640" height="320" fill="#fbfbf9" />
      {[0, 1, 2, 3].map((f) =>
        [0, 1, 2, 3].map((c) => {
          const x = 140 + c * 84 + (c >= 2 ? 28 : 0);
          const y = 32 + f * 58 + (f >= 2 ? 24 : 0);
          const cuad = (f >= 2 ? 2 : 0) + (c >= 2 ? 1 : 0);
          const fill = cuad === 0 ? AMARILLO : cuad === 3 ? '#222222' : '#ffffff';
          const txt = cuad === 3 ? '#ffffff' : '#222222';
          return (
            <g>
              <rect x={x} y={y} width="68" height="44" fill={fill} stroke="#222222" stroke-width="1.6" />
              <text x={x + 34} y={y + 27} text-anchor="middle" font-family={SANS} font-size="12" font-weight="700" fill={txt}>
                {String(f * 4 + c + 1).padStart(2, '0')}
              </text>
            </g>
          );
        }),
      )}
    </svg>

    <Guia slot="guia" pasos={pasos} final="Guía completada. Prueba ahora a enfrentar líneas conectoras con cajas y activa la lectura de dominancia en «Más controles»." />

    <Deslizador
      lab={lab}
      variable="distancia"
      etiqueta="Distancia entre grupos"
      min={0}
      max={48}
      paso={4}
      valor={28}
      unidad="px"
      ayuda="Abre un corredor horizontal y vertical para separar los cuatro cuadrantes por proximidad."
    />
    <Opciones
      lab={lab}
      variable="color"
      etiqueta="Parecido por color"
      valor="cuadrantes"
      opciones={[
        { valor: 'ninguno', texto: 'Ninguno' },
        { valor: 'filas', texto: 'Por filas' },
        { valor: 'columnas', texto: 'Por columnas' },
        { valor: 'cuadrantes', texto: 'Por cuadrantes' },
      ]}
      ayuda="Aplica semejanza cromática en la dirección elegida."
    />
    <Opciones
      lab={lab}
      variable="cajas"
      etiqueta="Cajas contenedoras"
      valor="ninguna"
      opciones={[
        { valor: 'ninguna', texto: 'Ninguna' },
        { valor: 'filas', texto: 'Por filas' },
        { valor: 'columnas', texto: 'Por columnas' },
        { valor: 'cuadrantes', texto: 'Por cuadrantes' },
      ]}
      ayuda="Encierra grupos en una región común con fondo y contorno."
    />
    <Interruptor
      lab={lab}
      variable="conexion"
      etiqueta="Línea conectora horizontal"
      ayuda="Une los elementos de cada fila mediante un trazo continuo (conexión uniforme)."
    />

    <Fragment slot="avanzados">
      <Interruptor
        lab={lab}
        variable="lectura"
        etiqueta="Mostrar qué ley domina"
        activo={true}
        ayuda="Superpone el diagnóstico cuantitativo de las señales activas y señala si cooperan o compiten."
      />
    </Fragment>

    <Fragment slot="pruebas">
      <button type="button" class="dv-boton" data-preset='{"distancia":0,"color":"ninguno","cajas":"ninguna","conexion":false}'>Retícula neutra sin grupos</button>
      <button type="button" class="dv-boton" data-preset='{"distancia":36,"color":"cuadrantes","cajas":"cuadrantes","conexion":false}'>Tres señales cooperando</button>
      <button type="button" class="dv-boton" data-preset='{"distancia":32,"color":"filas","cajas":"columnas","conexion":false}'>Conflicto entre espacio, color y cajas</button>
      <button type="button" class="dv-boton" data-preset='{"distancia":32,"color":"columnas","cajas":"ninguna","conexion":true}'>Conexión venciendo a distancia y color</button>
    </Fragment>
  </Instrumento>
)}

{paso === 'errores' && (
  <div class="dv-especimenes">
    <Instrumento
      id={`${lab}-e1`}
      titulo="Alinea el color con los grupos espaciales"
      comparar={false}
      consigna="En esta barra de edición, el espacio separa «Texto» y «Archivo», pero los colores alternados piden emparejar botones de grupos distintos. Haz que el color coopere con el espacio."
    >
      <div slot="escenario" style={`padding:16px 18px;font-family:${SANS};color:#222;`}>
        <p style="margin:0;font-size:13px;font-weight:700;">Barra de herramientas con señales opuestas</p>
      </div>
      <Opciones
        lab={`${lab}-e1`}
        variable="modo"
        etiqueta="Asignación del color"
        valor="conflicto"
        opciones={[
          { valor: 'conflicto', texto: 'Cruza los grupos' },
          { valor: 'neutro', texto: 'Un solo tono neutro' },
          { valor: 'coopera', texto: 'Refuerza cada grupo' },
        ]}
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e2`}
      titulo="Limpia el ruido para recuperar la buena forma"
      comparar={false}
      consigna="Cada celda tiene doble borde, sombra dura y esquinas marcadas. Cuando todas las piezas gritan su propio contorno, desaparece la lectura del conjunto. Reduce el ruido ornamental."
    >
      <div slot="escenario" style={`padding:16px 18px;font-family:${SANS};color:#222;`}>
        <p style="margin:0;font-size:13px;font-weight:700;">Horario semanal sobrecargado de líneas</p>
      </div>
      <Deslizador
        lab={`${lab}-e2`}
        variable="limpieza"
        etiqueta="Reducción de bordes redundantes"
        min={0}
        max={100}
        paso={10}
        valor={0}
        unidad="%"
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e3`}
      titulo="Suma señales para aislar una zona crítica"
      comparar={false}
      consigna="La acción «Eliminar cuenta» parece un ajuste rutinario más. Suma señales perceptivas (espacio, región común y contraste) hasta que nadie pueda confundirla con las preferencias normales."
    >
      <div slot="escenario" style={`padding:16px 18px;font-family:${SANS};color:#222;`}>
        <p style="margin:0;font-size:13px;font-weight:700;">Preferencias de perfil</p>
      </div>
      <Deslizador
        lab={`${lab}-e3`}
        variable="senales"
        etiqueta="Señales que separan la zona crítica"
        min={0}
        max={3}
        paso={1}
        valor={0}
        ayuda="0: integrada en la lista. 1: espacio. 2: espacio + región. 3: espacio + región + tono de alerta."
      />
    </Instrumento>
  </div>
)}

{paso === 'ejemplos' && (
  <div class="dv-anotadas">
    <Anotada
      rotulo="Billete de tren: lectura global en tres bloques antes de leer cada dato"
      notas={[
        {
          ...pct(330, 62),
          titulo: 'Ruta unificada por conexión',
          texto: 'Origen, flecha y destino forman una sola figura horizontal en el encabezado gracias a la línea continua que los enlaza.',
          zona: zona(18, 26, 324, 68),
        },
        {
          ...pct(330, 146),
          titulo: 'Datos de embarque por proximidad y región',
          texto: 'Fecha, coche y asiento comparten una banda amarilla que se lee como el bloque operativo al subir al vagón.',
          zona: zona(18, 104, 324, 66),
        },
        {
          ...pct(330, 228),
          titulo: 'Metadatos silenciados al pie',
          texto: 'Localizador y tarifa quedan agrupados abajo en cuerpo menor y gris secundario, fuera del recorrido urgente.',
          zona: zona(18, 182, 324, 68),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Billete de tren organizado en tres franjas claras: ruta conectada arriba, banda amarilla con coche y asiento en el centro, y código de reserva abajo.">
        <rect width={W} height={H} fill="#fbfbf9" />
        <rect x="18" y="18" width="324" height="244" fill="#ffffff" stroke={T} stroke-width="2" />
        <text x="34" y="42" font-family={SANS} font-size="9.5" font-weight="700" letter-spacing="1" fill={G}>ALTA VELOCIDAD · BILLETE CONFIRMADO</text>
        <text x="34" y="76" font-family={SANS} font-size="24" font-weight="900" fill={T}>MAD</text>
        <line x1="98" y1="68" x2="232" y2="68" stroke={T} stroke-width="2.5" />
        <polygon points="232,63 244,68 232,73" fill={T} />
        <text x="256" y="76" font-family={SANS} font-size="24" font-weight="900" fill={T}>BCN</text>
        <text x="34" y="92" font-family={SANS} font-size="10.5" fill={TXT}>08:30 · Atocha</text>
        <text x="256" y="92" font-family={SANS} font-size="10.5" fill={TXT}>11:05 · Sants</text>

        <rect x="30" y="110" width="300" height="58" fill={AMARILLO} stroke={T} stroke-width="1.5" />
        <text x="46" y="130" font-family={SANS} font-size="9.5" font-weight="700" fill={T}>FECHA</text>
        <text x="46" y="152" font-family={SANS} font-size="15" font-weight="900" fill={T}>14 NOV</text>
        <text x="154" y="130" font-family={SANS} font-size="9.5" font-weight="700" fill={T}>COCHE</text>
