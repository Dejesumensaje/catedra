        },
        {
          ...pct(330, 214),
          titulo: 'Alerta separada por región y contraste',
          texto: 'La glucemia elevada rompe la semejanza del grupo con borde grueso y etiqueta explícita para exigir atención inmediata.',
          zona: zona(232, 86, 110, 170),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Tarjeta médica con cabecera de paciente, tres constantes vitales normales a la izquierda y un bloque destacado a la derecha para la alerta de glucosa.">
        <rect width={W} height={H} fill="#fbfbf9" />
        <rect x="18" y="18" width="324" height="244" fill="#ffffff" stroke={T} stroke-width="1.8" />
        <text x="32" y="42" font-family={SANS} font-size="14" font-weight="900" fill={T}>C. Mendoza · HC 40891</text>
        <text x="32" y="60" font-family={SANS} font-size="10.5" fill={G}>64 años · Grupo O+ · Sin alergias registradas</text>
        <line x1="32" y1="72" x2="328" y2="72" stroke={REGLA} stroke-width="1.5" />

        <rect x="32" y="88" width="186" height="46" fill="#f7f7f5" stroke="#dcdcd6" stroke-width="1" />
        <text x="44" y="106" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>PRESIÓN ARTERIAL</text>
        <text x="44" y="124" font-family={SANS} font-size="14" font-weight="700" fill={T}>118 / 76 mmHg · Normal</text>

        <rect x="32" y="142" width="186" height="46" fill="#f7f7f5" stroke="#dcdcd6" stroke-width="1" />
        <text x="44" y="160" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>FRECUENCIA CARDÍACA</text>
        <text x="44" y="178" font-family={SANS} font-size="14" font-weight="700" fill={T}>68 lpm · Estable</text>

        <rect x="32" y="196" width="186" height="46" fill="#f7f7f5" stroke="#dcdcd6" stroke-width="1" />
        <text x="44" y="214" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>SATURACIÓN O₂</text>
        <text x="44" y="232" font-family={SANS} font-size="14" font-weight="700" fill={T}>98 % · Normal</text>

        <rect x="230" y="88" width="98" height="154" fill={AMARILLO} stroke={T} stroke-width="2.2" />
        <text x="242" y="110" font-family={SANS} font-size="9" font-weight="900" letter-spacing="0.8" fill={T}>FUERA DE RANGO</text>
        <text x="242" y="132" font-family={SANS} font-size="10.5" font-weight="700" fill={T}>GLUCOSA</text>
        <text x="242" y="168" font-family={SANS} font-size="26" font-weight="900" fill={T}>214</text>
        <text x="242" y="186" font-family={SANS} font-size="10.5" font-weight="700" fill={T}>mg/dL</text>
