---
// Interacción del color, escena 1: un mismo color central sobre dos fondos.
// El puente tiende una franja del color del centro entre los dos cuadros
// y deja ver que son uno solo.
import Instrumento from '../controles/Instrumento.astro';
import Interruptor from '../controles/Interruptor.astro';
import Guia, { type PasoGuia } from '../controles/Guia.astro';
import ColorHSL from './ColorHSL.astro';

const lab = 'color-centro';

const pasos: PasoGuia[] = [
  {
    hacer: 'Mira los dos cuadros del centro. Luego activa «Unir los dos centros».',
    logro: 'La franja tiene el color de los dos cuadros y los toca a ambos: son un solo color. Lo que cambiaba era lo que los rodea.',
  },
  {
    hacer: 'Baja la luminosidad del «Fondo izquierdo» hasta que sea casi negro.',
    pista: 'Lleva el deslizador «Luminosidad» del fondo izquierdo cerca de 0 %.',
    preparar: { unir: false },
    logro: 'Con los dos fondos oscuros, los centros se parecen mucho más. El efecto necesita dos fondos distintos.',
  },
  {
    hacer: 'Ahora sube la luminosidad del «Fondo izquierdo» hasta el blanco.',
    pista: 'Llévala por encima del 92 %.',
    logro: 'Sobre el fondo blanco, el centro tiende a verse más oscuro. Sobre el fondo oscuro de la derecha, más claro. Cada fondo cambia la apariencia del centro en la dirección contraria.',
  },
  {
    hacer: 'Mueve la luminosidad del «Color del centro» hasta que el cuadro de la derecha casi se pierda en su fondo.',
    pista: 'Bájala poco a poco, hacia un 20 %, mientras miras el cuadro de la derecha. El texto bajo el dibujo avisa cuando las luminancias se parecen.',
    logro: 'Centro y fondo tienen ahora casi la misma luminancia. El cuadro se distingue solo por el tono y su borde parece vibrar. En una foto en blanco y negro desaparecería. Así se pierde un texto sobre un fondo, y esa diferencia de luminancia es la que mide la razón de contraste.',
  },
  {
    hacer: 'Abre «Más controles» y activa «Rodear los centros con un filo».',
    abrir: true,
    logro: 'La línea negra separa el color de su fondo y el cuadro vuelve a verse, aunque los dos colores se parezcan. Un borde es una solución cuando dos colores que se tocan tienen poca diferencia.',
  },
];
---

<Instrumento
  id={lab}
  titulo="Instrumento · un color, dos fondos"
  consigna="Los dos cuadros del centro son del mismo color, aunque no lo parezca."
  comparar={false}
>
  <svg slot="escenario" viewBox="0 0 640 280" role="img" aria-label="El mismo cuadro de color sobre un fondo claro y sobre uno oscuro.">
    <rect x="0" y="0" width="320" height="280" fill="#f2c14e" />
    <rect x="320" y="0" width="320" height="280" fill="#3b2a5e" />
    <rect x="110" y="90" width="100" height="100" fill="#a67c52" />
    <rect x="430" y="90" width="100" height="100" fill="#a67c52" />
  </svg>

  <Guia slot="guia" pasos={pasos} />

  <ColorHSL lab={lab} prefijo="c" etiqueta="Color del centro" h={30} s={33} l={49} canales="l" />
  <ColorHSL lab={lab} prefijo="i" etiqueta="Fondo izquierdo" h={42} s={86} l={63} canales="l" />
  <Interruptor lab={lab} variable="unir" etiqueta="Unir los dos centros" ayuda="Una franja del mismo color conecta los cuadros." />

  <Fragment slot="avanzados">
    <Interruptor lab={lab} variable="filo" etiqueta="Rodear los centros con un filo" ayuda="Dibuja una línea negra entre el centro y su fondo." />
    <ColorHSL lab={lab} prefijo="d" etiqueta="Fondo derecho" h={259} s={38} l={27} />
    <ColorHSL lab={lab} prefijo="c" etiqueta="Color del centro: tono y saturación" h={30} s={33} l={49} canales="hs" selector={false} />
    <ColorHSL lab={lab} prefijo="i" etiqueta="Fondo izquierdo: tono y saturación" h={42} s={86} l={63} canales="hs" selector={false} />
  </Fragment>

  <Fragment slot="pruebas">
    <button type="button" class="dv-boton" data-preset='{"ch":0,"cs":0,"cl":50,"ih":0,"is":0,"il":92,"dh":0,"ds":0,"dl":10,"unir":false}'>Un gris entre blanco y negro</button>
    <button type="button" class="dv-boton" data-preset='{"ch":30,"cs":33,"cl":49,"ih":42,"is":86,"il":63,"dh":259,"ds":38,"dl":27,"unir":false}'>Un ocre que parece dos colores</button>
    <button type="button" class="dv-boton" data-preset='{"ch":120,"cs":20,"cl":55,"ih":120,"is":70,"il":55,"dh":330,"ds":60,"dl":55,"unir":false}'>Misma luminosidad, tono opuesto</button>
    <button type="button" class="dv-boton" data-preset='{"ch":0,"cs":0,"cl":50,"ih":210,"is":40,"il":30,"dh":210,"ds":40,"dl":30,"unir":false}'>Dos fondos iguales</button>
  </Fragment>
</Instrumento>

<script>
  import { conectar, svg } from '../../../lib/diseno-visual/estado';
  import { guiar } from '../../../lib/diseno-visual/guia';
  import { hslAHex, hexARgb, luminancia } from '../../../lib/diseno-visual/contraste';

  type E = {
    ch: number; cs: number; cl: number;
    ih: number; is: number; il: number;
    dh: number; ds: number; dl: number;
    unir: boolean; filo: boolean;
  };

  const color = (e: E, p: 'c' | 'i' | 'd') =>
    hslAHex(e[`${p}h`] as number, e[`${p}s`] as number, e[`${p}l`] as number);
  const Y = (hex: string) => luminancia(hexARgb(hex));

  function pintar(destino: HTMLElement, e: E) {
    const ancho = Math.max(destino.clientWidth, 240);
    const alto = ancho < 500 ? 200 : 280;
    const lado = Math.min(ancho / 4.2, alto * 0.4);
    const centro = color(e, 'c');
    const raiz = svg('svg', { viewBox: `0 0 ${ancho} ${alto}`, width: ancho, height: alto, role: 'img' });
    raiz.setAttribute('aria-label', `El mismo color ${centro} en dos cuadros, sobre ${color(e, 'i')} a la izquierda y ${color(e, 'd')} a la derecha.`);
    raiz.append(svg('rect', { x: 0, y: 0, width: ancho / 2, height: alto, fill: color(e, 'i') }));
    raiz.append(svg('rect', { x: ancho / 2, y: 0, width: ancho / 2, height: alto, fill: color(e, 'd') }));
    const y = (alto - lado) / 2;
    const xs = [ancho / 4 - lado / 2, (ancho * 3) / 4 - lado / 2];
    if (e.unir) {
      const franja = lado * 0.22;
      raiz.append(svg('rect', { x: xs[0] + lado / 2, y: alto / 2 - franja / 2, width: xs[1] - xs[0], height: franja, fill: centro }));
    }
    for (const x of xs) {
      raiz.append(svg('rect', {
        x, y, width: lado, height: lado, fill: centro,
        stroke: e.filo ? '#000' : 'none', 'stroke-width': e.filo ? 3 : 0,
      }));
    }
    destino.replaceChildren(raiz);
  }

  function relacion(fondo: number, centro: number): 'claro' | 'oscuro' | 'igual' {
    const r = (Math.max(fondo, centro) + 0.05) / (Math.min(fondo, centro) + 0.05);
    if (r < 1.15) return 'igual';
    return fondo > centro ? 'claro' : 'oscuro';
  }

  function describir(e: E): string {
    const c = color(e, 'c');
    const ci = color(e, 'i');
    const cd = color(e, 'd');
    if (ci === cd) {
      return `Los dos fondos son iguales (${ci}). Sin fondos distintos, los centros se ven iguales: el efecto necesita dos entornos diferentes.`;
    }
    const yc = Y(c);
    const izq = relacion(Y(ci), yc);
    const der = relacion(Y(cd), yc);
    const lado = (r: string) => r === 'claro' ? 'más claro' : r === 'oscuro' ? 'más oscuro' : 'de luminancia parecida';
    let efecto = '';
    if (izq !== 'igual' && der !== 'igual' && izq !== der) {
      const hacia = (r: string) => r === 'claro' ? 'más oscuro' : 'más claro';
      efecto = ` Cada fondo cambia la apariencia del centro en la dirección contraria: tiende a verse ${hacia(izq)} a la izquierda y ${hacia(der)} a la derecha.`;
    } else if (izq === der && izq !== 'igual') {
      efecto = ' Los dos fondos cambian el centro en la misma dirección, así que la diferencia entre los centros se reduce.';
    } else {
      efecto = ' Donde fondo y centro tienen luminancia parecida, el cambio depende sobre todo del tono y la saturación.';
    }
    const sat = Math.abs((e.is as number) - (e.ds as number)) > 30 && (e.cs as number) > 8
      ? ' Junto al fondo más saturado, el centro tiende a verse más apagado; junto al más gris, más vivo.'
      : '';
    let cierre = '';
    if (e.unir) cierre += ' La franja tiene el color del centro: al unirlos se ve que es un solo color.';
    if (e.filo) cierre += ' El filo negro separa el centro de su fondo. Compara si el efecto cambia.';
    return `Los dos centros son <b class="dv-cifra">el mismo color</b> (${c}). El fondo izquierdo es ${lado(izq)} que el centro; el derecho, ${lado(der)}.${efecto}${sat}${cierre}`;
  }

  const contraste = (a: string, b: string) => {
    const [x, y] = [Y(a), Y(b)];
    return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
  };

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-lab="color-centro"]')) {
    // La guía escucha antes de conectar: así recibe el primer estado.
    guiar<E>(raiz, [
      (e) => e.unir,
      (e) => e.il <= 12,
      (e) => e.il >= 92,
      (e) => contraste(color(e, 'c'), color(e, 'd')) < 1.15,
      (e) => e.filo,
    ]);
    conectar<E>({ raiz, pintar, describir });
  }
</script>
