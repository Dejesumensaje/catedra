---
// Paso 2 de énfasis: el mismo aviso comunitario en dos versiones.
// En la primera todo grita (bordes, mayúsculas, cajas oscuras, signos);
// en la segunda el entorno guarda calma para que un único dato concentre
// la mirada.
import Anotada from '../Anotada.astro';

const W = 360;
const H = 290;
const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const SERIF = "'PT Serif', Georgia, serif";
const T = '#222222';
const G = '#6f6f6f';
const ROJO = '#b3261e';
const AMARILLO = '#eeff41';
const pct = (x: number, y: number) => ({ x: (x / W) * 100, y: (y / H) * 100 });
const zona = (x: number, y: number, w: number, h: number) => ({ x: (x / W) * 100, y: (y / H) * 100, w: (w / W) * 100, h: (h / H) * 100 });
---

<div class="dv-anotadas">
  <Anotada
    veredicto="mal"
    rotulo="Cuando todo intenta destacar"
    notas={[
      { ...pct(334, 42), titulo: 'Tres bloques oscuros', texto: 'El encabezado, la fecha y el pie usan fondos oscuros o bordes gruesos. Todos reclaman la mirada con la misma fuerza.', zona: zona(16, 16, 328, 120) },
      { ...pct(334, 164), titulo: 'Exceso de señales', texto: 'Mayúsculas, subrayados, signos de admiración y etiquetas rojas aparecen a la vez. Cuando todo se subraya, nada sobresale.', zona: zona(16, 140, 328, 76) },
      { ...pct(334, 248), titulo: 'El dato clave se pierde', texto: 'Que el corte es el jueves de 2 a 5 p. m. cuesta encontrarlo entre tantos avisos urgentes.', zona: zona(16, 220, 328, 54) },
    ]}
  >
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Aviso de corte de agua donde todos los bloques llevan fondos negros, bordes rojos, mayúsculas y signos de exclamación.">
      <rect width={W} height={H} fill="#fff" />
      <rect x="20" y="18" width="320" height="44" fill={T} />
      <text x="180" y="46" text-anchor="middle" font-family={SANS} font-weight="900" font-size="18" fill={AMARILLO}>¡AVISO MUY IMPORTANTE!</text>
      <rect x="20" y="72" width="320" height="54" fill="#fbe9e7" stroke={ROJO} stroke-width="3" />
      <text x="180" y="96" text-anchor="middle" font-family={SANS} font-weight="900" font-size="15" fill={ROJO}>¡¡CORTE DE AGUA EN EL EDIFICIO!!</text>
      <text x="180" y="116" text-anchor="middle" font-family={SANS} font-weight="700" font-size="12" fill={T} text-decoration="underline">LEER CON ATENCIÓN POR FAVOR</text>
      <rect x="20" y="138" width="154" height="68" fill={T} />
      <text x="97" y="166" text-anchor="middle" font-family={SANS} font-weight="900" font-size="14" fill="#fff">JUEVES 14</text>
      <text x="97" y="188" text-anchor="middle" font-family={SANS} font-weight="700" font-size="12" fill={AMARILLO}>2:00 A 5:00 P. M.</text>
      <rect x="186" y="138" width="154" height="68" fill={ROJO} />
      <text x="263" y="166" text-anchor="middle" font-family={SANS} font-weight="900" font-size="13" fill="#fff">¡TANQUE EN</text>
      <text x="263" y="186" text-anchor="middle" font-family={SANS} font-weight="900" font-size="13" fill="#fff">MANTENIMIENTO!</text>
      <rect x="20" y="218" width="320" height="52" fill="#fff" stroke={T} stroke-width="3" />
      <text x="180" y="242" text-anchor="middle" font-family={SANS} font-weight="900" font-size="12" fill={T}>¡CIERRE TODAS LAS LLAVES DE PASO!</text>
      <text x="180" y="260" text-anchor="middle" font-family={SANS} font-weight="900" font-size="11" fill={ROJO}>ADMINISTRACIÓN — URGENTE</text>
    </svg>
  </Anotada>

  <Anotada
    veredicto="bien"
    rotulo="Cuando un solo elemento concentra la atención"
    notas={[
      { ...pct(334, 114), titulo: 'Un único punto focal', texto: 'La franja horaria es el único bloque con tamaño grande y acento de color. La mirada entra por ahí sin esfuerzo.', zona: zona(20, 74, 320, 82) },
      { ...pct(334, 42), titulo: 'Contexto sereno', texto: 'El tema («Corte de agua») encabeza la pieza con claridad, pero sin competir con la hora.', zona: zona(20, 22, 220, 44) },
      { ...pct(334, 214), titulo: 'Espacio y calma alrededor', texto: 'El motivo y la recomendación van en un tamaño tranquilo, con espacio suficiente para leerse después del dato principal.', zona: zona(20, 174, 320, 92) },
    ]}
  >
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="El mismo aviso de corte de agua: un encabezado limpio, la hora destacada en grande sobre una franja amarilla y una nota breve debajo.">
      <rect width={W} height={H} fill="#fff" />
      <text x="28" y="42" font-family={SANS} font-weight="700" font-size="11" letter-spacing="1.6" fill={G}>CORTE DE AGUA · JUEVES 14</text>
      <rect x="28" y="80" width="304" height="68" fill={AMARILLO} stroke={T} stroke-width="2" />
      <text x="44" y="124" font-family={SANS} font-weight="900" font-size="34" letter-spacing="-1" fill={T}>2:00 a 5:00 p. m.</text>
      <text font-family={SERIF} font-size="14" fill={T}>
        <tspan x="28" y="196">Lavado del tanque principal. Te recomendamos</tspan>
        <tspan x="28" y="216">reservar agua antes de las dos de la tarde.</tspan>
      </text>
      <line x1="28" y1="244" x2="332" y2="244" stroke="#e5e5e5" />
      <text x="28" y="264" font-family={SANS} font-size="11" fill={G}>Administración del edificio</text>
    </svg>
  </Anotada>
</div>
