---
import Anotada from '../Anotada.astro';
import Instrumento from '../controles/Instrumento.astro';
import Deslizador from '../controles/Deslizador.astro';
import Opciones from '../controles/Opciones.astro';
import Interruptor from '../controles/Interruptor.astro';
import Guia, { type PasoGuia } from '../controles/Guia.astro';
import Juego from '../Juego.astro';

interface Props {
  paso: 'idea' | 'miralo' | 'pruebalo' | 'errores' | 'ejemplos' | 'juego';
}

const { paso } = Astro.props;
const lab = 'patrones';

const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const SERIF = "'PT Serif', Georgia, serif";
const T = '#222222';
const TXT = '#444444';
const G = '#6f6f6f';
const PAPEL = '#ffffff';
const FONDO = '#fbfbf9';
const REGLA = '#e5e5e5';
const AMARILLO = '#eeff41';
const ROJO = '#b3261e';

const W = 360;
const H = 280;
const pct = (x: number, y: number) => ({ x: Math.round((x / W) * 100), y: Math.round((y / H) * 100) });
const zona = (x: number, y: number, w: number, h: number) => ({
  x: Math.round((x / W) * 100),
  y: Math.round((y / H) * 100),
  w: Math.round((w / W) * 100),
  h: Math.round((h / H) * 100),
});

const pasos: PasoGuia[] = [
  {
    titulo: 'Satura la pantalla sin revelación progresiva.',
    hacer: 'Con «Patrón bajo disección» en «Revelación progresiva», sube «Complejidad de la tarea (opciones / ítems)» a 18 o más y en «Aplicación del patrón» elige «Sin patrón (todo plano de golpe)».',
    pista: 'Mueve el deslizador a 18+ y cambia el segundo control a «Sin patrón (todo plano de golpe)».',
    logro: 'Cuando dieciocho controles primarios y secundarios aparecen al mismo nivel, quien llega por primera vez no sabe qué tocar primero. La sobrecarga bloquea la entrada.',
  },
  {
    titulo: 'Aplica la revelación progresiva.',
    hacer: 'Mantén la complejidad alta y cambia «Aplicación del patrón» a «Con patrón aplicado».',
    pista: 'Selecciona la primera opción en «Aplicación del patrón».',
    logro: 'Los tres controles esenciales quedan a la vista para empezar al instante y los quince ajustes finos se pliegan bajo «Más controles». La potencia sigue ahí, pero ya no intimida.',
  },
  {
    titulo: 'Explora el patrón Maestro-detalle.',
    hacer: 'En «Patrón bajo disección», selecciona «Maestro-detalle (índice y vista)».',
    pista: 'Elige la segunda opción del primer control.',
    preparar: { aplicacion: 'con-patron', complejidad: 15 },
    logro: 'En lugar de obligar a entrar y salir de quince páginas con el botón «Atrás», la lista maestra queda fija a la izquierda mientras el panel derecho muestra el detalle seleccionado en vivo.',
  },
  {
    titulo: 'Comprueba el patrón de Búsqueda con facetas.',
    hacer: 'En «Patrón bajo disección», selecciona «Búsqueda con facetas y estado vacío».',
    pista: 'Elige la tercera opción del primer control.',
    logro: 'El patrón articula cuatro piezas que cooperan: buscador por texto, filtros por categoría, contador de resultados en vivo y salida clara cuando no hay coincidencias.',
  },
  {
    titulo: 'Provoca el caso de cero resultados (estado vacío).',
    hacer: 'Abre «Más controles» y activa «Simular consulta con 0 resultados (estado vacío)».',
    pista: 'Despliega «Más controles» y marca la primera casilla.',
    preparar: { patron: 'busqueda', aplicacion: 'con-patron' },
    abrir: true,
    logro: 'Un patrón de filtrado no termina cuando hay coincidencias: cuando el recuento cae a cero, explica por qué ocurrió y ofrece un botón inmediato («Limpiar filtros») para salir del callejón sin salida.',
  },
];
---

{paso === 'idea' && (
  <div class="dv-pregunta-visual">
    <svg viewBox="0 0 600 180" role="img" aria-label="Tres interfaces distintas (un catálogo de biblioteca, una boletería de trenes y el índice de diseño visual) que usan componentes distintos pero comparten el mismo patrón de búsqueda, filtro por faceta y contador en vivo.">
      <rect width="600" height="180" fill={FONDO} />
      {[
        { x: 16, tit: '1. BIBLIOTECA PÚBLICA', busq: 'Buscar autor…', chip: '[Novela] [Ensayo]', cont: 'Hay 7 libros', item1: 'El sentido del orden', item2: 'Arte e ilusión' },
        { x: 212, tit: '2. HORARIOS DE TREN', busq: 'Estación destino…', chip: '[Directo] [Nocturno]', cont: '7 salidas hoy', item1: '08:15 · Medellín → Cali', item2: '14:40 · Medellín → Bogotá' },
        { x: 408, tit: '3. ÍNDICE /DISENO-VISUAL', busq: 'Filtrar concepto…', chip: '[Sistemas] [Color]', cont: 'Mostrando 7 de 37', item1: '29 · Tokens', item2: '30 · Componentes' },
      ].map((p) => (
        <g transform={`translate(${p.x}, 14)`}>
          <rect width="176" height="152" fill={PAPEL} stroke={T} stroke-width="1.5" />
          <text x="10" y="18" font-family={SANS} font-size="9" font-weight="900" letter-spacing="0.06em" fill={T}>{p.tit}</text>
          {/* 1. Buscador */}
          <rect x="10" y="26" width="156" height="20" fill={FONDO} stroke={T} stroke-width="1" />
          <text x="16" y="39" font-family={SANS} font-size="9" fill={G}>{p.busq}</text>
          {/* 2. Facetas */}
          <text x="10" y="60" font-family={SANS} font-size="9" font-weight="700" fill={TXT}>{p.chip}</text>
          {/* 3. Recuento vivo */}
          <rect x="10" y="68" width="156" height="16" fill={AMARILLO} stroke={T} stroke-width="1" />
          <text x="16" y="79" font-family={SANS} font-size="8.5" font-weight="900" fill={T}>ESTADO VIVO: {p.cont}</text>
          {/* 4. Lista que responde */}
          <rect x="10" y="92" width="156" height="22" fill={PAPEL} stroke={REGLA} stroke-width="1" />
          <text x="16" y="106" font-family={SERIF} font-size="9.5" font-weight="700" fill={T}>{p.item1}</text>
          <rect x="10" y="118" width="156" height="22" fill={PAPEL} stroke={REGLA} stroke-width="1" />
          <text x="16" y="132" font-family={SERIF} font-size="9.5" font-weight="700" fill={T}>{p.item2}</text>
        </g>
      ))}
    </svg>
    <p>Una biblioteca, una boletería de trenes y el índice de esta enciclopedia tienen tipografías y componentes distintos. ¿Por qué sabes usar las tres en el primer segundo?</p>
    <details>
      <summary>Ver la respuesta</summary>
      <div class="dv-texto">
        <p>Porque las tres resuelven el mismo problema recurrente aplicando el mismo <strong>patrón estructural</strong>: un campo de búsqueda arriba, facetas para acotar categorías, una línea de estado que anuncia cuántos resultados quedan («Hay 7 resultados») y una lista que se filtra al instante sin recargar la página. Los componentes concretos cambian, pero la coreografía que resuelve la tarea es la misma.</p>
      </div>
    </details>
  </div>
)}

{paso === 'miralo' && (
  <div class="dv-anotadas">
    <Anotada
      veredicto="mal"
      rotulo="Mecánicas improvisadas y sobrecarga sin patrones"
      notas={[
        {
          ...pct(330, 52),
          titulo: 'Sin orientación de recorrido',
          texto: 'El usuario no sabe en qué sección está ni cuántos pasos faltan para terminar la configuración.',
          zona: zona(16, 16, 328, 44),
        },
        {
          ...pct(330, 134),
          titulo: '14 controles avanzados lanzados de golpe',
          texto: 'Mezclar el título básico con parámetros técnicos de caché, puerto y codificación abruma a quien solo quería publicar.',
          zona: zona(16, 66, 328, 122),
        },
        {
          ...pct(330, 232),
          titulo: 'Acción destructiva sin confirmación',
          texto: 'El botón «Borrar archivo» está pegado a «Guardar» con el mismo estilo y ejecuta el borrado sin pedir confirmación.',
          zona: zona(16, 196, 328, 68),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Formulario confuso sin miga de pan, con doce ajustes técnicos mezclados con el título y un botón de borrado inmediato junto al de guardar.">
        <rect width={W} height={H} fill={PAPEL} />
        <rect x="16" y="16" width="328" height="44" fill="#fbe9e7" stroke={ROJO} stroke-width="1.5" />
        <text x="28" y="36" font-family={SANS} font-size="11" font-weight="900" fill={ROJO}>PANTALLA DE AJUSTES (¿DÓNDE ESTOY?)</text>
        <text x="28" y="51" font-family={SANS} font-size="9.5" fill={T}>Sin ruta de navegación ni jerarquía de pasos</text>

        <rect x="16" y="66" width="328" height="122" fill={FONDO} stroke={T} stroke-width="1.5" />
        <text x="26" y="84" font-family={SANS} font-size="9.5" font-weight="700" fill={T}>14 PARÁMETROS MEZCLADOS SIN FILTRO:</text>
        <text x="26" y="102" font-family={SANS} font-size="9.5" fill={TXT}>[Puerto TCP: 8080] [Codificación: UTF-8] [Título: ___]</text>
        <text x="26" y="120" font-family={SANS} font-size="9.5" fill={TXT}>[Timeout: 300 ms] [Reintentos: 4] [Autor: ___]</text>
        <text x="26" y="138" font-family={SANS} font-size="9.5" fill={TXT}>[Buffer: 64 KB] [Compresión: GZIP] [Fecha: ___]</text>
        <text x="26" y="156" font-family={SANS} font-size="9.5" fill={TXT}>[Hash SHA: activo] [Logs: nivel 3] [Caché: 0 s]</text>
        <text x="26" y="176" font-family={SANS} font-size="9.5" font-weight="700" fill={ROJO}>El usuario abandona antes de encontrar «Título» y «Autor».</text>

        <rect x="16" y="196" width="328" height="68" fill={PAPEL} stroke={ROJO} stroke-width="1.5" />
        <rect x="28" y="210" width="142" height="28" fill={T} />
        <text x="99" y="228" text-anchor="middle" font-family={SANS} font-size="10" font-weight="700" fill={PAPEL}>Borrar todo al clic</text>
        <rect x="182" y="210" width="142" height="28" fill={T} />
        <text x="253" y="228" text-anchor="middle" font-family={SANS} font-size="10" font-weight="700" fill={PAPEL}>Guardar cambios</text>
        <text x="28" y="254" font-family={SANS} font-size="9.5" fill={ROJO}>Mismo peso visual y cero aviso antes de destruir datos.</text>
      </svg>
    </Anotada>

    <Anotada
      veredicto="bien"
      rotulo="Tres patrones probados que cooperan con claridad"
      notas={[
        {
          ...pct(330, 42),
          titulo: 'Patrón 1: Miga de pan (breadcrumbs)',
          texto: 'Ubica la pantalla dentro de la jerarquía («Cursos › Pensamiento Sensorial › Sesión 07») y permite subir a cualquier nivel.',
          zona: zona(16, 16, 328, 42),
        },
        {
          ...pct(330, 128),
          titulo: 'Patrón 2: Revelación progresiva',
          texto: 'Muestra de entrada solo «Título» y «Fecha»; los parámetros técnicos van plegados bajo «Más controles (12)».',
          zona: zona(16, 64, 328, 120),
        },
        {
          ...pct(330, 230),
          titulo: 'Patrón 3: Confirmación explícita de borrado',
          texto: 'Separa la acción destructiva y exige confirmar el impacto («Se eliminarán 14 entregas») antes de ejecutar.',
          zona: zona(16, 192, 328, 72),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Interfaz estructurada mediante tres patrones: miga de pan superior, revelación progresiva para opciones avanzadas y diálogo de confirmación para borrado.">
        <rect width={W} height={H} fill={PAPEL} />
        {/* 1. Miga de pan */}
        <rect x="16" y="16" width="328" height="40" fill={FONDO} stroke={T} stroke-width="1.5" />
        <text x="28" y="40" font-family={SANS} font-size="10.5" font-weight="700" fill={G}>Cursos  ›  Pensamiento Sensorial  ›  <tspan fill={T}>Sesión 07</tspan></text>

        {/* 2. Revelación progresiva */}
        <rect x="16" y="64" width="328" height="120" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="28" y="86" font-family={SANS} font-size="10" font-weight="700" fill={T}>CAMPOS ESENCIALES (VISIBLES DE ENTRADA)</text>
        <rect x="28" y="94" width="190" height="22" fill={FONDO} stroke={T} stroke-width="1" />
        <text x="36" y="109" font-family={SERIF} font-size="11" fill={T}>Título: La distancia entre…</text>
        <rect x="228" y="94" width="102" height="22" fill={FONDO} stroke={T} stroke-width="1" />
        <text x="236" y="109" font-family={SANS} font-size="10" fill={T}>Fecha: 17 sep</text>

        <rect x="28" y="128" width="302" height="42" fill={FONDO} stroke={T} stroke-width="1.2" stroke-dasharray="3 2" />
        <text x="40" y="148" font-family={SANS} font-size="10.5" font-weight="900" fill={T}>▸ Más controles avanzados (12 parámetros técnicos)</text>
        <text x="40" y="162" font-family={SANS} font-size="9.5" fill={G}>Plegados por defecto para no saturar la tarea principal</text>

        {/* 3. Confirmación explícita */}
        <rect x="16" y="192" width="328" height="72" fill={AMARILLO} stroke={T} stroke-width="1.5" />
        <text x="28" y="212" font-family={SANS} font-size="10" font-weight="900" fill={T}>PATRÓN DE CONFIRMACIÓN ANTES DE BORRAR:</text>
        <text x="28" y="228" font-family={SERIF} font-size="11" fill={T}>«¿Eliminar S07? Se perderán 3 referentes asociados.»</text>
        <rect x="28" y="236" width="82" height="20" fill={PAPEL} stroke={T} stroke-width="1.2" />
        <text x="69" y="250" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={T}>Cancelar</text>
        <rect x="120" y="236" width="118" height="20" fill={ROJO} />
        <text x="179" y="250" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={PAPEL}>Sí, eliminar sesión</text>
      </svg>
    </Anotada>
  </div>
)}

{paso === 'pruebalo' && (
  <Instrumento
    id={lab}
    titulo="Diseccionador de patrones · contexto, fuerzas en tensión y solución"
    consigna="Elige uno de los tres patrones clásicos de diseño de información, aumenta la complejidad de la tarea (de 3 a 24 elementos) y alterna entre la pantalla sin patrón y con el patrón aplicado."
    nota="Fija la versión «Sin patrón» con 18 elementos como A y compárala con «Con patrón aplicado» en B para ver cómo baja la carga cognitiva."
  >
    <svg slot="escenario" viewBox="0 0 640 310" role="img" aria-label="Diseccionador de patrones mostrando el patrón de revelación progresiva con controles esenciales visibles y controles secundarios plegados.">
      <rect width="640" height="310" fill={FONDO} />
      <rect x="24" y="24" width="592" height="262" fill={PAPEL} stroke={T} stroke-width="1.5" />
      <text x="44" y="54" font-family={SANS} font-size="12" font-weight="900" fill={T}>PATRÓN: REVELACIÓN PROGRESIVA</text>
      <rect x="44" y="72" width="552" height="90" fill={FONDO} stroke={T} stroke-width="1.5" />
      <text x="60" y="102" font-family={SANS} font-size="11" font-weight="700" fill={T}>1. Primer nivel: 3 controles esenciales siempre visibles</text>
      <rect x="44" y="178" width="552" height="84" fill={AMARILLO} stroke={T} stroke-width="1.5" />
      <text x="60" y="212" font-family={SANS} font-size="11" font-weight="900" fill={T}>2. Segundo nivel bajo demanda: ▸ Más controles</text>
    </svg>

    <Guia slot="guia" pasos={pasos} final="Guía completada. Recorre los tres patrones activando las cotas de la estructura de Christopher Alexander (Contexto → Problema → Solución) en «Más controles»." />

    <Opciones
      lab={lab}
      variable="patron"
      etiqueta="Patrón bajo disección"
      valor="revelacion"
      opciones={[
        { valor: 'revelacion', texto: 'Revelación progresiva' },
        { valor: 'maestro', texto: 'Maestro-detalle (índice y vista)' },
        { valor: 'busqueda', texto: 'Búsqueda con facetas y estado vacío' },
      ]}
      ayuda="Cada patrón resuelve un problema recurrente distinto cuando crece el volumen de información."
    />

    <Deslizador
      lab={lab}
      variable="complejidad"
      etiqueta="Complejidad de la tarea (opciones / ítems)"
      min={3}
      max={24}
      paso={3}
      valor={15}
      unidad="ítems"
      ayuda="Con 3 ítems casi cualquier disposición funciona; por encima de 9 ítems el patrón se vuelve decisivo."
    />

    <Opciones
      lab={lab}
      variable="aplicacion"
      etiqueta="Aplicación del patrón"
      valor="con-patron"
      opciones={[
        { valor: 'con-patron', texto: 'Con patrón aplicado' },
        { valor: 'sin-patron', texto: 'Sin patrón (todo plano de golpe)' },
      ]}
      ayuda="Compara la solución estructurada frente a volcar todos los elementos en un único nivel."
    />

    <Fragment slot="avanzados">
      <Interruptor
        lab={lab}
        variable="vacio"
        etiqueta="Simular consulta con 0 resultados (estado vacío)"
        ayuda="En el patrón de búsqueda, comprueba cómo se guía al usuario cuando ningún ítem coincide."
      />
      <Interruptor
        lab={lab}
        variable="alexander"
        etiqueta="Mostrar estructura Contexto → Problema → Solución"
        activo={true}
        ayuda="Muestra la síntesis tripartita de Christopher Alexander (1977) para el patrón activo."
      />
    </Fragment>

    <Fragment slot="pruebas">
      <button type="button" class="dv-boton" data-preset='{"patron":"revelacion","complejidad":18,"aplicacion":"sin-patron","vacio":false}'>Sobrecarga: 18 controles de golpe</button>
      <button type="button" class="dv-boton" data-preset='{"patron":"revelacion","complejidad":18,"aplicacion":"con-patron","vacio":false}'>Revelación progresiva: 3 + 15 plegados</button>
      <button type="button" class="dv-boton" data-preset='{"patron":"maestro","complejidad":15,"aplicacion":"con-patron","vacio":false}'>Maestro-detalle en vivo</button>
      <button type="button" class="dv-boton" data-preset='{"patron":"busqueda","complejidad":21,"aplicacion":"con-patron","vacio":true}'>Búsqueda con estado vacío útil</button>
    </Fragment>
  </Instrumento>
)}

{paso === 'errores' && (
  <div class="dv-especimenes">
    <Instrumento
      id={`${lab}-e1`}
      titulo="Mantén consistente el orden de las acciones en todo el flujo"
      comparar={false}
      consigna="En la ventana 1 el botón «Aceptar» está a la derecha, pero en la ventana 2 alguien lo puso a la izquierda y «Cancelar» a la derecha. Quien viene haciendo clic por memoria muscular cancela su trabajo sin querer. Corrige el antipatrón."
    >
      <div slot="escenario" style={`padding:14px 16px;font-family:${SANS};color:${T};`}>
        <p style="margin:0;">Dos diálogos con el orden de botones invertido.</p>
      </div>
      <Opciones
        lab={`${lab}-e1`}
        variable="orden"
        etiqueta="Disposición de botones entre diálogos del sistema"
        valor="invertido"
        opciones={[
          { valor: 'invertido', texto: 'Cambia de lado según la ventana (antipatrón)' },
          { valor: 'consistente', texto: 'Cancelar siempre a la izq. · Acción principal a la der.' },
        ]}
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e2`}
      titulo="Aplica revelación progresiva cuando los controles pasen de 5"
      comparar={false}
      consigna="Un panel de exportación muestra 12 controles técnicos al mismo tiempo. El 90 % de las personas solo necesita elegir el formato. Ajusta cuántos controles quedan en el primer nivel."
    >
      <div slot="escenario" style={`padding:14px 16px;font-family:${SANS};color:${T};`}>
        <p style="margin:0;">12 controles desplegados en primer plano.</p>
      </div>
      <Deslizador
        lab={`${lab}-e2`}
        variable="visibles"
        etiqueta="Controles en el primer nivel (el resto va a «Más opciones»)"
        min={2}
        max={12}
        paso={2}
        valor={12}
        unidad="controles"
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e3`}
      titulo="Completa el patrón de filtrado diseñando su estado vacío"
      comparar={false}
      consigna="Cuando alguien filtra por «Sábado» y no hay talleres ese día, la pantalla queda en blanco y parece que la página se rompió. Añade el estado vacío del patrón."
    >
      <div slot="escenario" style={`padding:14px 16px;font-family:${SANS};color:${T};`}>
        <p style="margin:0;">Lista en blanco sin explicación cuando hay 0 resultados.</p>
      </div>
      <Opciones
        lab={`${lab}-e3`}
        variable="respuesta"
        etiqueta="Qué muestra el patrón cuando hay 0 coincidencias"
        valor="mudo"
        opciones={[
          { valor: 'mudo', texto: 'Espacio en blanco mudo' },
          { valor: 'util', texto: 'Explicación + botón «Restablecer filtros»' },
        ]}
      />
    </Instrumento>
  </div>
)}

{paso === 'ejemplos' && (
  <div class="dv-anotadas">
    <Anotada
      rotulo="Este mismo sitio (/diseno-visual): Revelación progresiva y Guía paso a paso"
      notas={[
        {
          ...pct(180, 58),
          titulo: '3 controles principales de entrada',
          texto: 'Cada instrumento de la enciclopedia muestra de inmediato solo los 2 o 3 controles que explican el fenómeno central.',
          zona: zona(18, 22, 324, 76),
        },
        {
          ...pct(180, 146),
          titulo: '«Más controles» plegado en <details>',
          texto: 'Los parámetros secundarios o de diagnóstico se guardan en un bloque desplegable nativo: siempre accesibles, nunca estorbando.',
          zona: zona(18, 106, 324, 72),
        },
        {
          ...pct(180, 228),
          titulo: 'Patrón de andamiaje (Guía con «Omitir»)',
          texto: 'La guía ofrece un recorrido estructurado paso a paso, pero incluye siempre la salida «Omitir la guía» para quien ya conoce la herramienta.',
          zona: zona(18, 186, 324, 76),
        },
      ]}
    >
