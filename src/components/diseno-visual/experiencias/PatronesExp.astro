)}

{paso === 'juego' && (
  <Juego
    slug={lab}
    rondas={5}
    descripcion="Cinco rondas sobre la diferencia entre componente y patrón, la estructura de Alexander, antipatrones y umbrales de complejidad."
  />
)}

<script>
  import { conectar, svg, n } from '../../../lib/diseno-visual/estado';
  import { guiar } from '../../../lib/diseno-visual/guia';
  import { jugar, barajar, type Ronda } from '../../../lib/diseno-visual/juego';

  const SANS = 'Roboto, Helvetica, Arial, sans-serif';
  const SERIF = "'PT Serif', Georgia, serif";

  type E = {
    patron: string;
    complejidad: number;
    aplicacion: string;
    vacio: boolean;
    alexander: boolean;
  };

  const FICHA_ALEXANDER: Record<string, { ctx: string; prob: string; sol: string }> = {
    revelacion: {
      ctx: 'CONTEXTO: Herramienta con ajustes frecuentes y ajustes expertos.',
      prob: 'PROBLEMA: Mostrar los 18 controles juntos abruma al 85 % de los usuarios.',
      sol: 'SOLUCIÓN: Dejar 3 controles esenciales a la vista y plegar el resto bajo demanda.',
    },
    maestro: {
      ctx: 'CONTEXTO: Exploración y comparación rápida entre decenas de fichas.',
      prob: 'PROBLEMA: Entrar a una página nueva y pulsar «Atrás» cada vez rompe la memoria visual.',
      sol: 'SOLUCIÓN: Mantener la lista maestra fija a un lado y actualizar el detalle en vivo.',
    },
    busqueda: {
      ctx: 'CONTEXTO: Catálogo extenso donde cada persona busca con criterios distintos.',
      prob: 'PROBLEMA: Recorrer una lista plana o quedarse ante una pantalla vacía sin explicación.',
      sol: 'SOLUCIÓN: Combinar buscador, facetas, contador vivo y estado vacío con salida clara.',
    },
  };

  function pintar(destino: HTMLElement, e: E) {
    const W = Math.max(destino.clientWidth, 280);
    const H = e.alexander ? 340 : 280;
    const conPatron = e.aplicacion === 'con-patron';
    const items = e.complejidad;

    const raiz = svg('svg', { viewBox: `0 0 ${W} ${H}`, width: W, height: H, role: 'img' });
    raiz.setAttribute(
      'aria-label',
      `Patrón ${e.patron} con ${items} elementos en modo ${conPatron ? 'con patrón aplicado' : 'sin patrón'}.`,
    );
    raiz.append(svg('rect', { width: W, height: H, fill: '#fbfbf9' }));

    const marcoH = e.alexander ? H - 82 : H - 28;
    const x0 = 16;
    const y0 = 14;
    const w0 = W - 32;

    raiz.append(
      svg('rect', {
        x: x0,
        y: y0,
        width: w0,
        height: marcoH,
        fill: '#ffffff',
        stroke: conPatron ? '#222222' : '#b3261e',
        'stroke-width': 1.6,
      }),
    );

    if (e.patron === 'revelacion') {
      if (conPatron) {
        const esenciales = Math.min(3, items);
        const avanzados = Math.max(0, items - 3);
        const tit = svg('text', {
          x: x0 + 16,
          y: y0 + 24,
          'font-family': SANS,
          'font-size': 10.5,
          'font-weight': 900,
          fill: '#222222',
        });
        tit.textContent = `PRIMER NIVEL · ${esenciales} CONTROLES ESENCIALES (FOCO CLARO)`;
        raiz.append(tit);

        const cw = Math.floor((w0 - 32 - 20) / 3);
        for (let i = 0; i < esenciales; i++) {
          const cx = x0 + 16 + i * (cw + 10);
          raiz.append(svg('rect', { x: cx, y: y0 + 36, width: cw, height: 54, fill: '#fbfbf9', stroke: '#222222', 'stroke-width': 1.4 }));
          const tLbl = svg('text', { x: cx + 10, y: y0 + 56, 'font-family': SANS, 'font-size': 10, 'font-weight': 700, fill: '#222222' });
          tLbl.textContent = ['1. Tamaño', '2. Contraste', '3. Espacio'][i];
          raiz.append(tLbl);
          raiz.append(svg('line', { x1: cx + 10, y1: y0 + 74, x2: cx + cw - 10, y2: y0 + 74, stroke: '#222222', 'stroke-width': 2.5 }));
          raiz.append(svg('circle', { cx: cx + cw * 0.6, cy: y0 + 74, r: 5, fill: '#eeff41', stroke: '#222222', 'stroke-width': 1.5 }));
        }

        // Cajón plegado de revelación progresiva
        const cajY = y0 + 112;
        raiz.append(
          svg('rect', {
            x: x0 + 16,
            y: cajY,
            width: w0 - 32,
            height: 76,
            fill: avanzados > 0 ? '#eeff41' : '#fbfbf9',
            stroke: '#222222',
            'stroke-width': 1.5,
          }),
        );
        const tMas = svg('text', { x: x0 + 28, y: cajY + 28, 'font-family': SANS, 'font-size': 11.5, 'font-weight': 900, fill: '#222222' });
        tMas.textContent = avanzados > 0
          ? `▸ Más controles (${avanzados} parámetros avanzados plegados a pedido)`
          : 'Sin parámetros secundarios adicionales (3 de 3 visibles)';
        raiz.append(tMas);

        const tSub = svg('text', { x: x0 + 28, y: cajY + 50, 'font-family': SERIF, 'font-size': 11.5, fill: '#222222' });
        tSub.textContent = 'La interfaz conserva toda su potencia sin exigir leer 18 deslizadores antes de empezar.';
        raiz.append(tSub);
      } else {
        // Sin patrón: rejilla abrumadora con todos los controles juntos
        const tit = svg('text', {
          x: x0 + 16,
          y: y0 + 22,
          'font-family': SANS,
          'font-size': 10,
          'font-weight': 900,
          fill: '#b3261e',
        });
        tit.textContent = `SIN REVELACIÓN PROGRESIVA · ${items} CONTROLES COMPITIENDO EN UN SOLO NIVEL`;
        raiz.append(tit);

        const cols = items > 12 ? 6 : 4;
        const filas = Math.ceil(items / cols);
        const gap = 6;
        const cw = Math.floor((w0 - 32 - gap * (cols - 1)) / cols);
        const ch = Math.min(44, Math.floor((marcoH - 44 - gap * (filas - 1)) / filas));

        for (let i = 0; i < items; i++) {
          const f = Math.floor(i / cols);
          const c = i % cols;
          const cx = x0 + 16 + c * (cw + gap);
          const cy = y0 + 32 + f * (ch + gap);
          raiz.append(svg('rect', { x: cx, y: cy, width: cw, height: ch, fill: '#fbe9e7', stroke: '#b3261e', 'stroke-width': 1 }));
          const tP = svg('text', { x: cx + 6, y: cy + 15, 'font-family': SANS, 'font-size': 8.5, 'font-weight': 700, fill: '#222222' });
          tP.textContent = `P-${String(i + 1).padStart(2, '0')}`;
          raiz.append(tP);
        }
      }
    } else if (e.patron === 'maestro') {
      if (conPatron) {
        const listaW = Math.round(w0 * 0.36);
        raiz.append(svg('rect', { x: x0 + 12, y: y0 + 12, width: listaW, height: marcoH - 24, fill: '#fbfbf9', stroke: '#222222', 'stroke-width': 1.2 }));
        const tM = svg('text', { x: x0 + 22, y: y0 + 30, 'font-family': SANS, 'font-size': 9.5, 'font-weight': 900, fill: '#6f6f6f' });
        tM.textContent = `MAESTRO (${items} FICHAS)`;
        raiz.append(tM);

        for (let i = 0; i < 5; i++) {
          const fy = y0 + 40 + i * 32;
          const activo = i === 1;
          raiz.append(svg('rect', { x: x0 + 20, y: fy, width: listaW - 16, height: 26, fill: activo ? '#eeff41' : '#ffffff', stroke: '#222222', 'stroke-width': activo ? 1.6 : 1 }));
          const tIt = svg('text', { x: x0 + 28, y: fy + 16, 'font-family': SANS, 'font-size': 9.5, 'font-weight': activo ? 900 : 700, fill: '#222222' });
          tIt.textContent = `S0${i + 1} · Sesión ${i + 1}`;
          raiz.append(tIt);
        }

        const detX = x0 + 20 + listaW;
        const detW = w0 - listaW - 32;
        raiz.append(svg('rect', { x: detX, y: y0 + 12, width: detW, height: marcoH - 24, fill: '#ffffff', stroke: '#222222', 'stroke-width': 1.5 }));
        const tDet = svg('text', { x: detX + 16, y: y0 + 36, 'font-family': SANS, 'font-size': 9.5, 'font-weight': 900, fill: '#6f6f6f' });
        tDet.textContent = 'DETALLE EN VIVO · SIN PERDER EL ÍNDICE';
        raiz.append(tDet);
        const hDet = svg('text', { x: detX + 16, y: y0 + 62, 'font-family': SERIF, 'font-size': 15, 'font-weight': 700, fill: '#222222' });
        hDet.textContent = 'S02 · Umbrales de percepción';
        raiz.append(hDet);
        const pDet = svg('text', { x: detX + 16, y: y0 + 86, 'font-family': SERIF, 'font-size': 11.5, fill: '#444444' });
        pDet.textContent = 'Cambiar de fila a la izquierda actualiza esta vista al instante.';
        raiz.append(pDet);
      } else {
        const tit = svg('text', { x: x0 + 16, y: y0 + 26, 'font-family': SANS, 'font-size': 10, 'font-weight': 900, fill: '#b3261e' });
        tit.textContent = `SIN MAESTRO-DETALLE · ${items} VIAJES DE IDA Y VUELTA CON EL BOTÓN «ATRÁS»`;
        raiz.append(tit);
        for (let i = 0; i < 3; i++) {
          const bx = x0 + 20 + i * Math.floor((w0 - 40) / 3);
          const bw = Math.floor((w0 - 60) / 3);
          raiz.append(svg('rect', { x: bx, y: y0 + 48, width: bw, height: 130, fill: '#fbe9e7', stroke: '#b3261e', 'stroke-width': 1.2 }));
          const tP = svg('text', { x: bx + 12, y: y0 + 74, 'font-family': SANS, 'font-size': 9.5, 'font-weight': 700, fill: '#222222' });
          tP.textContent = i === 1 ? '2. Abre otra URL' : i === 0 ? '1. Clic en lista' : '3. Pulsar «← Atrás»';
          raiz.append(tP);
          const tS = svg('text', { x: bx + 12, y: y0 + 98, 'font-family': SERIF, 'font-size': 10.5, fill: '#444444' });
          tS.textContent = 'Pierdes de vista el resto.';
          raiz.append(tS);
        }
      }
    } else {
      // Patrón: Búsqueda con facetas y estado vacío
      if (conPatron) {
        raiz.append(svg('rect', { x: x0 + 16, y: y0 + 16, width: Math.round(w0 * 0.45), height: 26, fill: '#fbfbf9', stroke: '#222222', 'stroke-width': 1.2 }));
        const tB = svg('text', { x: x0 + 26, y: y0 + 33, 'font-family': SANS, 'font-size': 10, fill: '#444444' });
        tB.textContent = e.vacio ? 'Buscar: «xqz-inexistente»' : 'Buscar por título o territorio…';
        raiz.append(tB);

        const tCont = svg('text', { x: x0 + w0 - 16, y: y0 + 33, 'text-anchor': 'end', 'font-family': SANS, 'font-size': 10, 'font-weight': 900, fill: '#222222' });
        tCont.textContent = e.vacio ? '0 RESULTADOS' : `MOSTRANDO ${Math.min(6, items)} DE ${items}`;
        raiz.append(tCont);

        if (e.vacio) {
          raiz.append(svg('rect', { x: x0 + 16, y: y0 + 56, width: w0 - 32, height: marcoH - 72, fill: '#fbfbf9', stroke: '#222222', 'stroke-width': 1.5, 'stroke-dasharray': '4 3' }));
          const tV1 = svg('text', { x: x0 + w0 / 2, y: y0 + 100, 'text-anchor': 'middle', 'font-family': SERIF, 'font-size': 14, 'font-weight': 700, fill: '#222222' });
          tV1.textContent = 'Ningún concepto coincide con «xqz-inexistente».';
          raiz.append(tV1);
          raiz.append(svg('rect', { x: x0 + w0 / 2 - 84, y: y0 + 118, width: 168, height: 28, fill: '#eeff41', stroke: '#222222', 'stroke-width': 1.5 }));
          const tBtn = svg('text', { x: x0 + w0 / 2, y: y0 + 136, 'text-anchor': 'middle', 'font-family': SANS, 'font-size': 10.5, 'font-weight': 900, fill: '#222222' });
          tBtn.textContent = 'Restablecer búsqueda';
          raiz.append(tBtn);
        } else {
          const cols = 3;
          const cw = Math.floor((w0 - 32 - 16) / cols);
          for (let i = 0; i < 6; i++) {
            const f = Math.floor(i / cols);
            const c = i % cols;
            const cx = x0 + 16 + c * (cw + 8);
            const cy = y0 + 58 + f * 64;
            raiz.append(svg('rect', { x: cx, y: cy, width: cw, height: 54, fill: '#ffffff', stroke: '#222222', 'stroke-width': 1.2 }));
            const tC = svg('text', { x: cx + 10, y: cy + 22, 'font-family': SANS, 'font-size': 9, 'font-weight': 700, fill: '#6f6f6f' });
            tC.textContent = 'TERRITORIO 05';
            raiz.append(tC);
            const tN = svg('text', { x: cx + 10, y: cy + 40, 'font-family': SERIF, 'font-size': 12, 'font-weight': 700, fill: '#222222' });
            tN.textContent = ['Tokens', 'Componentes', 'Patrones', 'Variantes', 'Sistemas', 'Retículas'][i];
            raiz.append(tN);
          }
        }
      } else {
        const tit = svg('text', { x: x0 + 16, y: y0 + 26, 'font-family': SANS, 'font-size': 10, 'font-weight': 900, fill: '#b3261e' });
        tit.textContent = e.vacio
          ? 'ESTADO VACÍO ROTO · LA PANTALLA QUEDA EN BLANCO SIN EXPLICAR QUÉ PASÓ'
          : `LISTA PLANA SIN FILTROS NI RECUENTO · HAY QUE LEER LOS ${items} ÍTEMS UNO POR UNO`;
        raiz.append(tit);
      }
    }

    // Ficha tripartita de Christopher Alexander (1977)
    if (e.alexander) {
      const al = FICHA_ALEXANDER[e.patron] ?? FICHA_ALEXANDER.revelacion;
      const ay = y0 + marcoH + 10;
      raiz.append(svg('rect', { x: x0, y: ay, width: w0, height: 60, fill: '#222222' }));
      const l1 = svg('text', { x: x0 + 12, y: ay + 18, 'font-family': SANS, 'font-size': 9.5, 'font-weight': 700, fill: '#dcdcd6' });
      l1.textContent = al.ctx;
      const l2 = svg('text', { x: x0 + 12, y: ay + 34, 'font-family': SANS, 'font-size': 9.5, 'font-weight': 700, fill: '#ffffff' });
      l2.textContent = al.prob;
      const l3 = svg('text', { x: x0 + 12, y: ay + 50, 'font-family': SANS, 'font-size': 9.5, 'font-weight': 900, fill: '#eeff41' });
      l3.textContent = al.sol;
      raiz.append(l1, l2, l3);
    }

    destino.replaceChildren(raiz);
  }

  function describir(e: E): string {
    const nombres: Record<string, string> = {
      revelacion: 'Revelación progresiva',
      maestro: 'Maestro-detalle',
      busqueda: 'Búsqueda con facetas y estado vacío',
    };
    const nom = nombres[e.patron] ?? e.patron;
    if (e.aplicacion === 'sin-patron') {
      return `Sin el patrón <b class="dv-cifra">${nom}</b>, los <b class="dv-cifra">${n(e.complejidad, 0)} elementos</b> compiten al mismo tiempo o dejan callejones sin salida.`;
    }
    if (e.patron === 'busqueda' && e.vacio) {
      return `<b class="dv-cifra">${nom}</b> ante 0 resultados: en lugar de dejar un lienzo en blanco, informa qué ocurrió y ofrece restablecer la consulta con un clic.`;
    }
    return `Patrón <b class="dv-cifra">${nom}</b> activo para <b class="dv-cifra">${n(e.complejidad, 0)} ítems</b>: organiza la tarea en capas predecibles sin cambiar los componentes individuales.`;
  }

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-lab="patrones"]')) {
    guiar<E>(raiz, [
      (e) => e.patron === 'revelacion' && e.complejidad >= 18 && e.aplicacion === 'sin-patron',
      (e) => e.patron === 'revelacion' && e.complejidad >= 15 && e.aplicacion === 'con-patron',
      (e) => e.patron === 'maestro' && e.aplicacion === 'con-patron',
      (e) => e.patron === 'busqueda' && e.aplicacion === 'con-patron',
      (e) => e.patron === 'busqueda' && e.vacio && e.aplicacion === 'con-patron',
    ]);
    conectar<E>({ raiz, pintar, describir });
  }

  // ── Especímenes de error ─────────────────────────────────────────
  type E1 = { orden: string };
  function pintarE1(d: HTMLElement, e: E1) {
    const inv = e.orden === 'invertido';
    d.innerHTML = `
      <div style="padding:14px 16px;font-family:${SANS};background:#ffffff;border:1.5px solid #222222;display:grid;grid-template-columns:1fr 1fr;gap:10px;color:#222222;">
        <div style="padding:10px;border:1px solid #222222;background:#fbfbf9;">
          <p style="margin:0 0 8px;font-size:10px;font-weight:700;color:#6f6f6f;">PASO 1 · GUARDAR BORRADOR</p>
          <div style="display:flex;gap:6px;justify-content:flex-end;">
            <span style="padding:4px 8px;border:1px solid #222222;background:#ffffff;font-size:10.5px;">Cancelar</span>
            <span style="padding:4px 8px;border:1px solid #222222;background:#eeff41;font-size:10.5px;font-weight:900;">Guardar</span>
          </div>
        </div>
        <div style="padding:10px;border:1.5px solid ${inv ? '#b3261e' : '#222222'};background:${inv ? '#fbe9e7' : '#fbfbf9'};">
          <p style="margin:0 0 8px;font-size:10px;font-weight:700;color:${inv ? '#b3261e' : '#6f6f6f'};">PASO 2 · PUBLICAR ENTREGA</p>
          <div style="display:flex;gap:6px;justify-content:flex-end;">
            ${
              inv
                ? `<span style="padding:4px 8px;border:1px solid #222222;background:#eeff41;font-size:10.5px;font-weight:900;">Publicar</span>
                   <span style="padding:4px 8px;border:1px solid #b3261e;background:#ffffff;font-size:10.5px;font-weight:700;">Cancelar</span>`
                : `<span style="padding:4px 8px;border:1px solid #222222;background:#ffffff;font-size:10.5px;">Cancelar</span>
                   <span style="padding:4px 8px;border:1px solid #222222;background:#eeff41;font-size:10.5px;font-weight:900;">Publicar</span>`
            }
          </div>
        </div>
      </div>`;
  }
  function describirE1(e: E1) {
    if (e.orden === 'invertido') return 'Invertir la posición de «Cancelar» y «Publicar» entre dos ventanas del mismo flujo provoca <b class="dv-cifra">errores por hábito motor</b>.';
    return '<b class="dv-cifra">Patrón espacial consistente</b>: la acción de avance ocupa siempre el mismo lugar predecible.';
  }

  type E2 = { visibles: number };
  function pintarE2(d: HTMLElement, e: E2) {
    const ocultos = 12 - e.visibles;
    const etiquetas = [
      'Formato', 'Calidad', 'Tamaño', 'Perfil ICC', 'Sangrado', 'Marcas corte',
      'Submuestreo', 'Compresión', 'Metadatos', 'Capas', 'Incrustar fuentes', 'Versión PDF',
    ];
    d.innerHTML = `
      <div style="padding:14px 16px;font-family:${SANS};background:#ffffff;border:1.5px solid #222222;color:#222222;">
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:8px;">
          ${etiquetas
            .slice(0, e.visibles)
            .map(
              (et) => `<div style="padding:5px 7px;border:1px solid #222222;background:#fbfbf9;font-size:10px;font-weight:700;">${et}</div>`,
            )
            .join('')}
        </div>
        ${
          ocultos > 0
            ? `<div style="padding:6px 10px;background:#eeff41;border:1.5px solid #222222;font-size:10.5px;font-weight:900;">▸ Más opciones avanzadas de imprenta (${ocultos} plegadas)</div>`
            : `<div style="padding:6px 10px;background:#fbe9e7;border:1px solid #b3261e;font-size:10.5px;font-weight:700;color:#b3261e;">Los 12 controles están abiertos de golpe sin jerarquía.</div>`
        }
      </div>`;
  }
  function describirE2(e: E2) {
    if (e.visibles > 4) return `Con <b class="dv-cifra">${e.visibles} controles</b> abiertos de entrada, el diálogo de exportación intimida antes de empezar.`;
    return `<b class="dv-cifra">${e.visibles} esenciales + ${12 - e.visibles} bajo demanda</b>: quien exporta rápido termina en un segundo y quien imprime en offset abre el desplegable.`;
  }

  type E3 = { respuesta: string };
  function pintarE3(d: HTMLElement, e: E3) {
    const mudo = e.respuesta === 'mudo';
    d.innerHTML = `
      <div style="padding:14px 16px;font-family:${SANS};background:#ffffff;border:1.5px solid #222222;color:#222222;">
        <div style="display:flex;justify-content:space-between;padding-bottom:8px;border-bottom:1px solid #e5e5e5;font-size:10.5px;font-weight:700;">
          <span>Filtro activo: Día = Sábado</span>
          <span>0 resultados</span>
        </div>
        ${
          mudo
            ? `<div style="height:64px;display:flex;align-items:center;justify-content:center;color:#6f6f6f;font-size:11px;">(Vacío total: ¿falló la red o no hay talleres?)</div>`
            : `<div style="padding:10px 0 2px;display:flex;align-items:center;justify-content:space-between;gap:10px;">
                <span style="font-family:${SERIF};font-size:12.5px;color:#222222;">No hay talleres programados los sábados.</span>
                <span style="padding:5px 10px;background:#eeff41;border:1.5px solid #222222;font-size:10.5px;font-weight:900;">Ver todos los días (14)</span>
              </div>`
        }
      </div>`;
  }
  function describirE3(e: E3) {
    if (e.respuesta === 'mudo') return 'Un contenedor vacío sin explicación parece un <b class="dv-cifra">fallo de carga</b>.';
    return '<b class="dv-cifra">Estado vacío constructivo</b>: explica la causa y ofrece la acción directa para recuperar todos los ítems.';
  }

  const especimenes: [string, (d: HTMLElement, e: never) => void, (e: never) => string][] = [
    ['patrones-e1', pintarE1 as never, describirE1 as never],
    ['patrones-e2', pintarE2 as never, describirE2 as never],
    ['patrones-e3', pintarE3 as never, describirE3 as never],
  ];
  for (const [id, p, desc] of especimenes) {
    for (const r of document.querySelectorAll<HTMLElement>(`[data-lab="${id}"]`)) {
      conectar({ raiz: r, pintar: p, describir: desc });
    }
  }

  // ── Juego de 5 rondas ────────────────────────────────────────────
  function r1ComponenteVsPatron(): Ronda {
    const ops = barajar([
      {
        texto: 'El botón y el cuadro de texto son componentes; «pedir confirmación escribiendo el nombre antes de borrar» es un patrón',
        es: true,
      },
      {
        texto: 'Patrón y componente son sinónimos exactos para referirse a cualquier archivo .astro',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: '¿Cuál es la diferencia fundamental entre un componente y un patrón de diseño?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Un componente es una pieza encapsulada concreta (un ladrillo); un patrón es una disposición o secuencia repetible que resuelve una situación humana recurrente.',
      repaso: 'Componente frente a patrón',
    };
  }

  function r2AlexanderContexto(): Ronda {
    const ops = barajar([
      {
        texto: 'Fracasa, porque el desplazamiento infinito impide alcanzar la información fija del pie de página',
        es: true,
      },
      {
        texto: 'Funciona siempre, porque un patrón famoso es válido en cualquier contexto sin excepción',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Un equipo copia el patrón de «desplazamiento infinito» (infinite scroll) en una tienda que además tiene enlaces legales y de contacto importantes en el pie de página. ¿Qué ocurre cuando el usuario intenta llegar al pie?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Como enseñó Christopher Alexander (1977), todo patrón solo es válido dentro de su contexto: cuando el usuario intenta tocar el pie, se cargan más productos y el pie huye hacia abajo.',
      repaso: 'El contexto del patrón',
    };
  }

  function r3MaestroDetalle(): Ronda {
    const ops = barajar([
      {
        texto: 'Maestro-detalle: lista filtrable a la izquierda y vista previa en vivo a la derecha',
        es: true,
      },
      {
        texto: 'Obligar a abrir cada una de las 40 fichas en una pestaña nueva sin vista previa',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Quien usa tu archivo necesita revisar y comparar rápidamente 40 cartas históricas una tras otra sin perder su posición en el índice. ¿Qué patrón resuelve mejor esa tarea?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'El patrón Maestro-detalle mantiene visible el contexto de la colección completa en un panel mientras el otro actualiza el documento elegido al instante.',
      repaso: 'Patrón Maestro-detalle',
    };
  }

  function r4EstadoVacio(): Ronda {
    const ops = barajar([
      {
        texto: 'Mostrar un mensaje claro («0 resultados para este filtro») junto a un botón para limpiar los filtros activos',
        es: true,
      },
      {
        texto: 'Dejar el área de resultados completamente blanca sin texto ni botones',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Al combinar dos filtros en el catálogo, ninguna entrada cumple ambos criterios a la vez. ¿Qué exige el patrón de búsqueda facetada en ese momento?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'El estado vacío es parte inseparable del patrón de búsqueda: confirma que el sistema respondió y ofrece una salida inmediata.',
      repaso: 'Estado vacío en búsquedas',
    };
  }

  function r5AjusteRevelacion(): Ronda {
    return {
      tipo: 'ajuste',
      pregunta: 'Este instrumento muestra 14 controles abiertos de golpe y paraliza a quien entra por primera vez. Ajusta el umbral de revelación progresiva para dejar entre 2 y 4 controles esenciales en primer plano y plegar el resto en «Más controles».',
      control: {
        etiqueta: 'Controles visibles en el primer nivel',
        min: 1,
        max: 14,
        paso: 1,
        valor: 14,
        unidad: 'controles',
      },
      pintar: (c, v) => {
        const plegados = 14 - v;
        c.innerHTML = `
          <div style="padding:12px;font-family:${SANS};background:#ffffff;border:1.5px solid #222222;color:#222222;">
            <p style="margin:0 0 6px;font-size:10px;font-weight:700;color:#6f6f6f;">PRIMER NIVEL: ${v} VISIBLE(S)</p>
            <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px;">
              ${Array.from({ length: v }, (_, i) => `<span style="padding:4px 8px;border:1px solid #222222;background:${i < 3 ? '#eeff41' : '#fbfbf9'};font-size:10px;font-weight:700;">Control ${i + 1}</span>`).join('')}
            </div>
            ${plegados > 0 ? `<div style="padding:5px 8px;border:1px dashed #222222;background:#fbfbf9;font-size:10px;font-weight:700;">▸ Más controles (${plegados} plegados)</div>` : ''}
          </div>`;
      },
      cumple: (v) => v >= 2 && v <= 4,
      falta: (v) => v > 4 ? `Con ${v} controles abiertos a la vez la entrada sigue sobrecargada. Deja entre 2 y 4.` : 'Con un solo control no alcanzas a mostrar la relación entre las dos variables principales.',
      porque: 'Mostrar de 2 a 4 controles esenciales invita a actuar de inmediato, mientras el cajón «Más controles» conserva las opciones avanzadas para quien quiera profundizar.',
      repaso: 'Umbral de revelación progresiva',
    };
  }

  const rootJuego = document.querySelector<HTMLElement>('[data-juego="patrones"]');
  if (rootJuego) {
    jugar(rootJuego, () =>
      barajar([
        r1ComponenteVsPatron(),
        r2AlexanderContexto(),
        r3MaestroDetalle(),
        r4EstadoVacio(),
        r5AjusteRevelacion(),
      ]),
    );
  }
</script>
