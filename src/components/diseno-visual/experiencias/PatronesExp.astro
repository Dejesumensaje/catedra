        <rect x="18" y="42" width="154" height="134" fill={FONDO} stroke={T} stroke-width="1.5" />
        <text x="28" y="62" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>VÍA 1 · POR SEMANA</text>
        <text x="28" y="84" font-family={SANS} font-size="11" font-weight="700" fill={T}>S05 · 3 sep</text>
        <text x="28" y="104" font-family={SANS} font-size="11" font-weight="700" fill={T}>S06 · 10 sep</text>
        <rect x="24" y="114" width="142" height="22" fill={AMARILLO} stroke={T} stroke-width="1.2" />
        <text x="30" y="129" font-family={SANS} font-size="11" font-weight="900" fill={T}>S07 · 17 sep →</text>
        <text x="28" y="154" font-family={SANS} font-size="11" font-weight="700" fill={T}>S08 · 24 sep</text>

        <rect x="188" y="42" width="154" height="134" fill={FONDO} stroke={T} stroke-width="1.5" />
        <text x="198" y="62" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>VÍA 2 · POR TENSIÓN ↔</text>
        <text x="198" y="86" font-family={SERIF} font-size="11.5" font-weight="700" fill={T}>Usabilidad ↔ Experiencia</text>
        <rect x="194" y="102" width="142" height="34" fill={AMARILLO} stroke={T} stroke-width="1.2" />
        <text x="200" y="118" font-family={SERIF} font-size="11" font-weight="700" fill={T}>Control ↔ Agencia</text>
        <text x="200" y="131" font-family={SANS} font-size="9" font-weight="700" fill={T}>Lleva a S03, S07, S12 →</text>
        <text x="198" y="156" font-family={SERIF} font-size="11.5" font-weight="700" fill={T}>Cuerpo ↔ Máquina</text>

        <rect x="18" y="186" width="324" height="74" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="30" y="208" font-family={SANS} font-size="10.5" font-weight="900" fill={T}>DESTINO ÚNICO: /pensamiento-sensorial/s07</text>
        <text x="30" y="228" font-family={SERIF} font-size="11.5" fill={TXT}>Resuelve dos intenciones de búsqueda distintas sin</text>
        <text x="30" y="244" font-family={SERIF} font-size="11.5" fill={TXT}>duplicar jamás la fuente de verdad (.mdx).</text>
