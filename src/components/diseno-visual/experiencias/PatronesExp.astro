        {
          ...pct(330, 56),
          titulo: 'Pregunta específica con nombre propio',
          texto: 'En vez de un «¿Estás seguro?» genérico que se acepta sin leer, el título nombra qué objeto exacto va a desaparecer.',
          zona: zona(24, 24, 312, 58),
        },
        {
          ...pct(330, 134),
          titulo: 'Cuantificación del impacto',
          texto: 'Enumera qué piezas dependientes se verán afectadas (18 entregas y 4 enlaces rotos) antes de que ocurra el daño.',
          zona: zona(24, 88, 312, 82),
        },
        {
          ...pct(330, 224),
          titulo: 'Verbo inequívoco en el botón final',
          texto: 'El botón repite la acción exacta («Eliminar repositorio») en lugar de decir «Sí» o «Aceptar».',
          zona: zona(24, 178, 312, 76),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Diálogo modal de confirmación bien diseñado que especifica el objeto a eliminar, detalla el impacto y usa verbos explícitos en los botones.">
        <rect width={W} height={H} fill={FONDO} />
        <rect x="24" y="24" width="312" height="230" fill={PAPEL} stroke={T} stroke-width="2" />
        <text x="40" y="50" font-family={SANS} font-size="10" font-weight="700" letter-spacing="0.08em" fill={ROJO}>ACCIÓN IRREVERSIBLE</text>
        <text x="40" y="72" font-family={SERIF} font-size="15" font-weight="700" fill={T}>¿Eliminar el curso «Archivo 2024»?</text>

        <rect x="40" y="90" width="280" height="74" fill="#fbe9e7" stroke={ROJO} stroke-width="1.2" />
        <text x="52" y="110" font-family={SANS} font-size="10" font-weight="700" fill={T}>Qué ocurrirá si continúas:</text>
        <text x="52" y="128" font-family={SERIF} font-size="11" fill={T}>• Se borrarán las 16 sesiones y sus memorias.</text>
        <text x="52" y="146" font-family={SERIF} font-size="11" fill={T}>• Quedarán sin destino 12 enlaces públicos.</text>

        <rect x="40" y="190" width="116" height="34" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="98" y="211" text-anchor="middle" font-family={SANS} font-size="11" font-weight="700" fill={T}>Conservar curso</text>

        <rect x="168" y="190" width="152" height="34" fill={ROJO} stroke={T} stroke-width="1.5" />
        <text x="244" y="211" text-anchor="middle" font-family={SANS} font-size="11" font-weight="900" fill={PAPEL}>Eliminar «Archivo 2024»</text>
      </svg>
    </Anotada>
