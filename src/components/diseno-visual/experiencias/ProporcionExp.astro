        <line x1="180" y1="257" x2="336" y2="23" stroke="#d8d8d0" stroke-width="1" stroke-dasharray="3 3" />
        <!-- Cajas de texto (márgenes 2:3:4:6 -> ext 34, cabeza 26, int 18, pie 52) -->
        <rect x="58" y="49" width="104" height="156" fill="#f4f4ee" stroke={T} stroke-width="1.2" />
        <rect x="198" y="49" width="104" height="156" fill={AMARILLO} stroke={T} stroke-width="1.5" />
        {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
          <g>
            <line x1="66" y1={62 + i * 15} x2="154" y2={62 + i * 15} stroke={TXT} stroke-width="2" />
            <line x1="206" y1={62 + i * 15} x2="294" y2={62 + i * 15} stroke={T} stroke-width="2" />
          </g>
        ))}
        <!-- Cotas de razón 2:3:4:6 en la página derecha -->
        <text x="189" y="130" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="900" fill={ROJO}>2</text>
        <text x="250" y="40" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="900" fill={ROJO}>3</text>
        <text x="319" y="130" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="900" fill={ROJO}>4</text>
        <text x="250" y="234" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="900" fill={ROJO}>6</text>
      </svg>
    </Anotada>

    <Anotada
      rotulo="Norma DIN 476 / ISO 216 (1:√2): invariancia al doblar"
      notas={[
        {
          ...pct(112, 138),
          titulo: 'Razón irracional 1 : 1,414',
