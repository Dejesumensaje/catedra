    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Doble página de libro abierto mostrando las diagonales de Van de Graaf y la progresión de márgenes 2:3:4:6.">
        <rect width={W} height={H} fill="#fbfbf9" />
