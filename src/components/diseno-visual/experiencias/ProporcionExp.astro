---
import Anotada from '../Anotada.astro';
import Instrumento from '../controles/Instrumento.astro';
import Deslizador from '../controles/Deslizador.astro';
import Opciones from '../controles/Opciones.astro';
import Interruptor from '../controles/Interruptor.astro';
import Guia, { type PasoGuia } from '../controles/Guia.astro';
import Juego from '../Juego.astro';

interface Props {
  paso: 'idea' | 'miralo' | 'pruebalo' | 'errores' | 'ejemplos' | 'juego';
}

const { paso } = Astro.props;
const lab = 'proporcion';

const W = 360;
const H = 280;
const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const SERIF = "'PT Serif', Georgia, serif";
const T = '#222222';
const TXT = '#444444';
const G = '#6f6f6f';
const ROJO = '#b3261e';
const AMARILLO = '#eeff41';

const pct = (x: number, y: number) => ({ x: (x / W) * 100, y: (y / H) * 100 });
const zona = (x: number, y: number, w: number, h: number) => ({
  x: (x / W) * 100,
  y: (y / H) * 100,
  w: (w / W) * 100,
  h: (h / H) * 100,
});

const pasos: PasoGuia[] = [
  {
    titulo: 'Comprueba el empate del 50 %.',
    hacer: 'Lleva «División principal / secundaria» a 50 %.',
    pista: 'Ubica el deslizador justo en la mitad (50 %).',
    preparar: { formato: '3:2', division: 62, margenes: 'canon', cotas: true },
    logro: 'Al 50 %, la imagen y la columna de texto ocupan exactamente la misma superficie. Ninguna domina ni acompaña: la mirada duda entre las dos mitades.',
  },
  {
    titulo: 'Observa la incomodidad de la zona tibia.',
    hacer: 'Mueve «División principal / secundaria» a 48 % o 52 %.',
    pista: 'Desplaza el control apenas 2 puntos a la izquierda o a la derecha del centro.',
    logro: 'Entre 46 % y 54 % la diferencia es demasiado pequeña para leerse como una decisión jerárquica y demasiado grande para verse simétrica. Suele percibirse como un 50/50 mal medido.',
  },
  {
    titulo: 'Establece una proporción clara (5:3 o 2:1).',
    hacer: 'Lleva «División principal / secundaria» a un valor entre 62 % y 68 %.',
    pista: 'Mueve el deslizador hacia la derecha hasta cruzar el 60 %.',
    logro: 'Con una partición cercana a 5:3 (62 %) o 2:1 (67 %), la zona principal domina sin ambigüedad y la columna secundaria actúa como contrapeso informativo.',
  },
  {
    titulo: 'Cambia la proporción exterior del formato.',
    hacer: 'En «Proporción del formato», selecciona «1:1,414 (DIN A4)».',
    pista: 'Elige la opción DIN A4 en el primer selector.',
    logro: 'La norma DIN (1:√2) tiene una propiedad única: si doblas o divides la hoja por la mitad del lado largo, las dos mitades conservan exactamente la misma proporción 1:1,414 del pliego original.',
  },
  {
    titulo: 'Compara márgenes iguales frente a márgenes progresivos.',
    hacer: 'Abre «Más controles» y cambia «Relación de márgenes» a «Uniforme (1:1:1:1)» y luego a «Progresiva (2:3:4:6)».',
    abrir: true,
    preparar: { formato: '2:3', division: 62 },
    logro: 'Con márgenes idénticos arriba y abajo, la caja impresa parece hundirse por gravedad óptica. La progresión clásica (más espacio al pie que a la cabeza) sostiene visualmente el bloque.',
  },
];
---

{paso === 'idea' && (
  <div class="dv-pregunta-visual">
    <div class="dv-pv-lienzo">
      <svg viewBox="0 0 600 180" role="img" aria-label="Dos pliegos con imagen y texto: a la izquierda divididos en 50 % y 50 % en empate; a la derecha divididos en 62 % y 38 % (razón 5:3) con jerarquía clara.">
        <rect width="600" height="180" fill="#fbfbf9" />

        <!-- Izquierda: 50% / 50% -->
        <g transform="translate(24, 18)">
          <text x="0" y="12" font-family={SANS} font-size="10" font-weight="700" letter-spacing="0.8" fill={G}>PARTICIÓN 50 % / 50 % · RAZÓN 1:1</text>
          <rect x="0" y="20" width="256" height="132" fill="#ffffff" stroke={T} stroke-width="1.5" />
          <!-- Mitad izquierda imagen -->
          <rect x="10" y="30" width="114" height="112" fill="#e5e5e0" stroke={T} stroke-width="1.2" />
          <circle cx="67" cy="76" r="22" fill={T} />
          <line x1="22" y1="124" x2="112" y2="124" stroke={G} stroke-width="2" />
          <!-- Eje central 50% -->
          <line x1="128" y1="20" x2="128" y2="152" stroke={ROJO} stroke-width="1.5" stroke-dasharray="3 3" />
          <!-- Mitad derecha texto -->
          <rect x="136" y="34" width="102" height="12" fill={T} />
          <rect x="136" y="52" width="94" height="8" fill={T} />
          <rect x="136" y="72" width="106" height="5" fill={TXT} />
          <rect x="136" y="82" width="100" height="5" fill={TXT} />
          <rect x="136" y="92" width="104" height="5" fill={TXT} />
          <rect x="136" y="102" width="82" height="5" fill={TXT} />
          <rect x="136" y="124" width="64" height="14" fill="#ffffff" stroke={T} stroke-width="1.2" />
          <text x="64" y="148" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={ROJO}>50 %</text>
          <text x="192" y="148" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={ROJO}>50 %</text>
        </g>

        <!-- Derecha: 62% / 38% (5:3) -->
        <g transform="translate(320, 18)">
          <text x="0" y="12" font-family={SANS} font-size="10" font-weight="700" letter-spacing="0.8" fill={T}>PARTICIÓN 62 % / 38 % · RAZÓN 5:3</text>
          <rect x="0" y="20" width="256" height="132" fill="#ffffff" stroke={T} stroke-width="1.5" />
          <!-- 62% imagen dominante -->
          <rect x="10" y="30" width="144" height="112" fill={AMARILLO} stroke={T} stroke-width="1.5" />
          <circle cx="82" cy="80" r="28" fill={T} />
          <line x1="26" y1="126" x2="138" y2="126" stroke={T} stroke-width="2" />
          <!-- Eje 62% -->
          <line x1="160" y1="20" x2="160" y2="152" stroke={T} stroke-width="1.2" stroke-dasharray="3 3" />
          <!-- 38% columna de texto -->
          <rect x="168" y="34" width="76" height="11" fill={T} />
          <rect x="168" y="50" width="64" height="7" fill={T} />
          <rect x="168" y="68" width="76" height="4.5" fill={TXT} />
          <rect x="168" y="77" width="72" height="4.5" fill={TXT} />
          <rect x="168" y="86" width="74" height="4.5" fill={TXT} />
          <rect x="168" y="95" width="58" height="4.5" fill={TXT} />
          <rect x="168" y="124" width="56" height="14" fill={T} />
          <text x="82" y="148" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={T}>62 % (5)</text>
          <text x="208" y="148" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>38 % (3)</text>
        </g>
      </svg>
    </div>
    <p>Los dos pliegos contienen la misma imagen y el mismo texto. ¿En cuál de los dos queda claro de inmediato qué bloque manda y cuál acompaña?</p>
    <details>
      <summary>Ver la respuesta</summary>
      <div class="dv-texto">
        <p>En el segundo (`62 % / 38 %`, razón aproximada `5:3`). Cuando divides una superficie en dos partes iguales (`50 % / 50 %`), ambas mitades reclaman el mismo protagonismo y producen un empate estático. Cuando la partición es francamente desigual, aparece una relación entre dominante y subordinado.</p>
      </div>
    </details>
  </div>
)}

{paso === 'miralo' && (
  <div class="dv-anotadas">
    <Anotada
      veredicto="mal"
      rotulo="Particiones tibias y medidas inconexas"
      notas={[
        {
          ...pct(184, 92),
          titulo: 'División casi a la mitad (48 % / 52 %)',
          texto: 'La foto y la columna de datos miden casi lo mismo, pero no exactamente igual. En vez de verse equilibrado, parece un centrado que falló por pocos milímetros.',
          zona: zona(18, 52, 324, 134),
        },
        {
          ...pct(312, 118),
          titulo: 'Recorte indeciso (1:1,06)',
          texto: 'El recuadro de la fotografía no es ni cuadrado franco (1:1) ni rectangular claro (4:3 o 3:2). Esa ambigüedad geométrica incomoda a la vista.',
          zona: zona(22, 58, 152, 122),
        },
        {
          ...pct(180, 248),
          titulo: 'Margen inferior aplastado',
          texto: 'El margen superior es más alto que el inferior y las tres franjas horizontales tienen alturas parecidas entre sí, por lo que la ficha parece caerse hacia el borde inferior.',
          zona: zona(18, 192, 324, 76),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Ficha editorial con partición indecisa de 48 % y 52 %, recorte casi cuadrado y margen inferior estrecho.">
        <rect width={W} height={H} fill="#ffffff" />
        <rect x="18" y="24" width="324" height="244" fill="#fbfbf9" stroke={T} stroke-width="1.5" />
        <!-- Encabezado pesado -->
        <rect x="28" y="34" width="304" height="22" fill="#e9e9e4" />
        <text x="36" y="49" font-family={SANS} font-size="10" font-weight="700" fill={T}>ARCHIVO DE ARQUITECTURA · FICHA 14</text>
        <!-- División 48% / 52% -->
        <line x1="174" y1="56" x2="174" y2="190" stroke={ROJO} stroke-width="1" stroke-dasharray="3 2" />
        <rect x="28" y="64" width="138" height="122" fill="#dcdcd4" stroke={T} stroke-width="1.2" />
        <rect x="52" y="88" width="90" height="74" fill="none" stroke={T} stroke-width="1.5" />
        <text x="97" y="130" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={ROJO}>1 : 1,06</text>
        <!-- Derecha 52% -->
        <text x="182" y="82" font-family={SERIF} font-size="15" font-weight="700" fill={T}>Pabellón Nórdico</text>
        <text x="182" y="98" font-family={SANS} font-size="10" font-weight="700" fill={G}>Sverre Fehn · 1962</text>
        <rect x="182" y="110" width="142" height="5" fill={TXT} />
        <rect x="182" y="121" width="136" height="5" fill={TXT} />
        <rect x="182" y="132" width="144" height="5" fill={TXT} />
        <rect x="182" y="143" width="118" height="5" fill={TXT} />
        <text x="97" y="182" text-anchor="middle" font-family={SANS} font-size="9" font-weight="700" fill={ROJO}>48 %</text>
        <text x="252" y="182" text-anchor="middle" font-family={SANS} font-size="9" font-weight="700" fill={ROJO}>52 %</text>
        <!-- Bloque inferior casi igual de alto y pegado al borde -->
        <rect x="28" y="194" width="304" height="68" fill="#ffffff" stroke={T} stroke-width="1.2" />
        <text x="38" y="214" font-family={SANS} font-size="10" font-weight="700" fill={T}>NOTA DE CONSTRUCCIÓN</text>
        <rect x="38" y="224" width="276" height="5" fill={TXT} />
        <rect x="38" y="235" width="260" height="5" fill={TXT} />
        <rect x="38" y="246" width="220" height="5" fill={TXT} />
      </svg>
    </Anotada>

    <Anotada
      veredicto="bien"
      rotulo="Razón 2:1 y márgenes progresivos"
      notas={[
        {
          ...pct(224, 108),
          titulo: 'Partición en tercios (2:1)',
          texto: 'La fotografía ocupa dos tercios del ancho útil (67 %) y la columna de texto un tercio (33 %). La relación 2:1 organiza el recorrido de inmediato.',
          zona: zona(26, 46, 308, 168),
        },
        {
          ...pct(124, 118),
          titulo: 'Formato 3:2 definido',
          texto: 'El encuadre de la imagen mantiene una proporción clásica 3:2 que dialoga con la caja general del pliego.',
          zona: zona(26, 52, 198, 132),
        },
        {
          ...pct(180, 246),
          titulo: 'Margen inferior generoso (progresión)',
          texto: 'El pie deja el doble de espacio que la cabeza. Ese zócalo sostiene la composición y evita que parezca hundirse.',
          zona: zona(18, 214, 324, 54),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="La misma ficha editorial organizada en proporción 2:1 (dos tercios para la imagen en formato 3:2 y un tercio para la ficha), con margen inferior amplio.">
        <rect width={W} height={H} fill="#ffffff" />
        <rect x="18" y="16" width="324" height="248" fill="#fbfbf9" stroke={T} stroke-width="1.5" />
        <!-- Cabecera compacta -->
        <text x="30" y="36" font-family={SANS} font-size="9.5" font-weight="700" letter-spacing="1" fill={G}>ARCHIVO DE ARQUITECTURA · FICHA 14</text>
        <line x1="30" y1="43" x2="330" y2="43" stroke="#dcdcd6" stroke-width="1" />
        <!-- 2/3 imagen en proporción 3:2 (192 x 128) -->
        <rect x="30" y="54" width="192" height="128" fill={AMARILLO} stroke={T} stroke-width="1.5" />
        <rect x="54" y="72" width="144" height="92" fill="#ffffff" stroke={T} stroke-width="1.5" />
        <line x1="54" y1="102" x2="198" y2="102" stroke={T} stroke-width="1.2" />
        <line x1="102" y1="72" x2="102" y2="164" stroke={T} stroke-width="1.2" />
        <line x1="150" y1="72" x2="150" y2="164" stroke={T} stroke-width="1.2" />
        <text x="126" y="177" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={T}>2/3 · FORMATO 3:2</text>
        <!-- Línea de tercio -->
        <line x1="230" y1="50" x2="230" y2="212" stroke={T} stroke-width="1" stroke-dasharray="3 3" />
        <!-- 1/3 columna derecha -->
        <text x="238" y="68" font-family={SERIF} font-size="15" font-weight="700" fill={T}>Pabellón</text>
        <text x="238" y="89" font-family={SERIF} font-size="15" font-weight="700" fill={T}>Nórdico</text>
        <text x="238" y="106" font-family={SANS} font-size="10" font-weight="700" fill={G}>Sverre Fehn, 1962</text>
        <rect x="238" y="120" width="88" height="4.5" fill={TXT} />
        <rect x="238" y="130" width="82" height="4.5" fill={TXT} />
        <rect x="238" y="140" width="86" height="4.5" fill={TXT} />
        <rect x="238" y="150" width="68" height="4.5" fill={TXT} />
        <text x="284" y="177" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>1/3 (33 %)</text>
        <!-- Pie con zócalo amplio debajo -->
        <line x1="30" y1="194" x2="330" y2="194" stroke="#dcdcd6" stroke-width="1" />
        <text x="30" y="210" font-family={SERIF} font-size="11" fill={TXT}>Luz difusa mediante vigas de hormigón de 60 mm de espesor.</text>
        <text x="180" y="246" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>ZÓCALO DE APOYO · MARGEN INFERIOR AMPLIO</text>
      </svg>
    </Anotada>
  </div>
)}

{paso === 'pruebalo' && (
  <Instrumento
    id={lab}
    titulo="Instrumento · laboratorio de formatos y particiones"
    consigna="Ajusta la proporción exterior del formato, mueve la división entre la zona principal y la secundaria, y compara qué ocurre cuando pasas del empate (50 %) a razones como 3:2 (60 %), 5:3 (62 %) o 2:1 (67 %)."
    nota="Fija una división de 50 % como A y compárala con 62 % (5:3) o 67 % (2:1) como B para observar cómo desaparece la indecisión."
  >
    <svg slot="escenario" viewBox="0 0 640 340" role="img" aria-label="Pliego editorial en proporción 3:2 dividido en 62 % para la imagen principal y 38 % para la columna de texto.">
      <rect width="640" height="340" fill="#fbfbf9" />
      <rect x="110" y="26" width="420" height="280" fill="#ffffff" stroke={T} stroke-width="1.8" />
      <rect x="138" y="54" width="224" height="196" fill={AMARILLO} stroke={T} stroke-width="1.5" />
      <rect x="378" y="54" width="124" height="18" fill={T} />
      <rect x="378" y="82" width="110" height="8" fill={G} />
      <rect x="378" y="106" width="120" height="6" fill={TXT} />
      <rect x="378" y="118" width="114" height="6" fill={TXT} />
      <rect x="378" y="130" width="118" height="6" fill={TXT} />
    </svg>

    <Guia slot="guia" pasos={pasos} final="Guía completada. Prueba otros formatos y activa las líneas de razón matemática en «Más controles»." />

    <Opciones
      lab={lab}
      variable="formato"
      etiqueta="Proporción del formato"
      valor="3:2"
      opciones={[
        { valor: '1:1', texto: '1:1 (Cuadrado)' },
        { valor: '4:5', texto: '4:5 (Editorial)' },
        { valor: 'din', texto: '1:1,414 (DIN A4)' },
        { valor: '3:2', texto: '3:2 (Clásico)' },
        { valor: '16:9', texto: '16:9 (Pantalla)' },
      ]}
      ayuda="Relación entre el ancho y el alto del soporte exterior."
    />
    <Deslizador
      lab={lab}
      variable="division"
      etiqueta="División principal / secundaria"
      min={20}
      max={80}
      paso={1}
      valor={62}
      unidad="%"
      ayuda="Porcentaje del espacio interior asignado a la zona principal. Entre 46 % y 54 % aparece la zona tibia."
    />

    <Fragment slot="avanzados">
      <Opciones
        lab={lab}
        variable="margenes"
        etiqueta="Relación de márgenes"
        valor="canon"
        opciones={[
          { valor: 'uniforme', texto: 'Uniforme (1:1:1:1)' },
          { valor: 'canon', texto: 'Progresiva (2:3:4:6)' },
          { valor: 'estrecho', texto: 'Mínima' },
        ]}
        ayuda="La progresión clásica 2:3:4:6 da más espacio al margen exterior y al pie para sostener la mancha."
      />
      <Interruptor
        lab={lab}
        variable="cotas"
        etiqueta="Mostrar razones matemáticas y diagnóstico"
        activo={true}
        ayuda="Dibuja las cotas, la razón simplificada más cercana y señala si la partición cae en empate."
      />
    </Fragment>

    <Fragment slot="pruebas">
      <button type="button" class="dv-boton" data-preset='{"formato":"3:2","division":50,"margenes":"uniforme","cotas":true}'>Empate indeciso (50 / 50)</button>
      <button type="button" class="dv-boton" data-preset='{"formato":"3:2","division":62,"margenes":"canon","cotas":true}'>Sección 5:3 (62 / 38)</button>
      <button type="button" class="dv-boton" data-preset='{"formato":"din","division":67,"margenes":"canon","cotas":true}'>Hoja DIN A4 en tercios (2:1)</button>
      <button type="button" class="dv-boton" data-preset='{"formato":"16:9","division":75,"margenes":"uniforme","cotas":true}'>Interfaz 3:1 (lienzo + panel)</button>
    </Fragment>
  </Instrumento>
)}

{paso === 'errores' && (
  <div class="dv-especimenes">
    <Instrumento
      id={`${lab}-e1`}
      titulo="Salir del empate 50 / 50 entre dos paneles"
      comparar={false}
      consigna="Esta interfaz divide la pantalla exactamente por la mitad entre el menú lateral y el documento de trabajo. Asigna al documento principal al menos dos tercios (67 %) o tres cuartos (75 %) del ancho."
    >
      <div slot="escenario" style="padding:16px 18px;font-family:Roboto,Helvetica,Arial,sans-serif;color:#222;">
        <p style="margin:0;font-size:13px;font-weight:700;">50 % menú lateral · 50 % lienzo de trabajo</p>
      </div>
      <Deslizador
        lab={`${lab}-e1`}
        variable="lienzo"
        etiqueta="Ancho del lienzo principal"
        min={45}
        max={80}
        paso={1}
        valor={50}
        unidad="%"
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e2`}
      titulo="Corregir un «casi cuadrado» accidental"
      comparar={false}
      consigna="El recorte de esta fotografía mide 1:1,06: no parece un rectángulo intencional, sino un cuadrado que salió descuadrado. Elige una proporción definida."
    >
      <div slot="escenario" style="padding:16px 18px;font-family:Roboto,Helvetica,Arial,sans-serif;color:#222;">
        <p style="margin:0;font-size:13px;font-weight:700;">Recorte ambiguo 1 : 1,06</p>
      </div>
      <Opciones
        lab={`${lab}-e2`}
        variable="recorte"
        etiqueta="Proporción del recorte"
        valor="1:1.06"
        opciones={[
          { valor: '1:1.06', texto: '1:1,06 (Tibia)' },
          { valor: '1:1', texto: '1:1 (Cuadrado franco)' },
          { valor: '4:3', texto: '4:3 (Rectangular)' },
          { valor: '3:2', texto: '3:2 (Horizontal)' },
        ]}
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e3`}
      titulo="Dar más zócalo al pie que a la cabeza"
      comparar={false}
      consigna="Cuando el margen inferior es menor o igual que el superior, el bloque parece resbalar hacia abajo. Aumenta la proporción del margen inferior respecto al superior."
    >
      <div slot="escenario" style="padding:16px 18px;font-family:Roboto,Helvetica,Arial,sans-serif;color:#222;">
        <p style="margin:0;font-size:13px;font-weight:700;">Margen inferior insuficiente</p>
      </div>
      <Deslizador
        lab={`${lab}-e3`}
        variable="pie"
        etiqueta="Proporción del margen inferior frente al superior"
        min={80}
        max={200}
        paso={10}
        valor={90}
        unidad="%"
      />
    </Instrumento>
  </div>
)}

{paso === 'ejemplos' && (
  <div class="dv-anotadas">
    <Anotada
      rotulo="Pliego de libro clásico: canon de márgenes 2:3:4:6 (Tschichold)"
      notas={[
        {
          ...pct(180, 128),
          titulo: 'Lomo compartido (2 + 2 = 4)',
          texto: 'El margen interior de cada página mide 2 partes, de modo que al abrir el libro ambos márgenes centrales suman 4 partes y equilibran el margen exterior.',
          zona: zona(156, 36, 48, 174),
        },
        {
          ...pct(312, 118),
          titulo: 'Progresión 2 : 3 : 4 : 6',
