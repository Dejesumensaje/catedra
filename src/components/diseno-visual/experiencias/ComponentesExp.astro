---
import Anotada from '../Anotada.astro';
import Instrumento from '../controles/Instrumento.astro';
import Deslizador from '../controles/Deslizador.astro';
import Opciones from '../controles/Opciones.astro';
import Interruptor from '../controles/Interruptor.astro';
import Guia, { type PasoGuia } from '../controles/Guia.astro';
import Juego from '../Juego.astro';

interface Props {
  paso: 'idea' | 'miralo' | 'pruebalo' | 'errores' | 'ejemplos' | 'juego';
}

const { paso } = Astro.props;
const lab = 'componentes';

const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const SERIF = "'PT Serif', Georgia, serif";
const T = '#222222';
const TXT = '#444444';
const G = '#6f6f6f';
const PAPEL = '#ffffff';
const FONDO = '#fbfbf9';
const REGLA = '#e5e5e5';
const AMARILLO = '#eeff41';
const ROJO = '#b3261e';

const W = 360;
const H = 280;
const pct = (x: number, y: number) => ({ x: Math.round((x / W) * 100), y: Math.round((y / H) * 100) });
const zona = (x: number, y: number, w: number, h: number) => ({
  x: Math.round((x / W) * 100),
  y: Math.round((y / H) * 100),
  w: Math.round((w / W) * 100),
  h: Math.round((h / H) * 100),
});

const pasos: PasoGuia[] = [
  {
    titulo: 'Somete el título a una longitud real.',
    hacer: 'Sube «Longitud del título (palabras)» a 18 o más.',
    pista: 'Arrastra el primer deslizador hacia la derecha.',
    logro: 'El título pasa de caber en un renglón ideal a ocupar tres líneas completas. Como el componente tiene altura elástica, empuja hacia abajo el resumen y la botonera sin pisar ningún elemento.',
  },
  {
    titulo: 'Quita las piezas opcionales.',
    hacer: 'En «Datos opcionales presentes», selecciona «Sin imagen ni etiqueta».',
    pista: 'Elige la tercera opción del selector de datos opcionales.',
    logro: 'Cuando faltan la miniatura y la categoría, el componente no deja un rectángulo gris vacío ni un hueco huérfano: el bloque de texto ocupa el ancho completo con limpieza.',
  },
  {
    titulo: 'Estrecha el contenedor donde vive.',
    hacer: 'Baja «Ancho del contenedor donde vive» a 280 px o menos.',
    pista: 'Mueve el deslizador de ancho hacia la izquierda.',
    preparar: { opcionales: 'todo', palabras: 10 },
    logro: 'En una columna estrecha, mantener la imagen al lado del texto aplastaría los renglones. El componente apila sus zonas verticalmente para proteger el ancho de lectura.',
  },
  {
    titulo: 'Observa qué ocurre cuando el contenedor es rígido.',
    hacer: 'Abre «Más controles» y en «Comportamiento ante contenido largo» elige «Altura fija (rígido)».',
    pista: 'Despliega «Más controles» y selecciona la segunda opción.',
    preparar: { palabras: 20, ancho: 460, opcionales: 'todo' },
    abrir: true,
    logro: 'Al fijar la altura en píxeles como en una maqueta estática, un título real de veinte palabras desborda la caja y pisa el botón de acción.',
  },
  {
    titulo: 'Inspecciona la anatomía interna en rayos X.',
    hacer: 'Con «Más controles» abierto, vuelve a «Elástico (se adapta)» y activa «Vista de rayos X (anatomía de huecos y reglas)».',
    pista: 'Elige «Elástico (se adapta)» y marca la casilla de rayos X.',
    abrir: true,
    logro: 'Las cotas muestran qué partes del componente son estructura fija (el marco, el pie de acción) y qué partes son ranuras elásticas u opcionales.',
  },
];
---

{paso === 'idea' && (
  <div class="dv-pregunta-visual">
    <svg viewBox="0 0 600 180" role="img" aria-label="Tres tarjetas: la maqueta ideal con 'Cine al aire', la tarjeta rígida rota cuando recibe un título de catorce palabras, y el componente elástico que se adapta sin romperse.">
      <rect width="600" height="180" fill={FONDO} />
      {/* 1. Maqueta ideal */}
      <g transform="translate(16, 18)">
        <rect width="176" height="144" fill={PAPEL} stroke={REGLA} stroke-width="1.5" />
        <text x="12" y="20" font-family={SANS} font-size="9" font-weight="700" fill={G}>1. MAQUETA IDEAL (FICTICIA)</text>
        <rect x="12" y="28" width="152" height="36" fill="#eaeae4" stroke={T} stroke-width="1" />
        <text x="88" y="50" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={TXT}>FOTO PERFECTA</text>
        <text x="12" y="84" font-family={SERIF} font-size="14" font-weight="700" fill={T}>Cine al aire</text>
        <text x="12" y="102" font-family={SANS} font-size="10" fill={G}>Jueves · 19:00</text>
        <rect x="12" y="112" width="84" height="22" fill={T} />
        <text x="54" y="127" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="700" fill={PAPEL}>Inscribirse</text>
      </g>

      {/* 2. Caja rígida con texto real */}
      <g transform="translate(212, 18)">
        <rect width="176" height="144" fill={PAPEL} stroke={ROJO} stroke-width="2" />
        <text x="12" y="20" font-family={SANS} font-size="9" font-weight="700" fill={ROJO}>2. CAJA RÍGIDA + DATO REAL</text>
        <rect x="12" y="28" width="152" height="32" fill="#fbe9e7" stroke={ROJO} stroke-width="1" stroke-dasharray="3 2" />
        <text x="88" y="48" text-anchor="middle" font-family={SANS} font-size="9" font-weight="700" fill={ROJO}>SIN FOTO (HUECO ROTO)</text>
        <text x="12" y="74" font-family={SERIF} font-size="11" font-weight="700" fill={T}>Coloquio internacional sobre</text>
        <text x="12" y="88" font-family={SERIF} font-size="11" font-weight="700" fill={T}>restauración de archivos de</text>
        <text x="12" y="102" font-family={SERIF} font-size="11" font-weight="700" fill={T}>nitrato en América Latina</text>
        <text x="12" y="116" font-family={SANS} font-size="9.5" font-weight="700" fill={ROJO}>Dra. M. Vega y Dr. J. Ortiz</text>
        <rect x="12" y="122" width="96" height="20" fill={T} />
        <text x="60" y="135" text-anchor="middle" font-family={SANS} font-size="9" font-weight="700" fill={AMARILLO}>Desborda la caja</text>
      </g>

      {/* 3. Componente elástico */}
      <g transform="translate(408, 18)">
        <rect width="176" height="144" fill={PAPEL} stroke={T} stroke-width="1.8" />
        <text x="12" y="20" font-family={SANS} font-size="9" font-weight="700" fill={T}>3. COMPONENTE ELÁSTICO</text>
        <text x="12" y="40" font-family={SERIF} font-size="11.5" font-weight="700" fill={T}>Coloquio internacional sobre</text>
        <text x="12" y="55" font-family={SERIF} font-size="11.5" font-weight="700" fill={T}>restauración de archivos de</text>
        <text x="12" y="70" font-family={SERIF} font-size="11.5" font-weight="700" fill={T}>nitrato en América Latina</text>
        <text x="12" y="88" font-family={SANS} font-size="9.5" fill={TXT}>M. Vega · J. Ortiz · Jue 19:00</text>
        <line x1="12" y1="98" x2="164" y2="98" stroke={REGLA} stroke-width="1" />
        <rect x="12" y="108" width="96" height="24" fill={AMARILLO} stroke={T} stroke-width="1.5" />
        <text x="60" y="124" text-anchor="middle" font-family={SANS} font-size="9.5" font-weight="900" fill={T}>Inscribirse →</text>
      </g>
    </svg>
    <p>En la maqueta inicial el título tenía tres palabras («Cine al aire») y todo cabía perfecto. ¿Por qué se rompió la tarjeta el primer día que se conectó a los datos reales?</p>
    <details>
      <summary>Ver la respuesta</summary>
      <div class="dv-texto">
        <p>Porque no se había diseñado un componente, sino un dibujo estático para un único caso feliz. Cuando llegó un evento real con catorce palabras de título, dos ponentes y sin fotografía adjunta, la caja de altura fija desbordó y dejó un hueco roto arriba. Un verdadero componente define qué partes son obligatorias, qué partes son opcionales y cómo se estira su estructura ante textos extremos.</p>
      </div>
    </details>
  </div>
)}

{paso === 'miralo' && (
  <div class="dv-anotadas">
    <Anotada
      veredicto="mal"
      rotulo="Tarjetas maquetadas a mano o con huecos rígidos"
      notas={[
        {
          ...pct(170, 56),
          titulo: 'Orden interno arbitrario',
          texto: 'En la primera tarjeta la fecha va arriba y el botón a la derecha; en la segunda el botón va arriba y la fecha al final.',
          zona: zona(16, 18, 328, 86),
        },
        {
          ...pct(170, 146),
          titulo: 'Hueco muerto cuando falta un dato opcional',
          texto: 'Cuando una actividad no tiene imagen, queda un recuadro vacío con un icono roto que desperdicia la mitad del espacio.',
          zona: zona(16, 110, 328, 76),
        },
        {
          ...pct(170, 232),
          titulo: 'Texto real truncado sin sentido',
          texto: 'Cortar el título con puntos suspensivos en la tercera palabra («Taller de introducción a la…») oculta de qué trata el curso.',
          zona: zona(16, 194, 328, 68),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Tres fichas de curso inconsistentes: cambian el orden de sus elementos, dejan un hueco vacío cuando falta la imagen y truncan el título.">
        <rect width={W} height={H} fill={PAPEL} />
        {/* Ficha 1 */}
        <rect x="16" y="18" width="328" height="84" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="28" y="38" font-family={SANS} font-size="10" font-weight="700" fill={ROJO}>14 DE AGOSTO · SALA 3</text>
        <text x="28" y="58" font-family={SERIF} font-size="13" font-weight="700" fill={T}>Seminario de edición</text>
        <rect x="244" y="36" width="86" height="24" fill={T} />
        <text x="287" y="52" text-anchor="middle" font-family={SANS} font-size="10" font-weight="700" fill={PAPEL}>Ver programa</text>
        <text x="28" y="86" font-family={SANS} font-size="9.5" fill={G}>Categoría: Posgrado (orden cambiado)</text>

        {/* Ficha 2: hueco roto */}
        <rect x="16" y="110" width="328" height="76" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <rect x="26" y="120" width="96" height="56" fill="#fbe9e7" stroke={ROJO} stroke-width="1.2" stroke-dasharray="3 2" />
        <text x="74" y="152" text-anchor="middle" font-family={SANS} font-size="8.5" font-weight="700" fill={ROJO}>SIN IMAGEN</text>
        <rect x="134" y="120" width="76" height="20" fill={T} />
        <text x="172" y="134" text-anchor="middle" font-family={SANS} font-size="9" font-weight="700" fill={PAPEL}>Inscribirse</text>
        <text x="134" y="156" font-family={SERIF} font-size="12.5" font-weight="700" fill={T}>Laboratorio de sonido</text>
        <text x="134" y="174" font-family={SANS} font-size="9.5" fill={G}>21 de agosto (fecha abajo)</text>

        {/* Ficha 3: truncado */}
        <rect x="16" y="194" width="328" height="68" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="28" y="218" font-family={SERIF} font-size="13" font-weight="700" fill={T}>Taller de introducción a la…</text>
        <text x="28" y="238" font-family={SANS} font-size="10" fill={ROJO}>¿A la botánica, a la cerámica o a la programación?</text>
      </svg>
    </Anotada>

    <Anotada
      veredicto="bien"
      rotulo="Un mismo componente elástico en tres instancias distintas"
      notas={[
        {
          ...pct(330, 52),
          titulo: 'Estructura fija reconocible',
          texto: 'En las tres fichas la categoría abre arriba a la izquierda, sigue el título completo y cierra abajo la fila de metadatos y acción.',
          zona: zona(16, 18, 328, 76),
        },
        {
          ...pct(330, 142),
          titulo: 'Colapso limpio de ranuras opcionales',
          texto: 'La segunda instancia no lleva imagen: la ranura colapsa sin dejar rastro y el título aprovecha todo el ancho.',
          zona: zona(16, 102, 328, 74),
        },
        {
          ...pct(330, 228),
          titulo: 'Crecimiento vertical ante títulos largos',
          texto: 'La tercera instancia recibe un título de dos líneas completas y empuja el pie hacia abajo manteniendo el margen interior constante.',
          zona: zona(16, 184, 328, 82),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Tres instancias limpias del mismo componente: una con imagen, otra sin imagen que colapsa su hueco y una tercera con título de dos líneas.">
        <rect width={W} height={H} fill={PAPEL} />
        {/* Instancia 1: con miniatura */}
        <rect x="16" y="18" width="328" height="76" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <rect x="26" y="28" width="56" height="56" fill="#eaeae4" stroke={T} stroke-width="1" />
        <text x="54" y="60" text-anchor="middle" font-family={SANS} font-size="8.5" font-weight="700" fill={TXT}>FOTO</text>
        <text x="94" y="38" font-family={SANS} font-size="9" font-weight="700" letter-spacing="0.06em" fill={G}>POSGRADO · 14 AGO</text>
        <text x="94" y="56" font-family={SERIF} font-size="13" font-weight="700" fill={T}>Seminario de edición</text>
        <text x="94" y="78" font-family={SANS} font-size="10" font-weight="700" fill={T}>Ver programa →</text>

        {/* Instancia 2: sin miniatura (colapso limpio) */}
        <rect x="16" y="102" width="328" height="74" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="28" y="122" font-family={SANS} font-size="9" font-weight="700" letter-spacing="0.06em" fill={G}>LABORATORIO · 21 AGO</text>
        <text x="28" y="142" font-family={SERIF} font-size="13" font-weight="700" fill={T}>Acústica y grabación de campo</text>
        <text x="28" y="162" font-family={SANS} font-size="10" font-weight="700" fill={T}>Ver programa →</text>

        {/* Instancia 3: título largo de dos líneas */}
        <rect x="16" y="184" width="328" height="82" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="28" y="202" font-family={SANS} font-size="9" font-weight="700" letter-spacing="0.06em" fill={G}>TALLER ABIERTO · 28 AGO</text>
        <text x="28" y="220" font-family={SERIF} font-size="12.5" font-weight="700" fill={T}>Introducción a la encuadernación</text>
        <text x="28" y="236" font-family={SERIF} font-size="12.5" font-weight="700" fill={T}>japonesa y restauración de papel</text>
        <text x="28" y="254" font-family={SANS} font-size="10" font-weight="700" fill={T}>Ver programa →</text>
      </svg>
    </Anotada>
  </div>
)}

{paso === 'pruebalo' && (
  <Instrumento
    id={lab}
    titulo="Banco de pruebas de resistencia · anatomía de un componente"
    consigna="Pon a prueba una tarjeta de catálogo sometiéndola a títulos de longitud extrema, ausencia de datos opcionales y cambios en el ancho de la columna donde se inserta."
    nota="Fija la versión corta con todos los datos como A y luego estira el título a 20 palabras y quita la imagen en B para comprobar qué reglas mantienen íntegra la pieza."
  >
    <svg slot="escenario" viewBox="0 0 640 310" role="img" aria-label="Tarjeta de componente en banco de pruebas mostrando su contenedor, ranura de imagen opcional, título variable y pie de acciones.">
      <rect width="640" height="310" fill={FONDO} />
      <rect x="90" y="36" width="460" height="236" fill={PAPEL} stroke={T} stroke-width="2" />
      <rect x="110" y="56" width="120" height="120" fill="#eaeae4" stroke={T} stroke-width="1.2" />
      <text x="250" y="72" font-family={SANS} font-size="10" font-weight="700" fill={G}>CICLO DOCUMENTAL · SALA 2</text>
      <text x="250" y="100" font-family={SERIF} font-size="18" font-weight="700" fill={T}>Memoria del ferrocarril</text>
      <rect x="250" y="216" width="130" height="32" fill={AMARILLO} stroke={T} stroke-width="1.5" />
      <text x="315" y="236" text-anchor="middle" font-family={SANS} font-size="11" font-weight="900" fill={T}>Reservar entrada</text>
    </svg>

    <Guia slot="guia" pasos={pasos} final="Guía completada. Activa la vista de rayos X y prueba la combinación más exigente: contenedor estrecho de 250 px con un título de 22 palabras." />

    <Deslizador
      lab={lab}
      variable="palabras"
      etiqueta="Longitud del título (palabras)"
      min={2}
      max={22}
      paso={2}
      valor={4}
      unidad="palabras"
      ayuda="Comprueba cómo pasa de 1 línea ideal a 3 o 4 líneas reales sin romper el pie de la tarjeta."
    />

    <Opciones
      lab={lab}
      variable="opcionales"
      etiqueta="Datos opcionales presentes"
      valor="todo"
      opciones={[
        { valor: 'todo', texto: 'Con imagen y etiqueta' },
        { valor: 'sin-imagen', texto: 'Sin imagen' },
        { valor: 'minimo', texto: 'Sin imagen ni etiqueta' },
      ]}
      ayuda="Las ranuras opcionales deben desaparecer sin dejar huecos vacíos."
    />

    <Deslizador
      lab={lab}
      variable="ancho"
      etiqueta="Ancho del contenedor donde vive"
      min={240}
      max={580}
      paso={20}
      valor={480}
      unidad="px"
      ayuda="Debajo de 340 px el componente apila sus bloques para no estrangular el texto."
    />

    <Fragment slot="avanzados">
      <Opciones
        lab={lab}
        variable="comportamiento"
        etiqueta="Comportamiento ante contenido largo"
        valor="elastico"
        opciones={[
          { valor: 'elastico', texto: 'Elástico (se adapta)' },
          { valor: 'rigido', texto: 'Altura fija (rígido)' },
        ]}
        ayuda="Compara un contenedor que crece con su contenido frente a una caja rígida que se desborda."
      />
      <Interruptor
        lab={lab}
        variable="rayosx"
        etiqueta="Vista de rayos X (anatomía de huecos y reglas)"
        ayuda="Dibuja con línea punteada las ranuras variables y las zonas fijas del componente."
      />
    </Fragment>

    <Fragment slot="pruebas">
      <button type="button" class="dv-boton" data-preset='{"palabras":4,"opcionales":"todo","ancho":480,"comportamiento":"elastico","rayosx":false}'>Caso feliz de maqueta (4 palabras)</button>
      <button type="button" class="dv-boton" data-preset='{"palabras":20,"opcionales":"sin-imagen","ancho":460,"comportamiento":"elastico","rayosx":true}'>Prueba extrema (20 palabras sin foto)</button>
      <button type="button" class="dv-boton" data-preset='{"palabras":12,"opcionales":"todo","ancho":260,"comportamiento":"elastico","rayosx":false}'>Columna lateral estrecha (260 px)</button>
      <button type="button" class="dv-boton" data-preset='{"palabras":20,"opcionales":"todo","ancho":460,"comportamiento":"rigido","rayosx":false}'>Fallo por caja de altura rígida</button>
    </Fragment>
  </Instrumento>
)}

{paso === 'errores' && (
  <div class="dv-especimenes">
    <Instrumento
      id={`${lab}-e1`}
      titulo="Permite que el botón respire cuando el texto crece o se traduce"
      comparar={false}
      consigna="Un botón diseñado con un ancho fijo de 90 px para la palabra «Enviar» se desborda cuando cambia a «Guardar y continuar» o se traduce al alemán. Cambia la regla de ancho."
    >
      <div slot="escenario" style={`padding:14px 16px;font-family:${SANS};color:${T};`}>
        <p style="margin:0;">Botón de 90 px fijos desbordado por texto largo.</p>
      </div>
      <Opciones
        lab={`${lab}-e1`}
        variable="regla"
        etiqueta="Regla de ancho del componente botón"
        valor="fijo"
        opciones={[
          { valor: 'fijo', texto: 'Ancho fijo (90 px)' },
          { valor: 'truncado', texto: 'Truncar con «…»' },
          { valor: 'relleno', texto: 'Ancho automático + espacio interior (16 px)' },
        ]}
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e2`}
      titulo="Colapsa la ranura cuando falta un dato opcional"
      comparar={false}
      consigna="El 40 % de los libros del catálogo antiguo no tienen portada digitalizada. Si la ranura de imagen es obligatoria, deja un cuadro roto. Haz que la ranura sea condicional."
    >
      <div slot="escenario" style={`padding:14px 16px;font-family:${SANS};color:${T};`}>
        <p style="margin:0;">Ficha bibliográfica sin imagen de portada.</p>
      </div>
      <Opciones
        lab={`${lab}-e2`}
        variable="ranura"
        etiqueta="Qué hace el componente cuando no llega imagen"
        valor="hueco"
        opciones={[
          { valor: 'hueco', texto: 'Dejar el recuadro vacío (hueco roto)' },
          { valor: 'colapsar', texto: 'Colapsar la ranura y expandir el texto' },
        ]}
      />
    </Instrumento>

    <Instrumento
      id={`${lab}-e3`}
      titulo="Divide el «componente navaja suiza» en dos piezas claras"
      comparar={false}
      consigna="Intentaron meter en un solo componente una tarjeta de artículo, un reproductor de audio, una encuesta y una tabla de precios. El resultado tiene 28 propiedades y confunde a todos. Sepáralo por responsabilidad."
    >
      <div slot="escenario" style={`padding:14px 16px;font-family:${SANS};color:${T};`}>
        <p style="margin:0;">Supercomponente inflado con 4 funciones incompatibles.</p>
      </div>
      <Opciones
        lab={`${lab}-e3`}
        variable="arquitectura"
        etiqueta="Arquitectura del catálogo de componentes"
        valor="navaja"
        opciones={[
          { valor: 'navaja', texto: '1 supercomponente con 28 interruptores' },
          { valor: 'modular', texto: '2 componentes simples y componibles' },
        ]}
      />
    </Instrumento>
  </div>
)}

{paso === 'ejemplos' && (
  <div class="dv-anotadas">
    <Anotada
      rotulo="Este mismo sitio (Instrumento.astro): un marco fijo con cuatro ranuras (slots)"
      notas={[
        {
          ...pct(180, 44),
