)}

{paso === 'juego' && (
  <Juego
    slug={lab}
    rondas={5}
    descripcion="Cinco rondas sobre pruebas de resistencia (stress test), ranuras opcionales, abstracción prematura y elasticidad."
  />
)}

<script>
  import { conectar, svg, n } from '../../../lib/diseno-visual/estado';
  import { guiar } from '../../../lib/diseno-visual/guia';
  import { jugar, barajar, type Ronda } from '../../../lib/diseno-visual/juego';

  const SANS = 'Roboto, Helvetica, Arial, sans-serif';
  const SERIF = "'PT Serif', Georgia, serif";

  type E = {
    palabras: number;
    opcionales: string;
    ancho: number;
    comportamiento: string;
    rayosx: boolean;
  };

  const BANCO_PALABRAS = [
    'Memoria', 'visual', 'del', 'ferrocarril', 'de', 'Antioquia', 'y', 'los',
    'archivos', 'fotográficos', 'industriales', 'conservados', 'en', 'estaciones',
    'rurales', 'entre', 'mil', 'novecientos', 'veinte', 'y', 'setenta', 'hoy',
  ];

  function partirLineas(palabras: string[], maxCaracteres: number): string[] {
    const lineas: string[] = [];
    let actual = '';
    for (const p of palabras) {
      const candidato = actual ? `${actual} ${p}` : p;
      if (candidato.length > maxCaracteres && actual) {
        lineas.push(actual);
        actual = p;
      } else {
        actual = candidato;
      }
    }
    if (actual) lineas.push(actual);
    return lineas;
  }

  function pintar(destino: HTMLElement, e: E) {
    const W = Math.max(destino.clientWidth, 280);
    const cardW = Math.min(e.ancho, W - 28);
    const apilado = cardW < 340;
    const tieneImg = e.opcionales === 'todo';
    const tieneEtiqueta = e.opcionales !== 'minimo';
    const esRigido = e.comportamiento === 'rigido';

    const listaPalabras = BANCO_PALABRAS.slice(0, e.palabras);
    const anchoTextoPx = tieneImg && !apilado ? cardW - 156 : cardW - 36;
    const charsPorLinea = Math.max(14, Math.floor(anchoTextoPx / 7.8));
    const lineasTitulo = partirLineas(listaPalabras, charsPorLinea);

    const altoImgArriba = tieneImg && apilado ? 82 : 0;
    const altoEtiqueta = tieneEtiqueta ? 20 : 0;
    const altoTitulo = lineasTitulo.length * 20;
    const altoMeta = 22;
    const altoPie = 42;
    const altoCalculado = 28 + altoImgArriba + altoEtiqueta + altoTitulo + altoMeta + altoPie;
    const cardH = esRigido ? 148 : Math.max(136, altoCalculado);
    const H = Math.max(290, cardH + 68);

    const raiz = svg('svg', { viewBox: `0 0 ${W} ${H}`, width: W, height: H, role: 'img' });
    raiz.setAttribute(
      'aria-label',
      `Componente tarjeta con ${e.palabras} palabras de título, ancho de ${cardW} px y modo ${e.comportamiento}.`,
    );
    raiz.append(svg('rect', { width: W, height: H, fill: '#fbfbf9' }));

    const x0 = Math.round((W - cardW) / 2);
    const y0 = 32;

    // Cota superior de ancho del contenedor
    const yCota = 18;
    raiz.append(svg('line', { x1: x0, y1: yCota, x2: x0 + cardW, y2: yCota, stroke: '#6f6f6f', 'stroke-width': 1 }));
    const txtCota = svg('text', {
      x: x0 + cardW / 2,
      y: yCota - 4,
      'text-anchor': 'middle',
      'font-family': SANS,
      'font-size': 9.5,
      'font-weight': 700,
      fill: '#6f6f6f',
    });
    txtCota.textContent = `CONTENEDOR: ${cardW} PX (${apilado ? 'APILADO VERTICAL' : 'DISPOSICIÓN HORIZONTAL'})`;
    raiz.append(txtCota);

    const desborda = esRigido && altoCalculado > cardH;

    // Marco de la tarjeta
    raiz.append(
      svg('rect', {
        x: x0,
        y: y0,
        width: cardW,
        height: cardH,
        fill: '#ffffff',
        stroke: desborda ? '#b3261e' : '#222222',
        'stroke-width': 2,
      }),
    );

    let tx = x0 + 18;
    let ty = y0 + 18;

    // Ranura de imagen opcional
    if (tieneImg) {
      const imgW = apilado ? cardW - 36 : 104;
      const imgH = apilado ? 70 : Math.min(104, cardH - 36);
      raiz.append(
        svg('rect', {
          x: tx,
          y: ty,
          width: imgW,
          height: imgH,
          fill: '#eaeae4',
          stroke: e.rayosx ? '#b3261e' : '#222222',
          'stroke-width': 1.2,
          ...(e.rayosx ? { 'stroke-dasharray': '4 3' } : {}),
        }),
      );
      const tFoto = svg('text', {
        x: tx + imgW / 2,
        y: ty + imgH / 2 + 4,
        'text-anchor': 'middle',
        'font-family': SANS,
        'font-size': 9.5,
        'font-weight': 700,
        fill: '#444444',
      });
      tFoto.textContent = e.rayosx ? 'RANURA: IMAGEN' : '16:9 / 1:1';
      raiz.append(tFoto);

      if (apilado) {
        ty += imgH + 14;
      } else {
        tx += imgW + 16;
      }
    }

    // Ranura de etiqueta opcional
    if (tieneEtiqueta) {
      if (e.rayosx) {
        raiz.append(
          svg('rect', {
            x: tx - 3,
            y: ty - 2,
            width: 158,
            height: 16,
            fill: 'none',
            stroke: '#b3261e',
            'stroke-width': 1,
            'stroke-dasharray': '3 2',
          }),
        );
      }
      const tEtq = svg('text', {
        x: tx,
        y: ty + 10,
        'font-family': SANS,
        'font-size': 9.5,
        'font-weight': 700,
        'letter-spacing': 0.7,
        fill: '#6f6f6f',
      });
      tEtq.textContent = 'CICLO DOCUMENTAL · SALA 2';
      raiz.append(tEtq);
      ty += 20;
    }

    // Ranura de título elástico
    if (e.rayosx) {
      raiz.append(
        svg('rect', {
          x: tx - 4,
          y: ty - 2,
          width: x0 + cardW - tx - 12,
          height: lineasTitulo.length * 20 + 4,
          fill: 'none',
          stroke: '#b3261e',
          'stroke-width': 1.2,
          'stroke-dasharray': '4 2',
        }),
      );
    }

    lineasTitulo.forEach((linea, idx) => {
      const yLinea = ty + 15 + idx * 20;
      const fueraDeCaja = esRigido && yLinea > y0 + cardH - 36;
      const tLin = svg('text', {
        x: tx,
        y: yLinea,
        'font-family': SERIF,
        'font-size': 15,
        'font-weight': 700,
        fill: fueraDeCaja ? '#b3261e' : '#222222',
      });
      tLin.textContent = linea;
      raiz.append(tLin);
    });

    ty += lineasTitulo.length * 20 + 8;

    const tMeta = svg('text', {
      x: tx,
      y: ty + 10,
      'font-family': SANS,
      'font-size': 10,
      fill: '#444444',
    });
    tMeta.textContent = 'Jueves 19:00 · Entrada libre';
    raiz.append(tMeta);

    // Pie fijo de acción
    const pieY = esRigido ? y0 + cardH - 38 : Math.max(y0 + cardH - 40, ty + 22);
    raiz.append(
      svg('line', {
        x1: x0 + 18,
        y1: pieY - 6,
        x2: x0 + cardW - 18,
        y2: pieY - 6,
        stroke: '#e5e5e5',
        'stroke-width': 1,
      }),
    );

    const btnW = 122;
    raiz.append(
      svg('rect', {
        x: x0 + cardW - 18 - btnW,
        y: pieY,
        width: btnW,
        height: 26,
        fill: desborda ? '#fbe9e7' : '#eeff41',
        stroke: desborda ? '#b3261e' : '#222222',
        'stroke-width': 1.5,
      }),
    );
    const tBtn = svg('text', {
      x: x0 + cardW - 18 - btnW / 2,
      y: pieY + 17,
      'text-anchor': 'middle',
      'font-family': SANS,
      'font-size': 10,
      'font-weight': 900,
      fill: desborda ? '#b3261e' : '#222222',
    });
    tBtn.textContent = desborda ? '¡Colisión con texto!' : 'Reservar cupo →';
    raiz.append(tBtn);

    if (e.rayosx) {
      const tRx = svg('text', {
        x: x0 + 18,
        y: pieY + 17,
        'font-family': SANS,
        'font-size': 9,
        'font-weight': 700,
        fill: '#b3261e',
      });
      tRx.textContent = `RAYOS X · ${lineasTitulo.length} LÍN. · ALTO ${cardH} PX`;
      raiz.append(tRx);
    }

    destino.replaceChildren(raiz);
  }

  function describir(e: E): string {
    const apilado = e.ancho < 340;
    if (e.comportamiento === 'rigido' && e.palabras >= 12) {
      return `¡Desbordamiento! Con una caja rígida de 148 px de alto, un título real de <b class="dv-cifra">${n(e.palabras, 0)} palabras</b> colisiona con la botonera inferior.`;
    }
    const modoDisp = apilado
      ? 'se apila verticalmente porque el contenedor bajó de 340 px'
      : 'mantiene disposición horizontal';
    const ranuras = e.opcionales === 'todo'
      ? 'con imagen y etiqueta activas'
      : e.opcionales === 'sin-imagen'
        ? 'colapsando limpiamente la ranura de imagen'
        : 'colapsando imagen y etiqueta sin dejar huecos vacíos';
    return `Título de <b class="dv-cifra">${n(e.palabras, 0)} palabras</b> en contenedor de <b class="dv-cifra">${n(e.ancho, 0)} px</b>: el componente ${modoDisp}, ${ranuras}.`;
  }

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-lab="componentes"]')) {
    guiar<E>(raiz, [
      (e) => e.palabras >= 18,
      (e) => e.opcionales === 'minimo',
      (e) => e.ancho <= 280,
      (e) => e.comportamiento === 'rigido' && e.palabras >= 14,
      (e) => e.comportamiento === 'elastico' && e.rayosx,
    ]);
    conectar<E>({ raiz, pintar, describir });
  }

  // ── Especímenes de error ─────────────────────────────────────────
  type E1 = { regla: string };
  function pintarE1(d: HTMLElement, e: E1) {
    const esFijo = e.regla === 'fijo';
    const esTrunc = e.regla === 'truncado';
    d.innerHTML = `
      <div style="padding:14px 16px;font-family:${SANS};background:#ffffff;border:1.5px solid #222222;display:flex;align-items:center;justify-content:space-between;gap:12px;">
        <span style="font-size:12px;color:#444444;">Traducción / texto real (+45 %):</span>
        <span style="
          display:inline-block;
          ${esFijo ? 'width:90px;white-space:nowrap;overflow:visible;border:2px solid #b3261e;background:#fbe9e7;color:#b3261e;' : ''}
          ${esTrunc ? 'width:96px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border:1.5px solid #222222;background:#eeff41;color:#222222;' : ''}
          ${e.regla === 'relleno' ? 'padding:7px 16px;border:1.5px solid #222222;background:#eeff41;color:#222222;' : 'padding:7px 8px;'}
          font-size:12px;font-weight:900;
        ">Guardar y publicar ahora</span>
      </div>`;
  }
  function describirE1(e: E1) {
    if (e.regla === 'fijo') return 'Con <b class="dv-cifra">90 px fijos</b>, el texto sale fuera de la caja del botón.';
    if (e.regla === 'truncado') return 'Truncar un botón de acción («Guardar y…») oculta qué ocurrirá al hacer clic.';
    return '<b class="dv-cifra">Ancho intrínseco + espacio interior</b>: el botón se adapta a cualquier longitud o idioma.';
  }

  type E2 = { ranura: string };
  function pintarE2(d: HTMLElement, e: E2) {
    const hueco = e.ranura === 'hueco';
    d.innerHTML = `
      <div style="padding:14px 16px;font-family:${SANS};background:#ffffff;border:1.5px solid #222222;display:flex;gap:12px;align-items:center;">
        ${hueco ? `<div style="width:76px;height:62px;flex-shrink:0;background:#fbe9e7;border:1.5px dashed #b3261e;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#b3261e;text-align:center;">SIN PORTADA</div>` : ''}
        <div>
          <p style="margin:0;font-size:10px;font-weight:700;color:#6f6f6f;">ARCHIVO IMPRESO · 1968</p>
          <p style="margin:3px 0 0;font-family:${SERIF};font-size:14px;font-weight:700;color:#222222;">Diseño y comunicación visual · Bruno Munari</p>
          <p style="margin:3px 0 0;font-size:11.5px;color:#444444;">Colección Biblioteca de Diseño · Sin imagen digitalizada.</p>
        </div>
      </div>`;
  }
  function describirE2(e: E2) {
    if (e.ranura === 'hueco') return 'El recuadro vacío llama más la atención que el propio título del libro.';
    return '<b class="dv-cifra">Ranura condicional</b>: cuando no hay imagen, la ficha se comporta como una entrada tipográfica completa.';
  }

  type E3 = { arquitectura: string };
  function pintarE3(d: HTMLElement, e: E3) {
    const navaja = e.arquitectura === 'navaja';
    d.innerHTML = navaja
      ? `<div style="padding:12px 14px;font-family:${SANS};background:#fbe9e7;border:1.5px solid #b3261e;color:#222222;">
          <p style="margin:0 0 6px;font-size:10px;font-weight:900;color:#b3261e;">&lt;SuperTarjeta mostrarAudio={true} mostrarEncuesta={true} mostrarPrecio={true} /&gt;</p>
          <p style="margin:0;font-size:12px;font-weight:700;">Conferencia inaugural · 03:42 min · ¿Te gustó? [Sí/No] · $ 45.000</p>
        </div>`
      : `<div style="padding:12px 14px;font-family:${SANS};background:#ffffff;border:1.5px solid #222222;display:grid;grid-template-columns:1fr 1fr;gap:8px;color:#222222;">
          <div style="padding:8px;border:1px solid #222222;background:#fbfbf9;">
            <span style="font-size:9.5px;font-weight:700;color:#6f6f6f;">&lt;TarjetaEvento /&gt;</span>
            <p style="margin:3px 0 0;font-size:12px;font-weight:700;">Conferencia inaugural</p>
          </div>
          <div style="padding:8px;border:1px solid #222222;background:#fbfbf9;">
            <span style="font-size:9.5px;font-weight:700;color:#6f6f6f;">&lt;ReproductorAudio /&gt;</span>
            <p style="margin:3px 0 0;font-size:12px;font-weight:700;">▶ Escuchar · 03:42 min</p>
          </div>
        </div>`;
  }
  function describirE3(e: E3) {
    if (e.arquitectura === 'navaja') return 'Un componente con <b class="dv-cifra">responsabilidades mezcladas</b> es difícil de mantener y fácil de romper.';
    return '<b class="dv-cifra">Responsabilidad única</b>: cada componente hace bien una sola tarea y se combina cuando hace falta.';
  }

  const especimenes: [string, (d: HTMLElement, e: never) => void, (e: never) => string][] = [
    ['componentes-e1', pintarE1 as never, describirE1 as never],
    ['componentes-e2', pintarE2 as never, describirE2 as never],
    ['componentes-e3', pintarE3 as never, describirE3 as never],
  ];
  for (const [id, p, desc] of especimenes) {
    for (const r of document.querySelectorAll<HTMLElement>(`[data-lab="${id}"]`)) {
      conectar({ raiz: r, pintar: p, describir: desc });
    }
  }

  // ── Juego de 5 rondas ────────────────────────────────────────────
  function r1StressTest(): Ronda {
    const ops = barajar([
      {
        texto: 'Probarlo con un título de 18 palabras, un título de 2 palabras y sin imagen opcional',
        es: true,
      },
      {
        texto: 'Probarlo únicamente con textos de tres palabras que midan exactamente igual en las tres tarjetas',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Acabas de diseñar el componente de tarjeta para el catálogo de cursos. ¿Cómo compruebas si su estructura aguanta la realidad antes de publicarlo?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Un componente se valida en sus bordes: textos muy largos, textos mínimos y ausencia de campos opcionales.',
      repaso: 'Prueba de resistencia (stress test)',
    };
  }

  function r2RanuraOpcional(): Ronda {
    const ops = barajar([
      {
        texto: 'La ranura colapsa por completo y el bloque de texto ocupa el espacio con naturalidad',
        es: true,
      },
      {
        texto: 'Queda un recuadro gris vacío con el texto «Sin imagen disponible» ocupando la mitad de la tarjeta',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'En una lista de noticias, solo la mitad de los artículos incluye fotografía. ¿Cómo debe comportarse el componente en las instancias sin foto?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Si un dato es opcional, su ausencia no es un error: la estructura debe reacomodarse sin dejar cicatrices ni huecos vacíos.',
      repaso: 'Ranuras opcionales',
    };
  }

  function r3AbstraccionPrematura(): Ronda {
    const ops = barajar([
      {
        texto: 'Esperar a ver si esa necesidad se repite en tres contextos reales antes de empaquetarla como componente universal',
        es: true,
      },
      {
        texto: 'Fusionarla dentro del componente de tarjeta estándar añadiendo doce interruptores nuevos',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'Una sola página del sitio necesita un bloque especial para comparar dos mapas antiguos. ¿Qué recomienda Alla Kholmatova en Design Systems (2017)?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'Convertir una pieza única en componente compartido o forzarla dentro de otro componente existente complica todo el sistema sin aportar reutilización real.',
      repaso: 'Evitar el componente navaja suiza',
    };
  }

  function r4Anatomia(): Ronda {
    const ops = barajar([
      {
        texto: 'El orden vertical de las zonas, las reglas de espaciado y la posición de la acción principal',
        es: true,
      },
      {
        texto: 'La cantidad exacta de letras que tiene el título de cada curso',
        es: false,
      },
    ]);
    return {
      tipo: 'eleccion',
      pregunta: 'En un componente bien construido, ¿qué parte pertenece a la estructura fija del sistema y no al contenido variable?',
      opciones: ops.map((o) => ({ texto: o.texto })),
      correcta: ops.findIndex((o) => o.es),
      porque: 'El componente fija la gramática espacial (jerarquía, márgenes, posición de las zonas) para que el contenido pueda variar libremente sin perder el orden.',
      repaso: 'Estructura fija frente a contenido variable',
    };
  }

  function r5AjusteContenedor(): Ronda {
    return {
      tipo: 'ajuste',
      pregunta: 'Esta ficha tiene miniatura e información al lado, pero está metida en una columna de 230 px que deja solo 9 letras por renglón. Amplía el ancho del contenedor hasta que la disposición horizontal tenga lectura holgada (380 px o más).',
      control: {
        etiqueta: 'Ancho disponible para el componente',
        min: 220,
        max: 520,
        paso: 20,
        valor: 230,
        unidad: 'px',
      },
      pintar: (c, v) => {
        c.innerHTML = `
          <div style="padding:12px;background:#fbfbf9;border:1px solid #e5e5e5;display:flex;justify-content:center;font-family:${SANS};">
            <div style="width:${v}px;max-width:100%;padding:12px;background:#ffffff;border:1.5px solid #222222;display:flex;gap:12px;align-items:flex-start;">
              <div style="width:72px;height:64px;flex-shrink:0;background:#eaeae4;border:1px solid #222222;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#444444;">FOTO</div>
              <div>
                <span style="font-size:9.5px;font-weight:700;color:#6f6f6f;">SEMINARIO · ${v} PX</span>
                <p style="margin:3px 0 0;font-family:${SERIF};font-size:13px;font-weight:700;color:#222222;line-height:1.25;">Historia de la imprenta moderna</p>
              </div>
            </div>
          </div>`;
      },
      cumple: (v) => v >= 380,
      falta: (v) => `Con ${v} px la columna de texto junto a la foto sigue siendo demasiado angosta. Sube al menos a 380 px.`,
      porque: 'Un componente con imagen lateral necesita un umbral mínimo de ancho (o apilarse en vertical) para no estrangular la línea de lectura.',
      repaso: 'Relación entre componente y contenedor',
    };
  }

  const rootJuego = document.querySelector<HTMLElement>('[data-juego="componentes"]');
  if (rootJuego) {
    jugar(rootJuego, () =>
      barajar([
        r1StressTest(),
        r2RanuraOpcional(),
        r3AbstraccionPrematura(),
        r4Anatomia(),
        r5AjusteContenedor(),
      ]),
    );
  }
</script>
