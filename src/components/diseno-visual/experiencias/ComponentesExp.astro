      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Dos instancias del componente de referencia bibliográfica: una con enlace DOI y otra de libro impreso sin enlace.">
        <rect width={W} height={H} fill={PAPEL} />
        <rect x="18" y="22" width="324" height="74" fill={FONDO} stroke={T} stroke-width="1.5" />
        <text x="30" y="42" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>NÚCLEO OBLIGATORIO: AUTOR + OBRA + AÑO</text>
        <text x="30" y="62" font-family={SERIF} font-size="12.5" font-weight="700" fill={T}>Karl Gerstner (1964). Designing Programmes.</text>
        <text x="30" y="80" font-family={SANS} font-size="10" fill={TXT}>Arthur Niggli · Sin URL (libro impreso)</text>

        <rect x="18" y="106" width="324" height="74" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="30" y="126" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>CON RANURA CONDICIONAL DE ENLACE (URL PRESENTE)</text>
        <text x="30" y="146" font-family={SERIF} font-size="12.5" font-weight="700" fill={T} text-decoration="underline">W3C Design Tokens Format Module (2024) ↗</text>
        <text x="30" y="164" font-family={SANS} font-size="10" fill={TXT}>https://tr.designtokens.org/format/</text>

        <rect x="18" y="190" width="324" height="72" fill={FONDO} stroke={REGLA} stroke-width="1.5" />
        <text x="30" y="210" font-family={SANS} font-size="9.5" font-weight="700" fill={G}>RANURA ELÁSTICA: NOTA DE CONTEXTO</text>
        <text x="30" y="230" font-family={SERIF} font-size="11.5" fill={TXT}>«Especificación estándar de pares nombre-valor</text>
        <text x="30" y="248" font-family={SERIF} font-size="11.5" fill={TXT}>independientes de la plataforma.»</text>
