          zona: zona(18, 36, 206, 148),
        },
        {
          ...pct(290, 76),
          titulo: 'Zona derecha indeformable (auto)',
          texto: 'El monto usa cifras tabulares y white-space: nowrap para que el signo y los decimales nunca se partan en dos renglones.',
          zona: zona(230, 36, 112, 148),
        },
        {
          ...pct(180, 226),
          titulo: 'Etiqueta opcional de estado',
          texto: 'Solo aparece cuando la transacción está «En verificación» o «Rechazada»; en pagos normales no añade ruido.',
          zona: zona(18, 194, 324, 66),
        },
      ]}
    >
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Tres filas de movimientos bancarios donde el importe a la derecha permanece alineado aunque el concepto a la izquierda ocupe una o dos líneas.">
        <rect width={W} height={H} fill={PAPEL} />
        <text x="18" y="26" font-family={SANS} font-size="10" font-weight="700" letter-spacing="0.06em" fill={G}>COMPONENTE FILA DE TRANSACCIÓN · 3 INSTANCIAS</text>

        {/* Fila 1: nombre corto */}
        <rect x="18" y="38" width="324" height="58" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="30" y="62" font-family={SANS} font-size="12" font-weight="700" fill={T}>Librería Lerner</text>
        <text x="30" y="80" font-family={SANS} font-size="10" fill={G}>12 oct · Tarjeta débito</text>
        <text x="330" y="68" text-anchor="end" font-family={SANS} font-size="13" font-weight="900" fill={T}>− $ 64.000</text>

        {/* Fila 2: nombre muy largo que baja a 2 líneas sin mover el monto */}
        <rect x="18" y="104" width="324" height="78" fill={PAPEL} stroke={T} stroke-width="1.5" />
        <text x="30" y="126" font-family={SANS} font-size="11.5" font-weight="700" fill={T}>Cooperativa de Caficultores del</text>
        <text x="30" y="142" font-family={SANS} font-size="11.5" font-weight="700" fill={T}>Suroeste Antioqueño Ltda.</text>
        <text x="30" y="164" font-family={SANS} font-size="10" fill={G}>11 oct · Transferencia</text>
        <text x="330" y="138" text-anchor="end" font-family={SANS} font-size="13" font-weight="900" fill={T}>− $ 1.280.500</text>

        {/* Fila 3: con insignia condicional */}
        <rect x="18" y="192" width="324" height="68" fill={FONDO} stroke={T} stroke-width="1.5" />
        <text x="30" y="216" font-family={SANS} font-size="12" font-weight="700" fill={T}>Editorial Universidad de Antioquia</text>
        <rect x="30" y="226" width="112" height="18" fill={AMARILLO} stroke={T} stroke-width="1" />
        <text x="86" y="238" text-anchor="middle" font-family={SANS} font-size="8.5" font-weight="900" fill={T}>EN VERIFICACIÓN</text>
        <text x="330" y="228" text-anchor="end" font-family={SANS} font-size="13" font-weight="900" fill={T}>− $ 95.000</text>
