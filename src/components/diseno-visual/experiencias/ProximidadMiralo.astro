---
// Paso 2 de proximidad: la misma tarjeta con todos los renglones a la misma
// distancia y con el aire organizado en tres bloques.
import Anotada from '../Anotada.astro';

const W = 360;
const H = 230;
const SANS = 'Roboto, Helvetica, Arial, sans-serif';
const lineas = [
  { t: 'Laura Restrepo', peso: 700, tam: 19 },
  { t: 'Diseñadora de servicios', peso: 400, tam: 13 },
  { t: '+57 300 555 0142', peso: 400, tam: 13 },
  { t: 'laura@estudio.co', peso: 400, tam: 13 },
  { t: 'Calle 10 # 43-12, Medellín', peso: 400, tam: 13 },
];

// Antes: el mismo aire debajo de cada renglón.
const igual = [34, 69, 104, 139, 174];
// Después: aire chico dentro de cada bloque, grande entre bloques.
const agrupado = [40, 60, 116, 136, 190];
const pct = (y: number) => (y / H) * 100;
---

<div class="dv-anotadas">
  <Anotada
    veredicto="mal"
    rotulo="Todo con el mismo espacio"
    notas={[
      { x: 86, y: pct(52), texto: 'Cada renglón está a la misma distancia del siguiente. Se leen cinco datos sueltos, sin orden.', zona: { x: 6, y: pct(14), w: 88, h: pct(170) } },
      { x: 86, y: pct(121), texto: 'El cargo está tan lejos del nombre como el teléfono. Nada indica que el cargo es de Laura y que el teléfono es para llamarla.', zona: { x: 6, y: pct(55), w: 88, h: pct(55) } },
    ]}
  >
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Tarjeta de presentación con cinco renglones igualmente espaciados.">
      {lineas.map((l, i) => (
        <text x="28" y={igual[i]} font-family={SANS} font-weight={l.peso} font-size={l.tam} fill="#222">{l.t}</text>
      ))}
    </svg>
  </Anotada>

  <Anotada
    veredicto="bien"
    rotulo="El espacio organizado en bloques"
    notas={[
      { x: 86, y: pct(46), titulo: 'Quién es', texto: 'Nombre y cargo van muy cerca. Se leen como una sola unidad.', zona: { x: 6, y: pct(20), w: 88, h: pct(48) } },
      { x: 86, y: pct(88), titulo: 'Cambio de tema', texto: 'Este espacio es mucho mayor que el de dentro de los bloques. Indica que empieza otro tema.', zona: { x: 6, y: pct(68), w: 88, h: pct(30) } },
      { x: 86, y: pct(126), titulo: 'Cómo encontrarla', texto: 'Teléfono y correo van juntos porque los dos sirven para contactarla.', zona: { x: 6, y: pct(100), w: 88, h: pct(44) } },
      { x: 86, y: pct(186), titulo: 'Dónde está', texto: 'La dirección va aparte porque es otro tipo de dato.', zona: { x: 6, y: pct(172), w: 88, h: pct(28) } },
    ]}
  >
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="La misma tarjeta con el nombre y el cargo juntos, el teléfono y el correo juntos y la dirección aparte.">
      {lineas.map((l, i) => (
        <text x="28" y={agrupado[i]} font-family={SANS} font-weight={l.peso} font-size={l.tam} fill="#222">{l.t}</text>
      ))}
    </svg>
  </Anotada>
</div>
