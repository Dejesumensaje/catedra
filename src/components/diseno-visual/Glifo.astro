---
// Diagrama mínimo de cada entrada para el índice. No es un ícono: es el
// fenómeno reducido a su relación. Decorativo para lectores de pantalla
// (el título y el resumen ya lo dicen).
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const T = '#222222';
const G = '#8f8f8f';
const R = '#d8d8d8';
const A = '#eeff41';
---

<svg class="dv-glifo" viewBox="0 0 88 64" aria-hidden="true" focusable="false">
  {/* ── 01 · PERCEPCIÓN ─────────────────────────────── */}
  {slug === 'gestalt' && (
    <g>
      {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => {
        const ang = (i * Math.PI) / 4;
        return <circle cx={44 + Math.cos(ang) * 19} cy={32 + Math.sin(ang) * 19} r="3.2" fill={T} />;
      })}
      <circle cx="44" cy="32" r="19" fill="none" stroke={T} stroke-width="1" stroke-dasharray="2 2.5" />
    </g>
  )}
  {slug === 'proximidad' && (
    <g fill={T}>
      {[0, 1, 2].map((g) =>
        [0, 1, 2, 3].map((i) => <circle cx={12 + g * 28 + (i % 2) * 8} cy={24 + Math.floor(i / 2) * 8} r="2.6" />),
      )}
    </g>
  )}
  {slug === 'semejanza' && (
    <g>
      {[0, 1, 2, 3].map((f) =>
        [0, 1, 2, 3, 4, 5].map((c) =>
          f % 2 === 0
            ? <circle cx={14 + c * 12} cy={14 + f * 12} r="3" fill={T} />
            : <circle cx={14 + c * 12} cy={14 + f * 12} r="2.4" fill="none" stroke={T} stroke-width="1.2" />,
        ),
      )}
    </g>
  )}
  {slug === 'region-comun' && (
    <g>
      <rect x="8" y="16" width="32" height="32" fill="#e5e5e5" stroke={T} stroke-width="1.5" />
      <rect x="48" y="16" width="32" height="32" fill="none" stroke={T} stroke-width="1.5" />
      <circle cx="18" cy="32" r="3" fill={T} />
      <circle cx="30" cy="32" r="3" fill={T} />
      <circle cx="58" cy="32" r="3" fill={T} />
      <circle cx="70" cy="32" r="3" fill={T} />
    </g>
  )}
  {slug === 'continuidad' && (
    <g>
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <circle cx={12 + i * 10.5} cy={32 - Math.sin((i / 6) * Math.PI) * 16} r="2.8" fill={T} />
      ))}
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <rect x={10 + i * 10.5} y={14 + i * 5.5} width="4" height="4" fill={G} />
      ))}
    </g>
  )}
  {slug === 'cierre' && (
    <g>
      <circle cx="44" cy="15" r="8" fill={T} />
      <circle cx="27" cy="46" r="8" fill={T} />
      <circle cx="61" cy="46" r="8" fill={T} />
      <polygon points="44,15 27,46 61,46" fill="#fbfbf9" />
    </g>
  )}
  {slug === 'figura-fondo' && (
    <g>
      <rect x="0" y="0" width="44" height="64" fill={T} />
      <rect x="44" y="0" width="44" height="64" fill="#ffffff" />
      <circle cx="24" cy="32" r="11" fill="#ffffff" />
      <circle cx="64" cy="32" r="11" fill={T} />
    </g>
  )}

  {/* ── 02 · TIPOGRAFÍA ─────────────────────────────── */}
  {slug === 'escalas-tipograficas' && (
    <g fill={T}>
      <rect x="12" y="12" width="56" height="10" />
      <rect x="12" y="28" width="40" height="6" />
      <rect x="12" y="40" width="62" height="2.5" />
      <rect x="12" y="45" width="60" height="2.5" />
      <rect x="12" y="50" width="38" height="2.5" />
    </g>
  )}
  {slug === 'jerarquia' && (
    <g>
      <rect x="10" y="11" width="16" height="4" fill={G} />
      <rect x="10" y="19" width="58" height="9" fill={T} />
      <rect x="22" y="34" width="46" height="4.5" fill={T} />
      <rect x="22" y="43" width="52" height="2.5" fill={G} />
      <rect x="22" y="49" width="40" height="2.5" fill={G} />
      <line x1="14" y1="34" x2="14" y2="52" stroke={T} stroke-width="2" />
    </g>
  )}
  {slug === 'familias-tipograficas' && (
    <g fill={T}>
      <text x="14" y="44" font-family="'PT Serif', Georgia, serif" font-size="34" font-weight="700">A</text>
      <text x="48" y="44" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="34" font-weight="900">a</text>
      <line x1="8" y1="22" x2="80" y2="22" stroke="#b3261e" stroke-width="1" stroke-dasharray="2 2" />
      <line x1="8" y1="44" x2="80" y2="44" stroke={T} stroke-width="1" />
    </g>
  )}
  {slug === 'peso-y-contraste' && (
    <g fill={T}>
      <rect x="12" y="14" width="2" height="36" />
      <rect x="24" y="14" width="5" height="36" />
      <rect x="40" y="14" width="9" height="36" />
      <rect x="60" y="14" width="15" height="36" />
    </g>
  )}
  {slug === 'interlineado' && (
    <g>
      <rect x="12" y="12" width="60" height="3.5" fill={T} />
      <rect x="12" y="19.5" width="64" height="8.5" fill="#e5e5e5" />
      <rect x="12" y="28" width="56" height="3.5" fill={T} />
      <rect x="12" y="35.5" width="64" height="8.5" fill="#e5e5e5" />
      <rect x="12" y="44" width="46" height="3.5" fill={T} />
    </g>
  )}
  {slug === 'ancho-de-linea' && (
    <g>
      <line x1="14" y1="10" x2="14" y2="54" stroke={T} stroke-width="1.5" />
      <line x1="74" y1="10" x2="74" y2="54" stroke={T} stroke-width="1.5" />
      <line x1="18" y1="18" x2="70" y2="18" stroke={T} stroke-width="1.5" />
      <polygon points="15,18 20,15 20,21" fill={T} />
      <polygon points="73,18 68,15 68,21" fill={T} />
      <rect x="18" y="28" width="52" height="3" fill={T} />
      <rect x="18" y="35" width="50" height="3" fill={T} />
      <rect x="18" y="42" width="38" height="3" fill={T} />
    </g>
  )}
  {slug === 'ritmo-tipografico' && (
    <g>
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <line x1="8" y1={10 + i * 7} x2="80" y2={10 + i * 7} stroke={R} stroke-width="1" />
      ))}
      <rect x="14" y="10" width="44" height="6" fill={T} />
      <rect x="14" y="24" width="58" height="3" fill={T} />
      <rect x="14" y="31" width="54" height="3" fill={T} />
      <rect x="14" y="45" width="38" height="5" fill={T} />
    </g>
  )}
  {slug === 'legibilidad' && (
    <g>
      <text x="11" y="41" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="24" font-weight="700" fill={T}>Il1</text>
      <line x1="45" y1="12" x2="45" y2="52" stroke={R} stroke-width="1.5" />
      <rect x="52" y="20" width="26" height="3" fill={T} />
      <rect x="52" y="28" width="24" height="3" fill={T} />
      <rect x="52" y="36" width="26" height="3" fill={T} />
      <rect x="52" y="44" width="18" height="3" fill={T} />
    </g>
  )}

  {/* ── 03 · COLOR ──────────────────────────────────── */}
  {slug === 'interaccion-del-color' && (
    <g>
      <rect x="0" y="0" width="44" height="64" fill="#1f3a5f" />
      <rect x="44" y="0" width="44" height="64" fill="#e9c46a" />
      <rect x="14" y="22" width="16" height="20" fill="#8a8a8a" />
      <rect x="58" y="22" width="16" height="20" fill="#8a8a8a" />
    </g>
  )}
  {slug === 'contraste' && (
    <g>
      <rect x="8" y="10" width="34" height="44" fill={T} />
      <rect x="17" y="22" width="16" height="20" fill="#ffffff" />
      <rect x="46" y="10" width="34" height="44" fill="#d8d8d4" />
      <rect x="55" y="22" width="16" height="20" fill="#c2c2be" />
    </g>
  )}
  {slug === 'armonia' && (
    <g>
      <rect x="8" y="14" width="44" height="36" fill="#233d4d" stroke={T} stroke-width="1.2" />
      <rect x="52" y="14" width="20" height="36" fill="#619b8a" stroke={T} stroke-width="1.2" />
      <rect x="72" y="14" width="8" height="36" fill="#fe7f2d" stroke={T} stroke-width="1.2" />
    </g>
  )}
  {slug === 'roles-semanticos' && (
    <g>
      <rect x="10" y="12" width="68" height="11" fill="#e8f5e9" stroke="#2e7d32" stroke-width="1.5" />
      <circle cx="17" cy="17.5" r="2.8" fill="#2e7d32" />
      <rect x="10" y="26.5" width="68" height="11" fill="#fff8e1" stroke="#b26a00" stroke-width="1.5" />
      <polygon points="17,29 14,35 20,35" fill="#b26a00" />
      <rect x="10" y="41" width="68" height="11" fill="#fdecea" stroke="#b3261e" stroke-width="1.5" />
      <rect x="14.5" y="44" width="5" height="5" fill="#b3261e" />
    </g>
  )}
  {slug === 'accesibilidad-del-color' && (
    <g>
      <circle cx="24" cy="32" r="11" fill="#0072b2" stroke={T} stroke-width="1.5" />
      <polygon points="60,20 49,42 71,42" fill="#e69f00" stroke={T} stroke-width="1.5" />
    </g>
  )}
  {slug === 'dependencia-del-contexto' && (
    <g>
      <rect x="8" y="10" width="36" height="44" fill="#c84b31" />
      <rect x="44" y="10" width="36" height="44" fill="#c84b31" />
      {[0, 1, 2, 3, 4].map((i) => (
        <line x1="10" y1={16 + i * 8} x2="42" y2={16 + i * 8} stroke="#ffffff" stroke-width="2" />
      ))}
      {[0, 1, 2, 3, 4].map((i) => (
        <line x1="46" y1={16 + i * 8} x2="78" y2={16 + i * 8} stroke={T} stroke-width="2" />
      ))}
    </g>
  )}

  {/* ── 04 · COMPOSICIÓN ────────────────────────────── */}
  {slug === 'reticulas-y-alineacion' && (
    <g>
      {[0, 1, 2, 3, 4, 5].map((c) => <rect x={8 + c * 12.5} y="6" width="9.5" height="52" fill="#e5e5e5" />)}
      <rect x="8" y="10" width="47" height="10" fill={T} />
      <rect x="8" y="26" width="22" height="26" fill={T} />
      <rect x="33" y="26" width="47" height="3" fill={T} />
      <rect x="33" y="33" width="47" height="3" fill={T} />
      <rect x="33" y="40" width="34" height="3" fill={T} />
    </g>
  )}
  {slug === 'proporcion' && (
    <g fill="none" stroke={T} stroke-width="1.5">
      <rect x="10" y="10" width="42" height="44" fill="#e5e5e5" />
      <rect x="52" y="10" width="26" height="27" />
      <rect x="52" y="37" width="16" height="17" />
      <rect x="68" y="37" width="10" height="17" />
    </g>
  )}
  {slug === 'equilibrio' && (
    <g>
      <line x1="12" y1="46" x2="76" y2="46" stroke={T} stroke-width="2" />
      <polygon points="44,46 39,55 49,55" fill={T} />
      <rect x="20" y="20" width="22" height="22" fill={G} stroke={T} stroke-width="1.2" />
      <circle cx="67" cy="35" r="6.5" fill={T} />
    </g>
  )}
  {slug === 'espacio-negativo' && (
    <g>
      <rect x="6" y="6" width="76" height="52" fill="#ffffff" stroke={T} stroke-width="1.2" />
      <rect x="54" y="36" width="20" height="14" fill={T} />
      <circle cx="58" cy="28" r="3" fill="#b3261e" />
    </g>
  )}
  {slug === 'densidad-visual' && (
    <g fill={T}>
      {[0, 1, 2, 3, 4].map((f) =>
        [0, 1, 2, 3].map((c) => (
          <rect x={10 + c * 18} y={12 + f * 9} width={c === 0 ? 12 : 8} height="3" fill={f === 0 ? T : G} />
        )),
      )}
      <line x1="10" y1="18" x2="76" y2="18" stroke={T} stroke-width="1.2" />
    </g>
  )}

  {/* ── 05 · SISTEMAS ───────────────────────────────── */}
  {slug === 'sistemas-y-excepciones' && (
    <g>
      {[0, 1, 2].map((f) =>
        [0, 1, 2, 3].map((c) => (
          <rect
            x={10 + c * 18}
            y={8 + f * 17}
            width="14"
            height="13"
            fill={f === 1 && c === 2 ? A : 'none'}
            stroke={T}
            stroke-width={f === 1 && c === 2 ? 2 : 1.2}
          />
        )),
      )}
    </g>
  )}
  {slug === 'tokens' && (
    <g>
      <circle cx="20" cy="32" r="8" fill={T} />
      <line x1="28" y1="29" x2="52" y2="16" stroke={T} stroke-width="1.4" />
      <line x1="28" y1="32" x2="52" y2="32" stroke={T} stroke-width="1.4" />
      <line x1="28" y1="35" x2="52" y2="48" stroke={T} stroke-width="1.4" />
      <rect x="52" y="10" width="24" height="11" fill="#e5e5e5" stroke={T} stroke-width="1.4" />
      <rect x="52" y="26.5" width="24" height="11" fill="#e5e5e5" stroke={T} stroke-width="1.4" />
      <rect x="52" y="43" width="24" height="11" fill="#e5e5e5" stroke={T} stroke-width="1.4" />
    </g>
  )}
  {slug === 'componentes' && (
    <g>
      <rect x="12" y="10" width="64" height="44" fill="#ffffff" stroke={T} stroke-width="1.8" />
      <rect x="18" y="16" width="18" height="18" fill={R} stroke={T} stroke-width="1" stroke-dasharray="2 2" />
      <rect x="42" y="17" width="28" height="6" fill={T} />
      <rect x="42" y="27" width="20" height="4" fill={G} />
      <rect x="18" y="40" width="52" height="8" fill={T} />
    </g>
  )}
  {slug === 'patrones' && (
    <g>
      <rect x="10" y="10" width="68" height="10" fill="#ffffff" stroke={T} stroke-width="1.4" />
      <circle cx="16" cy="15" r="2.2" fill={T} />
      {[0, 1, 2].map((i) => (
        <rect x={10 + i * 24} y="26" width="20" height="26" fill={i === 0 ? '#e5e5e5' : '#ffffff'} stroke={T} stroke-width="1.4" />
      ))}
    </g>
  )}
  {slug === 'variantes' && (
    <g>
      <rect x="10" y="11" width="68" height="12" fill={T} />
      <rect x="24" y="15" width="40" height="4" fill="#ffffff" />
      <rect x="10" y="27" width="68" height="12" fill="#ffffff" stroke={T} stroke-width="1.8" />
      <rect x="24" y="31" width="40" height="4" fill={T} />
      <rect x="10" y="43" width="68" height="12" fill="none" stroke={G} stroke-width="1.2" stroke-dasharray="3 2" />
      <rect x="24" y="47" width="40" height="4" fill={G} />
    </g>
  )}

  {/* ── 06 · EXPRESIÓN ──────────────────────────────── */}
  {slug === 'enfasis' && (
    <g>
      {[0, 1, 2].map((f) =>
        [0, 1, 2].map((c) => (
          <circle cx={14 + c * 11} cy={20 + f * 12} r="2.6" fill={G} />
        )),
      )}
      <circle cx="64" cy="32" r="13" fill={A} stroke={T} stroke-width="2" />
      <circle cx="64" cy="32" r="5" fill={T} />
    </g>
  )}
  {slug === 'tension' && (
    <g>
      <polygon points="10,16 42,32 10,48" fill={T} />
      <polygon points="78,16 46,32 78,48" fill={T} />
      <circle cx="44" cy="32" r="5" fill={A} stroke="#b3261e" stroke-width="1.5" />
    </g>
  )}
  {slug === 'asimetria' && (
    <g>
      <line x1="28" y1="6" x2="28" y2="58" stroke="#b3261e" stroke-width="1.5" stroke-dasharray="3 2" />
      <rect x="28" y="12" width="46" height="12" fill={T} />
      <rect x="28" y="30" width="32" height="5" fill={G} />
      <rect x="10" y="42" width="14" height="12" fill="#e5e5e5" stroke={T} stroke-width="1.5" />
    </g>
  )}
  {slug === 'ruptura' && (
    <g>
      {[0, 1, 2, 3, 4].map((i) => (
        <rect x={12 + i * 14} y="12" width="6" height="40" fill={i === 2 ? 'none' : R} />
      ))}
      <rect x="39" y="10" width="8" height="44" fill={A} stroke={T} stroke-width="1.8" transform="rotate(-18 43 32)" />
    </g>
  )}
  {slug === 'ambiguedad' && (
    <g fill="none" stroke={T} stroke-width="1.8">
      <rect x="18" y="12" width="30" height="30" />
      <rect x="36" y="22" width="30" height="30" fill="#e5e5e5" fill-opacity="0.65" />
      <line x1="18" y1="12" x2="36" y2="22" />
      <line x1="48" y1="12" x2="66" y2="22" />
      <line x1="18" y1="42" x2="36" y2="52" />
      <line x1="48" y1="42" x2="66" y2="52" />
    </g>
  )}
  {slug === 'extranamiento' && (
    <g>
      <rect x="10" y="16" width="34" height="3.5" fill={G} />
      <rect x="10" y="24" width="30" height="3.5" fill={G} />
      <rect x="10" y="32" width="34" height="3.5" fill={G} />
      <rect x="10" y="40" width="22" height="3.5" fill={G} />
      <text x="48" y="49" font-family="'PT Serif', Georgia, serif" font-size="46" font-weight="700" fill={T} transform="rotate(180 63 32)">¿</text>
    </g>
  )}
</svg>
